<?xml version="1.0" encoding="utf-8"?>
<!-- Долгое нажатие на значок: вкладки приложения. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="thirst"
        android:enabled="true"
        android:icon="@drawable/shortcut_water"
        android:shortcutShortLabel="@string/shortcut_thirst"
        android:shortcutLongLabel="@string/shortcut_thirst">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ledro6.sprout"
            android:targetClass="com.ledro6.sprout.MainActivity">
            <extra android:name="tab" android:value="home" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add"
        android:shortcutLongLabel="@string/shortcut_add">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ledro6.sprout"
            android:targetClass="com.ledro6.sprout.MainActivity">
            <extra android:name="tab" android:value="add" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="stats"
        android:enabled="true"
        android:icon="@drawable/shortcut_stats"
        android:shortcutShortLabel="@string/shortcut_stats"
        android:shortcutLongLabel="@string/shortcut_stats">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ledro6.sprout"
            android:targetClass="com.ledro6.sprout.MainActivity">
            <extra android:name="tab" android:value="stats" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ledro6.sprout"
            android:targetClass="com.ledro6.sprout.MainActivity">
            <extra android:name="tab" android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
