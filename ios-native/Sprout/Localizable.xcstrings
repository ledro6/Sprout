    "Зима: земля сохнет медленнее, поливать реже": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشتاء: التربة تجف أبطأ، اسقِ أقل"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зима: пръстта съхне по-бавно, поливайте по-рядко"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivern: la terra s’asseca més a poc a poc, rega menys"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemina schne pomaleji, zalévejte méně často"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorden tørrer langsommere, vand sjældnere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: Die Erde trocknet langsamer, seltener gießen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειμώνας: το χώμα στεγνώνει πιο αργά, ποτίζετε πιο αραιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: soil dries slower, water less often"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierno: la tierra se seca más despacio, riega menos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvi: multa kuivuu hitaammin, kastele harvemmin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiver : la terre sèche plus lentement, arrosez moins souvent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חורף: האדמה מתייבשת לאט יותר, להשקות פחות"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemlja se suši sporije, zalijevajte rjeđe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tél: a föld lassabban szárad, ritkábban öntözz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: il terriccio asciuga più lentamente, annaffia meno spesso"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қыс: топырақ баяу кебеді, сирек суарыңыз"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiema: žemė džiūsta lėčiau, laistykite rečiau"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorda tørker saktere, vann sjeldnere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: de aarde droogt langzamer, minder vaak water geven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: ziemia schnie wolniej, podlewaj rzadziej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: a terra seca mais devagar, regue menos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: a terra seca mais devagar, regue menos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iarnă: pământul se usucă mai încet, udă mai rar"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemina schne pomalšie, polievajte menej často"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemlja se suši počasneje, zalivajte redkeje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorden torkar långsammare, vattna mer sällan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kış: toprak daha yavaş kurur, daha seyrek sulayın"
