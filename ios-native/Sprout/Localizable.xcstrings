        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلا بنانے کے لیے “+” پر تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm “+” để tạo phòng đầu tiên."
          }
