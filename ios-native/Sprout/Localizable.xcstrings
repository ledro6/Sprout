    "Сфотографируйте растение — телефон попробует узнать его вид.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّر النبتة — سيحاول الهاتف التعرّف على نوعها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте растението – телефонът ще опита да разпознае вида му."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছের ছবি তুলুন — ফোন তার প্রজাতি চেনার চেষ্টা করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia la planta: el telèfon provarà de reconèixer-ne l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte rostlinu – telefon zkusí poznat její druh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et foto af planten – telefonen prøver at genkende arten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere die Pflanze – das Telefon versucht, die Art zu erkennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίστε το φυτό — το τηλέφωνο θα προσπαθήσει να αναγνωρίσει το είδος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the plant — the phone will try to recognize its species."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía la planta: el teléfono intentará reconocer su especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa kasvi – puhelin yrittää tunnistaa lajin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez la plante — le téléphone essaiera de reconnaître son espèce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડનો ફોટો લો — ફોન તેની જાત ઓળખવાનો પ્રયાસ કરશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלמו את הצמח — הטלפון ינסה לזהות את המין שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधे की फ़ोटो लें — फ़ोन उसकी प्रजाति पहचानने की कोशिश करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografirajte biljku – telefon će pokušati prepoznati vrstu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotózd le a növényt – a telefon megpróbálja felismerni a faját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tanamannya — ponsel akan mencoba mengenali jenisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa la pianta: il telefono proverà a riconoscerne la specie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物を撮影してください — 種類の判別を試みます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдікті суретке түсіріңіз — телефон оның түрін танып көреді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡದ ಫೋಟೋ ತೆಗೆಯಿರಿ — ಫೋನ್ ಅದರ ಜಾತಿ ಗುರುತಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물 사진을 찍으면 휴대폰이 종을 알아보려고 해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nufotografuokite augalą – telefonas pabandys atpažinti jo rūšį."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെടിയുടെ ഫോട്ടോ എടുക്കുക — ഫോൺ അതിന്റെ ഇനം തിരിച്ചറിയാൻ ശ്രമിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोपाचा फोटो घ्या — फोन त्याची जात ओळखण्याचा प्रयत्न करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto tumbuhan — telefon akan cuba mengecam spesiesnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bilde av planten – telefonen prøver å kjenne igjen arten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een foto van de plant – de telefoon probeert de soort te herkennen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗଛର ଫଟୋ ଉଠାନ୍ତୁ — ଫୋନ୍ ତାର ପ୍ରଜାତି ଚିହ୍ନିବାକୁ ଚେଷ୍ଟା କରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌਦੇ ਦੀ ਫ਼ੋਟੋ ਲਓ — ਫ਼ੋਨ ਉਸਦੀ ਕਿਸਮ ਪਛਾਣਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zdjęcie rośliny – telefon spróbuje rozpoznać jej gatunek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe a planta: o celular vai tentar reconhecer a espécie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe a planta: o telefone vai tentar reconhecer a espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiază planta – telefonul va încerca să-i recunoască specia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odfoťte rastlinu – telefón skúsi rozpoznať jej druh."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografirajte rastlino – telefon bo poskusil prepoznati vrsto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fota växten – telefonen försöker känna igen arten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செடியைப் புகைப்படம் எடுங்கள் — போன் அதன் வகையை அறிய முயலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్క ఫోటో తీయండి — ఫోన్ దాని జాతిని గుర్తించడానికి ప్రయత్నిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายรูปต้นไม้ — โทรศัพท์จะลองจำแนกชนิดให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkinin fotoğrafını çekin — telefon türünü tanımaya çalışacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографуйте рослину — телефон спробує впізнати її вид."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پودے کی تصویر لیں — فون اس کی قسم پہچاننے کی کوشش کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh cây — điện thoại sẽ thử nhận ra loài cây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给植物拍张照——手机会尝试识别它的种类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替植物拍張照——手機會嘗試辨識它的種類。"
          }
        }
      }
    },
    "Счёт от %@. Обновится, когда друг пришлёт код снова.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقاط بتاريخ %@. ستتحدث عندما يرسل صديقك الرمز مجددًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Резултат от %@. Ще се обнови, когато приятелят изпрати кода отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত স্কোর। বন্ধু আবার কোড পাঠালে আপডেট হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuació del %@. S’actualitzarà quan el teu amic torni a enviar el codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skóre k %@. Aktualizuje se, až přítel pošle kód znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Score fra %@. Opdateres, når din ven sender koden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand vom %@. Wird aktualisiert, wenn dein Freund den Code erneut schickt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκορ από %@. Θα ενημερωθεί όταν ο φίλος στείλει ξανά τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score as of %@. It updates when your friend sends their code again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuación del %@. Se actualizará cuando tu amigo vuelva a enviar su código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisteet %@. Päivittyy, kun kaverisi lähettää koodin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Score du %@. Il sera mis à jour quand votre ami renverra son code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સુધીનો સ્કોર. મિત્ર ફરી કોડ મોકલશે ત્યારે અપડેટ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוד מ־%@. יתעדכן כשהחבר ישלח את הקוד שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक का स्कोर। दोस्त के कोड दोबारा भेजने पर अपडेट होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat od %@. Ažurirat će se kad prijatelj ponovno pošalje kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontszám: %@. Frissül, amikor a barátod újra elküldi a kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor per %@. Diperbarui saat temanmu mengirim kodenya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggio del %@. Si aggiornerà quando il tuo amico invierà di nuovo il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@時点のスコア。友達がコードをもう一度送ると更新されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнгі ұпай. Досыңыз кодты қайта жібергенде жаңарады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ವರೆಗಿನ ಅಂಕ. ಸ್ನೇಹಿತರು ಮತ್ತೆ ಕೋಡ್ ಕಳುಹಿಸಿದಾಗ ನವೀಕರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기준 점수. 친구가 코드를 다시 보내면 업데이트돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatas nuo %@. Atsinaujins, kai draugas vėl atsiųs kodą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വരെയുള്ള സ്കോർ. സുഹൃത്ത് വീണ്ടും കോഡ് അയയ്ക്കുമ്പോൾ അപ്ഡേറ്റാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर्यंतचे गुण. मित्राने पुन्हा कोड पाठवल्यावर अपडेट होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor setakat %@. Dikemas kini apabila rakan menghantar kod sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poeng fra %@. Oppdateres når vennen sender koden på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Score van %@. Wordt bijgewerkt als je vriend de code opnieuw stuurt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ପର୍ଯ୍ୟନ୍ତ ସ୍କୋର୍। ବନ୍ଧୁ ପୁଣି କୋଡ୍ ପଠାଇଲେ ଅପଡେଟ୍ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੱਕ ਦਾ ਸਕੋਰ। ਦੋਸਤ ਦੇ ਮੁੜ ਕੋਡ ਭੇਜਣ 'ਤੇ ਅੱਪਡੇਟ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik z %@. Zaktualizuje się, gdy znajomy znów przyśle kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando seu amigo enviar o código de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando o seu amigo voltar a enviar o código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scor din %@. Se actualizează când prietenul trimite din nou codul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skóre k %@. Aktualizuje sa, keď priateľ znova pošle kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat na dan %@. Posodobi se, ko prijatelj znova pošlje kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poäng från %@. Uppdateras när vännen skickar koden igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வரையிலான மதிப்பெண். நண்பர் மீண்டும் குறியீட்டை அனுப்பும்போது புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వరకు స్కోర్. స్నేహితుడు మళ్లీ కోడ్ పంపినప్పుడు నవీకరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนน ณ %@ จะอัปเดตเมื่อเพื่อนส่งรหัสมาอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihli puan. Arkadaşınız kodu yeniden gönderince güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок від %@. Оновиться, коли друг надішле код знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تک کا اسکور۔ دوست کے دوبارہ کوڈ بھیجنے پر اپ ڈیٹ ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm tính đến %@. Sẽ cập nhật khi bạn của bạn gửi lại mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至%@的分数。朋友再次发来代码时会更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截至%@的分數。朋友再次傳來代碼時會更新。"
          }
        }
      }
    },
