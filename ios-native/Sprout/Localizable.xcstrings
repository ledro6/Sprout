    "Наклон телефона чуть двигает узор на фоне. Показания используются только для этого, не сохраняются и никуда не уходят.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, flytter baggrundsmønsteret sig en smule. Målingerne bruges kun til det, gemmes ikke og sendes ingen steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Telefon neigst, bewegt sich das Hintergrundmuster leicht. Die Messwerte dienen nur dazu, werden nicht gespeichert und gehen nirgendwohin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilting the phone gently moves the background pattern. The readings are used only for that, aren’t saved and go nowhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al inclinar el teléfono, el patrón del fondo se mueve un poco. Los datos solo se usan para eso, no se guardan y no van a ninguna parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimen kallistaminen liikuttaa taustakuviota hieman. Lukemia käytetään vain siihen, eikä niitä tallenneta tai lähetetä mihinkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incliner le téléphone déplace légèrement le motif d’arrière-plan. Les mesures ne servent qu’à cela, ne sont pas enregistrées et ne partent nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinando il telefono il motivo dello sfondo si sposta leggermente. I dati servono solo a questo, non vengono salvati e non vanno da nessuna parte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, flytter bakgrunnsmønsteret seg litt. Målingene brukes bare til det, lagres ikke og sendes ingen steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantelen van de telefoon beweegt het achtergrondpatroon een beetje. De metingen worden alleen daarvoor gebruikt, niet bewaard en nergens heen gestuurd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o celular move levemente o padrão do fundo. Os dados são usados só para isso, não são salvos e não vão para lugar nenhum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o telemóvel move ligeiramente o padrão do fundo. Os dados servem só para isso, não são guardados e não vão para lado nenhum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lutar telefonen rör sig bakgrundsmönstret lite. Mätvärdena används bara till det, sparas inte och skickas ingenstans."
          }
        }
      }
    },
