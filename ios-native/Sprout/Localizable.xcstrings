    "Каждый полив — нота: ближние планеты поют выше.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل سقية نغمة: الكواكب القريبة تغني بصوت أعلى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко поливане е нота: близките планети пеят по-високо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবার জল দেওয়া একটি সুর: কাছের গ্রহরা উঁচু সুরে গায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reg és una nota: els planetes propers canten més agut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zalití je tón: blízké planety zpívají výš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver vanding er en tone: indre planeter synger lysere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Guss ist ein Ton: Innere Planeten singen höher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πότισμα είναι μια νότα: οι κοντινοί πλανήτες τραγουδούν πιο ψηλά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every watering is a note: inner planets sing higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada riego es una nota: los planetas cercanos cantan más agudo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kastelu on nuotti: sisemmät planeetat laulavat korkeammalta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque arrosage est une note : les planètes proches chantent plus aigu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક વાર પાણી આપવું એક સૂર છે: નજીકના ગ્રહો ઊંચા સૂરે ગાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל השקיה היא תו: כוכבי הלכת הקרובים שרים גבוה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बार पानी देना एक सुर है: पास के ग्रह ऊँचा गाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako zalijevanje je nota: bliski planeti pjevaju više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden öntözés egy hang: a belső bolygók magasabban énekelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap siraman adalah nada: planet dekat bernyanyi lebih tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni annaffiatura è una nota: i pianeti vicini cantano più acuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりのたびに音が鳴ります：内側の惑星ほど高い音。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр суару — нота: жақын ғаламшарлар жоғары әндетеді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಬಾರಿ ನೀರು ಹಾಕುವುದು ಒಂದು ಸ್ವರ: ಹತ್ತಿರದ ಗ್ರಹಗಳು ಎತ್ತರದ ಸ್ವರದಲ್ಲಿ ಹಾಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 줄 때마다 음이 울려요: 안쪽 행성일수록 높은 음이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas laistymas – nata: artimos planetos dainuoja aukščiau."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ നനയ്ക്കലും ഒരു സ്വരമാണ്: അടുത്ത ഗ്രഹങ്ങൾ ഉയർന്ന സ്വരത്തിൽ പാടുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक वेळचे पाणी एक सूर आहे: जवळचे ग्रह उंच गातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap siraman ialah satu not: planet dekat menyanyi lebih tinggi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver vanning er en tone: indre planeter synger lysere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke gietbeurt is een noot: binnenste planeten zingen hoger."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତି ଥର ପାଣି ଦେବା ଏକ ସ୍ୱର: ନିକଟ ଗ୍ରହମାନେ ଉଚ୍ଚ ସ୍ୱରେ ଗାଆନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਵਾਰ ਪਾਣੀ ਦੇਣਾ ਇੱਕ ਸੁਰ ਹੈ: ਨੇੜਲੇ ਗ੍ਰਹਿ ਉੱਚਾ ਗਾਉਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde podlanie to nuta: bliskie planety śpiewają wyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada rega é uma nota: os planetas próximos cantam mais agudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada rega é uma nota: os planetas próximos cantam mais agudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare udare e o notă: planetele apropiate cântă mai sus."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé poliatie je tón: blízke planéty spievajú vyššie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako zalivanje je nota: bližnji planeti pojejo višje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje vattning är en ton: inre planeter sjunger ljusare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு நீர் ஊற்றலும் ஒரு சுரம்: அருகிலுள்ள கோள்கள் உயர்ந்த சுரத்தில் பாடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతిసారి నీళ్లు పోయడం ఒక స్వరం: దగ్గరి గ్రహాలు ఎత్తైన స్వరంలో పాడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรดน้ำแต่ละครั้งคือโน้ตหนึ่งตัว: ดาวเคราะห์วงใกล้ร้องเสียงสูงกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sulama bir nota: iç gezegenler daha ince söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен полив — нота: ближні планети співають вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر بار پانی دینا ایک سُر ہے: قریبی سیارے اونچا گاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần tưới là một nốt nhạc: hành tinh gần hát cao hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次浇水都是一个音符：内圈的行星唱得更高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次澆水都是一個音符：內圈的行星唱得更高。"
          }
        }
      }
    },
