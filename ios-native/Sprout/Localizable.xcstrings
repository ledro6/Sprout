    "Зима: земля сохнет медленнее, поливать реже": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشتاء: التربة تجف أبطأ، اسقِ أقل"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зима: пръстта съхне по-бавно, поливайте по-рядко"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীত: মাটি ধীরে শুকায়, কম জল দিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivern: la terra s’asseca més a poc a poc, rega menys"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemina schne pomaleji, zalévejte méně často"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorden tørrer langsommere, vand sjældnere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: Die Erde trocknet langsamer, seltener gießen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειμώνας: το χώμα στεγνώνει πιο αργά, ποτίζετε πιο αραιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: soil dries slower, water less often"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierno: la tierra se seca más despacio, riega menos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvi: multa kuivuu hitaammin, kastele harvemmin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiver : la terre sèche plus lentement, arrosez moins souvent"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શિયાળો: માટી ધીમે સુકાય છે, ઓછું પાણી આપો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חורף: האדמה מתייבשת לאט יותר, להשקות פחות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्दी: मिट्टी धीरे सूखती है, कम पानी दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemlja se suši sporije, zalijevajte rjeđe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tél: a föld lassabban szárad, ritkábban öntözz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim dingin: tanah lebih lambat kering, siram lebih jarang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: il terriccio asciuga più lentamente, annaffia meno spesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬：土の乾きが遅いので、水やりは控えめに"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қыс: топырақ баяу кебеді, сирек суарыңыз"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಳಿಗಾಲ: ಮಣ್ಣು ನಿಧಾನವಾಗಿ ಒಣಗುತ್ತದೆ, ಕಡಿಮೆ ನೀರು ಹಾಕಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겨울: 흙이 천천히 말라요, 물은 덜 자주"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiema: žemė džiūsta lėčiau, laistykite rečiau"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശൈത്യം: മണ്ണ് പതുക്കെ ഉണങ്ങും, കുറച്ച് നനയ്ക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हिवाळा: माती हळू सुकते, कमी पाणी द्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim sejuk: tanah lambat kering, siram kurang kerap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorda tørker saktere, vann sjeldnere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: de aarde droogt langzamer, minder vaak water geven"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଶୀତ: ମାଟି ଧୀରେ ଶୁଖେ, କମ୍ ପାଣି ଦିଅନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਰਦੀ: ਮਿੱਟੀ ਹੌਲੀ ਸੁੱਕਦੀ ਹੈ, ਘੱਟ ਪਾਣੀ ਦਿਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: ziemia schnie wolniej, podlewaj rzadziej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: a terra seca mais devagar, regue menos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverno: a terra seca mais devagar, regue menos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Iarnă: pământul se usucă mai încet, udă mai rar"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemina schne pomalšie, polievajte menej často"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima: zemlja se suši počasneje, zalivajte redkeje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorden torkar långsammare, vattna mer sällan"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குளிர்காலம்: மண் மெதுவாக உலரும், குறைவாகத் தண்ணீர் ஊற்றவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శీతాకాలం: మట్టి నెమ్మదిగా ఆరుతుంది, తక్కువ నీళ్లు పోయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฤดูหนาว: ดินแห้งช้าลง รดน้ำให้น้อยลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kış: toprak daha yavaş kurur, daha seyrek sulayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зима: земля висихає повільніше, поливати рідше"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سردی: مٹی آہستہ سوکھتی ہے، کم پانی دیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mùa đông: đất khô chậm hơn, tưới thưa hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冬季：土壤干得较慢，少浇水"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "冬季：土壤乾得較慢，少澆水"
          }
        }
      }
