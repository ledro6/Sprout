    "Полный доступ дают в настройках телефона: Sprout → Календари.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الوصول الكامل من إعدادات الهاتف: Sprout ← التقويمات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пълен достъп се дава в настройките на телефона: Sprout → Календари."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনের সেটিংসে পূর্ণ অ্যাক্সেস দিন: Sprout → ক্যালেন্ডার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dona accés complet a la configuració del telèfon: Sprout → Calendaris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný přístup povolíte v Nastavení telefonu: Sprout → Kalendáře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv fuld adgang i telefonens Indstillinger: Sprout → Kalendere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube vollen Zugriff in den Einstellungen des Telefons: Sprout → Kalender."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε πλήρη πρόσβαση στις Ρυθμίσεις του τηλεφώνου: Sprout → Ημερολόγια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full access in the phone’s Settings: Sprout → Calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da acceso completo en los Ajustes del teléfono: Sprout → Calendarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna täysi pääsy puhelimen asetuksista: Sprout → Kalenterit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès complet dans les Réglages du téléphone : Sprout → Calendriers."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોનનાં સેટિંગ્સમાં પૂરી ઍક્સેસ આપો: Sprout → કૅલેન્ડર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לתת גישה מלאה בהגדרות הטלפון: Sprout ← לוחות שנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन की सेटिंग्ज़ में पूरी पहुँच दें: Sprout → कैलेंडर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puni pristup dajete u postavkama telefona: Sprout → Kalendari."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teljes hozzáférést a telefon Beállításaiban adhatsz: Sprout → Naptárak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri akses penuh di Pengaturan ponsel: Sprout → Kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l’accesso completo nelle Impostazioni del telefono: Sprout → Calendari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの設定でフルアクセスを許可してください：Sprout → カレンダー。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Толық рұқсатты телефон баптауларында беріңіз: Sprout → Күнтізбелер."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಪೂರ್ಣ ಪ್ರವೇಶ ನೀಡಿ: Sprout → ಕ್ಯಾಲೆಂಡರ್‌ಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 설정에서 전체 접근을 허용하세요: Sprout → 캘린더."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visišką prieigą suteikite telefono nustatymuose: Sprout → Kalendoriai."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോണിന്റെ ക്രമീകരണങ്ങളിൽ പൂർണ്ണ ആക്സസ് നൽകുക: Sprout → കലണ്ടറുകൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोनच्या सेटिंग्जमध्ये पूर्ण प्रवेश द्या: Sprout → कॅलेंडर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri akses penuh dalam Tetapan telefon: Sprout → Kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi full tilgang i telefonens Innstillinger: Sprout → Kalendere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef volledige toegang in de Instellingen van de telefoon: Sprout → Agenda’s."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ୍ ସେଟିଂସ୍‌ରେ ପୂର୍ଣ୍ଣ ଆକ୍ସେସ୍ ଦିଅନ୍ତୁ: Sprout → କ୍ୟାଲେଣ୍ଡର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਪੂਰੀ ਪਹੁੰਚ ਦਿਓ: Sprout → ਕੈਲੰਡਰ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny dostęp włączysz w Ustawieniach telefonu: Sprout → Kalendarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê acesso total nos Ajustes do celular: Sprout → Calendários."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê acesso total nas Definições do telemóvel: Sprout → Calendários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordă acces complet din Configurările telefonului: Sprout → Calendare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný prístup povolíte v Nastaveniach telefónu: Sprout → Kalendáre."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poln dostop omogočite v nastavitvah telefona: Sprout → Koledarji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge full åtkomst i telefonens Inställningar: Sprout → Kalendrar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபோன் அமைப்புகளில் முழு அணுகலை அனுமதிக்கவும்: Sprout → கேலெண்டர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్ సెట్టింగ్‌లలో పూర్తి యాక్సెస్ ఇవ్వండి: Sprout → క్యాలెండర్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงทั้งหมดในการตั้งค่าของโทรศัพท์: Sprout → ปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam erişimi telefonun Ayarlar’ından verin: Sprout → Takvimler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ дають у налаштуваннях телефона: Sprout → Календарі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کی ترتیبات میں مکمل رسائی دیں: Sprout ← کیلنڈرز۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cấp toàn quyền truy cập trong Cài đặt của điện thoại: Sprout → Lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机的设置中允许完全访问：Sprout → 日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手機的設定中允許完整取用：Sprout → 行事曆。"
          }
        }
      }
    },
