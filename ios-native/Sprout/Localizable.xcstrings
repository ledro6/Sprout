    "Настройки приложения и «Стереть сад» — если захотите начать заново.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات التطبيق و«مسح الحديقة» — إن أردت البدء من جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройките на приложението и „Изтрий градината“ – ако решите да започнете отначало."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের সেটিংস আর “বাগান মুছে ফেলুন” — যদি নতুন করে শুরু করতে চান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els ajustos de l’app i «Esborra el jardí», si vols tornar a començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení aplikace a „Vymazat zahradu“ – pokud budete chtít začít znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens indstillinger og »Slet haven« – hvis du vil starte forfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Einstellungen und „Garten löschen“ – falls du neu anfangen willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις της εφαρμογής και η «Διαγραφή κήπου» — αν θελήσετε να ξεκινήσετε από την αρχή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App settings and “Erase Garden” — if you want to start over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de la app y «Borrar jardín», por si quieres empezar de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen asetukset ja ”Tyhjennä puutarha” – jos haluat aloittaa alusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de l’app et « Effacer le jardin » — si vous voulez tout recommencer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપની સેટિંગ્સ અને “બગીચો ભૂંસો” — જો ફરી શરૂ કરવું હોય તો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות האפליקציה ו„מחיקת הגינה” — אם תרצו להתחיל מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की सेटिंग्स और “बगीचा मिटाएँ” — अगर फिर से शुरू करना चाहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavke aplikacije i „Obriši vrt” – ako želite početi ispočetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app beállításai és a „Kert törlése” – ha újra akarod kezdeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan aplikasi dan “Hapus kebun” — kalau ingin mulai dari awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni dell’app e «Cancella giardino», se vuoi ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの設定と「庭を消去」— 最初からやり直したいときに。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба баптаулары мен «Бақты өшіру» — басынан бастағыңыз келсе."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮತ್ತು “ತೋಟ ಅಳಿಸಿಹಾಕಿ” — ಮತ್ತೆ ಆರಂಭಿಸಬೇಕಿದ್ದರೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 설정과 ‘정원 지우기’ — 처음부터 다시 시작하고 싶을 때."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programos nustatymai ir „Ištrinti sodą“ – jei norėsite pradėti iš naujo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ക്രമീകരണങ്ങളും “തോട്ടം മായ്ക്കുക”യും — വീണ്ടും തുടങ്ങണമെങ്കിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅपच्या सेटिंग्ज आणि “बाग पुसा” — पुन्हा सुरुवात करायची असेल तर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan aplikasi dan “Padam taman” — jika mahu mula semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appinnstillinger og «Slett hagen» – hvis du vil begynne på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-instellingen en ‘Wis tuin’ – als je opnieuw wilt beginnen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ସେଟିଂସ୍ ଓ “ବଗିଚା ଲିଭାନ୍ତୁ” — ପୁଣି ଆରମ୍ଭ କରିବାକୁ ଚାହିଁଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਅਤੇ “ਬਗੀਚਾ ਮਿਟਾਓ” — ਜੇ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨਾ ਚਾਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia aplikacji i „Wymaż ogród” – jeśli zechcesz zacząć od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes do app e “Apagar jardim”, se quiser começar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições da app e “Apagar jardim”, se quiser recomeçar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurările aplicației și „Șterge grădina” – dacă vrei s-o iei de la capăt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenia aplikácie a „Vymazať záhradu“ – ak budete chcieť začať odznova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavitve aplikacije in »Izbriši vrt« – če želite začeti znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens inställningar och ”Radera trädgården” – om du vill börja om."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் அமைப்புகளும் “தோட்டத்தை அழி” — புதிதாகத் தொடங்க விரும்பினால்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ సెట్టింగ్‌లు, “తోటను తుడిచివేయి” — మళ్లీ మొదలుపెట్టాలంటే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าแอปและ “ล้างสวน” — หากต้องการเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ayarları ve “Bahçeyi sil” — baştan başlamak isterseniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування застосунку й «Стерти сад» — якщо захочете почати наново."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کی ترتیبات اور ”باغ مٹائیں“ — اگر دوبارہ شروع کرنا چاہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt ứng dụng và “Xóa khu vườn” — nếu bạn muốn làm lại từ đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用设置和“抹掉花园”——如果想重新开始。"
          }
        },
        "zh-Hant": {
