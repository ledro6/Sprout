            "value": "Musim sejuk: tanah lambat kering, siram kurang kerap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinter: jorda tørker saktere, vann sjeldnere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter: de aarde droogt langzamer, minder vaak water geven"
