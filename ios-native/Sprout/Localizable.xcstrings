    "Нажмите на планету — узнаете, кто это.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على كوكب لتعرف من هو."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете планета, за да видите коя е."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে তা দেখতে একটি গ্রহে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un planeta per saber qui és."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na planetu a uvidíte, kdo to je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en planet for at se, hvem det er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Planeten – dann siehst du, wer es ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε έναν πλανήτη για να δείτε ποιος είναι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a planet to see who it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un planeta para saber quién es."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta planeettaa nähdäksesi, kuka se on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une planète pour savoir qui c’est."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોણ છે તે જોવા ગ્રહ પર ટૅપ કરો."
