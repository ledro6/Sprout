    "Привет! Меня не будет с %1$@ по %2$@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا! سأكون غائبًا من %1$@ إلى %2$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здрасти! Няма да ме има от %1$@ до %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমস্কার! আমি %1$@ থেকে %2$@ পর্যন্ত থাকব না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola! Seré fora del %1$@ al %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj! Nebudu tu od %1$@ do %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej! Jeg er væk fra %1$@ til %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ich bin vom %1$@ bis %2$@ weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεια! Θα λείπω από %1$@ έως %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I’ll be away from %1$@ to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola! Estaré fuera del %1$@ al %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei! Olen poissa %1$@–%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour ! Je serai absent du %1$@ au %2$@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નમસ્તે! હું %1$@ થી %2$@ સુધી બહાર હોઈશ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי! לא אהיה כאן מ־%1$@ עד %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते! मैं %1$@ से %2$@ तक बाहर रहूँगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok! Neću biti ovdje od %1$@ do %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szia! Nem leszek itthon: %1$@ – %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo! Aku pergi dari %1$@ sampai %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao! Sarò via dal %1$@ al %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは！%1$@から%2$@まで留守にします。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сәлем! Мен %1$@ – %2$@ аралығында болмаймын."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಸ್ಕಾರ! ನಾನು %1$@ ರಿಂದ %2$@ ರವರೆಗೆ ಊರಿನಲ್ಲಿ ಇರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요! %1$@부터 %2$@까지 집을 비워요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Labas! Manęs nebus nuo %1$@ iki %2$@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നമസ്കാരം! %1$@ മുതൽ %2$@ വരെ ഞാൻ സ്ഥലത്തുണ്ടാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्कार! मी %1$@ ते %2$@ बाहेर असेन."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Helo! Saya tiada dari %1$@ hingga %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei! Jeg er borte fra %1$@ til %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi! Ik ben weg van %1$@ tot %2$@."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନମସ୍କାର! ମୁଁ %1$@ ରୁ %2$@ ପର୍ଯ୍ୟନ୍ତ ବାହାରେ ରହିବି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਤਿ ਸ੍ਰੀ ਅਕਾਲ! ਮੈਂ %1$@ ਤੋਂ %2$@ ਤੱਕ ਬਾਹਰ ਰਹਾਂਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć! Nie będzie mnie od %1$@ do %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi! Vou estar fora de %1$@ a %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá! Vou estar fora de %1$@ a %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut! Voi lipsi între %1$@ și %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj! Nebudem tu od %1$@ do %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Živjo! Od %1$@ do %2$@ me ne bo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej! Jag är borta från %1$@ till %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வணக்கம்! %1$@ முதல் %2$@ வரை நான் வெளியூரில் இருப்பேன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమస్తే! నేను %1$@ నుండి %2$@ వరకు ఊళ్లో ఉండను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี! ฉันจะไม่อยู่ตั้งแต่ %1$@ ถึง %2$@"
