    "Готово? Растение появится на главной, в выбранной комнате.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز؟ ستظهر النبتة في الرئيسية، في الغرفة التي اخترتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово? Растението ще се появи на началния екран, в избраната стая."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তুত? গাছটি বেছে নেওয়া ঘরে হোম স্ক্রিনে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llest? La planta apareixerà a l’Inici, a l’habitació triada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo? Rostlina se objeví na ploše Domů, ve zvoleném pokoji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdig? Planten dukker op på Hjem, i det valgte rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig? Die Pflanze erscheint auf dem Startbildschirm im gewählten Raum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτοιμο; Το φυτό θα εμφανιστεί στην Αρχική, στο δωμάτιο που επιλέξατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done? The plant will appear on the Home screen in the chosen room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Listo? La planta aparecerá en Inicio, en la habitación elegida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmista? Kasvi ilmestyy Koti-näkymään valittuun huoneeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt ? La plante apparaîtra sur l’accueil, dans la pièce choisie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તૈયાર? છોડ પસંદ કરેલા ઓરડામાં હોમ પર દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוכן? הצמח יופיע במסך הבית, בחדר שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार? पौधा चुने हुए कमरे में होम पर दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotovo? Biljka će se pojaviti na Početnoj, u odabranoj sobi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kész? A növény megjelenik a Főoldalon, a kiválasztott szobában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai? Tanaman akan muncul di Beranda, di ruangan yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto? La pianta comparirà nella Home, nella stanza scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備OK？ 植物は選んだ部屋のホームに表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайын ба? Өсімдік басты бетте, таңдалған бөлмеде пайда болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿದ್ಧವೇ? ಗಿಡ ಆಯ್ದ ಕೋಣೆಯಲ್ಲಿ ಹೋಮ್‌ನಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 됐나요? 식물이 선택한 방의 홈 화면에 나타납니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baigta? Augalas atsiras pradžios ekrane, pasirinktame kambaryje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തയ്യാറോ? ചെടി തിരഞ്ഞെടുത്ത മുറിയിൽ ഹോമിൽ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार? रोप निवडलेल्या खोलीत मुख्य स्क्रीनवर दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap? Tumbuhan akan muncul di Utama, dalam bilik yang dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig? Planten dukker opp på Hjem, i rommet du valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar? De plant verschijnt op het beginscherm, in de gekozen kamer."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରସ୍ତୁତ? ଗଛ ବଛାଯାଇଥିବା କୋଠରୀରେ ହୋମ୍‌ରେ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਿਆਰ? ਪੌਦਾ ਚੁਣੇ ਕਮਰੇ ਵਿੱਚ ਹੋਮ 'ਤੇ ਦਿਖੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe? Roślina pojawi się na ekranie głównym, w wybranym pokoju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto? A planta vai aparecer no Início, no cômodo escolhido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto? A planta aparecerá no Início, na divisão escolhida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gata? Planta va apărea pe Acasă, în camera aleasă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo? Rastlina sa objaví na ploche Domov, vo zvolenej izbe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Končano? Rastlina se bo prikazala na Domov, v izbrani sobi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar? Växten visas på hemskärmen, i det valda rummet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயாரா? செடி தேர்ந்த அறையில் முகப்பில் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిద్ధమా? మొక్క ఎంచుకున్న గదిలో హోమ్‌లో కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว? ต้นไม้จะปรากฏบนหน้าหลัก ในห้องที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır mı? Bitki, seçilen odada Ana Sayfa'da görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово? Рослина з’явиться на головній, у вибраній кімнаті."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیار؟ پودا منتخب کمرے میں ہوم اسکرین پر نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong chưa? Cây sẽ xuất hiện ở Trang chính, trong phòng đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好了吗？植物会出现在主页上所选的房间里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好了嗎？植物會出現在主畫面所選的房間裡。"
          }
        }
      }
    },
