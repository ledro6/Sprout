    "Растения «%@» в саду больше нет.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد «%@» في الحديقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ вече не е в градината."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” আর বাগানে নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja no és al jardí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už v zahradě není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er ikke længere i haven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht mehr im Garten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν είναι πια στον κήπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer in the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya no está en el jardín."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole enää puutarhassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est plus dans le jardin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” હવે બગીચામાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” כבר לא בגינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अब बगीचे में नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” više nije u vrtu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” már nincs a kertben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sudah tidak ada di kebun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è più nel giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はもう庭にありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» енді бақта жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 더 이상 정원에 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sode nebėra."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” आता बागेत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sudah tiada dalam taman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke lenger i hagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ staat niet meer in de tuin."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ଆଉ ବଗିଚାରେ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਹੁਣ ਬਗੀਚੇ ਵਿੱਚ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie ma już w ogrodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está mais no jardim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está mais no jardim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu mai e în grădină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už v záhrade nie je."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« ni več na vrtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” finns inte längre i trädgården."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่อยู่ในสวนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” artık bahçede değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини «%@» у саду більше немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” không còn trong vườn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已不在花园中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
