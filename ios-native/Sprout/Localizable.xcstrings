            "state": "translated",
            "value": "ପରିଚୟ, ଶବ୍ଦକୋଷ ଓ ସଙ୍କେତ — ସବୁ ପୁଣି ଦେଖାଯାଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਣ-ਪਛਾਣ, ਸ਼ਬਦਕੋਸ਼ ਅਤੇ ਸੰਕੇਤ — ਸਭ ਮੁੜ ਦਿਖਾਏ ਜਾ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadzenie, słowniczek i podpowiedzi – wszystko można pokazać ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação, o glossário e as dicas — tudo pode ser mostrado de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação, o glossário e as dicas — tudo pode ser mostrado de novo."
          }
