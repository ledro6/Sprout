    "Телефон узнал: %1$@ — уверен на %2$lld%%. Поправьте, если не так.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkendt: %1$@ – %2$lld %% sikker. Ret det, hvis det er forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannt: %1$@ — zu %2$lld %% sicher. Korrigiere es, falls es nicht stimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized: %1$@ — %2$lld%% sure. Correct it if that’s wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocida: %1$@, con un %2$lld %% de seguridad. Corrígelo si no es así."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistettu: %1$@ – %2$lld %% varma. Korjaa, jos se on väärin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnu : %1$@ — sûr à %2$lld %%. Corrigez si ce n’est pas ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosciuta: %1$@, sicuro al %2$lld%%. Correggi se non è giusto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenkjent: %1$@ – %2$lld %% sikker. Rett det hvis det er feil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkend: %1$@ — %2$lld%% zeker. Pas het aan als het niet klopt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconhecida: %1$@ — %2$lld%% de certeza. Corrija se não for."
          }
        },
        "pt-PT": {
