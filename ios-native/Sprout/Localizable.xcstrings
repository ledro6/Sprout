    "Снимок тёмный — снимите при свете.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة مظلمة — التقطها في الضوء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е тъмна – снимайте на светло."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটা অন্ধকার — আলোয় তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto és fosca: fes-la amb llum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je tmavá – vyfoťte ji při světle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er mørkt – tag det i godt lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist dunkel – mach eins bei Licht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι σκοτεινή — τραβήξτε τη στο φως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is dark — take one in better light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está oscura: tómala con luz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on tumma – ota se valossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est sombre — prenez-la en pleine lumière."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો અંધારો છે — પ્રકાશમાં લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה חשוכה — צלמו באור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो अँधेरी है — रोशनी में लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je tamna – snimite je uz svjetlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó sötét – készítsd világosban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya gelap — ambil di tempat terang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è scura: scattala con più luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が暗すぎます — 明るい場所で撮ってください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет қараңғы — жарықта түсіріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಕತ್ತಲಾಗಿದೆ — ಬೆಳಕಿನಲ್ಲಿ ತೆಗೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 어두워요 — 밝은 곳에서 찍어 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka tamsi – fotografuokite šviesoje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ ഇരുണ്ടതാണ് — വെളിച്ചത്തിൽ എടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो अंधारा आहे — उजेडात घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto gelap — ambil di tempat terang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er mørkt – ta det i godt lys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is donker – maak er een bij goed licht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଅନ୍ଧାର — ଆଲୁଅରେ ଉଠାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਹਨੇਰੀ ਹੈ — ਰੋਸ਼ਨੀ ਵਿੱਚ ਲਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest ciemne – zrób je przy świetle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto está escura: tire com mais luz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia está escura: tire-a com mais luz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia e întunecată – fă-o la lumină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je tmavá – odfoťte ju pri svetle."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je temna – posnemite jo pri svetlobi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot är mörkt – ta det i bra ljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் இருட்டாக உள்ளது — வெளிச்சத்தில் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో చీకటిగా ఉంది — వెలుతురులో తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปมืด — ถ่ายในที่สว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf karanlık — ışıkta çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімок темний — зніміть при світлі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر اندھیری ہے — روشنی میں لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh bị tối — hãy chụp chỗ sáng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片太暗——请在光线充足处拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片太暗——請在光線充足處拍攝。"
          }
        }
      }
