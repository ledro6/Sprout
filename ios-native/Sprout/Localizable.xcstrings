    "Хотя бы одна остаётся.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى شكل واحد على الأقل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поне една остава."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তত একটি থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En queda almenys una."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspoň jeden zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindst én bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τουλάχιστον ένα μένει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una se queda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähintään yksi jää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une reste."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓછામાં ઓછો એક રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפחות אחת נשארת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barem jedan ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább egy marad."
          }
        },
        "id": {
          "stringUnit": {
