    "Прохладно: земля сохнет чуть медленнее": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجو بارد: التربة تجف أبطأ قليلًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хладно: пръстта съхне малко по-бавно"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresc: la terra s’asseca una mica més a poc a poc"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chladno: zemina schne o něco pomaleji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køligt: jorden tørrer lidt langsommere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kühl: Die Erde trocknet etwas langsamer"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δροσιά: το χώμα στεγνώνει λίγο πιο αργά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool: soil dries a little slower"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresco: la tierra se seca algo más despacio"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viileää: multa kuivuu vähän hitaammin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frais : la terre sèche un peu plus lentement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריר: האדמה מתייבשת קצת לאט יותר"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svježe: zemlja se suši malo sporije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hűvös: a föld kicsit lassabban szárad"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresco: il terriccio asciuga un po’ più lentamente"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салқын: топырақ сәл баяу кебеді"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėsu: žemė džiūsta šiek tiek lėčiau"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjølig: jorda tørker litt saktere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koel: de aarde droogt iets langzamer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chłodno: ziemia schnie trochę wolniej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresco: a terra seca um pouco mais devagar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresco: a terra seca um pouco mais devagar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răcoare: pământul se usucă puțin mai încet"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chladno: zemina schne o niečo pomalšie"
          }
        },
        "sl": {
          "stringUnit": {
