    "Все дождутся вас: перед отъездом полейте — и можно ехать.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتظرك كلها: اسقها قبل المغادرة وانطلق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички ще ви изчакат: полейте ги преди тръгване — и можете да вървите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবাই আপনার অপেক্ষা করবে: যাওয়ার আগে জল দিন, তারপর বেরিয়ে পড়ুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes t’esperaran: rega-les abans de marxar i llestos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny na vás počkají: před odjezdem je zalijte a můžete jet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle venter på dig: Vand dem, før du tager af sted – så kan du rejse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle halten durch: Gieß sie vor der Abreise — und los geht’s."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα θα σας περιμένουν: ποτίστε τα πριν φύγετε και καλό δρόμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone will wait for you: water them before you leave and off you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas te esperarán: riégalas antes de irte y listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki odottavat sinua: kastele ne ennen lähtöä, niin voit lähteä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vous attendront : arrosez-les avant de partir, et c’est parti."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધા તમારી રાહ જોશે: જતાં પહેલાં પાણી આપો અને નીકળી પડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כולם יחכו לך: להשקות לפני היציאה — ואפשר לנסוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब आपका इंतज़ार करेंगे: जाने से पहले पानी दें और निकल पड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve će vas pričekati: zalijte ih prije odlaska i možete ići."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind megvárnak: indulás előtt öntözd meg őket, és mehetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua akan menunggumu: siram sebelum berangkat, lalu pergilah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte ti aspetteranno: annaffiale prima di partire e via."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんな待っていてくれます：出発前に水をあげれば出かけられます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі сізді күтеді: кетер алдында суарыңыз да, жолға шығыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲವೂ ನಿಮಗಾಗಿ ಕಾಯುತ್ತವೆ: ಹೊರಡುವ ಮುನ್ನ ನೀರು ಹಾಕಿ ಹೊರಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 기다려 줄 거예요: 떠나기 전에 물을 주고 출발하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi jūsų palauks: palaistykite prieš išvykdami ir galite keliauti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം നിങ്ങൾക്കായി കാത്തിരിക്കും: പോകും മുമ്പ് നനച്ചിട്ട് പുറപ്പെടുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सगळी तुमची वाट पाहतील: जाण्याआधी पाणी घाला आणि निघा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua akan menunggu anda: siram sebelum bertolak dan boleh pergi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle venter på deg: Vann dem før du drar – så kan du reise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wachten allemaal op je: geef ze water voor je vertrekt en klaar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମସ୍ତେ ଆପଣଙ୍କ ପାଇଁ ଅପେକ୍ଷା କରିବେ: ଯିବା ପୂର୍ବରୁ ପାଣି ଦିଅନ୍ତୁ ଏବଂ ବାହାରି ପଡ଼ନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੇ ਤੁਹਾਡੀ ਉਡੀਕ ਕਰਨਗੇ: ਜਾਣ ਤੋਂ ਪਹਿਲਾਂ ਪਾਣੀ ਦਿਓ ਅਤੇ ਨਿਕਲ ਪਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie na ciebie poczekają: podlej je przed wyjazdem i w drogę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas vão esperar por você: regue antes de sair e pode ir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas vão esperar por si: regue antes de partir e pode ir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate te vor aștepta: udă-le înainte de plecare și poți pleca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky na vás počkajú: pred odchodom ich polejte a môžete ísť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse vas bodo počakale: zalijte jih pred odhodom in pot pod noge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla väntar på dig: vattna före avresan och åk."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் உங்களுக்காகக் காத்திருக்கும்: கிளம்பும் முன் தண்ணீர் ஊற்றிவிட்டுச் செல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్నీ మీ కోసం ఎదురుచూస్తాయి: బయలుదేరే ముందు నీళ్లు పోసి వెళ్లండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกต้นจะรอคุณ: รดน้ำก่อนออกเดินทางแล้วไปได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi sizi bekler: gitmeden önce sulayın, sonra yola çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі дочекаються вас: перед від’їздом полийте — і можна їхати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب آپ کا انتظار کریں گے: جانے سے پہلے پانی دیں اور چل پڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả sẽ chờ bạn: tưới trước khi đi là xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们都会等你：出发前浇一次水就可以走了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們都會等你：出發前澆一次水就可以走了。"
          }
        }
      }
    },
    "Все поливы этого растения. Ошибочную запись удалит долгое нажатие.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مرات سقي هذه النبتة. احذف السجل الخاطئ بضغطة مطوّلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички поливания на това растение. Грешен запис се трие с дълго натискане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গাছের সব জল দেওয়ার রেকর্ড। ভুল এন্ট্রি দীর্ঘ চাপে মুছুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els regs d’aquesta planta. Mantén premuda una entrada errònia per esborrar-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna zalití této rostliny. Chybný záznam smažete dlouhým podržením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vandinger af denne plante. Hold på en forkert post for at slette den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Güsse dieser Pflanze. Einen falschen Eintrag löschst du durch langes Drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα ποτίσματα αυτού του φυτού. Μια λάθος καταχώριση διαγράφεται με παρατεταμένο πάτημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every watering of this plant. Touch and hold a wrong entry to delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los riegos de esta planta. Mantén pulsada una entrada errónea para borrarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän kasvin kastelut. Väärän merkinnän voit poistaa pitkällä painalluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les arrosages de cette plante. Un appui long efface une entrée erronée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ છોડને આપેલું બધું પાણી. ખોટી નોંધ લાંબું દબાવીને કાઢી નાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההשקיות של הצמח הזה. רשומה שגויה נמחקת בלחיצה ארוכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पौधे को दिया गया हर पानी। ग़लत प्रविष्टि देर तक दबाकर हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sva zalijevanja ove biljke. Pogrešan zapis brišete dugim pritiskom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növény összes öntözése. Egy hibás bejegyzést hosszú nyomással törölhetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua siraman tanaman ini. Tekan lama catatan yang salah untuk menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le annaffiature di questa pianta. Tieni premuta una voce sbagliata per eliminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この植物の水やりすべて。間違った記録は長押しで削除できます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы өсімдіктің барлық суаруы. Қате жазбаны ұзақ басып жоюға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗಿಡಕ್ಕೆ ಹಾಕಿದ ಎಲ್ಲಾ ನೀರು. ತಪ್ಪು ನಮೂದನ್ನು ದೀರ್ಘವಾಗಿ ಒತ್ತಿ ಅಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식물의 모든 물주기. 잘못된 항목은 길게 눌러 삭제하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi šio augalo laistymai. Klaidingą įrašą ištrinsite ilgai paspaudę."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചെടിയുടെ എല്ലാ നനയ്ക്കലുകളും. തെറ്റായ എൻട്രി ദീർഘമായി അമർത്തി നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या रोपाला दिलेले सर्व पाणी. चुकीची नोंद दीर्घ दाबून हटवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua siraman tumbuhan ini. Tekan lama catatan yang salah untuk memadamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vanningene av denne planten. Hold inne en feil oppføring for å slette den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gietbeurten van deze plant. Houd een verkeerde invoer ingedrukt om die te verwijderen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଗଛକୁ ଦିଆଯାଇଥିବା ସମସ୍ତ ପାଣି। ଭୁଲ୍ ଏଣ୍ଟ୍ରି ଲମ୍ବା ଚାପି ଡିଲିଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪੌਦੇ ਨੂੰ ਦਿੱਤਾ ਸਾਰਾ ਪਾਣੀ। ਗ਼ਲਤ ਦਰਜ ਲੰਮਾ ਦਬਾ ਕੇ ਹਟਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie podlania tej rośliny. Błędny wpis usuniesz długim naciśnięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as regas desta planta. Toque e segure um registro errado para apagá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as regas desta planta. Mantenha premido um registo errado para o apagar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate udările acestei plante. O înregistrare greșită o ștergi cu o apăsare lungă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky poliatia tejto rastliny. Chybný záznam vymažete dlhým podržaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsa zalivanja te rastline. Napačen vnos izbrišete z dolgim pritiskom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla vattningar av den här växten. Håll ned en felaktig post för att radera den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செடிக்கு ஊற்றிய எல்லா நீரும். தவறான பதிவை நீண்ட நேரம் அழுத்தி நீக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ మొక్కకు పోసిన అన్ని నీళ్లు. తప్పు ఎంట్రీని ఎక్కువసేపు నొక్కి తొలగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
