    "День, когда воды попросят сразу три растения и больше, — удобно полить всех за один заход.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم تطلب فيه ثلاث نبتات أو أكثر الماء في آن واحد — مريح أن تسقيها كلها دفعة واحدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ден, в който три или повече растения ще поискат вода едновременно – удобно е да ги полеете всички наведнъж."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেদিন তিন বা তার বেশি গাছ একসঙ্গে জল চাইবে — সবাইকে একবারে জল দেওয়া সুবিধাজনক।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dia en què tres plantes o més demanaran aigua alhora: pràctic per regar-les totes d’una vegada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den, kdy si tři a více rostlin řekne o vodu najednou – šikovné zalít všechny naráz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag, hvor tre eller flere planter vil have vand på én gang – praktisk at vande dem alle i ét hug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag, an dem drei oder mehr Pflanzen gleichzeitig Wasser wollen – praktisch, alle in einem Durchgang zu gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μέρα που τρία ή περισσότερα φυτά θα ζητήσουν νερό ταυτόχρονα — βολικό να τα ποτίσετε όλα μαζί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day when three or more plants will want water at once — handy to water them all in one go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día en que tres o más plantas pedirán agua a la vez: práctico para regarlas todas de una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä, jolloin kolme kasvia tai enemmän haluaa vettä yhtä aikaa – kätevää kastella kaikki kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour où trois plantes ou plus voudront de l’eau en même temps — pratique pour tout arroser d’un coup."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એવો દિવસ જ્યારે ત્રણ કે વધુ છોડ એક સાથે પાણી માગશે — બધાને એક જ વારમાં પાણી આપવું સરળ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יום שבו שלושה צמחים או יותר ירצו מים בבת אחת – נוח להשקות את כולם בסיבוב אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह दिन जब तीन या ज़्यादा पौधे एक साथ पानी माँगेंगे — सबको एक ही बार में पानी देना आसान।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan kad će tri biljke ili više zatražiti vodu odjednom – zgodno ih je zaliti sve u jednom navratu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy nap, amikor három vagy több növény egyszerre kér vizet – kényelmes egyszerre megöntözni mindet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari ketika tiga tanaman atau lebih meminta air bersamaan — praktis untuk menyiram semuanya sekaligus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno in cui tre o più piante vorranno acqua insieme: comodo annaffiarle tutte in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3鉢以上が同時に水を欲しがる日。まとめて一度に水やりできて便利です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірден үш немесе одан көп өсімдік су сұрайтын күн — бәрін бір-ақ рет суару ыңғайлы."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂರು ಅಥವಾ ಹೆಚ್ಚು ಗಿಡಗಳು ಒಟ್ಟಿಗೆ ನೀರು ಕೇಳುವ ದಿನ — ಎಲ್ಲಕ್ಕೂ ಒಮ್ಮೆಗೇ ನೀರು ಹಾಕುವುದು ಸುಲಭ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 식물 이상이 한꺼번에 물을 원하는 날 — 한 번에 모두 물을 주기 좋아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diena, kai trys ar daugiau augalų vienu metu norės vandens – patogu palaistyti visus iš karto."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൂന്നോ അതിലധികമോ ചെടികൾ ഒരുമിച്ച് വെള്ളം ചോദിക്കുന്ന ദിവസം — എല്ലാറ്റിനെയും ഒറ്റയടിക്ക് നനയ്ക്കാൻ സൗകര്യം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्या दिवशी तीन किंवा अधिक रोपे एकाच वेळी पाणी मागतील — सर्वांना एकदाच पाणी देणे सोयीचे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari apabila tiga tumbuhan atau lebih meminta air serentak — mudah untuk menyiram semuanya sekali gus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag da tre eller flere planter vil ha vann samtidig – praktisk å vanne alle på én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag waarop drie of meer planten tegelijk water willen – handig om ze allemaal in één keer te gieten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେଉଁ ଦିନ ତିନି କିମ୍ବା ଅଧିକ ଗଛ ଏକାସାଙ୍ଗରେ ପାଣି ମାଗିବେ — ସମସ୍ତଙ୍କୁ ଥରକରେ ପାଣି ଦେବା ସହଜ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਦਿਨ ਜਦੋਂ ਤਿੰਨ ਜਾਂ ਵੱਧ ਪੌਦੇ ਇੱਕੋ ਸਮੇਂ ਪਾਣੀ ਮੰਗਣਗੇ — ਸਭ ਨੂੰ ਇੱਕੋ ਵਾਰ ਪਾਣੀ ਦੇਣਾ ਸੌਖਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, w którym trzy rośliny lub więcej zechcą wody naraz – wygodnie podlać wszystkie za jednym razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia em que três ou mais plantas vão pedir água ao mesmo tempo — prático para regar todas de uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia em que três ou mais plantas vão pedir água ao mesmo tempo — prático para as regar todas de uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O zi în care trei sau mai multe plante vor apă deodată – comod să le uzi pe toate dintr-odată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Deň, keď si tri a viac rastlín vypýta vodu naraz – šikovné poliať všetky naraz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan, ko si bodo tri rastline ali več hkrati zaželele vode – priročno jih je zaliti vse naenkrat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag då tre eller fler växter vill ha vatten samtidigt – smidigt att vattna alla på en gång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூன்று அல்லது அதிக செடிகள் ஒரே நேரத்தில் நீர் கேட்கும் நாள் — அனைத்துக்கும் ஒரே முறையில் ஊற்றுவது வசதி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూడు లేదా అంతకంటే ఎక్కువ మొక్కలు ఒకేసారి నీళ్లు అడిగే రోజు — అన్నింటికీ ఒకేసారి పోయడం సులువు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ต้นไม้สามต้นขึ้นไปต้องการน้ำพร้อมกัน — สะดวกที่จะรดทั้งหมดในครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç ya da daha fazla bitkinin aynı anda su isteyeceği bir gün — hepsini tek seferde sulamak için ideal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День, коли води попросять одразу три рослини й більше, — зручно полити всіх за один захід."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ دن جب تین یا زیادہ پودے ایک ساتھ پانی مانگیں گے — سب کو ایک ہی بار میں پانی دینا آسان۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày mà ba cây trở lên cùng cần nước một lúc — tiện tưới tất cả trong một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三株或更多植物同时要水的日子——正好一次浇完。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三株以上植物同時要水的日子——剛好一次澆完。"
          }
        }
      }
    },
