    "Отмечает полив: влажность встаёт на сто процентов, а полив попадает в журнал.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanding: fugten stiger til hundrede procent, og vandingen kommer i loggen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermerkt das Gießen: Die Feuchtigkeit steigt auf hundert Prozent, und das Gießen landet im Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs a watering: moisture goes up to one hundred percent and the watering is added to the log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un riego: la humedad sube al cien por cien y el riego se anota en el registro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa kastelun: kosteus nousee sataan prosenttiin ja kastelu tallentuu päiväkirjaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un arrosage : l’humidité remonte à cent pour cent et l’arrosage entre dans le journal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un’annaffiatura: l’umidità sale al cento per cento e l’annaffiatura finisce nel registro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanning: fukten stiger til hundre prosent, og vanningen havner i loggen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert een waterbeurt: de vochtigheid gaat naar honderd procent en de beurt komt in het logboek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra uma rega: a umidade sobe para cem por cento e a rega entra no histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista uma rega: a humidade sobe para cem por cento e a rega entra no registo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerar en vattning: fukten går upp till hundra procent och vattningen hamnar i loggen."
          }
        }
      }
    },
