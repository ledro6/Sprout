    "Пожалуйста, полей растения:": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من فضلك اسقِ هذه النباتات:"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моля те, полей растенията:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, rega aquestes plantes:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím, zalij tyto rostliny:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær sød at vande disse planter:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gieß diese Pflanzen:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότισε, σε παρακαλώ, αυτά τα φυτά:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please water these plants:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, riega estas plantas:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastelethan nämä kasvit:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d’arroser ces plantes :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בבקשה, תשקה את הצמחים האלה:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molim te, zalij ove biljke:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérlek, öntözd meg ezeket a növényeket:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, annaffia queste piante:"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өтінемін, мына өсімдіктерді суар:"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prašau, palaistyk šiuos augalus:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær så snill og vann disse plantene:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je deze planten water geven:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlej, proszę, te rośliny:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, regue estas plantas:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, regue estas plantas:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rog, udă aceste plante:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím, polej tieto rastliny:"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosim, zalij te rastline:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snälla, vattna de här växterna:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen şu bitkileri sula:"
          }
        },
        "uk": {
