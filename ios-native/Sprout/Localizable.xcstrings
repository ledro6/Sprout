      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser om vanding laves af telefonen selv ud fra tider, den selv beregner. Ingen push-server er involveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieß-Erinnerungen erstellt das Telefon selbst, nach Terminen, die es selbst berechnet. Ein Push-Server ist nicht beteiligt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watering reminders are created by the phone itself, from schedules calculated on it. No push server is involved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de riego los crea el propio teléfono, con plazos calculados en él. No interviene ningún servidor push."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastelumuistutukset luo puhelin itse sen omien laskemien aikojen mukaan. Push-palvelinta ei käytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels d’arrosage sont créés par le téléphone lui-même, selon des délais calculés sur place. Aucun serveur push n’intervient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria di annaffiatura li crea il telefono stesso, con scadenze calcolate su di esso. Nessun server push è coinvolto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser om vanning lages av telefonen selv, etter tider den regner ut selv. Ingen push-server er involvert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waterherinneringen maakt de telefoon zelf, op basis van schema’s die hij zelf berekent. Er komt geen pushserver aan te pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de rega são criados pelo próprio celular, com prazos calculados nele. Nenhum servidor push participa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de rega são criados pelo próprio telemóvel, com prazos calculados nele. Nenhum servidor push participa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattningspåminnelser skapas av telefonen själv, efter tider som räknas ut på den. Ingen pushserver är inblandad."
          }
        }
      }
    },
