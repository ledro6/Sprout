    "«%1$@» и ещё %2$@ просят воды": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» و%2$@ أخرى تحتاج إلى الماء"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ и още %2$@ искат вода"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” এবং আরও %2$@-এর জল দরকার"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» i %2$@ més necessiten aigua"
          }
        },
        "cs": {
