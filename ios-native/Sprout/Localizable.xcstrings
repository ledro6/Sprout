            "state": "translated",
            "value": "Just right: the card is glowing orange."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo a tiempo: la tarjeta brilla en naranja."
          }
        },
        "fi": {
