    "Снимок мыльный — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة ضبابية — سأستخدم النموذج الجاهز للنوع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е размазана — ще взема готовия модел на вида."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি ঝাপসা — প্রজাতির তৈরি মডেল নেব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto està desenfocada: faré servir el model a punt de l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je rozmazaná — použiji hotový model druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er uskarpt – jeg bruger artens færdige model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist unscharf — ich nehme das fertige Modell der Art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι θολή — θα χρησιμοποιήσω το έτοιμο μοντέλο του είδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is blurry — I’ll use the species’ ready-made model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está borrosa: usaré el modelo listo de la especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on epätarkka – käytän lajin valmista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est floue — je prendrai le modèle prêt de l’espèce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ઝાંખો છે — પ્રજાતિનું તૈયાર મૉડલ લઈશ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה מטושטשת — אשתמש במודל המוכן של הזן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो धुंधली है — प्रजाति का तैयार मॉडल लूँगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je mutna — uzet ću gotov model vrste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó elmosódott — a faj kész modelljét használom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya buram — aku pakai model siap pakai spesies ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è sfocata: userò il modello pronto della specie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がぼやけています — この種類の既製モデルを使います。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет бұлыңғыр — түрдің дайын моделін аламын."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಮಸುಕಾಗಿದೆ — ಜಾತಿಯ ಸಿದ್ಧ ಮಾದರಿ ಬಳಸುತ್ತೇನೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 흐려요 — 이 종의 기본 모델을 사용할게요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka neryški – naudosiu paruoštą rūšies modelį."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ മങ്ങിയതാണ് — ഇനത്തിന്റെ തയ്യാറായ മോഡൽ എടുക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
