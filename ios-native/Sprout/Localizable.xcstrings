    "По запросу «%@» в квартире ничего не растёт.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في منزلك يطابق «%@»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По заявката „%@“ вкъщи нищо не расте."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাড়িতে “%@”-এর সঙ্গে মেলে এমন কিছু নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa no creix res que coincideixi amb «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U vás doma nic neodpovídá „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet hjemme hos dig passer til ”%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu „%@“ wächst bei dir nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο σπίτι δεν υπάρχει τίποτα για «%@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in your home matches “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No crece nada en casa que coincida con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotonasi ei kasva mitään haulla ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne pousse chez vous pour « %@ »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘરમાં “%@” સાથે મેળ ખાતું કંઈ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין בבית שום דבר שמתאים ל־“%@”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर में “%@” से मेल खाता कुछ नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod vas ništa ne odgovara upitu „%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Otthon semmi sem felel meg ennek: „%@”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang cocok dengan “%@” di rumah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna pianta in casa corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致する植物はありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» сұрауы бойынша үйде ештеңе өспейді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮನೆಯಲ್ಲಿ “%@” ಗೆ ಹೊಂದುವುದು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 해당하는 식물이 없어요."
          }
        },
        "lt": {
