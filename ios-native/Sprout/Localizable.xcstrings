    "Отмечает полив: влажность встаёт на сто процентов, а полив попадает в журнал.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل السقي: ترتفع الرطوبة إلى مئة بالمئة ويُضاف السقي إلى السجل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбелязва поливане: влажността става сто процента, а поливането влиза в дневника."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una regada: la humitat puja al cent per cent i la regada s’anota al registre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamená zalití: vlhkost stoupne na sto procent a zalití se zapíše do deníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanding: fugten stiger til hundrede procent, og vandingen kommer i loggen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermerkt das Gießen: Die Feuchtigkeit steigt auf hundert Prozent, und das Gießen landet im Protokoll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράφει ένα πότισμα: η υγρασία ανεβαίνει στο εκατό τοις εκατό και το πότισμα μπαίνει στο ημερολόγιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs a watering: moisture goes up to one hundred percent and the watering is added to the log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un riego: la humedad sube al cien por cien y el riego se anota en el registro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa kastelun: kosteus nousee sataan prosenttiin ja kastelu tallentuu päiväkirjaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un arrosage : l’humidité remonte à cent pour cent et l’arrosage entre dans le journal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רושם השקיה: הלחות עולה למאה אחוז וההשקיה נכנסת ליומן."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilježi zalijevanje: vlažnost raste na sto posto, a zalijevanje ulazi u dnevnik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzít egy öntözést: a nedvesség száz százalékra nő, az öntözés pedig bekerül a naplóba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un’annaffiatura: l’umidità sale al cento per cento e l’annaffiatura finisce nel registro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суаруды белгілейді: ылғал жүз пайызға жетеді, ал суару журналға түседі."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažymi laistymą: drėgmė pakyla iki šimto procentų, o laistymas įrašomas į žurnalą."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanning: fukten stiger til hundre prosent, og vanningen havner i loggen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert een waterbeurt: de vochtigheid gaat naar honderd procent en de beurt komt in het logboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje podlanie: wilgotność rośnie do stu procent, a podlanie trafia do dziennika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra uma rega: a umidade sobe para cem por cento e a rega entra no histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista uma rega: a humidade sobe para cem por cento e a rega entra no registo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o udare: umiditatea urcă la sută la sută, iar udarea intră în jurnal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamená poliatie: vlhkosť stúpne na sto percent a poliatie sa zapíše do denníka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabeleži zalivanje: vlažnost se dvigne na sto odstotkov, zalivanje pa se zapiše v dnevnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerar en vattning: fukten går upp till hundra procent och vattningen hamnar i loggen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sulamayı kaydeder: nem yüzde yüze çıkar ve sulama günlüğe eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначає полив: вологість стає сто відсотків, а полив потрапляє в журнал."
          }
        }
      }
    },
