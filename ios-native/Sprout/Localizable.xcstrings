    "Приложение напомнит, когда пора удобрять и пересаживать.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيذكّرك التطبيق حين يحين وقت التسميد وإعادة الزراعة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложението ще напомни, когато е време за торене и пресаждане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার দেওয়া আর টব বদলানোর সময় হলে অ্যাপ মনে করিয়ে দেবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app t’avisarà quan calgui adobar i trasplantar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace připomene, kdy je čas hnojit a přesazovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen minder dig om, når det er tid til at gøde og plante om."
          }
        },
        "de": {
          "stringUnit": {
