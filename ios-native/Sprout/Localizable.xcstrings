              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ہر %lld مہینے بعد"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tháng một lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每%lld个月一次"
