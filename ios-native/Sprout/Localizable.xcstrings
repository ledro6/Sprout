        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο αναζήτησης είναι κάτω, δίπλα στη γραμμή καρτελών. Ψάχνει σε παρατσούκλια, είδη και σημειώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
