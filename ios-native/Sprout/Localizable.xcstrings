    "В скопированном нет кода Sprout. Скопируйте сообщение друга целиком — код лежит в нём последней строкой.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد رمز Sprout فيما نسخته. انسخ رسالة صديقك كاملة — الرمز في السطر الأخير."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В копираното няма код на Sprout. Копирайте цялото съобщение на приятеля — кодът е на последния ред."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপি করা লেখায় Sprout কোড নেই। বন্ধুর পুরো বার্তা কপি করুন — কোডটি শেষ লাইনে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que has copiat no conté cap codi de Sprout. Copia el missatge sencer del teu amic: el codi és a l’última línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve zkopírovaném textu není kód Sproutu. Zkopírujte celou zprávu od přítele — kód je na posledním řádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kopierede indeholder ingen Sprout-kode. Kopiér din vens hele besked – koden står på sidste linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kopierten ist kein Sprout-Code. Kopiere die ganze Nachricht deines Freundes — der Code steht in der letzten Zeile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο κείμενο που αντιγράψατε δεν υπάρχει κωδικός Sprout. Αντιγράψτε ολόκληρο το μήνυμα του φίλου — ο κωδικός είναι στην τελευταία γραμμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s no Sprout code in what you copied. Copy your friend’s whole message — the code is its last line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copiaste no contiene un código de Sprout. Copia el mensaje entero de tu amigo: el código está en la última línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioimassasi tekstissä ei ole Sprout-koodia. Kopioi kaverisi koko viesti – koodi on viimeisellä rivillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez copié ne contient pas de code Sprout. Copiez tout le message de votre ami — le code est sur la dernière ligne."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૉપિ કરેલા લખાણમાં Sprout કોડ નથી. મિત્રનો આખો સંદેશ કૉપિ કરો — કોડ છેલ્લી લીટીમાં છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטקסט שהועתק אין קוד Sprout. יש להעתיק את כל ההודעה של החבר — הקוד בשורה האחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी किए गए टेक्स्ट में Sprout कोड नहीं है। दोस्त का पूरा संदेश कॉपी करें — कोड आखिरी पंक्ति में है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U kopiranom tekstu nema Sprout koda. Kopirajte cijelu prijateljevu poruku — kod je u zadnjem retku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimásolt szövegben nincs Sprout-kód. Másold ki a barátod teljes üzenetét — a kód az utolsó sorban van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kamu salin tidak berisi kode Sprout. Salin seluruh pesan temanmu — kodenya ada di baris terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel testo copiato non c’è un codice Sprout. Copia l’intero messaggio del tuo amico: il codice è nell’ultima riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした内容にSproutのコードがありません。友達のメッセージ全体をコピーしてください — コードは最後の行にあります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірілген мәтінде Sprout коды жоқ. Досыңыздың хабарын толық көшіріңіз — код соңғы жолда тұр."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಕಲಿಸಿದ ಪಠ್ಯದಲ್ಲಿ Sprout ಕೋಡ್ ಇಲ್ಲ. ಸ್ನೇಹಿತರ ಪೂರ್ತಿ ಸಂದೇಶವನ್ನು ನಕಲಿಸಿ — ಕೋಡ್ ಕೊನೆಯ ಸಾಲಿನಲ್ಲಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 내용에 Sprout 코드가 없어요. 친구의 메시지 전체를 복사하세요 — 코드는 마지막 줄에 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukopijuotame tekste nėra Sprout kodo. Nukopijuokite visą draugo žinutę – kodas yra paskutinėje eilutėje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകർത്തിയതിൽ Sprout കോഡില്ല. സുഹൃത്തിന്റെ സന്ദേശം മുഴുവൻ പകർത്തുക — കോഡ് അവസാന വരിയിലാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी केलेल्या मजकुरात Sprout कोड नाही. मित्राचा संपूर्ण संदेश कॉपी करा — कोड शेवटच्या ओळीत आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang disalin tiada kod Sprout. Salin keseluruhan mesej rakan anda — kodnya di baris terakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierte, inneholder ingen Sprout-kode. Kopier hele meldingen fra vennen din – koden står på siste linje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In wat je kopieerde staat geen Sprout-code. Kopieer het hele bericht van je vriend — de code staat op de laatste regel."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କପି କରାଯାଇଥିବା ଲେଖାରେ Sprout କୋଡ୍ ନାହିଁ। ବନ୍ଧୁଙ୍କ ସମ୍ପୂର୍ଣ୍ଣ ବାର୍ତ୍ତା କପି କରନ୍ତୁ — କୋଡ୍ ଶେଷ ଧାଡ଼ିରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਪੀ ਕੀਤੇ ਟੈਕਸਟ ਵਿੱਚ Sprout ਕੋਡ ਨਹੀਂ ਹੈ। ਦੋਸਤ ਦਾ ਪੂਰਾ ਸੁਨੇਹਾ ਕਾਪੀ ਕਰੋ — ਕੋਡ ਆਖਰੀ ਲਾਈਨ ਵਿੱਚ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W skopiowanym tekście nie ma kodu Sprout. Skopiuj całą wiadomość znajomego — kod jest w ostatnim wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem código do Sprout. Copie a mensagem inteira do seu amigo — o código fica na última linha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem um código do Sprout. Copie a mensagem inteira do seu amigo — o código está na última linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul copiat nu conține un cod Sprout. Copiază tot mesajul prietenului — codul e pe ultimul rând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V skopírovanom texte nie je kód Sproutu. Skopírujte celú správu od priateľa — kód je na poslednom riadku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V kopiranem ni kode Sprout. Kopirajte celotno sporočilo prijatelja — koda je v zadnji vrstici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierade innehåller ingen Sprout-kod. Kopiera vännens hela meddelande – koden står på sista raden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகலெடுத்ததில் Sprout குறியீடு இல்லை. நண்பரின் முழுச் செய்தியையும் நகலெடுக்கவும் — குறியீடு கடைசி வரியில் உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాపీ చేసిన దానిలో Sprout కోడ్ లేదు. స్నేహితుని పూర్తి సందేశాన్ని కాపీ చేయండి — కోడ్ చివరి పంక్తిలో ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่คัดลอกไม่มีรหัส Sprout คัดลอกข้อความของเพื่อนทั้งหมด — รหัสอยู่บรรทัดสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınızda Sprout kodu yok. Arkadaşınızın mesajının tamamını kopyalayın — kod son satırdadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У скопійованому немає коду Sprout. Скопіюйте повідомлення друга повністю — код лежить у ньому останнім рядком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپی کیے گئے متن میں Sprout کوڈ نہیں ہے۔ دوست کا پورا پیغام کاپی کریں — کوڈ آخری سطر میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đã sao chép không có mã Sprout. Hãy sao chép toàn bộ tin nhắn của bạn bè — mã nằm ở dòng cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝的内容中没有 Sprout 代码。请拷贝朋友的完整消息——代码在最后一行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝的內容中沒有 Sprout 代碼。請拷貝朋友的完整訊息——代碼在最後一行。"
          }
        }
      }
