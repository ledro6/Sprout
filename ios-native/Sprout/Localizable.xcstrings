        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألوان والكثافة والطول — من الصورة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветове, гъстота и височина – от снимката."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রং, ঘনত্ব ও উচ্চতা — ছবি থেকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors, densitat i alçada, a partir de la foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barvy, hustota a výška – z fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farver, tæthed og højde – fra fotoet."
          }
        },
        "de": {
