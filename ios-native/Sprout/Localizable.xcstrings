    "Как жил ваш сад в этом году. Нажмите справа — дальше, слева — назад.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا عاشت حديقتك هذا العام. انقر يمينًا للتالي، ويسارًا للرجوع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Как живя градината ви тази година. Докоснете вдясно — напред, вляво — назад."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ বছর আপনার বাগান এভাবেই কাটল। এগোতে ডানে, পেছোতে বাঁয়ে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ha viscut el teu jardí aquest any. Toca a la dreta per avançar i a l’esquerra per tornar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak vaše zahrada žila letos. Klepnutím vpravo dál, vlevo zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sådan levede din have i år. Tryk til højre for at gå videre, til venstre for at gå tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So hat dein Garten dieses Jahr gelebt. Tippe rechts für weiter, links für zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς έζησε ο κήπος σας φέτος. Πατήστε δεξιά για συνέχεια, αριστερά για πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How your garden lived this year. Tap on the right to go on, on the left to go back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así vivió tu jardín este año. Toca a la derecha para avanzar y a la izquierda para volver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näin puutarhasi eli tänä vuonna. Napauta oikealta eteenpäin, vasemmalta taaksepäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment votre jardin a vécu cette année. Touchez à droite pour avancer, à gauche pour revenir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વર્ષે તમારો બગીચો આમ જીવ્યો. આગળ માટે જમણે, પાછળ માટે ડાબે ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך חיה הגינה השנה. הקשה מימין — הלאה, משמאל — אחורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साल आपका बगीचा ऐसे जिया। आगे के लिए दाएँ, पीछे के लिए बाएँ टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovako je vaš vrt živio ove godine. Dodirnite desno za dalje, lijevo za natrag."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így élt idén a kerted. Koppints jobbra a továbblépéshez, balra a visszalépéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begini kebun Anda menjalani tahun ini. Ketuk kanan untuk lanjut, kiri untuk kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Com’è andato l’anno del tuo giardino. Tocca a destra per avanzare, a sinistra per tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今年のあなたの庭の歩み。右をタップで次へ、左で戻ります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақтың осы жылы қалай өткені. Оң жаққа түртсеңіз — алға, сол жаққа — артқа."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವರ್ಷ ನಿಮ್ಮ ತೋಟ ಹೀಗೆ ಬದುಕಿತು. ಮುಂದೆ ಹೋಗಲು ಬಲಕ್ಕೆ, ಹಿಂದೆ ಹೋಗಲು ಎಡಕ್ಕೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 정원이 지낸 이야기예요. 오른쪽을 탭하면 다음, 왼쪽은 이전이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip jūsų sodas gyveno šiemet. Palieskite dešinėje — toliau, kairėje — atgal."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വർഷം നിങ്ങളുടെ തോട്ടം ഇങ്ങനെയായിരുന്നു. മുന്നോട്ട് പോകാൻ വലത്തും പിന്നോട്ട് പോകാൻ ഇടത്തും ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वर्षी तुमची बाग अशी जगली. पुढे जाण्यासाठी उजवीकडे, मागे जाण्यासाठी डावीकडे टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginilah taman anda melalui tahun ini. Ketik kanan untuk seterusnya, kiri untuk kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik levde hagen din i år. Trykk til høyre for å gå videre, til venstre for å gå tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo leefde je tuin dit jaar. Tik rechts voor verder, links voor terug."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏ ବର୍ଷ ଆପଣଙ୍କ ବଗିଚା ଏମିତି ବିତିଲା। ଆଗକୁ ଯିବାକୁ ଡାହାଣ, ପଛକୁ ଯିବାକୁ ବାମ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਸਾਲ ਤੁਹਾਡਾ ਬਗੀਚਾ ਇੰਝ ਜੀਵਿਆ। ਅੱਗੇ ਲਈ ਸੱਜੇ, ਪਿੱਛੇ ਲਈ ਖੱਬੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak żył twój ogród w tym roku. Stuknij z prawej, by iść dalej, z lewej — by wrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como seu jardim viveu este ano. Toque à direita para avançar e à esquerda para voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o seu jardim viveu este ano. Toque à direita para avançar e à esquerda para voltar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum a trăit grădina ta anul acesta. Atinge în dreapta pentru înainte, în stânga pentru înapoi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Takto žila vaša záhrada tento rok. Ťuknite vpravo pre ďalej, vľavo pre späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tako je vaš vrt živel letos. Tapnite desno za naprej, levo za nazaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så levde din trädgård i år. Tryck till höger för att gå vidare, till vänster för att backa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆண்டு உங்கள் தோட்டம் இப்படி வாழ்ந்தது. அடுத்ததற்கு வலப்பக்கம், முந்தையதற்கு இடப்பக்கம் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఏడాది మీ తోట ఇలా గడిచింది. ముందుకు కుడివైపు, వెనక్కి ఎడమవైపు ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือหนึ่งปีของสวนคุณ แตะด้านขวาเพื่อไปต่อ ด้านซ้ายเพื่อย้อนกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz bu yıl böyle yaşadı. İleri için sağa, geri için sola dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як жив ваш сад цього року. Торкніться праворуч — далі, ліворуч — назад."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سال آپ کا باغ ایسے جیا۔ آگے کے لیے دائیں، پیچھے کے لیے بائیں ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một năm của khu vườn bạn. Chạm bên phải để tiếp, bên trái để quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的花园这一年是这样度过的。轻点右侧前进，左侧返回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的花園這一年是這樣度過的。點右側前進，左側返回。"
          }
        }
      }
    },
