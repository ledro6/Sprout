    "После полива по узору бежит цветная волна — так видно, что полив засчитан.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد السقي تمرّ موجة ملوّنة عبر النقش، وهكذا تعرف أن السقي احتُسب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След поливане по шарката минава цветна вълна – така се вижда, че поливането е отчетено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জল দেওয়ার পর নকশার ওপর দিয়ে রঙিন ঢেউ বয়ে যায় — এতে বোঝা যায় জল দেওয়া গণনা হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de regar, una onada de color recorre el motiu: així saps que el reg s’ha comptat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zalití přeběhne vzorem barevná vlna – tak poznáte, že se zálivka započítala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter vanding løber en farvet bølge hen over mønsteret – så kan du se, at vandingen er talt med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Gießen läuft eine farbige Welle über das Muster – so siehst du, dass das Gießen gezählt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά το πότισμα ένα χρωματιστό κύμα διατρέχει το μοτίβο — έτσι φαίνεται ότι το πότισμα μετρήθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After watering, a colored wave runs across the pattern — that’s how you know the watering counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de regar, una ola de color recorre el patrón: así sabes que el riego se ha contado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastelun jälkeen kuvion yli kulkee värikäs aalto – siitä näet, että kastelu kirjattiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’arrosage, une vague colorée parcourt le motif — c’est le signe que l’arrosage est compté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાણી આપ્યા પછી ભાત પર રંગીન લહેર દોડે છે — એનાથી ખબર પડે છે કે પાણી આપવું ગણાઈ ગયું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי השקיה עובר על הדוגמה גל צבעוני – כך יודעים שההשקיה נספרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी देने के बाद पैटर्न पर रंगीन लहर दौड़ती है — इससे पता चलता है कि पानी देना गिना गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon zalijevanja preko uzorka prođe obojeni val – tako znate da je zalijevanje zabilježeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öntözés után színes hullám fut végig a mintán – így látod, hogy az öntözés beszámított."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah menyiram, gelombang berwarna melintasi pola — tanda penyiraman sudah tercatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l’annaffiatura un’onda colorata attraversa il motivo: così sai che l’annaffiatura è stata registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりのあと、模様に色の波が広がります。水やりが記録されたしるしです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суарғаннан кейін өрнек бойымен түрлі-түсті толқын жүреді — суару есептелгенін осылай көресіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀರು ಹಾಕಿದ ನಂತರ ವಿನ್ಯಾಸದ ಮೇಲೆ ಬಣ್ಣದ ಅಲೆ ಓಡುತ್ತದೆ — ನೀರು ಹಾಕಿದ್ದು ಲೆಕ್ಕಕ್ಕೆ ಬಂತು ಎಂದು ಹೀಗೆ ತಿಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 주고 나면 무늬 위로 색 물결이 퍼져요. 물주기가 기록됐다는 뜻이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Po laistymo raštu nubėga spalvota banga – taip matyti, kad laistymas įskaitytas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നനച്ച ശേഷം ചിത്രപ്പണിയിലൂടെ ഒരു നിറമുള്ള തിര ഓടും — നനച്ചത് കണക്കിൽ പെട്ടെന്ന് അങ്ങനെ അറിയാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाणी दिल्यावर नक्षीवरून रंगीत लाट धावते — त्यावरून कळते की पाणी देणे मोजले गेले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas menyiram, gelombang berwarna melintasi corak — tanda siraman sudah dikira."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter vanning går en farget bølge over mønsteret – slik ser du at vanningen er registrert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het water geven loopt er een gekleurde golf over het patroon – zo zie je dat het water geven is geteld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାଣି ଦେବା ପରେ ନକ୍ସା ଉପରେ ରଙ୍ଗୀନ ଢେଉ ଦୌଡ଼େ — ଏଥିରୁ ଜଣାପଡ଼େ ପାଣି ଦେବା ଗଣାଗଲା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਣੀ ਦੇਣ ਤੋਂ ਬਾਅਦ ਨਮੂਨੇ ’ਤੇ ਰੰਗੀਨ ਲਹਿਰ ਦੌੜਦੀ ਹੈ — ਇਸ ਤੋਂ ਪਤਾ ਲੱਗਦਾ ਹੈ ਕਿ ਪਾਣੀ ਦੇਣਾ ਗਿਣਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po podlaniu przez wzór przebiega kolorowa fala – tak widać, że podlanie zostało zaliczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da rega, uma onda colorida percorre o padrão — assim você sabe que a rega foi contada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da rega, uma onda colorida percorre o padrão — assim sabe que a rega foi contada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După udare, un val colorat trece peste model — așa știi că udarea a fost numărată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po poliatí prebehne vzorom farebná vlna – tak viete, že sa polievanie započítalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zalivanju čez vzorec steče barvni val – tako vidite, da je zalivanje zabeleženo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter vattning sveper en färgad våg över mönstret – så ser du att vattningen räknats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீர் ஊற்றிய பிறகு வடிவத்தின் மேல் ஒரு வண்ண அலை ஓடும் — நீர் ஊற்றியது கணக்கில் சேர்ந்தது என்று இப்படித் தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీళ్లు పోసిన తర్వాత నమూనాపై రంగుల అల పరుగెడుతుంది — నీళ్లు పోసింది లెక్కలోకి వచ్చిందని అలా తెలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังรดน้ำ จะมีคลื่นสีวิ่งผ่านลวดลาย เป็นสัญญาณว่าบันทึกการรดน้ำแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulamadan sonra desenin üzerinden renkli bir dalga geçer; sulamanın sayıldığını böyle anlarsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після поливу візерунком біжить кольорова хвиля — так видно, що полив зараховано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پانی دینے کے بعد نقش پر رنگین لہر دوڑتی ہے — یوں پتا چلتا ہے کہ پانی دینا شمار ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi tưới, một làn sóng màu chạy qua hoa văn — dấu hiệu lần tưới đã được ghi nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浇水后，一道彩色波浪划过图案——说明这次浇水已记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "澆水後，一道彩色波浪劃過圖案——表示這次澆水已記錄。"
          }
        }
      }
    },
