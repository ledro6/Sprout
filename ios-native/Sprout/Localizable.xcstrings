    "Лежит в приложении — AR открывается сразу.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدمج في التطبيق — يفتح الواقع المعزز فورًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вграден в приложението – AR се отваря веднага."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপেই আছে — AR সঙ্গে সঙ্গে খোলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja és a l’app: la RA s’obre de seguida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je v aplikaci – AR se otevře hned."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligger i appen – AR åbner med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App enthalten – AR öffnet sofort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει στην εφαρμογή — το AR ανοίγει αμέσως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built into the app — AR opens right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluido en la app: la RA se abre al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmiina sovelluksessa – AR aukeaa heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclus dans l’app — la RA s’ouvre tout de suite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપમાં જ છે — AR તરત ખૂલે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מובנה באפליקציה — ה־AR נפתח מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में ही है — AR तुरंत खुलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već je u aplikaciji – AR se otvara odmah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appban van – az AR azonnal megnyílik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah ada di aplikasi — AR langsung terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già nell’app: l’AR si apre subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに内蔵 — ARはすぐに開きます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбада бар — AR бірден ашылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ನಲ್ಲೇ ಇದೆ — AR ತಕ್ಷಣ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 들어 있어서 AR이 바로 열려요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jau yra programoje – AR atsidaro iškart."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിൽ തന്നെയുണ്ട് — AR ഉടൻ തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅपमध्येच आहे — AR लगेच उघडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
