    "Приложение не выходит в интернет. У него нет ни учётной записи, ни сервера, ни аналитики, ни рекламы.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتصل التطبيق بالإنترنت. لا حساب ولا خادم ولا تحليلات ولا إعلانات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложението не излиза в интернет. Няма профил, сървър, анализи и реклами."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি ইন্টারনেটে যায় না। এর কোনো অ্যাকাউন্ট, সার্ভার, অ্যানালিটিক্স বা বিজ্ঞাপন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app no es connecta a internet. No té compte, ni servidor, ni analítiques, ni publicitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace nechodí na internet. Nemá účet, server, analytiku ani reklamy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldrig på internettet. Den har ingen konto, ingen server, ingen analyse og ingen reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App geht nicht ins Internet. Sie hat weder ein Konto noch einen Server, keine Analyse und keine Werbung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή δεν συνδέεται στο διαδίκτυο. Δεν έχει λογαριασμό, διακομιστή, αναλυτικά στοιχεία ή διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app never goes online. It has no account, no server, no analytics and no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se conecta a internet. No tiene cuenta, ni servidor, ni analíticas, ni publicidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appi ei käytä internetiä. Sillä ei ole tiliä, palvelinta, analytiikkaa eikä mainoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne se connecte jamais à Internet. Elle n’a ni compte, ni serveur, ni statistiques, ni publicité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ ઇન્ટરનેટ સાથે જોડાતી નથી. તેમાં ખાતું, સર્વર, ઍનાલિટિક્સ કે જાહેરાતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה לא מתחברת לאינטרנט. אין לה חשבון, שרת, ניתוח נתונים או פרסומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप इंटरनेट से नहीं जुड़ता। इसमें न खाता है, न सर्वर, न एनालिटिक्स, न विज्ञापन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija ne izlazi na internet. Nema račun, poslužitelj, analitiku ni oglase."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás nem csatlakozik az internetre. Nincs fiókja, szervere, analitikája és hirdetése."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak terhubung ke internet. Tidak ada akun, server, analitik, maupun iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non va su internet. Non ha account, server, analisi né pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはインターネットに接続しません。アカウントも、サーバも、解析も、広告もありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба интернетке шықпайды. Онда аккаунт та, сервер де, аналитика да, жарнама да жоқ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸುವುದಿಲ್ಲ. ಖಾತೆ, ಸರ್ವರ್, ವಿಶ್ಲೇಷಣೆ, ಜಾಹೀರಾತು ಯಾವುದೂ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 인터넷에 연결하지 않아요. 계정도, 서버도, 분석도, 광고도 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa nesijungia prie interneto. Ji neturi paskyros, serverio, analitikos ar reklamos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ഇന്റർനെറ്റിൽ കണക്റ്റ് ചെയ്യുന്നില്ല. അക്കൗണ്ടോ സെർവറോ അനലിറ്റിക്സോ പരസ്യങ്ങളോ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप इंटरनेटला जोडत नाही. त्यात खाते, सर्व्हर, विश्लेषण किंवा जाहिराती नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl tidak menyambung ke internet. Tiada akaun, pelayan, analitik atau iklan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldri på internett. Den har ingen konto, ingen server, ingen analyse og ingen reklame."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app gaat niet online. Hij heeft geen account, geen server, geen analyse en geen reclame."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ଇଣ୍ଟରନେଟ୍‌ରେ ଯାଏ ନାହିଁ। ଏହାର ଆକାଉଣ୍ଟ, ସର୍ଭର୍, ଆନାଲିଟିକ୍ସ କିମ୍ବା ବିଜ୍ଞାପନ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਇੰਟਰਨੈੱਟ ਨਾਲ ਨਹੀਂ ਜੁੜਦੀ। ਇਸ ਵਿੱਚ ਨਾ ਖਾਤਾ, ਨਾ ਸਰਵਰ, ਨਾ ਵਿਸ਼ਲੇਸ਼ਣ, ਨਾ ਇਸ਼ਤਿਹਾਰ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie łączy się z internetem. Nie ma konta, serwera, analityki ani reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não acessa a internet. Não tem conta, servidor, análises nem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app não acede à internet. Não tem conta, servidor, estatísticas nem publicidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația nu accesează internetul. Nu are cont, server, analize sau reclame."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apka nechodí na internet. Nemá účet, server, analytiku ani reklamy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija ne dostopa do interneta. Nima računa, strežnika, analitike ne oglasov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldrig ut på internet. Den har inget konto, ingen server, ingen analys och ingen reklam."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலி இணையத்துடன் இணைவதில்லை. கணக்கு, சர்வர், பகுப்பாய்வு, விளம்பரம் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ ఇంటర్నెట్‌కు కనెక్ట్ అవ్వదు. ఖాతా, సర్వర్, విశ్లేషణలు, ప్రకటనలు ఏవీ లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปไม่ใช้อินเทอร์เน็ต ไม่มีบัญชี เซิร์ฟเวอร์ การวิเคราะห์ หรือโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama internete çıkmaz. Hesabı, sunucusu, analitiği ve reklamı yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не виходить в інтернет. У нього немає ні облікового запису, ні сервера, ні аналітики, ні реклами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ انٹرنیٹ سے نہیں جڑتی۔ اس کا نہ اکاؤنٹ ہے، نہ سرور، نہ تجزیات، نہ اشتہارات۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không kết nối internet. Không có tài khoản, máy chủ, phân tích hay quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不会联网。它没有账户、服务器、分析，也没有广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不會連上網路。它沒有帳號、伺服器、分析，也沒有廣告。"
          }
        }
      }
    },
