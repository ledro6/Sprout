    "«%1$@» и ещё %2$@ просят воды": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» و%2$@ أخرى تحتاج إلى الماء"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ и още %2$@ искат вода"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” এবং আরও %2$@-এর জল দরকার"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» i %2$@ més necessiten aigua"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ a ještě %2$@ potřebují vodu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” og %2$@ mere trænger til vand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und noch %2$@ brauchen Wasser"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» και άλλα %2$@ θέλουν νερό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” plus %2$@ need water"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” y %2$@ más necesitan agua"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” ja lisäksi %2$@ tarvitsevat vettä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et encore %2$@ ont besoin d’eau"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” અને બીજા %2$@ને પાણી જોઈએ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ועוד %2$@ צריכים מים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” और बाकी %2$@ को पानी चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” i još %2$@ trebaju vode"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” és még %2$@ vizet kér"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” dan %2$@ lagi butuh air"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e altre %2$@ hanno bisogno d’acqua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」ほか%2$@が水を欲しがっています"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» және тағы %2$@ су сұрайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ 외 %2$@에 물이 필요해요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ir dar %2$@ reikia vandens"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” आणि आणखी %2$@ ना पाणी हवे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” dan %2$@ lagi perlukan air"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» og %2$@ til trenger vann"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ en nog %2$@ hebben water nodig"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ଏବଂ ଆଉ %2$@ କୁ ପାଣି ଦରକାର"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ਅਤੇ ਹੋਰ %2$@ ਨੂੰ ਪਾਣੀ ਚਾਹੀਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” i jeszcze %2$@ potrzebują wody"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e mais %2$@ precisam de água"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e mais %2$@ precisam de água"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” și încă %2$@ au nevoie de apă"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ a ešte %2$@ potrebujú vodu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« in še %2$@ potrebujejo vodo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” och %2$@ till behöver vatten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” และอีก %2$@ ต้องการน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ve %2$@ daha su istiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» і ще %2$@ просять води"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” và %2$@ nữa cần nước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”和另外%2$@需要浇水"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」和另外%2$@需要澆水"
          }
