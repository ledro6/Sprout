    "Телефон узнал: %1$@ — уверен на %2$lld%%. Поправьте, если не так.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التعرف: %1$@ — بثقة %2$lld٪. صحّح إن لم يكن صحيحًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознато: %1$@ — сигурност %2$lld%%. Поправете, ако не е така."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconeguda: %1$@, amb un %2$lld %% de seguretat. Corregeix-ho si no és així."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznáno: %1$@ — jistota %2$lld %%. Pokud to nesedí, opravte to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkendt: %1$@ – %2$lld %% sikker. Ret det, hvis det er forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannt: %1$@ — zu %2$lld %% sicher. Korrigiere es, falls es nicht stimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναγνωρίστηκε: %1$@ — βεβαιότητα %2$lld%%. Διορθώστε αν δεν είναι σωστό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized: %1$@ — %2$lld%% sure. Correct it if that’s wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocida: %1$@, con un %2$lld %% de seguridad. Corrígelo si no es así."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistettu: %1$@ – %2$lld %% varma. Korjaa, jos se on väärin."
          }
        },
        "fr": {
          "stringUnit": {
