          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешен запис се изтрива с продължително натискане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল এন্ট্রি দীর্ঘক্ষণ চেপে মুছুন।"
          }
        },
        "ca": {
          "stringUnit": {
