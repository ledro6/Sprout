    "Сколько растений просят воды и кто первый.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم نبتة تحتاج إلى الماء ومن الأولى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко растения искат вода и кое е първо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কতগুলো গাছের জল দরকার এবং প্রথমে কে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantes plantes necessiten aigua i quina va primer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik rostlin potřebuje vodu a která je první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter der trænger til vand, og hvem der er først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Pflanzen Wasser brauchen und wer zuerst dran ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσα φυτά θέλουν νερό και ποιο είναι πρώτο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many plants need water and who’s first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas plantas necesitan agua y cuál va primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Montako kasvia tarvitsee vettä ja kuka ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de plantes ont besoin d’eau et laquelle en premier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેટલા છોડને પાણી જોઈએ અને પહેલું કોણ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה צמחים צריכים מים ומי ראשון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कितने पौधों को पानी चाहिए और सबसे पहले कौन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko biljaka treba vode i koja je prva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány növénynek kell víz, és ki az első."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tanaman yang butuh air dan mana yang pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante piante hanno bisogno d’acqua e chi per prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を待つ植物の数と、いちばん先の植物。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қанша өсімдік су сұрайды және кім бірінші."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಷ್ಟು ಗಿಡಗಳಿಗೆ ನೀರು ಬೇಕು ಮತ್ತು ಮೊದಲು ಯಾರು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물이 필요한 식물 수와 가장 먼저 줄 식물."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek augalų reikia vandens ir kuris pirmas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എത്ര ചെടികൾക്ക് വെള്ളം വേണം, ആദ്യം ആര്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किती रोपांना पाणी हवे आणि पहिले कोण."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tumbuhan perlukan air dan siapa yang pertama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter som trenger vann, og hvem som er først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel planten water nodig hebben en wie eerst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେତେ ଗଛକୁ ପାଣି ଦରକାର ଏବଂ ପ୍ରଥମେ କିଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿੰਨੇ ਪੌਦਿਆਂ ਨੂੰ ਪਾਣੀ ਚਾਹੀਦਾ ਹੈ ਅਤੇ ਪਹਿਲਾ ਕੌਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile roślin potrzebuje wody i która pierwsza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas plantas precisam de água e qual é a primeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas plantas precisam de água e qual é a primeira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte plante au nevoie de apă și care e prima."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko rastlín potrebuje vodu a ktorá je prvá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko rastlin potrebuje vodo in katera je prva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur många växter som behöver vatten och vem som är först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எத்தனை செடிகளுக்குத் தண்ணீர் தேவை, முதலில் யார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎన్ని మొక్కలకు నీళ్లు కావాలి, మొదట ఎవరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีต้นไม้กี่ต้นที่ต้องการน้ำและต้นไหนก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaç bitkinin suya ihtiyacı var ve ilk sırada kim var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки рослин просять води і хто перший."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کتنے پودوں کو پانی چاہیے اور پہلے کون۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao nhiêu cây cần nước và cây nào trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有多少植物需要浇水，谁排第一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有多少植物需要澆水，誰排第一。"
          }
        }
      }
    },
