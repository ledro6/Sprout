    "Десять поливов подряд вовремя — когда в земле 20–40% воды.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشر سقيات متتالية في وقتها — حين يبقى في التربة 20–40٪ ماء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Десет поливания поред навреме — когато в почвата има 20–40% вода."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টানা দশবার সময়মতো জল — যখন মাটিতে ২০–৪০% জল থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deu regs seguits a temps, amb 20–40 % d’aigua a la terra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deset zálivek v řadě včas — když je v zemi 20–40 % vody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti vandinger i træk til tiden – med 20–40 % vand tilbage i jorden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehnmal in Folge rechtzeitig gegossen – bei 20–40 % Wasser in der Erde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δέκα ποτίσματα στη σειρά στην ώρα τους — με 20–40% νερό στο χώμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten waterings in a row on time — with 20–40% water left in the soil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez riegos seguidos a tiempo, con 20–40 % de agua en la tierra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kymmenen kastelua putkeen ajallaan – kun mullassa on 20–40 % vettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix arrosages d’affilée à temps — avec 20–40 % d’eau dans la terre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સળંગ દસ વાર સમયસર પાણી — જ્યારે માટીમાં 20–40% પાણી હોય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עשר השקיות ברצף בזמן — כשבאדמה נשארו 20–40% מים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगातार दस बार समय पर पानी — जब मिट्टी में 20–40% पानी बचा हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deset zalijevanja zaredom na vrijeme — kad je u zemlji 20 – 40 % vode."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tíz öntözés egymás után időben – amikor 20–40% víz van a földben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh kali berturut-turut menyiram tepat waktu — saat tanah berisi 20–40% air."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieci annaffiature di fila al momento giusto, con 20–40% d’acqua nel terriccio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10回連続でちょうどよいタイミングに水やり（土の水分20〜40%）。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қатарынан он рет уақытында суару — топырақта 20–40% су қалғанда."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸತತ ಹತ್ತು ಬಾರಿ ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ನೀರು — ಮಣ್ಣಿನಲ್ಲಿ 20–40% ನೀರು ಇದ್ದಾಗ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10번 연속 제때 물주기 — 흙에 수분이 20–40% 남았을 때."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dešimt laistymų iš eilės laiku — kai žemėje yra 20–40 % vandens."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടർച്ചയായി പത്ത് തവണ സമയത്ത് നനയ്ക്കൽ — മണ്ണിൽ 20–40% വെള്ളം ഉള്ളപ്പോൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सलग दहा वेळा वेळेवर पाणी — मातीत 20–40% पाणी असताना."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh siraman berturut-turut tepat pada masanya — ketika tanah berisi 20–40% air."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti vanninger på rad i tide – med 20–40 % vann igjen i jorda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tien keer achter elkaar op tijd water gegeven — bij 20–40% water in de grond."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲଗାତାର ଦଶ ଥର ଠିକ୍ ସମୟରେ ପାଣି — ମାଟିରେ 20–40% ପାଣି ଥିବାବେଳେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਗਾਤਾਰ ਦਸ ਵਾਰ ਸਮੇਂ ਸਿਰ ਪਾਣੀ — ਜਦੋਂ ਮਿੱਟੀ ਵਿੱਚ 20–40% ਪਾਣੀ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziesięć podlań z rzędu na czas — gdy w ziemi jest 20–40% wody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez regas seguidas na hora certa — com 20–40% de água na terra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez regas seguidas a tempo — com 20–40% de água na terra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zece udări la rând la timp — cu 20–40 % apă în pământ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Desať polievaní za sebou včas — keď je v zemi 20 – 40 % vody."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deset zalivanj zapored ob pravem času — ko je v zemlji 20–40 % vode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tio vattningar i rad i tid – med 20–40 % vatten kvar i jorden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ந்து பத்து முறை சரியான நேரத்தில் நீர் — மண்ணில் 20–40% நீர் இருக்கும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వరుసగా పది సార్లు సమయానికి నీళ్లు — మట్టిలో 20–40% నీరు ఉన్నప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รดน้ำตรงเวลาสิบครั้งติดต่อกัน — ตอนที่ดินเหลือน้ำ 20–40%"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka arkaya on kez zamanında sulama — toprakta %20–40 su varken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Десять поливів поспіль вчасно — коли в землі 20–40% води."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسلسل دس بار وقت پر پانی — جب مٹی میں 20–40% پانی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mười lần tưới đúng lúc liên tiếp — khi đất còn 20–40% nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续十次按时浇水——土里还剩 20–40% 的水时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續十次準時澆水——土裡還剩 20–40% 的水時。"
          }
        }
      }
    },
