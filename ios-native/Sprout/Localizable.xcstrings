        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout’u açın, bahçeniz burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Sprout — і сад з’явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Sprout và khu vườn sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Sprout，你的花园就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Sprout，你的花園就會顯示在這裡。"
          }
