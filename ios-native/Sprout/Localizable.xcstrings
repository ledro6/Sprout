    "Имя правится прямо в строке, порядок — за ручку справа, удалить — смахнуть влево.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعدَّل الاسم في السطر نفسه، والترتيب بالمقبض على اليمين، والحذف بالسحب إلى اليسار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името се редактира направо в реда, подредбата – с дръжката вдясно, изтриването – с плъзгане наляво."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম সারিতেই বদলান, ক্রম ডান দিকের হ্যান্ডেলে, মুছতে বাঁদিকে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom s’edita a la mateixa fila; l’ordre, amb la nansa de la dreta; per esborrar, llisca cap a l’esquerra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jméno se upravuje přímo v řádku, pořadí úchytem vpravo, smazání přejetím doleva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres direkte i rækken, rækkefølgen med håndtaget til højre, slet ved at stryge til venstre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Namen änderst du direkt in der Zeile, die Reihenfolge am Griff rechts, löschen durch Wischen nach links."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα αλλάζει μέσα στη γραμμή, η σειρά με τη λαβή δεξιά, η διαγραφή με σάρωση αριστερά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit a name right in its row, drag the handle on the right to reorder, swipe left to delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se edita en la propia fila; el orden, con el asa de la derecha; para borrar, desliza a la izquierda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeä muokataan suoraan rivillä, järjestystä oikean reunan kahvasta; poista pyyhkäisemällä vasemmalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom se modifie directement dans la ligne, l’ordre avec la poignée à droite ; balayez vers la gauche pour supprimer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નામ પંક્તિમાં જ બદલો, ક્રમ જમણા હૅન્ડલથી, કાઢવા માટે ડાબે સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "את השם עורכים ישר בשורה, את הסדר – בידית מימין, ומוחקים בהחלקה שמאלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम पंक्ति में ही बदलें, क्रम दाएँ हैंडल से, हटाने के लिए बाएँ स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime se uređuje izravno u retku, redoslijed hvataljkom desno, a brisanje povlačenjem ulijevo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nevet közvetlenül a sorban szerkesztheted, a sorrendet a jobb oldali fogantyúval, törlés balra húzással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama diubah langsung di barisnya, urutan dengan gagang di kanan, hapus dengan menggesek ke kiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome si modifica direttamente nella riga, l’ordine con la maniglia a destra; per eliminare, scorri a sinistra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は行の中でそのまま編集、並べ替えは右のハンドル、削除は左にスワイプ。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы жолдың өзінде өңделеді, реті — оң жақтағы тұтқамен, жою — солға сырғыту."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೆಸರನ್ನು ಸಾಲಿನಲ್ಲೇ ಬದಲಿಸಿ, ಕ್ರಮವನ್ನು ಬಲಬದಿಯ ಹ್ಯಾಂಡಲ್‌ನಿಂದ, ಅಳಿಸಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 행에서 바로 편집, 순서는 오른쪽 핸들로, 삭제는 왼쪽으로 쓸어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pavadinimas redaguojamas tiesiog eilutėje, tvarka – rankenėle dešinėje, trinama perbraukus į kairę."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേര് വരിയിൽത്തന്നെ മാറ്റുക, ക്രമം വലതുവശത്തെ ഹാൻഡിൽ കൊണ്ട്, നീക്കാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नाव ओळीतच बदला, क्रम उजव्या हँडलने, हटवण्यासाठी डावीकडे स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama disunting terus dalam barisnya, susunan dengan pemegang di kanan, padam dengan meleret ke kiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet endres rett i raden, rekkefølgen med håndtaket til høyre, sletting ved å sveipe mot venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig een naam direct in de rij, versleep de greep rechts om te ordenen, veeg naar links om te verwijderen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନାମ ଧାଡ଼ିରେ ହିଁ ବଦଳାନ୍ତୁ, କ୍ରମ ଡାହାଣ ହ୍ୟାଣ୍ଡଲ୍‌ରେ, ଡିଲିଟ୍ ପାଇଁ ବାମକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਾਂ ਕਤਾਰ ਵਿੱਚ ਹੀ ਬਦਲੋ, ਤਰਤੀਬ ਸੱਜੇ ਹੈਂਡਲ ਨਾਲ, ਹਟਾਉਣ ਲਈ ਖੱਬੇ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwę edytuje się w samym wierszu, kolejność – uchwytem po prawej, usuwa się przesunięciem w lewo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome se edita na própria linha, a ordem pela alça à direita; para apagar, deslize para a esquerda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome edita-se na própria linha, a ordem pela pega à direita; para apagar, deslize para a esquerda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele se editează direct în rând, ordinea – cu mânerul din dreapta, ștergerea – glisând spre stânga."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno sa upravuje priamo v riadku, poradie úchytom vpravo, mazanie potiahnutím doľava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime urejate kar v vrstici, vrstni red z ročico na desni, brišete pa s potegom v levo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet ändras direkt i raden, ordningen med handtaget till höger, radera genom att svepa åt vänster."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெயரை வரிசையிலேயே மாற்றுங்கள், வரிசையை வலது கைப்பிடியால், நீக்க இடதுபுறம் ஸ்வைப் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేరు వరుసలోనే మార్చండి, క్రమం కుడివైపు హ్యాండిల్‌తో, తొలగించడానికి ఎడమకు స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ชื่อได้ในแถวเลย เรียงลำดับด้วยที่จับทางขวา ปัดไปทางซ้ายเพื่อลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad doğrudan satırda düzenlenir, sıra sağdaki tutamakla değişir, silmek için sola kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім’я редагується просто в рядку, порядок — за ручку праворуч, видалити — змахнути ліворуч."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نام قطار ہی میں بدلا جاتا ہے، ترتیب دائیں ہینڈل سے، اور حذف بائیں سوائپ سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên được sửa ngay trên dòng, thứ tự bằng tay kéo bên phải, xóa bằng cách vuốt sang trái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在行内直接修改名称，拖动右侧把手调整顺序，向左轻扫即可删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列中直接修改名稱，拖移右側把手調整順序，向左滑動即可刪除。"
          }
        }
      }
    },
    "Имя правится прямо в строке. Потяните за ручку справа, чтобы поменять порядок, — в том же порядке комнаты листаются на главной.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعدَّل الاسم مباشرة في السطر. اسحب المقبض لتغيير الترتيب — بالترتيب نفسه تتنقّل بين الغرف في الصفحة الرئيسية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името се редактира направо в реда. Дръпнете дръжката вдясно, за да смените реда — в същия ред се плъзгат стаите на началния екран."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম সরাসরি সারিতেই বদলানো যায়। ক্রম বদলাতে ডানদিকের হাতল টানুন — হোমে ঘরগুলো এই ক্রমেই সোয়াইপ করে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom s’edita a la mateixa fila. Arrossega la nansa de la dreta per canviar l’ordre: en aquest mateix ordre passen les habitacions a l’inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název se upravuje přímo v řádku. Tažením úchytu vpravo změníte pořadí — ve stejném pořadí se místnosti listují na domovské obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres direkte i rækken. Træk i håndtaget til højre for at ændre rækkefølgen – i samme rækkefølge stryger du gennem rummene på startskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird direkt in der Zeile bearbeitet. Zieh am Griff rechts, um die Reihenfolge zu ändern — in derselben Reihenfolge wischst du auf der Startseite durch die Räume."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα αλλάζει απευθείας στη γραμμή. Σύρετε τη λαβή δεξιά για να αλλάξετε τη σειρά — με την ίδια σειρά περνούν τα δωμάτια στην αρχική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit a name right in its row. Drag the handle on the right to change the order — you’ll swipe through rooms in the same order on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se edita en la propia fila. Arrastra el asa de la derecha para cambiar el orden: en ese mismo orden se pasan las habitaciones en Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeä muokataan suoraan rivillä. Muuta järjestystä vetämällä oikealla olevasta kahvasta – samassa järjestyksessä huoneita selataan Koti-välilehdellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom se modifie directement dans la ligne. Faites glisser la poignée à droite pour changer l’ordre — c’est dans cet ordre que les pièces défilent sur l’accueil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નામ સીધું લીટીમાં જ બદલો. ક્રમ બદલવા જમણી બાજુનું હૅન્ડલ ખેંચો — હોમ પર રૂમ આ જ ક્રમમાં સ્વાઇપ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם נערך ישירות בשורה. גררו את הידית משמאל כדי לשנות את הסדר — באותו סדר מדפדפים בין החדרים במסך הראשי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम सीधे पंक्ति में बदलें। क्रम बदलने के लिए दाईं ओर का हैंडल खींचें — होम पर कमरे इसी क्रम में स्वाइप होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv se uređuje izravno u retku. Povucite ručicu desno da promijenite redoslijed — istim redom listate sobe na početnoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név közvetlenül a sorban szerkeszthető. A sorrend a jobb oldali fogantyú húzásával módosítható — a főoldalon ugyanebben a sorrendben lapozhatsz a szobák között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama diedit langsung di barisnya. Seret pegangan di kanan untuk mengubah urutan — dengan urutan yang sama ruangan digeser di beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome si modifica direttamente nella riga. Trascina la maniglia a destra per cambiare l’ordine: nello stesso ordine scorrerai le stanze nella Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は行のまま編集できます。右側のハンドルをドラッグすると順番を変えられます — ホームでもこの順番で部屋をスワイプできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы тура жолда өзгертіледі. Ретін өзгерту үшін оң жақтағы тұтқаны сүйреңіз — басты бетте бөлмелер дәл осы ретпен парақталады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೆಸರನ್ನು ನೇರವಾಗಿ ಸಾಲಿನಲ್ಲೇ ಬದಲಿಸಿ. ಕ್ರಮ ಬದಲಿಸಲು ಬಲಬದಿಯ ಹಿಡಿಕೆಯನ್ನು ಎಳೆಯಿರಿ — ಮುಖಪುಟದಲ್ಲಿ ಕೋಣೆಗಳು ಇದೇ ಕ್ರಮದಲ್ಲಿ ಸ್ವೈಪ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 행에서 바로 편집해요. 오른쪽 핸들을 드래그하면 순서를 바꿀 수 있어요 — 홈에서도 이 순서대로 방을 넘겨요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pavadinimas redaguojamas tiesiog eilutėje. Tempkite rankenėlę dešinėje, kad pakeistumėte tvarką – ta pačia tvarka kambariai braukiami pradžios ekrane."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേര് വരിയിൽ തന്നെ മാറ്റുക. ക്രമം മാറ്റാൻ വലതുവശത്തെ ഹാൻഡിൽ വലിക്കുക — ഹോമിൽ മുറികൾ ഇതേ ക്രമത്തിൽ സ്വൈപ്പ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नाव थेट ओळीतच बदला. क्रम बदलण्यासाठी उजवीकडील हँडल ओढा — मुख्य पानावर खोल्या याच क्रमाने स्वाइप होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama diedit terus dalam baris. Seret pemegang di kanan untuk menukar susunan — bilik dileret dengan susunan yang sama di skrin utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres rett i raden. Dra i håndtaket til høyre for å endre rekkefølgen – i samme rekkefølge sveiper du mellom rommene på startsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam wijzig je direct in de regel. Sleep de greep rechts om de volgorde te wijzigen — in dezelfde volgorde veeg je door de kamers op het startscherm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନାମ ସିଧାସଳଖ ଧାଡ଼ିରେ ବଦଳାନ୍ତୁ। କ୍ରମ ବଦଳାଇବାକୁ ଡାହାଣ ପଟର ହ୍ୟାଣ୍ଡେଲ୍ ଟାଣନ୍ତୁ — ହୋମ୍‌ରେ ରୁମ୍ ଏହି କ୍ରମରେ ସ୍ୱାଇପ୍ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਾਮ ਸਿੱਧਾ ਕਤਾਰ ਵਿੱਚ ਬਦਲੋ। ਕ੍ਰਮ ਬਦਲਣ ਲਈ ਸੱਜੇ ਪਾਸੇ ਦਾ ਹੈਂਡਲ ਖਿੱਚੋ — ਹੋਮ ਉੱਤੇ ਕਮਰੇ ਇਸੇ ਕ੍ਰਮ ਵਿੱਚ ਸਵਾਈਪ ਹੁੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwę edytuje się bezpośrednio w wierszu. Przeciągnij uchwyt po prawej, aby zmienić kolejność — w tej samej kolejności przesuwasz pokoje na ekranie głównym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome é editado na própria linha. Arraste a alça à direita para mudar a ordem — é nessa ordem que os cômodos passam no Início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome edita-se na própria linha. Arraste a pega à direita para mudar a ordem — é por essa ordem que as divisões passam no Início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele se editează direct pe rând. Trage de mânerul din dreapta ca să schimbi ordinea — în aceeași ordine glisezi prin camere pe pagina principală."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názov sa upravuje priamo v riadku. Potiahnutím úchytu vpravo zmeníte poradie — v rovnakom poradí sa miestnosti listujú na úvodnej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime urejate kar v vrstici. Povlecite ročico na desni, da spremenite vrstni red — v enakem vrstnem redu listate sobe na začetnem zaslonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet redigeras direkt i raden. Dra i handtaget till höger för att ändra ordningen – i samma ordning sveper du mellan rummen på hemskärmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெயரை வரியிலேயே திருத்தலாம். வரிசையை மாற்ற வலப்பக்கக் கைப்பிடியை இழுக்கவும் — முகப்பில் அறைகள் இதே வரிசையில் ஸ்வைப் ஆகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేరును నేరుగా వరుసలోనే మార్చండి. క్రమం మార్చడానికి కుడివైపు హ్యాండిల్‌ను లాగండి — హోమ్‌లో గదులు ఇదే క్రమంలో స్వైప్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขชื่อได้ในแถวโดยตรง ลากที่จับด้านขวาเพื่อเปลี่ยนลำดับ — ในหน้าหลักจะปัดดูห้องตามลำดับเดียวกันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad doğrudan satırda düzenlenir. Sırayı değiştirmek için sağdaki tutamağı sürükleyin — ana sayfada odalar arasında aynı sırayla geçersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва правиться просто в рядку. Потягніть за ручку праворуч, щоб змінити порядок, — у тому самому порядку кімнати гортаються на головній."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نام سیدھا قطار ہی میں بدلیں۔ ترتیب بدلنے کے لیے ہینڈل کھینچیں — ہوم پر کمرے اسی ترتیب سے سوائپ ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa tên ngay trên dòng. Kéo tay nắm bên phải để đổi thứ tự — ở trang chủ, bạn sẽ vuốt qua các phòng theo đúng thứ tự đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称可直接在行内编辑。拖动右侧的把手可调整顺序——在主页上滑动切换房间时也按此顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱可直接在該列編輯。拖移右側的控制點可調整順序——在主頁上滑動切換房間時也依此順序。"
          }
        }
      }
    },
    "Имя стоит в профиле и уходит вместе со счётом друзьям.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر اسمك في الملف الشخصي ويُرسل مع نقاطك إلى الأصدقاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името стои в профила и отива заедно с резултата при приятелите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নাম প্রোফাইলে থাকে এবং স্কোরের সঙ্গে বন্ধুদের কাছে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu nom surt al perfil i arriba als amics amb la teva puntuació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jméno je v profilu a putuje se skóre k přátelům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn står i profilen og følger med din score til vennerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name steht im Profil und geht mit deinem Punktestand an Freunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομά σας εμφανίζεται στο προφίλ και πηγαίνει μαζί με το σκορ στους φίλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name appears in your profile and is sent to friends along with your score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre aparece en el perfil y viaja con tu puntuación a tus amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi näkyy profiilissa ja lähtee pisteidesi mukana kavereille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom figure dans le profil et part avec votre score chez vos amis."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું નામ પ્રોફાઇલમાં દેખાય છે અને સ્કોર સાથે મિત્રો સુધી જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם מופיע בפרופיל ונשלח לחברים יחד עם הניקוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नाम प्रोफ़ाइल में दिखता है और स्कोर के साथ दोस्तों तक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime je u profilu i ide s vašim rezultatom prijateljima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A neved a profilban szerepel, és a pontszámoddal együtt eljut a barátaidhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Namamu tampil di profil dan dikirim bersama skor ke teman-teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome compare nel profilo e arriva agli amici con il tuo punteggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はプロフィールに表示され、スコアと一緒に友達に届きます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атыңыз профильде тұрады және ұпаймен бірге достарға барады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೆಸರು ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಕಾಣುತ್ತದೆ ಮತ್ತು ಅಂಕಗಳೊಂದಿಗೆ ಸ್ನೇಹಿತರಿಗೆ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 프로필에 표시되며 점수와 함께 친구에게 전달돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardas rodomas profilyje ir kartu su rezultatu keliauja draugams."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പേര് പ്രൊഫൈലിൽ കാണും, സ്കോറിനൊപ്പം സുഹൃത്തുക്കൾക്ക് പോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे नाव प्रोफाइलमध्ये दिसते आणि गुणांसोबत मित्रांकडे जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama anda dipaparkan dalam profil dan dihantar bersama skor kepada rakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet ditt står i profilen og følger med poengsummen til vennene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam staat in je profiel en gaat met je score mee naar vrienden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନାମ ପ୍ରୋଫାଇଲ୍‌ରେ ଦେଖାଯାଏ ଏବଂ ସ୍କୋର୍ ସହ ବନ୍ଧୁମାନଙ୍କ ପାଖକୁ ଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਨਾਮ ਪ੍ਰੋਫ਼ਾਈਲ ਵਿੱਚ ਦਿਸਦਾ ਹੈ ਅਤੇ ਸਕੋਰ ਨਾਲ ਦੋਸਤਾਂ ਕੋਲ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imię widnieje w profilu i trafia razem z wynikiem do znajomych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome aparece no perfil e vai junto com sua pontuação para os amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu nome aparece no perfil e vai com a sua pontuação para os amigos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele apare în profil și pleacă împreună cu scorul la prieteni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno je v profile a putuje so skóre k priateľom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime je v profilu in gre skupaj z rezultatom k prijateljem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt namn visas i profilen och följer med poängen till vännerna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயர் சுயவிவரத்தில் தெரியும், மதிப்பெண்ணுடன் நண்பர்களுக்குச் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పేరు ప్రొఫైల్‌లో కనిపిస్తుంది, స్కోర్‌తో పాటు స్నేహితులకు వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อของคุณแสดงในโปรไฟล์และส่งไปพร้อมคะแนนถึงเพื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız profilde görünür ve puanınızla birlikte arkadaşlarınıza gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім’я стоїть у профілі й іде разом із рахунком друзям."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نام پروفائل میں نظر آتا ہے اور اسکور کے ساتھ دوستوں تک جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên bạn hiện trong hồ sơ và được gửi kèm điểm số đến bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字显示在个人资料中，并会随分数一起发给朋友。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字會顯示在個人檔案中，並隨分數一起傳給朋友。"
          }
        }
      }
    },
