    "Фигурки узора, его цвет и цвет волны после полива.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشكال النقش ولونها ولون الموجة بعد السقي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фигурите на шарката, цветът ѝ и цветът на вълната след поливане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নকশার আকৃতি, তার রং আর জল দেওয়ার পর ঢেউয়ের রং।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les figures del patró, el seu color i el de l’onada després del reg."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Figurky vzoru, jejich barva a barva vlny po zalití."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mønstrets figurer, dets farve og farven på bølgen efter vanding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Figuren des Musters, seine Farbe und die Farbe der Welle nach dem Gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχήματα του μοτίβου, το χρώμα του και το χρώμα του κύματος μετά το πότισμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern shapes, their color, and the color of the wave after watering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las figuras del patrón, su color y el color de la ola tras el riego."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvion hahmot, sen väri ja aallon väri kastelun jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formes du motif, sa couleur et celle de la vague après l’arrosage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ભાતની આકૃતિઓ, તેનો રંગ અને પાણી પછી લહેરનો રંગ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צורות הדוגמה, הצבע שלה וצבע הגל אחרי השקיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैटर्न की आकृतियाँ, उनका रंग और पानी देने के बाद लहर का रंग।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Figure uzorka, njihova boja i boja vala nakon zalijevanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A minta figurái, a színe és a hullám színe öntözés után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk pola, warnanya, dan warna gelombang setelah menyiram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le figure del motivo, il loro colore e quello dell’onda dopo l’annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "模様の図形とその色、水やり後の波の色。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өрнек фигуралары, оның түсі және суарудан кейінгі толқын түсі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿನ್ಯಾಸದ ಆಕೃತಿಗಳು, ಅವುಗಳ ಬಣ್ಣ ಮತ್ತು ನೀರು ಹಾಕಿದ ನಂತರದ ಅಲೆಯ ಬಣ್ಣ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무늬의 도형과 색, 물을 준 뒤 물결의 색."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rašto figūros, jų spalva ir bangos spalva po laistymo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിത്രപ്പണിയിലെ രൂപങ്ങൾ, അവയുടെ നിറം, നനച്ചശേഷമുള്ള തിരയുടെ നിറം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नक्षीच्या आकृत्या, त्यांचा रंग आणि पाणी दिल्यानंतरच्या लाटेचा रंग."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk corak, warnanya dan warna gelombang selepas menyiram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mønsterets figurer, fargen og fargen på bølgen etter vanning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De figuren van het patroon, hun kleur en de kleur van de golf na het gieten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନକ୍ସାର ଆକୃତି, ସେଗୁଡ଼ିକର ରଙ୍ଗ ଓ ପାଣି ପରେ ଢେଉର ରଙ୍ଗ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਮੂਨੇ ਦੀਆਂ ਆਕ੍ਰਿਤੀਆਂ, ਉਨ੍ਹਾਂ ਦਾ ਰੰਗ ਅਤੇ ਪਾਣੀ ਤੋਂ ਬਾਅਦ ਲਹਿਰ ਦਾ ਰੰਗ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Figurki wzoru, jego kolor i kolor fali po podlaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As figuras do padrão, a cor dele e a cor da onda depois da rega."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As figuras do padrão, a sua cor e a cor da onda depois da rega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Figurile modelului, culoarea lui și culoarea valului după udare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Figúrky vzoru, ich farba a farba vlny po poliatí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Figure vzorca, njihova barva in barva vala po zalivanju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mönstrets figurer, dess färg och vågens färg efter vattning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வடிவத்தின் உருவங்கள், அவற்றின் நிறம், நீர் ஊற்றிய பின் அலையின் நிறம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమూనా ఆకారాలు, వాటి రంగు, నీళ్లు పోసిన తర్వాత అల రంగు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปทรงของลวดลาย สีของมัน และสีของคลื่นหลังรดน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenin şekilleri, rengi ve sulamadan sonraki dalganın rengi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фігурки візерунка, його колір і колір хвилі після поливу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نقش کی شکلیں، ان کا رنگ اور پانی کے بعد لہر کا رنگ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hình của họa tiết, màu của chúng và màu của làn sóng sau khi tưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图案的图形、颜色，以及浇水后波纹的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖案的圖形、顏色，以及澆水後波紋的顏色。"
          }
        }
      }
    },
