        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಯಾವಾಗಲೂ ಮುಂದಿನ ಹಂತ ಬರೆದಿರುತ್ತದೆ: ಕ್ಯಾಮೆರಾ ತೋರಿಸಿ, ಗಿಡ ಇಡಿ, ಅದನ್ನು ಆಯ್ಕೆ ಮಾಡಿ."
