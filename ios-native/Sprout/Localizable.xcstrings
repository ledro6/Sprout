    "Нажмите, чтобы искать снова. Долгое нажатие — забыть запрос.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لتبحث مجددًا. الضغط المطوّل ينسى البحث."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете, за да търсите отново. Дълго натискане – забравяне на търсенето."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার খুঁজতে ট্যাপ করুন। দীর্ঘ চাপে খোঁজ ভুলে যান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per tornar a cercar. Mantén premut per oblidar la cerca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím hledáte znovu. Dlouhým podržením hledání zapomenete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at søge igen. Hold nede for at glemme søgningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um erneut zu suchen. Lang drücken – Suche vergessen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε για να ψάξετε ξανά. Παρατεταμένο πάτημα — ξεχάστε την αναζήτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to search again. Touch and hold to forget a search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para buscar de nuevo. Mantén pulsado para olvidar la búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae uudelleen napauttamalla. Pitkä painallus unohtaa haun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour chercher à nouveau. Appui long : oublier la recherche."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફરીથી શોધવા ટૅપ કરો. લાંબું દબાવો — શોધ ભૂલી જાઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו כדי לחפש שוב. לחיצה ארוכה – לשכוח את החיפוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से खोजने के लिए टैप करें। देर तक दबाएँ — खोज भूल जाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite za ponovno pretraživanje. Dugi pritisak – zaboravi upit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az újbóli kereséshez. Hosszú nyomással elfelejtheted a keresést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mencari lagi. Tekan lama untuk melupakan pencarian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per cercare di nuovo. Tieni premuto per dimenticare la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで再検索。長押しで検索履歴から削除。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайта іздеу үшін түртіңіз. Ұзақ басу — сұранысты ұмыту."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮತ್ತೆ ಹುಡುಕಲು ಟ್ಯಾಪ್ ಮಾಡಿ. ದೀರ್ಘವಾಗಿ ಒತ್ತಿ — ಹುಡುಕಾಟ ಮರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 다시 검색해요. 길게 누르면 검색 기록에서 지워요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite, kad ieškotumėte vėl. Ilgai paspaudus – pamiršti užklausą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടും തിരയാൻ ടാപ്പ് ചെയ്യുക. ദീർഘമായി അമർത്തുക — തിരയൽ മറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुन्हा शोधण्यासाठी टॅप करा. दीर्घ दाबा — शोध विसरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk mencari lagi. Tekan lama untuk melupakan carian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å søke igjen. Hold inne for å glemme søket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om opnieuw te zoeken. Houd ingedrukt om een zoekopdracht te vergeten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୁଣି ଖୋଜିବାକୁ ଟାପ୍ କରନ୍ତୁ। ଲମ୍ବା ଚାପନ୍ତୁ — ସନ୍ଧାନ ଭୁଲିଯାଆନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੜ ਖੋਜਣ ਲਈ ਟੈਪ ਕਰੋ। ਲੰਮਾ ਦਬਾਓ — ਖੋਜ ਭੁੱਲ ਜਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, by szukać ponownie. Długie naciśnięcie – zapomnij zapytanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para buscar de novo. Toque e segure para esquecer a busca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para pesquisar de novo. Mantenha premido para esquecer a pesquisa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ca să cauți din nou. Apăsare lungă – uită căutarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím hľadáte znova. Dlhým podržaním vyhľadávanie zabudnete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite za ponovno iskanje. Dolg pritisk – pozabi iskanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att söka igen. Håll ned för att glömma sökningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் தேட தட்டுங்கள். நீண்ட நேரம் அழுத்துங்கள் — தேடலை மறக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్లీ వెతకడానికి ట్యాప్ చేయండి. ఎక్కువసేపు నొక్కండి — శోధనను మరచిపోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อค้นหาอีกครั้ง แตะค้างเพื่อลืมคำค้นหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden aramak için dokunun. Uzun basın — aramayı unutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб шукати знову. Довге натискання — забути запит."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ تلاش کے لیے ٹیپ کریں۔ دیر تک دبائیں — تلاش بھول جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để tìm lại. Nhấn giữ để quên tìm kiếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可再次搜索。长按可删除这条搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下即可再次搜尋。長按可刪除這筆搜尋。"
          }
        }
      }
    },
