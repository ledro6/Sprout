    "Откройте Sprout — и сад появится здесь.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Sprout وستظهر حديقتك هنا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Sprout — и градината ще се появи тук."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Sprout i el teu jardí apareixerà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Sprout a zahrada se objeví tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Sprout, så vises din have her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Sprout, dann erscheint dein Garten hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Sprout και ο κήπος σας θα εμφανιστεί εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sprout and your garden will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Sprout y tu jardín aparecerá aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Sprout, niin puutarhasi näkyy tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Sprout et votre jardin apparaîtra ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Sprout והגינה תופיע כאן."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Sprout i vaš će se vrt pojaviti ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Sproutot, és itt megjelenik a kerted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Sprout e il tuo giardino apparirà qui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout-ты ашыңыз — бақ осында пайда болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite Sprout ir sodas atsiras čia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Sprout, så vises hagen din her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sprout en je tuin verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Sprout, a twój ogród pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Sprout e seu jardim vai aparecer aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Sprout e o seu jardim aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Sprout și grădina ta va apărea aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Sprout a záhrada sa objaví tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite Sprout in vaš vrt se bo pojavil tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Sprout så visas din trädgård här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout’u açın, bahçeniz burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Sprout — і сад з’явиться тут."
          }
        }
      }
    },
    "Открывает растения комнаты в дополненной реальности.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
