    "Поменяли вид — в AR встанет модель нового вида.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت النوع — سيظهر في الواقع المعزز نموذج النوع الجديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменихте вида – в AR ще застане моделът на новия вид."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রজাতি বদলেছেন — AR-এ নতুন প্রজাতির মডেল দাঁড়াবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has canviat l’espècie? A la RA sortirà el model de la nova espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnili jste druh – v AR se objeví model nového druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiftet art – i AR står modellen af den nye art."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Art geändert – in AR steht dann das Modell der neuen Art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξατε είδος — στο AR θα μπει το μοντέλο του νέου είδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed the species — AR will show the new species’ model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiaste la especie? En RA aparecerá el modelo de la nueva especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laji vaihtui – AR:ssä näkyy uuden lajin malli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espèce changée — la RA affichera le modèle de la nouvelle espèce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાત બદલી — AR માં નવી જાતનું મૉડલ દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיניתם מין — ב־AR יעמוד המודל של המין החדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रजाति बदली — AR में नई प्रजाति का मॉडल दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijenili ste vrstu – u AR-u će stajati model nove vrste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fajt váltottál – az AR-ben az új faj modellje jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis diganti — di AR akan muncul model jenis yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Specie cambiata: in AR comparirà il modello della nuova specie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類を変更すると、ARには新しい種類のモデルが表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түрді ауыстырдыңыз — AR-да жаңа түрдің моделі тұрады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜಾತಿ ಬದಲಿಸಿದಿರಿ — AR ನಲ್ಲಿ ಹೊಸ ಜಾತಿಯ ಮಾದರಿ ಇರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종을 바꾸면 AR에는 새 종의 모델이 나와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitėte rūšį – AR stovės naujos rūšies modelis."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനം മാറ്റി — AR-ൽ പുതിയ ഇനത്തിന്റെ മോഡൽ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जात बदलली — AR मध्ये नव्या जातीचे मॉडेल दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesies ditukar — dalam AR akan muncul model spesies baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Byttet art – i AR står modellen av den nye arten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soort gewijzigd – in AR staat dan het model van de nieuwe soort."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରଜାତି ବଦଳିଲା — AR ରେ ନୂଆ ପ୍ରଜାତିର ମଡେଲ୍ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸਮ ਬਦਲੀ — AR ਵਿੱਚ ਨਵੀਂ ਕਿਸਮ ਦਾ ਮਾਡਲ ਦਿਸੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniono gatunek – w AR stanie model nowego gatunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou a espécie? Na RA vai aparecer o modelo da nova espécie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou a espécie? Na RA vai surgir o modelo da nova espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai schimbat specia – în RA va apărea modelul noii specii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenili ste druh – v AR sa objaví model nového druhu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremenili ste vrsto – v AR bo model nove vrste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt art – i AR står modellen av den nya arten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வகையை மாற்றினீர்கள் — AR இல் புதிய வகையின் மாடல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జాతి మార్చారు — AR లో కొత్త జాతి మోడల్ ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนชนิดแล้ว — ใน AR จะเป็นโมเดลของชนิดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türü değiştirdiniz — AR’de yeni türün modeli görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінили вид — в AR стане модель нового виду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قسم بدلی — AR میں نئی قسم کا ماڈل ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi loài rồi — trong AR sẽ là mô hình của loài mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换种类后，AR 中会显示新种类的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換種類後，AR 中會顯示新種類的模型。"
          }
        }
      }
    },
