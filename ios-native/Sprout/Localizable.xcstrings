    "Модель построю по снимку.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأبني النموذج من الصورة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще направя модела по снимката."
