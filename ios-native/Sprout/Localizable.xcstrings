    "Потяните снимок или разведите пальцы. Двойное нажатие вернёт как было.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الصورة أو باعد بين أصابعك. اضغط مرتين للاستعادة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете снимката или разтворете пръсти. Двойно докосване връща както беше."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি টানুন বা আঙুল ছড়ান। আগের মতো করতে দুবার ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega la foto o separa els dits. Toca dues vegades per restablir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhněte fotku nebo roztáhněte prsty. Dvojím klepnutím obnovíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i fotoet, eller spred fingrene. Dobbelttryk for at nulstille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das Foto oder spreiz die Finger. Doppeltippen setzt es zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε τη φωτογραφία ή ανοίξτε τα δάχτυλα. Διπλό πάτημα για επαναφορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the photo or spread your fingers. Double-tap to reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la foto o separa los dedos. Toca dos veces para restablecer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kuvaa tai levitä sormia. Palauta kaksoisnapautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la photo ou écartez les doigts. Touchez deux fois pour revenir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ખેંચો અથવા આંગળીઓ ફેલાવો. પહેલાં જેવું કરવા બે વાર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו את התמונה או הרחיקו את האצבעות. הקשה כפולה מחזירה למצב הקודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो खींचें या उँगलियाँ फैलाएँ। पहले जैसा करने के लिए दो बार टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite fotografiju ili raširite prste. Dvaput dodirnite za vraćanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fotót, vagy húzd szét az ujjaidat. Dupla koppintás visszaállítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto atau renggangkan jari. Ketuk dua kali untuk mengembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la foto o allarga le dita. Tocca due volte per ripristinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をドラッグするか、指を広げてください。ダブルタップで元に戻ります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретті сүйреңіз не саусақтарды ашыңыз. Екі рет түрту бастапқы күйге қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 드래그하거나 손가락을 벌리세요. 이중 탭하면 되돌아가요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkite nuotrauką arba išskėskite pirštus. Dukart bakstelėkite, kad atkurtumėte."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो ओढा किंवा बोटे पसरा. पूर्ववत करण्यासाठी दोनदा टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto atau renggangkan jari. Ketik dua kali untuk tetapkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i bildet eller spre fingrene. Dobbelttrykk for å tilbakestille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de foto of spreid je vingers. Dubbeltik om te herstellen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଟାଣନ୍ତୁ କିମ୍ବା ଆଙ୍ଗୁଠି ବିସ୍ତାର କରନ୍ତୁ। ପୂର୍ବ ପରି କରିବାକୁ ଦୁଇଥର ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਖਿੱਚੋ ਜਾਂ ਉਂਗਲਾਂ ਫੈਲਾਓ। ਪਹਿਲਾਂ ਵਾਂਗ ਕਰਨ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij zdjęcie lub rozsuń palce. Stuknij dwukrotnie, aby wrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a foto ou afaste os dedos. Toque duas vezes para voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a fotografia ou afaste os dedos. Toque duas vezes para repor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage fotografia sau depărtează degetele. Atinge de două ori pentru resetare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťahajte fotku alebo roztiahnite prsty. Dvojitým klepnutím obnovíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlecite fotografijo ali razprite prste. Dvakrat tapnite za ponastavitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra fotot eller sära på fingrarna. Dubbeltryck för att återställa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรูปถ่ายหรือกางนิ้ว แตะสองครั้งเพื่อคืนค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı sürükleyin ya da parmaklarınızı açın. Sıfırlamak için iki kez dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягніть знімок або розведіть пальці. Подвійне натискання поверне як було."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo ảnh hoặc xòe ngón tay. Chạm hai lần để đặt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动照片或张开手指。连按两下可复原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移照片或張開手指。點兩下可復原。"
          }
        }
      }
    },
    "Похоже, земля сохнет быстрее: %1$@ вместо %2$@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن التربة تجف أسرع: %1$@ بدلًا من %2$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изглежда пръстта съхне по-бързо: %1$@ вместо %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনে হচ্ছে মাটি তাড়াতাড়ি শুকাচ্ছে: %2$@-এর বদলে %1$@।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembla que la terra s’asseca més de pressa: %1$@ en lloc de %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá se, že zemina schne rychleji: %1$@ místo %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden ser ud til at tørre hurtigere: %1$@ i stedet for %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erde scheint schneller zu trocknen: %1$@ statt %2$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται ότι το χώμα στεγνώνει πιο γρήγορα: %1$@ αντί για %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the soil dries faster: %1$@ instead of %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la tierra se seca más rápido: %1$@ en lugar de %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Multa näyttää kuivuvan nopeammin: %1$@ eikä %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que la terre sèche plus vite : %1$@ au lieu de %2$@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાગે છે માટી ઝડપથી સુકાય છે: %2$@ ને બદલે %1$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שהאדמה מתייבשת מהר יותר: %1$@ במקום %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है मिट्टी जल्दी सूख रही है: %2$@ की जगह %1$@।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čini se da se zemlja suši brže: %1$@ umjesto %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, gyorsabban szárad a föld: %1$@ helyett %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya tanah lebih cepat kering: %1$@, bukan %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che il terriccio asciughi più in fretta: %1$@ invece di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "土の乾きが早いようです：%2$@ではなく%1$@。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топырақ тезірек кебетін сияқты: %2$@ емес, %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙이 더 빨리 마르는 것 같아요: %2$@ 대신 %1$@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodo, žemė džiūsta greičiau: %1$@, o ne %2$@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माती लवकर सुकते असे दिसते: %2$@ ऐवजी %1$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nampaknya tanah kering lebih cepat: %1$@, bukan %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorda ser ut til å tørke raskere: %1$@ i stedet for %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aarde lijkt sneller te drogen: %1$@ in plaats van %2$@."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଗୁଛି ମାଟି ଶୀଘ୍ର ଶୁଖୁଛି: %2$@ ବଦଳରେ %1$@।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੱਗਦਾ ਹੈ ਮਿੱਟੀ ਜਲਦੀ ਸੁੱਕਦੀ ਹੈ: %2$@ ਦੀ ਥਾਂ %1$@।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że ziemia schnie szybciej: %1$@ zamiast %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că pământul se usucă mai repede: %1$@ în loc de %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá sa, že zemina schne rýchlejšie: %1$@ namiesto %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videti je, da se zemlja suši hitreje: %1$@ namesto %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden verkar torka snabbare: %1$@ i stället för %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนดินแห้งเร็วขึ้น: %1$@ แทนที่จะเป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprak daha hızlı kuruyor gibi: %2$@ yerine %1$@."
          }
        },
        "uk": {
