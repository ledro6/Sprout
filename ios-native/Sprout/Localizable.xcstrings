          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next step is always written here: point the camera, place the plant, select it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí siempre está el siguiente paso: apuntar con la cámara, colocar la planta, elegirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä lukee aina seuraava vaihe: suuntaa kamera, aseta kasvi, valitse se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étape suivante est toujours écrite ici : viser avec la caméra, poser la plante, la choisir."
