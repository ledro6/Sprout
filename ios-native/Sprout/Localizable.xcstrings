        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕਦੋਂ ਜਾ ਰਹੇ ਹੋ ਅਤੇ ਕਦੋਂ ਮੁੜੋਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy wyjeżdżasz i kiedy wrócisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você viaja e quando volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando parte e quando volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când pleci și când te întorci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy odchádzate a kedy sa vrátite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdaj odhajate in kdaj se vrnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du reser och när du kommer tillbaka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எப்போது புறப்படுகிறீர்கள், எப்போது திரும்புவீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎప్పుడు వెళ్తారు, ఎప్పుడు తిరిగి వస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไปเมื่อไร และกลับเมื่อไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman gidip ne zaman döneceğiniz."
