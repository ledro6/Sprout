        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଗୁଛି ମାଟି ଶୀଘ୍ର ଶୁଖୁଛି: %2$@ ବଦଳରେ %1$@।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੱਗਦਾ ਹੈ ਮਿੱਟੀ ਜਲਦੀ ਸੁੱਕਦੀ ਹੈ: %2$@ ਦੀ ਥਾਂ %1$@।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że ziemia schnie szybciej: %1$@ zamiast %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că pământul se usucă mai repede: %1$@ în loc de %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá sa, že zemina schne rýchlejšie: %1$@ namiesto %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videti je, da se zemlja suši hitreje: %1$@ namesto %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden verkar torka snabbare: %1$@ i stället för %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மண் வேகமாக உலர்வது போலத் தெரிகிறது: %2$@ க்குப் பதிலாக %1$@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మట్టి త్వరగా ఆరుతున్నట్లుంది: %2$@ బదులుగా %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนดินแห้งเร็วขึ้น: %1$@ แทนที่จะเป็น %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprak daha hızlı kuruyor gibi: %2$@ yerine %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, земля висихає швидше: %1$@ замість %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لگتا ہے مٹی جلدی سوکھ رہی ہے: %2$@ کے بجائے %1$@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ đất khô nhanh hơn: %1$@ thay vì %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看来土壤干得更快：%1$@，而不是%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看來土壤乾得更快：%1$@，而不是%2$@。"
          }
        }
      }
    },
    "Появится меню: полить, переименовать, перевезти в другую комнату. Держите дольше или ведите пальцем — карточки закачаются, и их можно переставить.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر قائمة: السقي، وإعادة التسمية، والنقل إلى غرفة أخرى. واصل الضغط أو اسحب إصبعك، فتبدأ البطاقات بالاهتزاز ويمكنك إعادة ترتيبها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще се появи меню: полей, преименувай, премести в друга стая. Задръжте по-дълго или плъзнете пръст – картите ще се разклатят и ще можете да ги пренаредите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মেনু আসবে: জল দিন, নাম বদলান, অন্য ঘরে সরান। আরও চেপে থাকুন বা আঙুল টানুন — কার্ডগুলো দুলতে শুরু করবে, আর সেগুলো সাজিয়ে নিতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apareixerà un menú: regar, canviar el nom, moure a una altra habitació. Mantén-lo més estona o arrossega el dit: les targetes es posaran a tremolar i les podràs reordenar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objeví se nabídka: zalít, přejmenovat, přestěhovat do jiného pokoje. Podržte déle nebo táhněte prstem – karty se rozkývou a můžete je přeskládat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En menu dukker op: vand, omdøb, flyt til et andet rum. Hold længere, eller træk med fingeren – kortene begynder at vippe, og du kan flytte rundt på dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menü erscheint: gießen, umbenennen, in einen anderen Raum bringen. Hältst du länger oder ziehst den Finger, wackeln die Karten, und du kannst sie umsortieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται ένα μενού: πότισμα, μετονομασία, μεταφορά σε άλλο δωμάτιο. Κρατήστε περισσότερο ή σύρετε το δάχτυλο — οι κάρτες αρχίζουν να τρέμουν και μπορείτε να τις αναδιατάξετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu appears: water, rename, move to another room. Hold longer or drag your finger — the cards start to jiggle and you can rearrange them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece un menú: regar, cambiar el nombre, mover a otra habitación. Mantén más tiempo o arrastra el dedo: las tarjetas empiezan a temblar y puedes reordenarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiin tulee valikko: kastele, nimeä uudelleen, siirrä toiseen huoneeseen. Pidä pidempään tai vedä sormella – kortit alkavat heilua, ja voit järjestää ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu apparaît : arroser, renommer, déplacer dans une autre pièce. Maintenez plus longtemps ou faites glisser le doigt — les cartes se mettent à trembler et vous pouvez les réorganiser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેનૂ આવશે: પાણી આપો, નામ બદલો, બીજા ઓરડામાં ખસેડો. વધુ દબાવી રાખો અથવા આંગળી ખેંચો — કાર્ડ હલવા લાગશે અને તમે તેમનો ક્રમ બદલી શકશો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יופיע תפריט: להשקות, לשנות שם, להעביר לחדר אחר. החזיקו עוד או גררו את האצבע – הכרטיסים יתחילו לרעוד ואפשר יהיה לסדר אותם מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेनू आएगा: पानी दें, नाम बदलें, दूसरे कमरे में ले जाएँ। और देर दबाएँ या उंगली खींचें — कार्ड हिलने लगेंगे और आप उनका क्रम बदल सकेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojavit će se izbornik: zalij, preimenuj, premjesti u drugu sobu. Zadržite dulje ili povucite prstom – kartice će se zatresti i možete ih presložiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenik egy menü: öntözés, átnevezés, áthelyezés másik szobába. Tartsd tovább, vagy húzd az ujjad – a kártyák remegni kezdenek, és átrendezheted őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu akan muncul: siram, ganti nama, pindah ke ruangan lain. Tahan lebih lama atau geser jarimu — kartu mulai bergoyang dan bisa diatur ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare un menu: annaffiare, rinominare, spostare in un’altra stanza. Tieni premuto più a lungo o trascina il dito: le schede iniziano a tremolare e puoi riordinarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューが出ます。水やり、名前の変更、別の部屋への移動ができます。さらに押し続けるか指を動かすと、カードが揺れ始め、並べ替えられます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәзір шығады: суару, атын өзгерту, басқа бөлмеге көшіру. Ұзағырақ ұстаңыз немесе саусақпен жылжытыңыз — карточкалар шайқала бастайды, оларды қайта орналастыруға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆನು ಬರುತ್ತದೆ: ನೀರು ಹಾಕಿ, ಹೆಸರು ಬದಲಿಸಿ, ಬೇರೆ ಕೋಣೆಗೆ ಸರಿಸಿ. ಇನ್ನಷ್ಟು ಹಿಡಿದಿಡಿ ಅಥವಾ ಬೆರಳು ಎಳೆಯಿರಿ — ಕಾರ್ಡ್‌ಗಳು ಅಲುಗಾಡತೊಡಗುತ್ತವೆ ಮತ್ತು ಅವುಗಳ ಕ್ರಮ ಬದಲಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴가 나와요. 물주기, 이름 바꾸기, 다른 방으로 옮기기. 더 오래 누르거나 손가락을 움직이면 카드가 흔들리고 순서를 바꿀 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsiras meniu: palaistyti, pervadinti, perkelti į kitą kambarį. Palaikykite ilgiau arba braukite pirštu – kortelės ims virpėti ir galėsite jas perstatyti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മെനു വരും: നനയ്ക്കുക, പേര് മാറ്റുക, മറ്റൊരു മുറിയിലേക്ക് മാറ്റുക. കൂടുതൽ നേരം പിടിക്കുക അല്ലെങ്കിൽ വിരൽ വലിക്കുക — കാർഡുകൾ ഇളകാൻ തുടങ്ങും, അവയുടെ ക്രമം മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेनू येईल: पाणी द्या, नाव बदला, दुसऱ्या खोलीत हलवा. अजून धरून ठेवा किंवा बोट ओढा — कार्डे हलू लागतील आणि तुम्ही त्यांचा क्रम बदलू शकाल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu akan muncul: siram, namakan semula, pindah ke bilik lain. Tahan lebih lama atau seret jari — kad mula bergoyang dan boleh disusun semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En meny dukker opp: vann, gi nytt navn, flytt til et annet rom. Hold lenger eller dra med fingeren – kortene begynner å vippe, og du kan flytte dem rundt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verschijnt een menu: water geven, hernoemen, naar een andere kamer verplaatsen. Houd langer vast of sleep je vinger – de kaarten gaan wiebelen en je kunt ze herschikken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମେନୁ ଆସିବ: ପାଣି ଦିଅନ୍ତୁ, ନାମ ବଦଳାନ୍ତୁ, ଅନ୍ୟ କୋଠରୀକୁ ନିଅନ୍ତୁ। ଆହୁରି ଧରି ରଖନ୍ତୁ ବା ଆଙ୍ଗୁଠି ଟାଣନ୍ତୁ — କାର୍ଡସବୁ ହଲିବାକୁ ଲାଗିବ ଓ ଆପଣ ସେଗୁଡ଼ିକର କ୍ରମ ବଦଳାଇ ପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਨੂ ਆਵੇਗਾ: ਪਾਣੀ ਦਿਓ, ਨਾਂ ਬਦਲੋ, ਦੂਜੇ ਕਮਰੇ ਵਿੱਚ ਲੈ ਜਾਓ। ਹੋਰ ਦਬਾ ਕੇ ਰੱਖੋ ਜਾਂ ਉਂਗਲ ਖਿੱਚੋ — ਕਾਰਡ ਹਿੱਲਣ ਲੱਗਣਗੇ ਅਤੇ ਤੁਸੀਂ ਉਹਨਾਂ ਦੀ ਤਰਤੀਬ ਬਦਲ ਸਕੋਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się menu: podlej, zmień imię, przenieś do innego pokoju. Przytrzymaj dłużej albo przesuń palcem – karty zaczną się chwiać i możesz je przestawić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece um menu: regar, renomear, mudar de cômodo. Segure mais ou arraste o dedo — os cartões começam a tremer e você pode reorganizá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece um menu: regar, mudar o nome, mudar de divisão. Mantenha mais tempo ou arraste o dedo — os cartões começam a tremer e pode reorganizá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare un meniu: udă, redenumește, mută în altă încăpere. Ține mai mult sau trage cu degetul — cardurile încep să tremure și le poți rearanja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí sa ponuka: poliať, premenovať, presťahovať do inej izby. Podržte dlhšie alebo ťahajte prstom – karty sa rozkývu a môžete ich preusporiadať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojavi se meni: zalij, preimenuj, preseli v drugo sobo. Pridržite dlje ali povlecite s prstom – kartice se začnejo majati in jih lahko preuredite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En meny visas: vattna, byt namn, flytta till ett annat rum. Håll längre eller dra med fingret – korten börjar vicka och du kan flytta runt dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மெனு வரும்: நீர் ஊற்று, பெயர் மாற்று, வேறு அறைக்கு நகர்த்து. இன்னும் பிடித்திருங்கள் அல்லது விரலை இழுங்கள் — அட்டைகள் அசையத் தொடங்கும், அவற்றின் வரிசையை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెనూ వస్తుంది: నీళ్లు పోయండి, పేరు మార్చండి, వేరే గదికి తరలించండి. ఇంకా పట్టుకోండి లేదా వేలిని లాగండి — కార్డులు కదలడం మొదలవుతుంది, మీరు వాటి క్రమాన్ని మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะมีเมนูขึ้นมา: รดน้ำ เปลี่ยนชื่อ ย้ายไปห้องอื่น ถ้ากดค้างนานขึ้นหรือลากนิ้ว การ์ดจะเริ่มสั่นและจัดเรียงใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir menü çıkar: sula, yeniden adlandır, başka odaya taşı. Daha uzun tutun ya da parmağınızı kaydırın; kartlar sallanmaya başlar ve yerlerini değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’явиться меню: полити, перейменувати, перевезти в іншу кімнату. Тримайте довше або ведіть пальцем — картки захитаються, і їх можна переставити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مینو آئے گا: پانی دیں، نام بدلیں، دوسرے کمرے میں لے جائیں۔ مزید دبائے رکھیں یا انگلی کھینچیں — کارڈ ہلنے لگیں گے اور آپ ان کی ترتیب بدل سکیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một menu hiện ra: tưới, đổi tên, chuyển sang phòng khác. Giữ lâu hơn hoặc kéo ngón tay — các thẻ sẽ rung lên và bạn có thể sắp xếp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会出现菜单：浇水、重命名、移到其他房间。按得更久或拖动手指——卡片会晃动起来，就能重新排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會出現選單：澆水、重新命名、移到其他房間。按得更久或拖移手指——卡片會晃動起來，就能重新排列。"
          }
        }
      }
    },
    "Появятся кличка, влажность и срок, а полить можно прямо отсюда.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سترى اللقب والرطوبة والموعد — ويمكنك السقي من هنا مباشرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще видите прякора, влажността и интервала – и можете да полеете направо оттук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাকনাম, আর্দ্রতা আর ব্যবধান দেখা যাবে — আর এখান থেকেই জল দিতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuràs el sobrenom, la humitat i l’interval, i el podràs regar des d’aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidíte přezdívku, vlhkost a interval – a můžete zalít přímo odsud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser kælenavn, fugt og interval – og kan vande lige herfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst Namen, Feuchtigkeit und Intervall – und kannst direkt von hier aus gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα δείτε το παρατσούκλι, την υγρασία και το διάστημα — και μπορείτε να ποτίσετε από εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll see its name, moisture, and interval — and you can water it right here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verás su apodo, su humedad y su intervalo, y podrás regarlo desde aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näet lempinimen, kosteuden ja välin – ja voit kastella suoraan tästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous verrez son surnom, son humidité et sa fréquence — et vous pourrez l’arroser d’ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હુલામણું નામ, ભેજ અને ગાળો દેખાશે — અને અહીંથી જ પાણી આપી શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יופיעו הכינוי, הלחות והתדירות – ואפשר להשקות ישר מכאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपनाम, नमी और अंतराल दिखेगा — और यहीं से पानी दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjet ćete nadimak, vlažnost i interval – a možete i zaliti odavde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Látod a becenevét, a nedvességét és az időközét – és innen meg is öntözheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan melihat nama panggilan, kelembapan, dan jarak siram — dan bisa menyiram langsung dari sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedrai soprannome, umidità e intervallo, e potrai annaffiarlo da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネーム、湿度、間隔が表示され、ここから水やりもできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лақап аты, ылғалы және мерзімі көрінеді, ал суаруды осы жерден жасауға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಡ್ಡಹೆಸರು, ತೇವಾಂಶ ಮತ್ತು ಅಂತರ ಕಾಣುತ್ತದೆ — ಇಲ್ಲಿಂದಲೇ ನೀರು ಹಾಕಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별명, 습도, 간격이 보이고 여기서 바로 물을 줄 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamatysite pravardę, drėgmę ir intervalą – ir galėsite palaistyti tiesiai iš čia."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓമനപ്പേര്, ഈർപ്പം, ഇടവേള എന്നിവ കാണാം — ഇവിടെനിന്നുതന്നെ നനയ്ക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टोपणनाव, ओलावा आणि अंतर दिसेल — आणि इथूनच पाणी देता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan melihat nama panggilan, kelembapan dan selang — dan boleh menyiram terus dari sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser kallenavn, fuktighet og intervall – og kan vanne rett herfra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet bijnaam, vochtigheid en interval – en je kunt meteen hier water geven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡାକନାମ, ଆର୍ଦ୍ରତା ଓ ବ୍ୟବଧାନ ଦେଖାଯିବ — ଏଠାରୁ ହିଁ ପାଣି ଦେଇ ପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਪਨਾਮ, ਨਮੀ ਅਤੇ ਵਕਫ਼ਾ ਦਿਖੇਗਾ — ਅਤੇ ਇੱਥੋਂ ਹੀ ਪਾਣੀ ਦੇ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobaczysz przezwisko, wilgotność i odstęp – i podlejesz ją stąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você verá o apelido, a umidade e o intervalo — e pode regar daqui mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verá a alcunha, a humidade e o intervalo — e pode regar daqui mesmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei vedea porecla, umiditatea și intervalul – și o poți uda chiar de aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidíte prezývku, vlhkosť a interval – a môžete poliať priamo odtiaľto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videli boste vzdevek, vlažnost in interval – zalijete pa lahko kar od tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser smeknamn, fukt och intervall – och kan vattna direkt härifrån."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செல்லப்பெயர், ஈரப்பதம், இடைவெளி தெரியும் — இங்கிருந்தே நீர் ஊற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముద్దుపేరు, తేమ, విరామం కనిపిస్తాయి — ఇక్కడి నుంచే నీళ్లు పోయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะเห็นชื่อเล่น ความชื้น และช่วงรดน้ำ — และรดน้ำได้จากตรงนี้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma adını, nemini ve aralığını görürsünüz — buradan sulayabilirsiniz de."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’являться кличка, вологість і строк, а полити можна просто звідси."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عرفی نام، نمی اور وقفہ نظر آئے گا — اور آپ یہیں سے پانی دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ thấy biệt danh, độ ẩm và khoảng tưới — và có thể tưới ngay tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以看到昵称、湿度和间隔——还能直接在这里浇水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以看到暱稱、濕度和間隔——還能直接在這裡澆水。"
          }
        }
      }
    },
