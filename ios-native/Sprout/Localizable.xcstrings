    "Тридцать дней ни одно растение не пересохло.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثون يومًا دون أن تجف أي نبتة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Трийсет дни нито едно растение не е пресъхнало."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিরিশ দিন কোনো গাছ শুকিয়ে যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenta dies sense que s’assequi cap planta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Třicet dní bez jediné vyschlé rostliny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tredive dage uden at nogen plante er tørret ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreißig Tage lang ist keine Pflanze ausgetrocknet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τριάντα μέρες χωρίς να ξεραθεί κανένα φυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirty days without a single plant drying out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treinta días sin que se seque ninguna planta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolmekymmentä päivää ilman, että yksikään kasvi kuivui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trente jours sans qu’aucune plante ne se dessèche."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ત્રીસ દિવસ સુધી એક પણ છોડ સુકાયો નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלושים יום בלי שאף צמח התייבש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीस दिन तक कोई भी पौधा नहीं सूखा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trideset dana bez ijedne presušene biljke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Harminc napig egyetlen növény sem száradt ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga puluh hari tanpa satu pun tanaman kering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenta giorni senza che nessuna pianta si secchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間、どの植物も乾ききらなかった。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отыз күн бойы бірде-бір өсімдік кеуіп қалмады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂವತ್ತು ದಿನ ಯಾವ ಗಿಡವೂ ಒಣಗಲಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 동안 한 식물도 마르지 않았어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trisdešimt dienų neišdžiūvo nė vienas augalas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുപ്പത് ദിവസം ഒരു ചെടിയും ഉണങ്ങിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तीस दिवस एकही रोप सुकले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga puluh hari tanpa sebarang tumbuhan kering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tretti dager uten at noen plante har tørket ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dertig dagen lang is geen enkele plant uitgedroogd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତିରିଶ ଦିନ କୌଣସି ଗଛ ଶୁଖିନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੀਹ ਦਿਨ ਕੋਈ ਵੀ ਪੌਦਾ ਨਹੀਂ ਸੁੱਕਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzydzieści dni bez żadnej przesuszonej rośliny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta dias sem nenhuma planta secar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta dias sem nenhuma planta secar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Treizeci de zile fără ca vreo plantă să se usuce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tridsať dní bez jedinej vyschnutej rastliny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trideset dni se ni izsušila nobena rastlina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trettio dagar utan att någon växt torkat ut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முப்பது நாள் எந்தச் செடியும் காய்ந்துவிடவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముప్పై రోజులు ఏ మొక్కా ఎండిపోలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามสิบวันที่ไม่มีต้นไม้ต้นไหนแห้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otuz gün boyunca hiçbir bitki kurumadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тридцять днів жодна рослина не пересохла."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیس دن تک کوئی پودا نہیں سوکھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba mươi ngày không cây nào bị khô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三十天内没有一株植物干透。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三十天內沒有一株植物乾透。"
          }
        }
