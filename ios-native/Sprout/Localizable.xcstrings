            "value": "色・茂り具合・高さは写真から。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түстер, жиілік пен бой — суреттен."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಣ್ಣ, ದಟ್ಟತೆ, ಎತ್ತರ — ಫೋಟೋದಿಂದ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색, 무성함, 키는 사진에서 가져와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalvos, tankumas ir aukštis – iš nuotraukos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിറങ്ങൾ, ഇടതൂർച്ച, ഉയരം — ഫോട്ടോയിൽ നിന്ന്."
          }
        },
        "mr": {
          "stringUnit": {
