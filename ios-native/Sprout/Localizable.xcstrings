        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantes plantes i habitacions tens i quants dies fa que cuides el jardí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik máte rostlin a pokojů a kolik dní se staráte o zahradu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter og rum du har, og hvor mange dage du har passet din have."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Pflanzen und Räume du hast und wie viele Tage du dich schon um deinen Garten kümmerst."
