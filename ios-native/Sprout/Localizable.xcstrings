        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonas neatpažino augalo nuotraukoje – įrašykite rūšį patys."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोनने फोटोतील रोप ओळखले नाही — प्रजाती स्वतः लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon tidak mengecam tumbuhan dalam foto — taipkan spesies sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kjente ikke igjen noen plante på bildet – skriv inn arten selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De telefoon herkende geen plant op de foto — vul de soort zelf in."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ୍ ଫଟୋରେ ଗଛ ଚିହ୍ନିପାରିଲା ନାହିଁ — ପ୍ରଜାତି ନିଜେ ଲେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਨੇ ਫ਼ੋਟੋ ਵਿੱਚ ਪੌਦਾ ਨਹੀਂ ਪਛਾਣਿਆ — ਕਿਸਮ ਆਪ ਲਿਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon nie rozpoznał rośliny na zdjęciu — wpisz gatunek sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular não reconheceu nenhuma planta na foto — digite a espécie você mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel não reconheceu nenhuma planta na fotografia — escreva a espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonul n-a recunoscut nicio plantă în fotografie — scrie tu specia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón na fotke nerozpoznal žiadnu rastlinu — zadajte druh sami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon na fotografiji ni prepoznal rastline — vrsto vpišite sami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kände inte igen någon växt på fotot – skriv in arten själv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์จำต้นไม้ในรูปไม่ได้ — โปรดพิมพ์พันธุ์เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon fotoğrafta bitki tanımadı — türü kendiniz yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослину на знімку телефон не впізнав — впишіть вид самі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại không nhận ra cây trong ảnh — hãy tự nhập loài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有在照片中认出植物——请自己填写品种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機沒有在照片中認出植物——請自行填寫品種。"
          }
        }
      }
    },
