    "Сад стоит. Нажмите на растение, чтобы полить его.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven står på plads. Tryk på en plante for at vande den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Garten steht. Tippe auf eine Pflanze, um sie zu gießen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden is in place. Tap a plant to water it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardín está colocado. Toca una planta para regarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarha on paikallaan. Kastele kasvi napauttamalla sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jardin est en place. Touchez une plante pour l’arroser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giardino è posizionato. Tocca una pianta per annaffiarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen står på plass. Trykk på en plante for å vanne den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tuin staat. Tik op een plant om hem water te geven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está no lugar. Toque numa planta para regá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está no lugar. Toque numa planta para a regar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trädgården står på plats. Tryck på en växt för att vattna den."
          }
        }
      }
    },
