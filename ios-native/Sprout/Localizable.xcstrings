        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രണ്ട് വിരലുകൊണ്ട് തിരിക്കുക, പിഞ്ച് ചെയ്ത് വലുപ്പം മാറ്റുക"
