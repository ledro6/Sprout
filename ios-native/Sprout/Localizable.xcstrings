        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átültetés, tápoldat, hol szeret állni…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti pot, pupuk, tempat favoritnya…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinvaso, concime, dove le piace stare…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植え替え、肥料、好きな置き場所…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайта отырғызу, тыңайтқыштар, қайда тұрғанды ұнатады…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분갈이, 비료, 좋아하는 자리…"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Persodinimas, trąšos, kur mėgsta stovėti…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंडी बदल, खत, कुठे ठेवायला आवडते…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar pasu, baja, tempat kegemarannya…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omplanting, gjødsel, hvor den liker å stå …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpotten, voeding, waar hij graag staat…"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟବ ବଦଳ, ସାର, କେଉଁଠି ରହିବାକୁ ଭଲପାଏ…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗਮਲਾ ਬਦਲਣਾ, ਖਾਦ, ਕਿੱਥੇ ਰਹਿਣਾ ਪਸੰਦ ਹੈ…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesadzanie, nawozy, gdzie lubi stać…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca de vaso, adubo, onde gosta de ficar…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudança de vaso, adubo, onde gosta de estar…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplantare, îngrășământ, unde îi place să stea…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presádzanie, hnojivá, kde rada stojí…"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Presajanje, gnojila, kje rada stoji …"
          }
        },
        "sv": {
