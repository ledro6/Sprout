    "Покрутите барабан — ниже видно, как новый срок ляжет на карточку.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر العجلة — ترى في الأسفل كيف سيظهر الموعد الجديد على البطاقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Завъртете колелото – отдолу ще видите как новият интервал ще легне на картата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চাকা ঘোরান — নিচে দেখবেন নতুন ব্যবধান কার্ডে কেমন দেখাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la roda: a sota veuràs com queda el nou interval a la targeta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otočte kolečkem – níže uvidíte, jak se nový interval zobrazí na kartě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej hjulet – nedenfor ser du, hvordan det nye interval lander på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh am Rad – darunter siehst du, wie das neue Intervall auf der Karte aussieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γυρίστε τον τροχό — από κάτω βλέπετε πώς θα εμφανιστεί το νέο διάστημα στην κάρτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin the wheel — below you’ll see how the new interval lands on the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la rueda: debajo verás cómo queda el nuevo intervalo en la tarjeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyöritä rullaa – alla näet, miltä uusi väli näyttää kortilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la molette : en dessous, vous voyez comment la nouvelle fréquence s’affiche sur la carte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચક્ર ફેરવો — નીચે દેખાશે કે નવો ગાળો કાર્ડ પર કેવો દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סובבו את הגלגל – למטה רואים איך התדירות החדשה תופיע על הכרטיס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिया घुमाएँ — नीचे दिखेगा कि नया अंतराल कार्ड पर कैसा दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrenite kotačić – ispod vidite kako novi interval izgleda na kartici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgasd a kereket – lent látod, hogyan kerül az új időköz a kártyára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar roda — di bawahnya terlihat bagaimana jarak siram baru tampil di kartu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la ruota: sotto vedi come il nuovo intervallo apparirà sulla scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールを回すと、新しい間隔がカードにどう表示されるか下に出ます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барабанды айналдырыңыз — төменде жаңа мерзімнің карточкада қалай көрінетіні көрсетіледі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಕ್ರ ತಿರುಗಿಸಿ — ಹೊಸ ಅಂತರ ಕಾರ್ಡ್‌ನಲ್ಲಿ ಹೇಗೆ ಕಾಣುತ್ತದೆ ಎಂದು ಕೆಳಗೆ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠을 돌리면 새 간격이 카드에 어떻게 보일지 아래에 나와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasukite ratuką – žemiau matysite, kaip naujas intervalas atrodys kortelėje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചക്രം തിരിക്കുക — പുതിയ ഇടവേള കാർഡിൽ എങ്ങനെ കാണുമെന്ന് താഴെ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चक्र फिरवा — खाली दिसेल की नवे अंतर कार्डवर कसे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar roda — di bawahnya kelihatan bagaimana selang baharu dipaparkan pada kad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snurr hjulet – under ser du hvordan det nye intervallet havner på kortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan het wiel – eronder zie je hoe het nieuwe interval op de kaart komt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚକ ଘୁରାନ୍ତୁ — ତଳେ ଦେଖାଯିବ ନୂଆ ବ୍ୟବଧାନ କାର୍ଡରେ କିପରି ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹੀਆ ਘੁਮਾਓ — ਹੇਠਾਂ ਦਿਖੇਗਾ ਕਿ ਨਵਾਂ ਵਕਫ਼ਾ ਕਾਰਡ 'ਤੇ ਕਿਵੇਂ ਦਿਖੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokręć bębnem – poniżej widać, jak nowy odstęp wyląduje na karcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a roda — abaixo você vê como o novo intervalo fica no cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode a roda — em baixo vê como o novo intervalo fica no cartão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotește roata – dedesubt vezi cum se așază noul interval pe fișă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otočte kolieskom – nižšie uvidíte, ako sa nový interval zobrazí na karte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavrtite kolo – spodaj vidite, kako se nov interval prikaže na kartici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snurra hjulet – nedanför ser du hur det nya intervallet hamnar på kortet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சக்கரத்தைச் சுழற்றுங்கள் — புதிய இடைவெளி அட்டையில் எப்படித் தெரியும் என்று கீழே காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చక్రం తిప్పండి — కొత్త విరామం కార్డుపై ఎలా కనిపిస్తుందో కింద కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมุนวงล้อ — ด้านล่างจะเห็นว่าช่วงรดน้ำใหม่แสดงบนการ์ดอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çarkı çevirin — aşağıda yeni aralığın karta nasıl yansıdığını görürsünüz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрутіть барабан — нижче видно, як новий строк ляже на картку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہیہ گھمائیں — نیچے نظر آئے گا کہ نیا وقفہ کارڈ پر کیسا لگے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay bánh xe — bên dưới sẽ thấy khoảng tưới mới hiện trên thẻ ra sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动滚轮——下方能看到新的间隔在卡片上会怎样显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉動滾輪——下方能看到新的間隔在卡片上會如何顯示。"
          }
        }
      }
    },
    "Поле поиска — внизу, у панели вкладок. Ищет по кличке, виду и заметкам.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقل البحث في الأسفل بجوار شريط علامات التبويب. يبحث في الألقاب والأنواع والملاحظات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Полето за търсене е долу, до лентата с раздели. Търси по прякор, вид и бележки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোঁজার ঘর নিচে, ট্যাব বারের পাশে। ডাকনাম, প্রজাতি আর নোটে খোঁজে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El camp de cerca és a baix, al costat de la barra de pestanyes. Cerca per sobrenom, espècie i notes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole hledání je dole u panelu karet. Hledá podle přezdívky, druhu a poznámek."
