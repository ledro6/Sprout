    "Самые сухие растения и кнопка «Полить».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النباتات الأكثر جفافًا وزر «اسقِ»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-сухите растения и бутон „Полей“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে শুকনো গাছ ও “জল দিন” বোতাম।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes més seques i un botó «Rega»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsušší rostliny a tlačítko „Zalít“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tørreste planter og en ”Vand”-knap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die trockensten Pflanzen und eine „Gießen“-Taste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πιο ξερά φυτά και ένα κουμπί «Πότισμα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The driest plants and a “Water” button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas más secas y un botón “Regar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuivimmat kasvit ja Kastele-painike."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes les plus sèches et un bouton « Arroser »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી સૂકા છોડ અને “પાણી આપો” બટન."
          }
        },
        "he": {
