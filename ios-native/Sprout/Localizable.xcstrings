        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресаждане, торове, къде обича да стои…"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasplantament, adob, on li agrada estar…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesazování, hnojiva, kde ráda stojí…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omplantning, gødning, hvor den kan lide at stå …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umtopfen, Dünger, wo sie gern steht …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφύτευση, λίπασμα, πού του αρέσει να στέκεται…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repotting, fertilizer, where it likes to stand…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasplante, abono, dónde le gusta estar…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruukun vaihto, lannoitus, missä se viihtyy…"
          }
