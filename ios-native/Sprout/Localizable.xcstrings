        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍‌ରେ ଅଛି — AR ତୁରନ୍ତ ଖୋଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਵਿੱਚ ਹੀ ਹੈ — AR ਤੁਰੰਤ ਖੁੱਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest w aplikacji – AR otwiera się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já vem no app: a RA abre na hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já vem na app: a RA abre de imediato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E deja în aplicație – RA se deschide imediat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je v aplikácii – AR sa otvorí hneď."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že v aplikaciji – AR se odpre takoj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns i appen – AR öppnas direkt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பிலேயே உள்ளது — AR உடனே திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లోనే ఉంది — AR వెంటనే తెరుచుకుంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอยู่ในแอป — AR เปิดได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada hazır — AR hemen açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежить у застосунку — AR відкривається одразу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں ہی موجود — AR فوراً کھلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sẵn trong ứng dụng — AR mở ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置在应用中——AR 立即打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建在 App 中——AR 立即開啟。"
          }
        }
