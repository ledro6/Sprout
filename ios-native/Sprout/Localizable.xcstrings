    "В этой комнате пока ничего не растёт. Посадите сюда растение во вкладке «Добавить» или перевезите из другой комнаты.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vokser endnu intet i dette rum. Plant noget på fanen ”Tilføj”, eller flyt en plante hertil fra et andet rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Raum wächst noch nichts. Setz hier im Tab „Hinzufügen“ etwas ein oder hol eine Pflanze aus einem anderen Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is growing in this room yet. Plant something in the “Add” tab or move a plant here from another room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no crece nada en esta habitación. Planta algo en la pestaña “Añadir” o trae una planta de otra habitación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä huoneessa ei vielä kasva mitään. Istuta jotain välilehdellä ”Lisää” tai siirrä kasvi toisesta huoneesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne pousse encore dans cette pièce. Plantez-y quelque chose dans l’onglet « Ajouter » ou déplacez une plante depuis une autre pièce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa stanza non cresce ancora niente. Pianta qualcosa nella scheda “Aggiungi” o sposta qui una pianta da un’altra stanza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting vokser i dette rommet ennå. Plant noe i fanen «Legg til», eller flytt hit en plante fra et annet rom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er groeit nog niets in deze kamer. Plant hier iets in het tabblad ‘Voeg toe’ of verhuis een plant uit een andere kamer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada crescendo neste cômodo. Plante algo na aba “Adicionar” ou traga uma planta de outro cômodo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não cresce nada nesta divisão. Plante algo no separador “Adicionar” ou traga uma planta de outra divisão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget växer i det här rummet än. Plantera något på fliken ”Lägg till” eller flytta hit en växt från ett annat rum."
          }
        }
      }
    },
