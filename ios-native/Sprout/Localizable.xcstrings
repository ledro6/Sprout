    },
    "Растения на снимке телефон не узнал — впишите вид сами.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتعرف الهاتف على نبتة في الصورة — اكتب النوع بنفسك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът не разпозна растение на снимката — впишете вида сами."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন ছবিতে কোনো গাছ চিনতে পারেনি — প্রজাতি নিজে লিখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El telèfon no ha reconegut cap planta a la foto: escriu tu l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon na fotce nerozpoznal žádnou rostlinu — zadejte druh sami."
          }
