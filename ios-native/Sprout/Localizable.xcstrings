            "value": "Zatiaľ žiadne polievanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalivanj še ni bilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga vattningar än."
          }
        },
        "ta": {
