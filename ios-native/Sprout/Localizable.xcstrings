                  "value": "Раз на %lld місяця"
                }
              }
            }
          }
        },
        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ہر %lld مہینے بعد"
