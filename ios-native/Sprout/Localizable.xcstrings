          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotón nem látszik növény — a faj kész modelljét használom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella foto non si vede nessuna pianta: userò il modello pronto della specie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретте өсімдік көрінбейді — түрдің дайын моделін аламын."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukoje nesimato augalo – naudosiu paruoštą rūšies modelį."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plante synes på bildet – jeg bruker artens ferdige modell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
