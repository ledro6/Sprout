    "Придумайте имя. По виду подставится обычный срок полива.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمًا. ومن النوع يُملأ موعد السقي المعتاد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измислете име. По вида ще се попълни обичайният интервал на поливане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটা নাম ভাবুন। প্রজাতি থেকে সাধারণ ব্যবধান বসে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventa un nom. Amb l’espècie s’omple l’interval de reg habitual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymyslete jméno. Podle druhu se doplní obvyklý interval zalévání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find på et navn. Ud fra arten udfyldes det sædvanlige vandingsinterval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk dir einen Namen aus. Über die Art wird das übliche Gießintervall eingesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκεφτείτε ένα όνομα. Από το είδος συμπληρώνεται το συνηθισμένο διάστημα ποτίσματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come up with a name. The usual watering interval fills in from the species."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventa un nombre. Con la especie se rellena el intervalo de riego habitual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keksi nimi. Lajin perusteella täytetään tavallinen kasteluväli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un nom. La fréquence d’arrosage habituelle se remplit d’après l’espèce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ નામ વિચારો. જાત પરથી સામાન્ય ગાળો ભરાઈ જશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המציאו שם. לפי הסוג תמולא תדירות ההשקיה הרגילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई नाम सोचें। प्रजाति से सामान्य अंतराल भर जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smislite ime. Prema vrsti upisat će se uobičajeni interval zalijevanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Találj ki egy nevet. A faj alapján kitöltődik a szokásos öntözési időköz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat nama. Dari spesies, jarak siram yang biasa akan terisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventa un nome. Dalla specie viene preso l’intervallo di annaffiatura abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を考えましょう。種類からふつうの水やり間隔が入ります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ат ойлап табыңыз. Түріне қарай әдеттегі суару мерзімі қойылады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಹೆಸರು ಯೋಚಿಸಿ. ಜಾತಿಯಿಂದ ಸಾಮಾನ್ಯ ಅಂತರ ತುಂಬುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 지어 주세요. 종류에 따라 보통 물주기 간격이 채워집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugalvokite vardą. Pagal rūšį įrašomas įprastas laistymo intervalas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പേര് ആലോചിക്കൂ. ഇനം അനുസരിച്ച് സാധാരണ ഇടവേള നിറയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे नाव सुचवा. जातीवरून नेहमीचे अंतर भरले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Reka satu nama. Daripada spesies, selang siraman biasa akan diisi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn på et navn. Ut fra arten fylles det vanlige vanningsintervallet inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzin een naam. Via de soort wordt het gebruikelijke gietinterval ingevuld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ନାମ ଭାବନ୍ତୁ। ପ୍ରଜାତିରୁ ସାଧାରଣ ବ୍ୟବଧାନ ପୂରଣ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਨਾਂ ਸੋਚੋ। ਕਿਸਮ ਤੋਂ ਆਮ ਵਕਫ਼ਾ ਭਰ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymyśl imię. Na podstawie gatunku wstawi się zwykły odstęp podlewania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Invente um nome. Pela espécie entra o intervalo de rega usual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Invente um nome. Pela espécie é preenchido o intervalo de rega habitual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventează un nume. După specie se completează intervalul de udare obișnuit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymyslite meno. Podľa druhu sa doplní zvyčajný interval polievania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmislite si ime. Po vrsti se vpiše običajni interval zalivanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta på ett namn. Utifrån arten fylls det vanliga vattningsintervallet i."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பெயரை யோசியுங்கள். இனத்தைப் பொறுத்து வழக்கமான இடைவெளி நிரப்பப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక పేరు ఆలోచించండి. జాతిని బట్టి సాధారణ విరామం నింపబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อ ช่วงรดน้ำตามปกติจะถูกกรอกตามชนิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ad bulun. Türe göre olağan sulama aralığı doldurulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Придумайте ім’я. За видом підставиться звичайний строк поливу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی نام سوچیں۔ قسم کے مطابق معمول کا وقفہ بھر دیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghĩ ra một cái tên. Theo loài, khoảng tưới thông thường sẽ được điền sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起个名字吧。会按品种填入常规的浇水间隔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取個名字吧。會依品種填入一般的澆水間隔。"
          }
        }
      }
    },
