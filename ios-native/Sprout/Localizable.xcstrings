          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પાસે કેટલા છોડ અને ઓરડા છે, અને કેટલા દિવસથી તમે બગીચાની સંભાળ લો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה צמחים וחדרים יש לכם וכמה ימים אתם מטפלים בגינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास कितने पौधे और कमरे हैं, और कितने दिन से आप बगीचे की देखभाल कर रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko imate biljaka i soba te koliko dana brinete o vrtu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány növényed és szobád van, és hány napja gondozod a kertet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tanaman dan ruangan yang Anda punya, dan sudah berapa hari Anda merawat kebun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante piante e stanze hai e da quanti giorni ti prendi cura del giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物と部屋の数、そして庭のお世話を何日続けているか。"
