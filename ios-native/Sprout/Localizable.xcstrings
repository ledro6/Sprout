    "Исчезнут все растения и весь журнал поливов. Вернуть их будет нельзя.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planter og hele vandingsloggen forsvinder. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pflanzen und das ganze Gießprotokoll verschwinden. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All plants and the whole watering log will disappear. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparecerán todas las plantas y todo el registro de riegos. No se podrá deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kasvit ja koko kastelupäiväkirja katoavat. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les plantes et tout le journal d’arrosage disparaîtront. Impossible de revenir en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spariranno tutte le piante e tutto il registro delle annaffiature. Non si potrà annullare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planter og hele vanningsloggen forsvinner. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planten en het hele waterlogboek verdwijnen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas e todo o histórico de regas vão sumir. Não será possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas e todo o registo de regas vão desaparecer. Não será possível anular."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla växter och hela vattningsloggen försvinner. Det går inte att ångra."
          }
        }
      }
    },
    "Их включают в настройках телефона: Sprout → Уведомления.": {
