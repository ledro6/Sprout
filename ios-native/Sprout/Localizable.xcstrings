            "value": "Resten klarer seg selv: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rest redt zich zelf: %@."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାକିମାନେ ନିଜେ ସମ୍ଭାଳିନେବେ: %@।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਆਪ ਸੰਭਾਲ ਲੈਣਗੇ: %@।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reszta poradzi sobie sama: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras aguentam sozinhas: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras aguentam sozinhas: %@."
          }
        },
        "ro": {
