    "Чем выше ступень, тем чаще лейка.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما علت الدرجة، زاد مرور المرشّة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колкото по-високо стъпалото, толкова по-често е идвала лейката."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধাপ যত উঁচু, ঝারি তত বেশি এসেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com més alt l’esglaó, més sovint hi ha passat la regadora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím vyšší stupeň, tím častěji přišla konev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo højere trin, jo oftere kom vandkanden forbi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je höher die Stufe, desto öfter kam die Gießkanne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο πιο ψηλό το σκαλί, τόσο πιο συχνά πέρασε το ποτιστήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The higher the step, the more often the watering can came by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más alto el escalón, más veces pasó la regadera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä korkeampi porras, sitä useammin kastelukannu kävi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus la marche est haute, plus l’arrosoir est passé souvent."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગથિયું જેટલું ઊંચું, ઝારી એટલી વાર આવી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שהמדרגה גבוהה יותר, המזלף הגיע לעיתים קרובות יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीढ़ी जितनी ऊँची, झारी उतनी बार आई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što je stepenica viša, to je kantica češće dolazila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minél magasabb a lépcső, annál gyakrabban jött a locsolókanna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin tinggi anak tangganya, makin sering penyiram datang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto è il gradino, più spesso è passato l’annaffiatoio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段が高いほど、じょうろがよく通いました。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саты неғұрлым биік болса, суарғыш соғұрлым жиі келді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟ್ಟಿಲು ಎತ್ತರವಾದಷ್ಟೂ ನೀರಿನ ಕ್ಯಾನ್ ಹೆಚ್ಚು ಬಾರಿ ಬಂತು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계단이 높을수록 물뿌리개가 자주 찾아왔어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuo aukštesnė pakopa, tuo dažniau ateidavo laistytuvas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പടി എത്ര ഉയർന്നതോ, അത്ര കൂടുതൽ തവണ നനയ്ക്കാനുള്ള പാത്രം വന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पायरी जितकी उंच, तितक्या वेळा झारी आली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tinggi anak tangga, lebih kerap penyiram datang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo høyere trinn, jo oftere kom vannkanna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe hoger de trede, hoe vaker de gieter langskwam."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାହାଚ ଯେତେ ଉଚ୍ଚ, ଝାରି ସେତେ ଥର ଆସିଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌੜੀ ਜਿੰਨੀ ਉੱਚੀ, ਫੁਹਾਰਾ ਓਨੀ ਵਾਰ ਆਇਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im wyższy stopień, tym częściej przychodziła konewka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais alto o degrau, mais vezes o regador passou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais alto o degrau, mais vezes passou o regador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu cât treapta e mai înaltă, cu atât stropitoarea a trecut mai des."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím vyšší stupeň, tým častejšie prišla krhla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Višja ko je stopnica, pogosteje je prišla zalivalka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju högre steg, desto oftare kom vattenkannan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படி எவ்வளவு உயரமோ, அவ்வளவு முறை பூவாளி வந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెట్టు ఎంత ఎత్తైతే, నీళ్ల డబ్బా అంత ఎక్కువ సార్లు వచ్చింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นยิ่งสูง บัวรดน้ำก็ยิ่งแวะบ่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basamak ne kadar yüksekse, sulama kabı o kadar sık uğradı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що вища сходинка, то частіше приходила лійка."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیڑھی جتنی اونچی، فوارہ اتنی بار آیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bậc càng cao, bình tưới càng hay ghé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "台阶越高，水壶来得越勤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階梯越高，澆水壺來得越勤。"
          }
        }
      }
    },
    "Чем суше земля, тем ярче тень: оранжевая — скоро поливать, красная — пора.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما جفّت التربة اشتد التوهج: البرتقالي — اسقِ قريبًا، والأحمر — اسقِ الآن."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колкото по-суха е почвата, толкова по-ярко е сиянието: оранжево – полейте скоро, червено – полейте сега."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাটি যত শুকনো, আভা তত উজ্জ্বল: কমলা — শিগগির জল দিন, লাল — এখনই জল দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com més seca la terra, més intensa la resplendor: taronja, rega aviat; vermella, rega ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím sušší hlína, tím jasnější záře: oranžová – zalít brzy, červená – zalít hned."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo tørrere jord, jo stærkere skær: orange – vand snart, rødt – vand nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je trockener die Erde, desto heller das Leuchten: orange – bald gießen, rot – jetzt gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο πιο ξερό το χώμα, τόσο πιο έντονη η λάμψη: πορτοκαλί — ποτίστε σύντομα, κόκκινη — ποτίστε τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drier the soil, the brighter the glow: orange means water soon, red means water now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más seca la tierra, más intenso el brillo: naranja, riega pronto; rojo, riega ya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä kuivempi multa, sitä kirkkaampi hehku: oranssi – kastele pian, punainen – kastele nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus la terre est sèche, plus le halo est vif : orange, bientôt ; rouge, maintenant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માટી જેટલી સૂકી, ચમક એટલી તેજ: નારંગી — જલદી પાણી આપો, લાલ — હમણાં પાણી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שהאדמה יבשה יותר, הזוהר חזק יותר: כתום – להשקות בקרוב, אדום – להשקות עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिट्टी जितनी सूखी, चमक उतनी तेज़: नारंगी — जल्द पानी दें, लाल — अभी पानी दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što je zemlja suša, sjaj je jači: narančasti – zalijte uskoro, crveni – zalijte odmah."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minél szárazabb a föld, annál erősebb a ragyogás: narancssárga – öntözz hamarosan, piros – öntözz most."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin kering tanahnya, makin terang cahayanya: oranye — siram sebentar lagi, merah — siram sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più la terra è secca, più l’alone è intenso: arancione, annaffia presto; rosso, annaffia ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "土が乾くほど光が強くなります：オレンジはそろそろ、赤はいますぐ水やり。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топырақ неғұрлым құрғақ болса, жарық соғұрлым ашық: қызғылт сары — жақында суару, қызыл — қазір суару."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣ್ಣು ಎಷ್ಟು ಒಣಗಿದೆಯೋ ಹೊಳಪು ಅಷ್ಟು ಪ್ರಖರ: ಕಿತ್ತಳೆ — ಬೇಗ ನೀರು ಹಾಕಿ, ಕೆಂಪು — ಈಗಲೇ ನೀರು ಹಾಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙이 마를수록 빛이 강해져요: 주황색은 곧, 빨간색은 지금 물을 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuo sausesnė žemė, tuo ryškesnis švytėjimas: oranžinis – netrukus laistyti, raudonas – laistyti dabar."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മണ്ണ് എത്ര ഉണങ്ങുന്നോ തിളക്കം അത്രയും ശക്തം: ഓറഞ്ച് — ഉടൻ നനയ്ക്കുക, ചുവപ്പ് — ഇപ്പോൾ നനയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माती जितकी कोरडी, चमक तितकी तेज: नारिंगी — लवकरच पाणी द्या, लाल — आत्ताच पाणी द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makin kering tanah, makin terang cahayanya: jingga — siram tidak lama lagi, merah — siram sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo tørrere jord, desto sterkere glød: oransje – vann snart, rød – vann nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe droger de aarde, hoe feller de gloed: oranje – binnenkort gieten, rood – nu gieten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାଟି ଯେତେ ଶୁଖିଲା, ଝଲକ ସେତେ ଉଜ୍ଜ୍ୱଳ: କମଳା — ଶୀଘ୍ର ପାଣି ଦିଅନ୍ତୁ, ନାଲି — ଏବେ ପାଣି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿੱਟੀ ਜਿੰਨੀ ਸੁੱਕੀ, ਚਮਕ ਓਨੀ ਤੇਜ਼: ਸੰਤਰੀ — ਛੇਤੀ ਪਾਣੀ ਦਿਓ, ਲਾਲ — ਹੁਣੇ ਪਾਣੀ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im suchsza ziemia, tym jaśniejsza poświata: pomarańczowa – podlej wkrótce, czerwona – podlej teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais seca a terra, mais forte o brilho: laranja, regue logo; vermelho, regue agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais seca a terra, mais forte o brilho: laranja, regue em breve; vermelho, regue já."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu cât pământul e mai uscat, cu atât strălucirea e mai puternică: portocaliu – udă curând, roșu – udă acum."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím suchšia zem, tým jasnejšia žiara: oranžová – poliať čoskoro, červená – poliať hneď."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolj ko je zemlja suha, močnejši je sij: oranžen – zalijte kmalu, rdeč – zalijte zdaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju torrare jord, desto starkare sken: orange – vattna snart, rött – vattna nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மண் எவ்வளவு காய்ந்ததோ ஒளிர்வு அவ்வளவு பிரகாசம்: ஆரஞ்சு — விரைவில் ஊற்றுங்கள், சிவப்பு — இப்போதே ஊற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మట్టి ఎంత ఎండితే మెరుపు అంత తీవ్రం: నారింజ — త్వరలో పోయండి, ఎరుపు — ఇప్పుడే పోయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดินยิ่งแห้ง แสงยิ่งจ้า: สีส้ม — ใกล้ถึงเวลารด สีแดง — รดตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprak ne kadar kuruysa ışıltı o kadar parlak: turuncu — yakında sula, kırmızı — şimdi sula."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що сухіша земля, то яскравіша тінь: помаранчева — скоро поливати, червона — пора."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مٹی جتنی خشک، چمک اتنی تیز: نارنجی — جلد پانی دیں، سرخ — ابھی پانی دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đất càng khô, viền sáng càng rực: màu cam — sắp phải tưới, màu đỏ — tưới ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土越干，光晕越亮：橙色——该准备浇水了，红色——现在就浇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "土越乾，光暈越亮：橘色——該準備澆水了，紅色——現在就澆。"
          }
        }
      }
    },
