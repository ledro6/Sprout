            "value": "מוצגים %1$lld מתוך %2$lld: יותר מזה כבד לטלפון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld में से %1$lld दिखाए गए: इससे ज़्यादा फ़ोन पर भारी पड़ेगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazano %1$lld od %2$lld: više bi bilo preteško za telefon"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld látható: több túl nehéz lenne a telefonnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan %1$lld dari %2$lld: lebih banyak akan terlalu berat untuk ponsel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld di %2$lld visualizzate: di più sarebbe troppo per il telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld件中%1$lld件を表示：これ以上は端末の負荷が大きすぎます"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld көрсетілген: одан көбі телефонға ауыр"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ರಲ್ಲಿ %1$lld ತೋರಿಸಲಾಗಿದೆ: ಹೆಚ್ಚಾದರೆ ಫೋನ್‌ಗೆ ಭಾರ"
          }
        },
        "ko": {
          "stringUnit": {
