          "stringUnit": {
            "state": "translated",
            "value": "Klepnite a záhrada sa objaví okolo zameriavača"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite in vrt se bo pojavil okoli merka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck så dyker trädgården upp runt siktet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தட்டினால் இலக்குக்குறியைச் சுற்றி தோட்டம் தோன்றும்"
          }
        },
        "te": {
