    "Растения в неё можно будет посадить или перевезти.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيمكنك الزراعة فيها أو نقل النباتات إليها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В нея ще може да засаждате или да местите растения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে গাছ লাগানো বা আনা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi podràs plantar o portar-hi plantes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete do ní moct sázet nebo stěhovat rostliny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Pflanzen hineinsetzen oder dorthin umziehen lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα μπορείτε να φυτεύετε σε αυτό ή να μεταφέρετε φυτά εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be able to plant in it or move plants there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás plantar en ella o traer plantas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit istuttaa siihen tai siirtää sinne kasveja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez y planter ou y déplacer des plantes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેમાં છોડ વાવી કે લાવી શકાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר יהיה לשתול בו או להעביר אליו צמחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें पौधे लगा सकेंगे या ला सकेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moći ćete u nju saditi ili premještati biljke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ültethetsz bele, vagy növényeket költöztethetsz ide."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menanam atau memindahkan tanaman ke sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai piantarci o spostarci piante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この部屋に植えたり、植物を移したりできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған өсімдік отырғызуға немесе көшіруге болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದರಲ್ಲಿ ಗಿಡ ನೆಡಬಹುದು ಅಥವಾ ತರಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방에 식물을 심거나 옮길 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jame galėsite sodinti arba perkelti į jį augalus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിൽ ചെടികൾ നടാനോ കൊണ്ടുവരാനോ കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यात रोपे लावता किंवा आणता येतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menanam atau memindahkan tumbuhan ke sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt er planten in zetten of naartoe verhuizen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଥିରେ ଗଛ ଲଗାଇ କିମ୍ବା ଆଣି ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਿੱਚ ਪੌਦੇ ਲਗਾਏ ਜਾਂ ਲਿਆਂਦੇ ਜਾ ਸਕਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będzie można w nim sadzić albo przenosić do niego rośliny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você poderá plantar nele ou mudar plantas para lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poderá plantar nela ou mudar plantas para lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei putea planta în ea sau muta plante acolo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete do nej môcť sadiť alebo sťahovať rastliny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanjo boste lahko sadili ali preselili rastline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plantera i det eller flytta växter dit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதில் செடிகளை நடலாம் அல்லது கொண்டு வரலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇందులో మొక్కలు నాటవచ్చు లేదా తీసుకురావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะปลูกในห้องนี้หรือย้ายต้นไม้มาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçine bitki dikebilir ya da oraya bitki taşıyabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У неї можна буде посадити або перевезти рослини."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس میں پودے لگائے یا لائے جا سکیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể trồng hoặc chuyển cây vào phòng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在里面种植物，或把植物搬进去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在裡面種植物，或把植物搬進去。"
          }
        }
      }
    },
    "Растения дождутся меня сами — поливать никого не нужно. Спасибо!": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتدبر النباتات أمرها من دوني — لا حاجة للسقي. شكرًا!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растенията ще издържат без мен — няма нужда от поливане. Благодаря!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছগুলো আমাকে ছাড়াই ঠিক থাকবে — জল দিতে হবে না। ধন্যবাদ!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes aguantaran sense mi: no cal regar. Gràcies!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostliny to beze mě zvládnou — zalévat není potřeba. Díky!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planterne klarer sig uden mig – ingen skal vandes. Tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen kommen ohne mich aus — gießen ist nicht nötig. Danke!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα φυτά θα τα βγάλουν πέρα χωρίς εμένα — δεν χρειάζεται πότισμα. Ευχαριστώ!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plants will be fine without me — no watering needed. Thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas aguantarán sin mí: no hace falta regar. ¡Gracias!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvit pärjäävät ilman minua – kastelua ei tarvita. Kiitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes tiendront sans moi — pas besoin d’arroser. Merci !"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડ મારા વિના સંભાળી લેશે — પાણી આપવાની જરૂર નથી. આભાર!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמחים יסתדרו בלעדיי — אין צורך להשקות. תודה!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधे मेरे बिना संभल जाएँगे — पानी देने की ज़रूरत नहीं। धन्यवाद!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljke će izdržati bez mene — ne treba ih zalijevati. Hvala!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növények kibírják nélkülem — nem kell öntözni. Köszönöm!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman-tanaman akan baik-baik saja tanpaku — tidak perlu disiram. Terima kasih!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante resisteranno senza di me: non serve annaffiare. Grazie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物は私がいなくても大丈夫です — 水やりは不要です。ありがとう！"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдіктер менсіз де шыдайды — суарудың қажеті жоқ. Рақмет!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡಗಳು ನಾನಿಲ್ಲದೆಯೂ ಚೆನ್ನಾಗಿರುತ್ತವೆ — ನೀರು ಹಾಕುವ ಅಗತ್ಯವಿಲ್ಲ. ಧನ್ಯವಾದಗಳು!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물들은 저 없이도 괜찮아요 — 물을 줄 필요가 없어요. 고마워요!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalai išsivers be manęs – laistyti nereikia. Ačiū!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെടികൾ ഞാനില്ലാതെയും നന്നായിരിക്കും — നനയ്ക്കേണ്ട ആവശ്യമില്ല. നന്ദി!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोपे माझ्याशिवाय ठीक राहतील — पाणी घालायची गरज नाही. धन्यवाद!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbuhan akan okey tanpa saya — tidak perlu disiram. Terima kasih!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantene klarer seg uten meg – ingen trenger vann. Takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planten redden zich zonder mij — water geven is niet nodig. Bedankt!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗଛଗୁଡ଼ିକ ମୋ ବିନା ଠିକ୍ ରହିବେ — ପାଣି ଦେବା ଦରକାର ନାହିଁ। ଧନ୍ୟବାଦ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌਦੇ ਮੇਰੇ ਬਿਨਾਂ ਠੀਕ ਰਹਿਣਗੇ — ਪਾਣੀ ਦੇਣ ਦੀ ਲੋੜ ਨਹੀਂ। ਧੰਨਵਾਦ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośliny poradzą sobie beze mnie — nie trzeba ich podlewać. Dziękuję!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas vão aguentar sem mim — não precisa regar. Obrigado!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas aguentam sem mim — não é preciso regar. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantele se descurcă fără mine — nu trebuie udate. Mulțumesc!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastliny to bezo mňa zvládnu — netreba polievať. Ďakujem!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastline bodo zdržale brez mene — zalivanje ni potrebno. Hvala!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växterna klarar sig utan mig – ingen behöver vattnas. Tack!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செடிகள் நான் இல்லாமலும் நன்றாக இருக்கும் — தண்ணீர் ஊற்றத் தேவையில்லை. நன்றி!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్కలు నేను లేకుండానే బాగుంటాయి — నీళ్లు పోయాల్సిన అవసరం లేదు. ధన్యవాదాలు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นไม้อยู่ได้โดยไม่มีฉัน — ไม่ต้องรดน้ำ ขอบคุณนะ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiler bensiz idare eder — sulamaya gerek yok. Teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини дочекаються мене самі — поливати нікого не треба. Дякую!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پودے میرے بغیر ٹھیک رہیں گے — پانی دینے کی ضرورت نہیں۔ شکریہ!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cây sẽ ổn khi không có mình — không cần tưới. Cảm ơn nhé!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物们没有我也没问题——不需要浇水。谢谢！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "植物們沒有我也沒問題——不需要澆水。謝謝！"
          }
        }
      }
    },
    "Растения кружат по орбитам полива. Послушайте, как звучит месяц.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النبتات تدور في مدارات السقي. استمع كيف يبدو صوت شهر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растенията обикалят по орбитите си на поливане. Чуйте как звучи един месец."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছেরা জলের কক্ষপথে ঘোরে। শুনুন একটা মাস কেমন শোনায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes giren per les seves òrbites de reg. Escolta com sona un mes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostliny krouží po drahách zalévání. Poslechněte si, jak zní měsíc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planterne kredser i deres vandingsbaner. Hør, hvordan en måned lyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen kreisen auf ihren Gießbahnen. Hör dir an, wie ein Monat klingt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα φυτά περιφέρονται στις τροχιές ποτίσματός τους. Ακούστε πώς ηχεί ένας μήνας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plants circle along their watering orbits. Hear what a month sounds like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas giran en sus órbitas de riego. Escucha cómo suena un mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvit kiertävät kasteluratojaan. Kuuntele, miltä kuukausi kuulostaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes tournent sur leurs orbites d’arrosage. Écoutez à quoi ressemble un mois."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડ પોતાની પાણીની ભ્રમણકક્ષામાં ફરે છે. સાંભળો, એક મહિનો કેવો લાગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמחים חגים במסלולי ההשקיה שלהם. האזינו איך נשמע חודש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधे अपनी पानी की कक्षाओं में घूमते हैं। सुनिए, एक महीना कैसा सुनाई देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljke kruže svojim putanjama zalijevanja. Poslušajte kako zvuči mjesec."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növények az öntözési pályáikon keringenek. Hallgasd meg, hogyan szól egy hónap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman beredar di orbit siramnya. Dengarkan bagaimana bunyi sebulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante girano sulle loro orbite di annaffiatura. Ascolta come suona un mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物が水やりの軌道を回ります。1か月の音を聴いてみましょう。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдіктер суару орбиталарымен айналады. Бір айдың қалай естілетінін тыңдаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡಗಳು ನೀರಿನ ಕಕ್ಷೆಗಳಲ್ಲಿ ಸುತ್ತುತ್ತವೆ. ಒಂದು ತಿಂಗಳು ಹೇಗೆ ಕೇಳಿಸುತ್ತದೆ ಆಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 물주기 궤도를 돌아요. 한 달이 어떤 소리인지 들어 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalai sukasi laistymo orbitomis. Paklausykite, kaip skamba mėnuo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെടികൾ നനയ്ക്കൽ ഭ്രമണപഥങ്ങളിൽ ചുറ്റുന്നു. ഒരു മാസം എങ്ങനെ മുഴങ്ങുന്നുവെന്ന് കേൾക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोपे आपापल्या पाण्याच्या कक्षांत फिरतात. ऐका, एक महिना कसा वाटतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbuhan beredar di orbit siramannya. Dengar bagaimana bunyi sebulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantene sirkler i vanningsbanene sine. Hør hvordan en måned låter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planten draaien in hun gietbanen. Luister hoe een maand klinkt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗଛମାନେ ପାଣିର କକ୍ଷପଥରେ ଘୂରନ୍ତି। ଶୁଣନ୍ତୁ, ଗୋଟିଏ ମାସ କିପରି ଶୁଣାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌਦੇ ਆਪਣੇ ਪਾਣੀ ਦੇ ਪੰਧਾਂ 'ਤੇ ਘੁੰਮਦੇ ਹਨ। ਸੁਣੋ, ਇੱਕ ਮਹੀਨਾ ਕਿਹੋ ਜਿਹਾ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośliny krążą po orbitach podlewania. Posłuchaj, jak brzmi miesiąc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas giram em suas órbitas de rega. Ouça como soa um mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas giram nas suas órbitas de rega. Ouça como soa um mês."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantele se rotesc pe orbitele de udare. Ascultă cum sună o lună."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastliny krúžia po dráhach polievania. Vypočujte si, ako znie mesiac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastline krožijo po svojih tirnicah zalivanja. Poslušajte, kako zveni mesec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växterna kretsar i sina vattningsbanor. Hör hur en månad låter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செடிகள் தங்கள் நீர் சுற்றுப்பாதைகளில் சுழல்கின்றன. ஒரு மாதம் எப்படி ஒலிக்கிறது என்று கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్కలు తమ నీటి కక్ష్యల్లో తిరుగుతాయి. ఒక నెల ఎలా వినిపిస్తుందో వినండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นไม้โคจรไปตามวงโคจรการรดน้ำ ฟังดูว่าหนึ่งเดือนมีเสียงอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiler sulama yörüngelerinde döner. Bir ayın nasıl duyulduğunu dinleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини кружляють орбітами поливу. Послухайте, як звучить місяць."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پودے اپنے پانی کے مداروں پر گھومتے ہیں۔ سنیں ایک مہینہ کیسا لگتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cây cối xoay quanh quỹ đạo tưới của mình. Hãy nghe một tháng vang lên thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物沿着浇水轨道运转。听听一个月是什么声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "植物沿著澆水軌道運行。聽聽一個月是什麼聲音。"
          }
        }
      }
    },
    "Растения на снимке не видно — снимите его целиком.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النبتة لا تظهر في الصورة — التقطها كاملة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растението не се вижда на снимката – хванете го цялото."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিতে গাছ দেখা যাচ্ছে না — পুরো গাছটা ফ্রেমে আনুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la foto no es veu la planta: enquadra-la sencera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotce není vidět rostlina – vyfoťte ji celou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten kan ikke ses på fotoet – få hele planten med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze ist auf dem Foto nicht zu sehen – nimm sie ganz auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φυτό δεν φαίνεται στη φωτογραφία — πιάστε το ολόκληρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant isn’t visible in the photo — get all of it in the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ve la planta en la foto: encuádrala entera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi ei näy kuvassa – ota se kokonaan kuvaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne voit pas la plante sur la photo — cadrez-la en entier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટામાં છોડ દેખાતો નથી — આખો છોડ ફ્રેમમાં લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמח לא נראה בתמונה — צלמו אותו כולו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो में पौधा नहीं दिख रहा — पूरा पौधा फ़्रेम में लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotografiji se ne vidi biljka – snimite je cijelu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növény nem látszik a fotón – vedd le egészben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman tidak terlihat di foto — ambil seluruh tanamannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella foto non si vede la pianta: inquadrala per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に植物が写っていません — 植物全体を入れて撮ってください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретте өсімдік көрінбейді — оны толық түсіріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋದಲ್ಲಿ ಗಿಡ ಕಾಣುತ್ತಿಲ್ಲ — ಇಡೀ ಗಿಡವನ್ನು ಚೌಕಟ್ಟಿನಲ್ಲಿ ತೆಗೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 식물이 보이지 않아요 — 식물 전체가 나오게 찍어 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukoje nesimato augalo – nufotografuokite jį visą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോയിൽ ചെടി കാണുന്നില്ല — മുഴുവൻ ചെടിയും ഫ്രെയിമിൽ എടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटोत रोप दिसत नाही — संपूर्ण रोप फ्रेममध्ये घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbuhan tidak kelihatan dalam foto — ambil seluruh tumbuhan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten synes ikke på bildet – få med hele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant is niet te zien op de foto – zet hem helemaal in beeld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋରେ ଗଛ ଦେଖାଯାଉନାହିଁ — ପୂରା ଗଛକୁ ଫ୍ରେମ୍‌ରେ ନିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਵਿੱਚ ਪੌਦਾ ਨਹੀਂ ਦਿਸਦਾ — ਪੂਰਾ ਪੌਦਾ ਫ਼ਰੇਮ ਵਿੱਚ ਲਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zdjęciu nie widać rośliny – uchwyć ją w całości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta não aparece na foto: enquadre ela inteira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta não aparece na fotografia: enquadre-a por inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planta nu se vede în fotografie – încadreaz-o întreagă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotke nevidno rastlinu – odfoťte ju celú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastline na fotografiji ni videti – zajemite jo v celoti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växten syns inte på fotot – få med hela."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்தில் செடி தெரியவில்லை — முழுச் செடியையும் சட்டகத்தில் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలో మొక్క కనిపించడం లేదు — మొత్తం మొక్కను ఫ్రేమ్‌లో తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองไม่เห็นต้นไม้ในรูป — ถ่ายให้เห็นทั้งต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafta bitki görünmüyor — bitkinin tamamını kadraja alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини на знімку не видно — зніміть її цілком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر میں پودا نظر نہیں آ رہا — پورا پودا فریم میں لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy cây trong ảnh — hãy chụp trọn cả cây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片里看不到植物——请把整株植物拍进来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片裡看不到植物——請把整株植物拍進來。"
          }
        }
