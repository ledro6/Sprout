    "На телефоне нет ни Face ID, ни код-пароля.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في هذا الهاتف بصمة وجه ولا رمز دخول."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът няма нито Face ID, нито код."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে Face ID বা পাসকোড কোনোটিই নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest telèfon no té Face ID ni codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon nemá Face ID ani kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen har hverken Face ID eller adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat weder Face ID noch einen Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το τηλέφωνο δεν έχει ούτε Face ID ούτε κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has neither Face ID nor a passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene ni Face ID ni código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä puhelimessa ei ole Face ID:tä eikä pääsykoodia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n’a ni Face ID ni code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોનમાં Face ID કે પાસકોડ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלפון אין Face ID ואין קוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन में न Face ID है, न पासकोड।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon nema ni Face ID ni šifru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a telefonon nincs se Face ID, se jelkód."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak punya Face ID maupun kode sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non ha né Face ID né codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにはFace IDもパスコードもありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонда Face ID да, құпия код та жоқ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋನ್‌ನಲ್ಲಿ Face ID ಆಗಲಿ ಪಾಸ್‌ಕೋಡ್ ಆಗಲಿ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 Face ID도 암호도 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame telefone nėra nei Face ID, nei kodo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോണിൽ Face ID-യോ പാസ്കോഡോ ഇല്ല."
