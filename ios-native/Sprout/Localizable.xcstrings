    "Модель не собралась. Попробуйте снять ещё раз, при ровном свете.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بناء النموذج. حاول المسح مجددًا في ضوء متساوٍ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът не се получи. Опитайте пак на равномерна светлина."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল তৈরি হয়নি। সমান আলোয় আবার স্ক্যান করে দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut fer el model. Torna a escanejar amb llum uniforme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se nepodařilo sestavit. Zkuste skenovat znovu při rovnoměrném světle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kunne ikke bygges. Scan igen i jævnt lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ließ sich nicht bauen. Scanne noch einmal bei gleichmäßigem Licht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο δεν φτιάχτηκε. Σαρώστε ξανά σε ομοιόμορφο φως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model couldn’t be built. Try scanning again in even light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el modelo. Vuelve a escanear con luz uniforme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallia ei saatu koottua. Skannaa uudelleen tasaisessa valossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a pas pu être construit. Réessayez sous une lumière homogène."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૉડલ બની શક્યું નહીં. સરખા પ્રકાશમાં ફરી સ્કૅન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לבנות את המודל. נסו לסרוק שוב באור אחיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल नहीं बन पाया। एक-सी रोशनी में फिर से स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se nije uspio složiti. Pokušajte ponovno uz ravnomjerno svjetlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült összerakni a modellt. Szkennelj újra egyenletes fényben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gagal dibuat. Coba pindai lagi dengan cahaya merata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non si è costruito. Riprova con una luce uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを作れませんでした。均一な光の下でもう一度スキャンしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель құралмады. Біркелкі жарықта қайта түсіріп көріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾದರಿ ನಿರ್ಮಾಣವಾಗಲಿಲ್ಲ. ಸಮ ಬೆಳಕಿನಲ್ಲಿ ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 만들지 못했어요. 고른 조명에서 다시 스캔해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelio sukurti nepavyko. Pabandykite skenuoti dar kartą tolygioje šviesoje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോഡൽ ഉണ്ടായില്ല. തുല്യമായ വെളിച്ചത്തിൽ വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडेल तयार झाले नाही. एकसारख्या प्रकाशात पुन्हा स्कॅन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gagal dibina. Cuba imbas semula dalam cahaya sekata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kunne ikke bygges. Skann på nytt i jevnt lys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model is niet gelukt. Scan opnieuw bij gelijkmatig licht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମଡେଲ୍ ତିଆରି ହୋଇପାରିଲା ନାହିଁ। ସମାନ ଆଲୋକରେ ପୁଣି ସ୍କାନ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਡਲ ਨਹੀਂ ਬਣ ਸਕਿਆ। ਇੱਕਸਾਰ ਰੋਸ਼ਨੀ ਵਿੱਚ ਮੁੜ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się złożyć modelu. Zeskanuj jeszcze raz przy równym świetle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível montar o modelo. Escaneie de novo com luz uniforme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível montar o modelo. Digitalize de novo com luz uniforme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul nu s-a putut construi. Scanează din nou la lumină uniformă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sa nepodarilo zostaviť. Skúste skenovať znova pri rovnomernom svetle."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modela ni bilo mogoče sestaviti. Poskusite znova pri enakomerni svetlobi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kunde inte byggas. Skanna igen i jämnt ljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாடல் உருவாகவில்லை. சீரான வெளிச்சத்தில் மீண்டும் ஸ்கேன் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడల్ తయారవలేదు. సమాన వెలుతురులో మళ్లీ స్కాన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างโมเดลไม่สำเร็จ ลองสแกนใหม่ในแสงที่สม่ำเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model oluşturulamadı. Eşit ışıkta yeniden taramayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель не зібралася. Спробуйте зняти ще раз, при рівному світлі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل نہیں بن سکا۔ یکساں روشنی میں دوبارہ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dựng được mô hình. Hãy quét lại dưới ánh sáng đều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能生成。请在均匀光线下重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能產生。請在均勻光線下重新掃描。"
          }
        }
      }
    },
