    "Счёт от %@. Обновится, когда друг пришлёт код снова.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقاط بتاريخ %@. ستتحدث عندما يرسل صديقك الرمز مجددًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Резултат от %@. Ще се обнови, когато приятелят изпрати кода отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত স্কোর। বন্ধু আবার কোড পাঠালে আপডেট হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuació del %@. S’actualitzarà quan el teu amic torni a enviar el codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skóre k %@. Aktualizuje se, až přítel pošle kód znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Score fra %@. Opdateres, når din ven sender koden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand vom %@. Wird aktualisiert, wenn dein Freund den Code erneut schickt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκορ από %@. Θα ενημερωθεί όταν ο φίλος στείλει ξανά τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score as of %@. It updates when your friend sends their code again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuación del %@. Se actualizará cuando tu amigo vuelva a enviar su código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisteet %@. Päivittyy, kun kaverisi lähettää koodin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Score du %@. Il sera mis à jour quand votre ami renverra son code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સુધીનો સ્કોર. મિત્ર ફરી કોડ મોકલશે ત્યારે અપડેટ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוד מ־%@. יתעדכן כשהחבר ישלח את הקוד שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक का स्कोर। दोस्त के कोड दोबारा भेजने पर अपडेट होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat od %@. Ažurirat će se kad prijatelj ponovno pošalje kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontszám: %@. Frissül, amikor a barátod újra elküldi a kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor per %@. Diperbarui saat temanmu mengirim kodenya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggio del %@. Si aggiornerà quando il tuo amico invierà di nuovo il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@時点のスコア。友達がコードをもう一度送ると更新されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнгі ұпай. Досыңыз кодты қайта жібергенде жаңарады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ವರೆಗಿನ ಅಂಕ. ಸ್ನೇಹಿತರು ಮತ್ತೆ ಕೋಡ್ ಕಳುಹಿಸಿದಾಗ ನವೀಕರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기준 점수. 친구가 코드를 다시 보내면 업데이트돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatas nuo %@. Atsinaujins, kai draugas vėl atsiųs kodą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വരെയുള്ള സ്കോർ. സുഹൃത്ത് വീണ്ടും കോഡ് അയയ്ക്കുമ്പോൾ അപ്ഡേറ്റാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर्यंतचे गुण. मित्राने पुन्हा कोड पाठवल्यावर अपडेट होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor setakat %@. Dikemas kini apabila rakan menghantar kod sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poeng fra %@. Oppdateres når vennen sender koden på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Score van %@. Wordt bijgewerkt als je vriend de code opnieuw stuurt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ପର୍ଯ୍ୟନ୍ତ ସ୍କୋର୍। ବନ୍ଧୁ ପୁଣି କୋଡ୍ ପଠାଇଲେ ଅପଡେଟ୍ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੱਕ ਦਾ ਸਕੋਰ। ਦੋਸਤ ਦੇ ਮੁੜ ਕੋਡ ਭੇਜਣ 'ਤੇ ਅੱਪਡੇਟ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik z %@. Zaktualizuje się, gdy znajomy znów przyśle kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando seu amigo enviar o código de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando o seu amigo voltar a enviar o código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scor din %@. Se actualizează când prietenul trimite din nou codul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skóre k %@. Aktualizuje sa, keď priateľ znova pošle kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat na dan %@. Posodobi se, ko prijatelj znova pošlje kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poäng från %@. Uppdateras när vännen skickar koden igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வரையிலான மதிப்பெண். நண்பர் மீண்டும் குறியீட்டை அனுப்பும்போது புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వరకు స్కోర్. స్నేహితుడు మళ్లీ కోడ్ పంపినప్పుడు నవీకరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนน ณ %@ จะอัปเดตเมื่อเพื่อนส่งรหัสมาอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihli puan. Arkadaşınız kodu yeniden gönderince güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок від %@. Оновиться, коли друг надішле код знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تک کا اسکور۔ دوست کے دوبارہ کوڈ بھیجنے پر اپ ڈیٹ ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm tính đến %@. Sẽ cập nhật khi bạn của bạn gửi lại mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至%@的分数。朋友再次发来代码时会更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截至%@的分數。朋友再次傳來代碼時會更新。"
          }
        }
      }
    },
