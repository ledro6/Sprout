    "Остальные дождутся сами: %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقية ستتدبر أمرها: %@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Останалите ще издържат сами: %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকিরা নিজেরাই সামলে নেবে: %@।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les altres aguantaran soles: %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní to zvládnou samy: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resten klarer sig selv: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rest hält selbst durch: %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υπόλοιπα θα τα βγάλουν πέρα μόνα τους: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest will wait on their own: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás aguantarán solas: %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut pärjäävät itse: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres tiendront seules : %@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકીના જાતે સંભાળી લેશે: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר יסתדרו לבד: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी खुद संभल जाएँगे: %@।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostale će izdržati same: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi kibírja magától: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisanya bisa bertahan sendiri: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le altre resisteranno da sole: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかは自分で待てます：%@。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалғандары өздері шыдайды: %@."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿದವು ತಾವೇ ನಿಭಾಯಿಸುತ್ತವೆ: %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지는 스스로 버틸 수 있어요: %@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiti išsivers patys: %@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാക്കിയുള്ളവ സ്വയം പിടിച്ചുനിൽക്കും: %@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकीची स्वतः सांभाळतील: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang lain boleh bertahan sendiri: %@."
          }
        },
        "nb": {
