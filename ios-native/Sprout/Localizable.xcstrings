    "Растения «%@» в саду больше нет.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد «%@» في الحديقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ вече не е в градината."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja no és al jardí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už v zahradě není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er ikke længere i haven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht mehr im Garten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν είναι πια στον κήπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer in the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya no está en el jardín."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole enää puutarhassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est plus dans le jardin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” כבר לא בגינה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” više nije u vrtu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” már nincs a kertben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è più nel giardino."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» енді бақта жоқ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sode nebėra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke lenger i hagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ staat niet meer in de tuin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie ma już w ogrodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está mais no jardim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está mais no jardim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu mai e în grădină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už v záhrade nie je."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« ni več na vrtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” finns inte längre i trädgården."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” artık bahçede değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини «%@» у саду більше немає."
          }
        }
      }
    },
    "Растения в неё можно будет посадить или перевезти.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيمكنك الزراعة فيها أو نقل النباتات إليها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В нея ще може да засаждате или да местите растения."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi podràs plantar o portar-hi plantes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete do ní moct sázet nebo stěhovat rostliny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Pflanzen hineinsetzen oder dorthin umziehen lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα μπορείτε να φυτεύετε σε αυτό ή να μεταφέρετε φυτά εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be able to plant in it or move plants there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás plantar en ella o traer plantas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit istuttaa siihen tai siirtää sinne kasveja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez y planter ou y déplacer des plantes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר יהיה לשתול בו או להעביר אליו צמחים."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moći ćete u nju saditi ili premještati biljke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ültethetsz bele, vagy növényeket költöztethetsz ide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai piantarci o spostarci piante."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған өсімдік отырғызуға немесе көшіруге болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jame galėsite sodinti arba perkelti į jį augalus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt er planten in zetten of naartoe verhuizen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będzie można w nim sadzić albo przenosić do niego rośliny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você poderá plantar nele ou mudar plantas para lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poderá plantar nela ou mudar plantas para lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei putea planta în ea sau muta plante acolo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete do nej môcť sadiť alebo sťahovať rastliny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanjo boste lahko sadili ali preselili rastline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plantera i det eller flytta växter dit."
          }
        },
        "tr": {
