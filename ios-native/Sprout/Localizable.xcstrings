    "Нажмите «+», чтобы завести первую.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «+» لإنشاء أول غرفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете „+“, за да създадете първата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমটি তৈরি করতে “+” ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «+» per crear la primera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na „+“ vytvoříte první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ”+” for at oprette det første."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „+“, um den ersten anzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε «+» για να δημιουργήσετε το πρώτο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “+” to create the first one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca “+” para crear la primera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo ensimmäinen napauttamalla ”+”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « + » pour créer la première."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલો બનાવવા “+” પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על “+” כדי ליצור את הראשון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहला बनाने के लिए “+” पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite „+” da stvorite prvu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a „+” gombra az első létrehozásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “+” untuk membuat yang pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “+” per creare la prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「+」をタップして最初の部屋を作成します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біріншісін жасау үшін «+» түймесін түртіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘+’를 탭하여 첫 방을 만드세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite „+“, kad sukurtumėte pirmąjį."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिली तयार करण्यासाठी “+” वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik “+” untuk mencipta yang pertama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «+» for å opprette det første."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ‘+’ om de eerste aan te maken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରଥମଟି ତିଆରି କରିବାକୁ “+” ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹਿਲਾ ਬਣਾਉਣ ਲਈ “+” 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij „+”, aby utworzyć pierwszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “+” para criar o primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “+” para criar a primeira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge „+” ca să creezi prima."
          }
        },
