    "Файл сада попадает в резервную копию iPhone — туда же, куда и остальные ваши данные, по правилам Apple.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Havefilen kommer med i iPhonens sikkerhedskopi – sammen med resten af dine data, efter Apples regler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gartendatei landet im iPhone-Backup — dort, wo auch deine übrigen Daten liegen, nach den Regeln von Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden file goes into your iPhone backup — together with the rest of your data, under Apple’s rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del jardín entra en la copia de seguridad del iPhone, junto con el resto de tus datos, según las reglas de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhatiedosto menee iPhonen varmuuskopioon – muiden tietojesi mukana, Applen sääntöjen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier du jardin va dans la sauvegarde de l’iPhone — avec le reste de vos données, selon les règles d’Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file del giardino finisce nel backup dell’iPhone, insieme al resto dei tuoi dati, secondo le regole di Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagefilen blir med i sikkerhetskopien av iPhonen – sammen med resten av dataene dine, etter Apples regler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tuinbestand gaat mee in de iPhone-reservekopie — samen met je andere gegevens, volgens de regels van Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo do jardim vai para o backup do iPhone — junto com o resto dos seus dados, pelas regras da Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro do jardim vai para a cópia de segurança do iPhone — com o resto dos seus dados, segundo as regras da Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trädgårdsfilen följer med i iPhonens säkerhetskopia – tillsammans med resten av dina data, enligt Apples regler."
          }
        }
      }
    },
