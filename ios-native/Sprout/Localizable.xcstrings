    "Вечер — время для сада: день позади, лейка в руке.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساء وقت الحديقة: انتهى النهار والمرشّة في يدك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечерта е за градината: денят е зад гърба ви, лейката в ръка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সন্ধ্যা বাগানের সময়: দিন শেষ, হাতে ঝারি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El vespre és l’hora del jardí: el dia s’ha acabat, la regadora a la mà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer patří zahradě: den je za vámi, konev v ruce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aftenen er havens tid: dagen er omme, vandkanden i hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends ist Gartenzeit: Der Tag ist geschafft, die Gießkanne in der Hand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βράδυ είναι ώρα κήπου: η μέρα τελείωσε, το ποτιστήρι στο χέρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening is garden time: the day is done, watering can in hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarde es para el jardín: el día ha terminado y tienes la regadera en la mano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilta on puutarhan aikaa: päivä on ohi, kastelukannu kädessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, c’est l’heure du jardin : la journée est finie, l’arrosoir en main."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાંજ બગીચાનો સમય છે: દિવસ પૂરો, હાથમાં ઝારી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערב הוא זמן הגינה: היום מאחור, המזלף ביד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाम बगीचे का समय है: दिन बीत गया, हाथ में झारी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer je vrijeme za vrt: dan je iza vas, kantica u ruci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az este a kerté: a nap véget ért, a locsolókanna a kézben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sore adalah waktu kebun: hari sudah usai, penyiram di tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera è l’ora del giardino: la giornata è finita, l’annaffiatoio in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕方は庭の時間。1日が終わり、じょうろを手に。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеш — бақтың уақыты: күн артта, суарғыш қолда."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಜೆ ತೋಟದ ಸಮಯ: ದಿನ ಮುಗಿಯಿತು, ಕೈಯಲ್ಲಿ ನೀರಿನ ಕ್ಯಾನ್."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁은 정원의 시간. 하루를 마치고 물뿌리개를 들어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakaras — sodo metas: diena baigėsi, laistytuvas rankoje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സന്ധ്യ തോട്ടത്തിന്റെ സമയമാണ്: ദിവസം കഴിഞ്ഞു, കൈയിൽ നനയ്ക്കാനുള്ള പാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संध्याकाळ बागेची वेळ: दिवस संपला, हातात झारी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petang ialah masa taman: hari sudah berlalu, penyiram di tangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvelden er hagens tid: dagen er over, vannkanna i hånda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De avond is tuintijd: de dag zit erop, de gieter in de hand."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସନ୍ଧ୍ୟା ବଗିଚାର ସମୟ: ଦିନ ସରିଲା, ହାତରେ ଝାରି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ਾਮ ਬਗੀਚੇ ਦਾ ਸਮਾਂ ਹੈ: ਦਿਨ ਮੁੱਕਿਆ, ਹੱਥ ਵਿੱਚ ਫੁਹਾਰਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczór to czas ogrodu: dzień za tobą, konewka w dłoni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim da tarde é a hora do jardim: o dia acabou, o regador na mão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim do dia é a hora do jardim: o dia já passou, o regador na mão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seara e ora grădinii: ziua s-a terminat, stropitoarea în mână."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer patrí záhrade: deň je za vami, krhla v ruke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer je čas za vrt: dan je mimo, zalivalka v roki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvällen är trädgårdens tid: dagen är slut, vattenkannan i handen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாலை தோட்டத்தின் நேரம்: நாள் முடிந்தது, கையில் பூவாளி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాయంత్రం తోట సమయం: రోజు ముగిసింది, చేతిలో నీళ్ల డబ్బా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยามเย็นคือเวลาของสวน วันผ่านไปแล้ว บัวรดน้ำอยู่ในมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam bahçenin vakti: gün bitti, sulama kabı elde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечір — час для саду: день позаду, лійка в руці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شام باغ کا وقت ہے: دن ختم، ہاتھ میں فوارہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi tối là giờ của khu vườn: ngày đã qua, bình tưới trong tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "傍晚是花园时间：一天结束，水壶在手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傍晚是花園時間：一天結束，澆水壺在手。"
          }
        }
      }
    },
