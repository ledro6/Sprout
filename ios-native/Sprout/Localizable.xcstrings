    "Полейте всех разом и отправьте соседу памятку.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسقِ الجميع دفعة واحدة وأرسل إلى الجار مذكرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Полейте всички наведнъж и изпратете бележка на съседа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবাইকে একসঙ্গে জল দিন আর প্রতিবেশীকে চিরকুট পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega-les totes alhora i envia una nota al veí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte všechny najednou a pošlete sousedovi lístek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vand alle på én gang, og send naboen en seddel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieß alle auf einmal und schick deinem Nachbarn eine Notiz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποτίστε όλα μαζί και στείλτε στον γείτονα ένα σημείωμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water everyone at once and send your neighbor a note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega a todas de una vez y envía una nota al vecino."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastele kaikki kerralla ja lähetä naapurille muistilappu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrosez tout le monde d’un coup et envoyez un mot au voisin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધાને એક સાથે પાણી આપો અને પડોશીને ચિઠ્ઠી મોકલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השקו את כולם בבת אחת ושלחו לשכן פתק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबको एक साथ पानी दें और पड़ोसी को पर्ची भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte sve odjednom i pošaljite susjedu poruku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öntözz meg mindenkit egyszerre, és küldj egy üzenetet a szomszédnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siram semuanya sekaligus dan kirim catatan ke tetangga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffia tutte in una volta e manda un promemoria al vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員にまとめて水やりして、お隣さんにメモを送りましょう。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлығын бірге суарып, көршіге жадынама жіберіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲರಿಗೂ ಒಮ್ಮೆಗೇ ನೀರು ಹಾಕಿ ಮತ್ತು ನೆರೆಯವರಿಗೆ ಚೀಟಿ ಕಳುಹಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두에게 한 번에 물을 주고 이웃에게 메모를 보내세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaistykite visus iš karto ir nusiųskite kaimynui raštelį."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാവരെയും ഒരുമിച്ച് നനച്ച് അയൽക്കാരന് ഒരു കുറിപ്പ് അയയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वांना एकदाच पाणी द्या आणि शेजाऱ्यांना चिठ्ठी पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siram semuanya sekali gus dan hantar nota kepada jiran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vann alle på én gang og send naboen en lapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef iedereen tegelijk water en stuur de buren een briefje."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମସ୍ତଙ୍କୁ ଏକାଥରେ ପାଣି ଦିଅନ୍ତୁ ଓ ପଡ଼ୋଶୀଙ୍କୁ ଚିଠି ପଠାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਨੂੰ ਇੱਕੋ ਵਾਰ ਪਾਣੀ ਦਿਓ ਅਤੇ ਗੁਆਂਢੀ ਨੂੰ ਪਰਚੀ ਭੇਜੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlej wszystkie naraz i wyślij sąsiadowi notatkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue todas de uma vez e mande um recado ao vizinho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue todas de uma vez e envie um recado ao vizinho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Udă-le pe toate deodată și trimite-i vecinului un bilet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polejte všetky naraz a pošlite susedovi lístok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte vse naenkrat in pošljite sosedu sporočilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattna alla på en gång och skicka en lapp till grannen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைவருக்கும் ஒரே முறை நீர் ஊற்றி அண்டை வீட்டாருக்குக் குறிப்பு அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్నింటికీ ఒకేసారి నీళ్లు పోసి పొరుగువారికి చీటీ పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รดน้ำทุกต้นในครั้งเดียว แล้วส่งโน้ตให้เพื่อนบ้าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsini bir kerede sulayın ve komşunuza bir not gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Полийте всіх разом і надішліть сусідові пам’ятку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کو ایک ساتھ پانی دیں اور پڑوسی کو پرچی بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tưới tất cả một lượt và gửi hàng xóm một ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次给所有植物浇水，再给邻居发一张便条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次替所有植物澆水，再傳一張便條給鄰居。"
          }
        }
      }
    },
    "Полейте растение — и здесь появится, сколько воды было в земле в этот миг.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسقِ نبتة، وسترى هنا كم كان في التربة من ماء في تلك اللحظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Полейте растение и тук ще видите колко вода е имало в почвата в този момент."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো গাছে জল দিন — সেই মুহূর্তে মাটিতে কতটা জল ছিল এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega una planta i aquí veuràs quanta aigua hi havia a la terra en aquell moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte rostlinu a tady uvidíte, kolik vody v tu chvíli bylo v hlíně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vand en plante, så ser du her, hvor meget vand der var i jorden i det øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieß eine Pflanze – dann siehst du hier, wie viel Wasser in diesem Moment in der Erde war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποτίστε ένα φυτό και εδώ θα δείτε πόσο νερό είχε το χώμα εκείνη τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water a plant, and you’ll see here how much water was in the soil at that moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega una planta y aquí verás cuánta agua había en la tierra en ese momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastele kasvi, niin näet tässä, paljonko mullassa oli sillä hetkellä vettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrosez une plante : vous verrez ici combien d’eau il y avait dans la terre à ce moment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ છોડને પાણી આપો — તે ક્ષણે માટીમાં કેટલું પાણી હતું તે અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השקו צמח – וכאן יופיע כמה מים היו באדמה באותו רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पौधे को पानी दें — यहाँ दिखेगा कि उस पल मिट्टी में कितना पानी था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte biljku i ovdje ćete vidjeti koliko je vode u tom trenutku bilo u zemlji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Öntözz meg egy növényt, és itt látni fogod, mennyi víz volt a földben abban a pillanatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siram tanaman, dan di sini Anda akan melihat berapa banyak air di tanah saat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffia una pianta e qui vedrai quanta acqua c’era nella terra in quel momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物に水やりすると、そのとき土にどれだけ水があったかがここに表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдікті суарыңыз — сол сәтте топырақта қанша су болғаны осында көрсетіледі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡಕ್ಕೆ ನೀರು ಹಾಕಿ — ಆ ಕ್ಷಣದಲ್ಲಿ ಮಣ್ಣಿನಲ್ಲಿ ಎಷ್ಟು ನೀರಿತ್ತು ಎಂದು ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물에 물을 주면, 그 순간 흙에 수분이 얼마나 있었는지 여기에 표시돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaistykite augalą ir čia pamatysite, kiek vandens tuo metu buvo žemėje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചെടി നനയ്ക്കൂ — ആ നിമിഷം മണ്ണിൽ എത്ര വെള്ളമുണ്ടായിരുന്നുവെന്ന് ഇവിടെ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखाद्या रोपाला पाणी द्या — त्या क्षणी मातीत किती पाणी होते ते इथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siram tumbuhan, dan di sini anda akan melihat berapa banyak air dalam tanah pada ketika itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vann en plante, så ser du her hvor mye vann det var i jorden i det øyeblikket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef een plant water – dan zie je hier hoeveel water er op dat moment in de aarde zat."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ଗଛକୁ ପାଣି ଦିଅନ୍ତୁ — ସେହି ମୁହୂର୍ତ୍ତରେ ମାଟିରେ କେତେ ପାଣି ଥିଲା ଏଠାରେ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਪੌਦੇ ਨੂੰ ਪਾਣੀ ਦਿਓ — ਉਸ ਪਲ ਮਿੱਟੀ ਵਿੱਚ ਕਿੰਨਾ ਪਾਣੀ ਸੀ, ਇੱਥੇ ਦਿਖੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlej roślinę – a zobaczysz tu, ile wody było w ziemi w tej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue uma planta e aqui você verá quanta água havia na terra naquele momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue uma planta e aqui verá quanta água havia na terra nesse momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Udă o plantă și aici vei vedea câtă apă era în pământ în acel moment."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polejte rastlinu a tu uvidíte, koľko vody v tej chvíli bolo v zemi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijte rastlino in tu boste videli, koliko vode je bilo v tistem trenutku v zemlji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattna en växt så ser du här hur mycket vatten som fanns i jorden i det ögonblicket."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு செடிக்கு நீர் ஊற்றுங்கள் — அந்த நொடியில் மண்ணில் எவ்வளவு நீர் இருந்தது என்று இங்கே தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక మొక్కకు నీళ్లు పోయండి — ఆ క్షణంలో మట్టిలో ఎంత నీరు ఉందో ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รดน้ำต้นไม้ แล้วคุณจะเห็นที่นี่ว่าตอนนั้นในดินมีน้ำเท่าไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi sulayın — o anda toprakta ne kadar su olduğunu burada görürsünüz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Полийте рослину — і тут з’явиться, скільки води було в землі цієї миті."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی پودے کو پانی دیں — یہاں دکھے گا کہ اس لمحے مٹی میں کتنا پانی تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tưới một cây, rồi ở đây bạn sẽ thấy lúc đó trong đất có bao nhiêu nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浇一次水，这里就会显示那一刻土里有多少水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "澆一次水，這裡就會顯示那一刻土裡有多少水。"
          }
        }
      }
    },
