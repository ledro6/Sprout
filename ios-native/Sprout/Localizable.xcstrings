    "Двумя пальцами — повернуть, щипком — размер": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبعان للتدوير، والقرص لتغيير الحجم"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С два пръста — завъртане, с щипване — размер"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই আঙুলে ঘোরান, চিমটি দিয়ে আকার বদলান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos dits per girar, pessiga per a la mida"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvěma prsty otočit, sevřením změnit velikost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To fingre drejer, knib for størrelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit zwei Fingern drehen, mit Aufziehen die Größe ändern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο δάχτυλα για περιστροφή, τσίμπημα για μέγεθος"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two fingers to rotate, pinch to resize"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos dedos para girar, pellizca para el tamaño"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi sormea kääntää, nipistys muuttaa kokoa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux doigts pour tourner, pincez pour la taille"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બે આંગળીથી ફેરવો, ચપટીથી કદ બદલો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי אצבעות לסיבוב, צביטה לגודל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो उँगलियों से घुमाएँ, पिंच से आकार बदलें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva prsta za okretanje, štipanje za veličinu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két ujjal forgatás, csippentéssel méret"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua jari untuk memutar, cubit untuk ukuran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due dita per ruotare, pizzica per ridimensionare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指で回転、ピンチでサイズ変更"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі саусақпен — бұру, қысумен — өлшем"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 회전, 핀치로 크기 조절"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dviem pirštais – pasukti, suimant – dydis"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन बोटांनी फिरवा, चिमटीने आकार बदला"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua jari untuk putar, cubit untuk saiz"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To fingre roterer, knip for størrelse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee vingers om te draaien, knijp voor het formaat"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୁଇ ଆଙ୍ଗୁଠିରେ ଘୁରାନ୍ତୁ, ଚିମୁଟିରେ ଆକାର ବଦଳାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੋ ਉਂਗਲਾਂ ਨਾਲ ਘੁਮਾਓ, ਚੂੰਢੀ ਨਾਲ ਆਕਾਰ ਬਦਲੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa palce — obrót, szczypnięcie — rozmiar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois dedos para girar, pinça para o tamanho"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois dedos para rodar, beliscar para o tamanho"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două degete pentru rotire, ciupire pentru mărime"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvoma prstami otočiť, stiahnutím zmeniť veľkosť"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z dvema prstoma zasuk, s ščipom velikost"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två fingrar vrider, nyp för storlek"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองนิ้วเพื่อหมุน บีบเพื่อปรับขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parmakla döndür, sıkıştırarak boyutlandır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двома пальцями — повернути, щипком — розмір"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ngón để xoay, chụm để đổi kích thước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指旋转，捏合缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指旋轉，捏合縮放"
          }
        }
      }
    },
