            "value": "Fotoğraf bulanık — daha net bir tane çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімок розмитий — зніміть чіткіше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر دھندلی ہے — زیادہ صاف لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh bị mờ — hãy chụp rõ hơn."
          }
        },
        "zh-Hans": {
