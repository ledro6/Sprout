    "Поставьте растение на стол или пол и наведите на него камеру": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع النبتة على طاولة أو على الأرض ووجّه الكاميرا نحوها"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложете растението на маса или на пода и насочете камерата към него"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছটা টেবিলে বা মেঝেতে রাখুন আর ক্যামেরা তার দিকে ধরুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa la planta en una taula o a terra i apunta-hi la càmera"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavte rostlinu na stůl nebo na zem a namiřte na ni fotoaparát"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil planten på et bord eller gulvet, og ret kameraet mod den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Pflanze auf einen Tisch oder den Boden und richte die Kamera darauf"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε το φυτό σε τραπέζι ή στο πάτωμα και στρέψτε την κάμερα προς αυτό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the plant on a table or the floor and point the camera at it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la planta en una mesa o en el suelo y apunta la cámara hacia ella"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta kasvi pöydälle tai lattialle ja osoita sitä kameralla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la plante sur une table ou au sol et visez-la avec la caméra"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડને ટેબલ કે ફ્લોર પર મૂકો અને કૅમેરા તેની તરફ રાખો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניחו את הצמח על שולחן או על הרצפה וכוונו אליו את המצלמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधे को मेज़ या फ़र्श पर रखें और कैमरा उसकी ओर करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavite biljku na stol ili pod i usmjerite kameru prema njoj"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a növényt asztalra vagy a padlóra, és fordítsd felé a kamerát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan tanaman di meja atau lantai lalu arahkan kamera ke sana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti la pianta su un tavolo o sul pavimento e inquadrala"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物をテーブルか床に置いて、カメラを向けてください"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдікті үстелге не еденге қойып, камераны соған бағыттаңыз"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡವನ್ನು ಮೇಜು ಅಥವಾ ನೆಲದ ಮೇಲೆ ಇಟ್ಟು ಕ್ಯಾಮೆರಾವನ್ನು ಅದರತ್ತ ತಿರುಗಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물을 탁자나 바닥에 놓고 카메라를 향해 주세요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastatykite augalą ant stalo ar grindų ir nukreipkite į jį kamerą"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെടി മേശയിലോ തറയിലോ വെച്ച് ക്യാമറ അതിലേക്ക് തിരിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोप टेबलवर किंवा जमिनीवर ठेवा आणि कॅमेरा त्याकडे वळवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan tumbuhan di atas meja atau lantai dan halakan kamera kepadanya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett planten på et bord eller gulvet, og rett kameraet mot den"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de plant op een tafel of de vloer en richt de camera erop"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗଛଟିକୁ ଟେବୁଲ୍ ବା ଚଟାଣରେ ରଖି କ୍ୟାମେରା ତା’ ଆଡ଼କୁ କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌਦੇ ਨੂੰ ਮੇਜ਼ ਜਾਂ ਫ਼ਰਸ਼ 'ਤੇ ਰੱਖੋ ਅਤੇ ਕੈਮਰਾ ਉਸ ਵੱਲ ਕਰੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postaw roślinę na stole lub podłodze i skieruj na nią aparat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque a planta numa mesa ou no chão e aponte a câmera para ela"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouse a planta numa mesa ou no chão e aponte a câmara para ela"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune planta pe o masă sau pe podea și îndreaptă camera spre ea"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položte rastlinu na stôl alebo na zem a namierte na ňu fotoaparát"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite rastlino na mizo ali tla in nanjo usmerite kamero"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ växten på ett bord eller golvet och rikta kameran mot den"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செடியை மேசையிலோ தரையிலோ வைத்து கேமராவை அதை நோக்கித் திருப்புங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్కను టేబుల్ లేదా నేలపై ఉంచి కెమెరాను దాని వైపు తిప్పండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางต้นไม้บนโต๊ะหรือพื้น แล้วหันกล้องไปที่ต้นไม้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiyi bir masaya ya da yere koyun ve kamerayı ona çevirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте рослину на стіл або підлогу й наведіть на неї камеру"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پودے کو میز یا فرش پر رکھیں اور کیمرا اس کی طرف کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cây lên bàn hoặc sàn nhà rồi hướng camera vào cây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把植物放在桌上或地上，并将相机对准它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把植物放在桌上或地上，並將相機對準它"
          }
        }
      }
    },
    "Потрясите телефон — фигурки узора разлетятся и соберутся снова. Просто для радости.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هزّ الهاتف، فتتناثر أشكال النقش ثم تجتمع من جديد. للمتعة فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разклатете телефона – фигурките от шарката се разпръскват и пак се събират. Просто за радост."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন ঝাঁকান — নকশার আকৃতিগুলো ছড়িয়ে পড়ে আবার জড়ো হয়। শুধু মজার জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacseja el telèfon: les figures del motiu s’escampen i es tornen a reunir. Només per diversió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatřeste telefonem – tvary vzoru se rozletí a zase se sejdou. Jen pro radost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryst telefonen – mønsterets figurer flyver fra hinanden og samler sig igen. Bare for sjov."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttle dein Telefon – die Figuren des Musters fliegen auseinander und finden wieder zusammen. Einfach zum Spaß."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουνήστε το τηλέφωνο — τα σχήματα του μοτίβου σκορπίζουν και ξαναμαζεύονται. Απλώς για χαρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your phone — the pattern’s shapes scatter and come back together. Just for fun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agita el teléfono: las figuras del patrón se dispersan y vuelven a juntarse. Solo por diversión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravista puhelinta – kuvion hahmot sinkoutuvat erilleen ja kokoontuvat taas. Ihan vain iloksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secouez le téléphone — les figures du motif s’éparpillent puis se rassemblent. Juste pour le plaisir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોન હલાવો — ભાતની આકૃતિઓ વિખેરાઈને ફરી ભેગી થાય છે. બસ મજા માટે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נערו את הטלפון – צורות הדוגמה מתפזרות ומתאספות שוב. סתם בשביל הכיף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन हिलाइए — पैटर्न की आकृतियाँ बिखरकर फिर जुड़ जाती हैं। बस मज़े के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protresite telefon – oblici uzorka razlete se i ponovno se skupe. Samo za zabavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rázd meg a telefont – a minta formái szétrepülnek, majd újra összeállnak. Csak a móka kedvéért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kocok ponselmu — bentuk-bentuk pola berhamburan lalu berkumpul lagi. Sekadar untuk senang-senang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuoti il telefono: le figure del motivo si sparpagliano e poi si ricompongono. Solo per divertimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを振ると、模様の図形が飛び散って、また集まります。ただの遊びです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонды шайқаңыз — өрнек фигуралары шашырап, қайта жиналады. Жай көңіл үшін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಅಲುಗಾಡಿಸಿ — ವಿನ್ಯಾಸದ ಆಕೃತಿಗಳು ಚದುರಿ ಮತ್ತೆ ಒಟ್ಟಾಗುತ್ತವೆ. ಸುಮ್ಮನೆ ಮೋಜಿಗಾಗಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 흔들면 무늬의 도형이 흩어졌다가 다시 모여요. 그냥 재미로요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakratykite telefoną – rašto figūros išsilaksto ir vėl susirenka. Tiesiog dėl džiaugsmo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൺ കുലുക്കുക — ചിത്രപ്പണിയിലെ രൂപങ്ങൾ ചിതറി വീണ്ടും ഒന്നിക്കും. വെറുതെ രസത്തിന്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन हलवा — नक्षीतील आकृती विखुरतात आणि पुन्हा एकत्र येतात. फक्त गंमत म्हणून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Goncang telefon — bentuk-bentuk corak berselerak dan berkumpul semula. Sekadar untuk seronok."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rist telefonen – figurene i mønsteret flyr fra hverandre og samles igjen. Bare for moro skyld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schud je telefoon – de figuurtjes van het patroon vliegen uit elkaar en komen weer samen. Gewoon voor de lol."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ ହଲାନ୍ତୁ — ନକ୍ସାର ଆକୃତିସବୁ ଛିଞ୍ଚାଡ଼ି ହୋଇ ପୁଣି ଏକାଠି ହୁଅନ୍ତି। କେବଳ ମଜା ପାଇଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਹਿਲਾਓ — ਨਮੂਨੇ ਦੀਆਂ ਆਕ੍ਰਿਤੀਆਂ ਖਿੰਡ ਕੇ ਫਿਰ ਇਕੱਠੀਆਂ ਹੋ ਜਾਂਦੀਆਂ ਹਨ। ਬੱਸ ਮਜ਼ੇ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrząśnij telefonem – figurki wzoru rozlecą się i znów zbiorą. Tak dla radości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacuda o celular — as figuras do padrão se espalham e voltam a se juntar. Só por diversão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abane o telemóvel — as figuras do padrão espalham-se e voltam a juntar-se. Só por diversão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scutură telefonul — figurile modelului se împrăștie și se adună la loc. Doar de distracție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatraste telefónom – tvary vzoru sa rozletia a znova sa zídu. Len pre radosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stresite telefon – oblike vzorca se razletijo in spet zberejo. Samo za veselje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaka telefonen – figurerna i mönstret flyger isär och samlas igen. Bara för skojs skull."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "போனைக் குலுக்குங்கள் — வடிவத்தின் உருவங்கள் சிதறி மீண்டும் ஒன்றுசேரும். சும்மா வேடிக்கைக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్‌ను ఊపండి — నమూనా ఆకారాలు చెదిరి మళ్లీ కలుస్తాయి. కేవలం సరదాకి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขย่าโทรศัพท์ รูปทรงในลวดลายจะกระจายออกแล้วกลับมารวมกัน แค่เพื่อความสนุก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu sallayın: desendeki şekiller dağılır ve yeniden toplanır. Sadece keyif için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрусіть телефон — фігурки візерунка розлетяться й зберуться знову. Просто для радості."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون ہلائیں — نقش کی شکلیں بکھر کر پھر اکٹھی ہو جاتی ہیں۔ بس مزے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắc điện thoại — các hình trong hoa văn tung ra rồi tụ lại. Chỉ để vui thôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇一摇手机——图案里的图形会四散开来，再重新聚拢。纯属好玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搖一搖手機——圖案裡的圖形會四散開來，再重新聚攏。純粹好玩。"
          }
        }
      }
    },
    "Потяните снимок или разведите пальцы. Двойное нажатие вернёт как было.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الصورة أو باعد بين أصابعك. اضغط مرتين للاستعادة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете снимката или разтворете пръсти. Двойно докосване връща както беше."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি টানুন বা আঙুল ছড়ান। আগের মতো করতে দুবার ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega la foto o separa els dits. Toca dues vegades per restablir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhněte fotku nebo roztáhněte prsty. Dvojím klepnutím obnovíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i fotoet, eller spred fingrene. Dobbelttryk for at nulstille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das Foto oder spreiz die Finger. Doppeltippen setzt es zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε τη φωτογραφία ή ανοίξτε τα δάχτυλα. Διπλό πάτημα για επαναφορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the photo or spread your fingers. Double-tap to reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la foto o separa los dedos. Toca dos veces para restablecer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kuvaa tai levitä sormia. Palauta kaksoisnapautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la photo ou écartez les doigts. Touchez deux fois pour revenir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ખેંચો અથવા આંગળીઓ ફેલાવો. પહેલાં જેવું કરવા બે વાર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו את התמונה או הרחיקו את האצבעות. הקשה כפולה מחזירה למצב הקודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो खींचें या उँगलियाँ फैलाएँ। पहले जैसा करने के लिए दो बार टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite fotografiju ili raširite prste. Dvaput dodirnite za vraćanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fotót, vagy húzd szét az ujjaidat. Dupla koppintás visszaállítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto atau renggangkan jari. Ketuk dua kali untuk mengembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la foto o allarga le dita. Tocca due volte per ripristinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をドラッグするか、指を広げてください。ダブルタップで元に戻ります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретті сүйреңіз не саусақтарды ашыңыз. Екі рет түрту бастапқы күйге қайтарады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಎಳೆಯಿರಿ ಅಥವಾ ಬೆರಳುಗಳನ್ನು ಅಗಲಿಸಿ. ಹಿಂದಿನಂತೆ ಮಾಡಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 드래그하거나 손가락을 벌리세요. 이중 탭하면 되돌아가요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkite nuotrauką arba išskėskite pirštus. Dukart bakstelėkite, kad atkurtumėte."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ വലിക്കുക അല്ലെങ്കിൽ വിരലുകൾ അകറ്റുക. പഴയപടിയാക്കാൻ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो ओढा किंवा बोटे पसरा. पूर्ववत करण्यासाठी दोनदा टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto atau renggangkan jari. Ketik dua kali untuk tetapkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i bildet eller spre fingrene. Dobbelttrykk for å tilbakestille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de foto of spreid je vingers. Dubbeltik om te herstellen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଟାଣନ୍ତୁ କିମ୍ବା ଆଙ୍ଗୁଠି ବିସ୍ତାର କରନ୍ତୁ। ପୂର୍ବ ପରି କରିବାକୁ ଦୁଇଥର ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਖਿੱਚੋ ਜਾਂ ਉਂਗਲਾਂ ਫੈਲਾਓ। ਪਹਿਲਾਂ ਵਾਂਗ ਕਰਨ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij zdjęcie lub rozsuń palce. Stuknij dwukrotnie, aby wrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a foto ou afaste os dedos. Toque duas vezes para voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a fotografia ou afaste os dedos. Toque duas vezes para repor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage fotografia sau depărtează degetele. Atinge de două ori pentru resetare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťahajte fotku alebo roztiahnite prsty. Dvojitým klepnutím obnovíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlecite fotografijo ali razprite prste. Dvakrat tapnite za ponastavitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra fotot eller sära på fingrarna. Dubbeltryck för att återställa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்தை இழுக்கவும் அல்லது விரல்களை விரிக்கவும். பழையபடி ஆக்க இருமுறை தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోను లాగండి లేదా వేళ్లను విప్పండి. మునుపటిలా చేయడానికి రెండుసార్లు నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรูปถ่ายหรือกางนิ้ว แตะสองครั้งเพื่อคืนค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı sürükleyin ya da parmaklarınızı açın. Sıfırlamak için iki kez dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягніть знімок або розведіть пальці. Подвійне натискання поверне як було."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر کھینچیں یا انگلیاں پھیلائیں۔ پہلے جیسا کرنے کے لیے دو بار تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo ảnh hoặc xòe ngón tay. Chạm hai lần để đặt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动照片或张开手指。连按两下可复原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移照片或張開手指。點兩下可復原。"
          }
        }
      }
    },
    "Похоже, земля сохнет быстрее: %1$@ вместо %2$@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن التربة تجف أسرع: %1$@ بدلًا من %2$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изглежда пръстта съхне по-бързо: %1$@ вместо %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনে হচ্ছে মাটি তাড়াতাড়ি শুকাচ্ছে: %2$@-এর বদলে %1$@।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembla que la terra s’asseca més de pressa: %1$@ en lloc de %2$@."
