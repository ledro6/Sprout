    "Сад стоит. Нажмите на растение, чтобы полить его.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحديقة في مكانها. اضغط على نبتة لسقيها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Градината е поставена. Докоснете растение, за да го полеете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাগান রাখা হয়েছে। জল দিতে গাছে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardí és al seu lloc. Toca una planta per regar-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrada stojí. Klepnutím na rostlinu ji zalijete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven står på plads. Tryk på en plante for at vande den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Garten steht. Tippe auf eine Pflanze, um sie zu gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κήπος τοποθετήθηκε. Πατήστε ένα φυτό για να το ποτίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden is in place. Tap a plant to water it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardín está colocado. Toca una planta para regarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarha on paikallaan. Kastele kasvi napauttamalla sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jardin est en place. Touchez une plante pour l’arroser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બગીચો મુકાઈ ગયો. પાણી આપવા છોડ પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגינה במקום. הקישו על צמח כדי להשקות אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचा रख दिया गया। पानी देने के लिए पौधे पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrt stoji. Dodirnite biljku da je zalijete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kert a helyén van. Koppints egy növényre a megöntözéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebun sudah diletakkan. Ketuk tanaman untuk menyiramnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giardino è posizionato. Tocca una pianta per annaffiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭を配置しました。植物をタップすると水やりできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақ орнады. Суару үшін өсімдікті түртіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೋಟ ಇರಿಸಲಾಗಿದೆ. ನೀರು ಹಾಕಲು ಗಿಡವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원을 배치했어요. 식물을 탭하면 물을 줄 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodas pastatytas. Bakstelėkite augalą, kad jį palaistytumėte."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തോട്ടം വച്ചു. നനയ്ക്കാൻ ചെടിയിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाग ठेवली. पाणी घालण्यासाठी रोपावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taman sudah diletakkan. Ketik tumbuhan untuk menyiramnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen står på plass. Trykk på en plante for å vanne den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tuin staat. Tik op een plant om hem water te geven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଗିଚା ରଖାଗଲା। ପାଣି ଦେବାକୁ ଗଛ ଉପରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਗੀਚਾ ਰੱਖ ਦਿੱਤਾ। ਪਾਣੀ ਦੇਣ ਲਈ ਪੌਦੇ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogród stoi. Stuknij roślinę, aby ją podlać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está no lugar. Toque numa planta para regá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está no lugar. Toque numa planta para a regar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grădina e așezată. Atinge o plantă ca s-o uzi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záhrada stojí. Klepnutím na rastlinu ju polejete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrt stoji. Tapnite rastlino, da jo zalijete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trädgården står på plats. Tryck på en växt för att vattna den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோட்டம் வைக்கப்பட்டது. தண்ணீர் ஊற்ற செடியைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తోట ఉంచబడింది. నీళ్లు పోయడానికి మొక్కను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางสวนแล้ว แตะต้นไม้เพื่อรดน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçe yerleşti. Sulamak için bir bitkiye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сад стоїть. Натисніть на рослину, щоб полити її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باغ رکھ دیا گیا۔ پانی دینے کے لیے پودے پر تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vườn đã được đặt. Chạm vào cây để tưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花园已放置。轻点植物即可浇水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花園已放置。點一下植物即可澆水。"
          }
        }
      }
    },
    "Сад только начинается — самое интересное впереди.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حديقتك في بدايتها — والأجمل لم يأتِ بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Градината тепърва започва — най-хубавото предстои."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাগান সবে শুরু হলো — সেরাটা এখনও বাকি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu jardí tot just comença: el millor encara ha d’arribar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zahrada teprve začíná — to nejlepší je před vámi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din have er kun lige begyndt – det bedste venter forude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten fängt gerade erst an – das Beste kommt noch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κήπος σας μόλις ξεκινά — τα καλύτερα έρχονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is just getting started — the best is yet to come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jardín acaba de empezar: lo mejor está por llegar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhasi on vasta alussa – paras on vielä edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jardin ne fait que commencer — le meilleur reste à venir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બગીચો હજી શરૂ થયો છે — શ્રેષ્ઠ હજી આવવાનું બાકી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגינה רק מתחילה — הכי טוב עוד לפנינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचा अभी शुरू हुआ है — सबसे अच्छा आगे है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš vrt tek počinje — najbolje tek dolazi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kerted még csak most kezdődik — a java még hátravan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebun Anda baru saja dimulai — yang terbaik masih akan datang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino è appena all’inizio: il meglio deve ancora venire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭はまだ始まったばかり。本番はこれから。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақ енді басталып жатыр — ең қызығы алда."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೋಟ ಈಗಷ್ಟೇ ಶುರುವಾಗಿದೆ — ಅತ್ಯುತ್ತಮವಾದುದು ಇನ್ನೂ ಬರಲಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원은 이제 막 시작했어요. 가장 좋은 건 아직 남았어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų sodas tik pradeda — geriausia dar laukia."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തോട്ടം തുടങ്ങിയതേയുള്ളൂ — ഏറ്റവും നല്ലത് ഇനിയും വരാനിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाग आत्ताच सुरू झाली आहे — सर्वोत्तम अजून यायचे आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taman anda baru bermula — yang terbaik masih belum tiba."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen din har så vidt begynt – det beste venter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin is net begonnen — het mooiste komt nog."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଗିଚା ଏବେ ଆରମ୍ଭ ହେଲା — ସବୁଠୁ ଭଲ ଏବେ ଆସିବାକୁ ବାକି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਗੀਚਾ ਹੁਣੇ ਸ਼ੁਰੂ ਹੋਇਆ ਹੈ — ਸਭ ਤੋਂ ਵਧੀਆ ਅਜੇ ਆਉਣਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ogród dopiero się zaczyna — najlepsze przed tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jardim está só começando — o melhor ainda está por vir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu jardim está só a começar — o melhor ainda está para vir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grădina ta abia începe — ce e mai frumos abia urmează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša záhrada sa ešte len začína — to najlepšie príde."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš vrt se šele začenja — najboljše šele prihaja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din trädgård har precis börjat – det bästa återstår."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோட்டம் இப்போதுதான் தொடங்கியுள்ளது — சிறந்தது இனிமேல்தான்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తోట ఇప్పుడే మొదలైంది — అసలైనది ఇంకా రానుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวนของคุณเพิ่งเริ่มต้น — สิ่งที่ดีที่สุดยังรออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz daha yeni başlıyor — en güzeli önünüzde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сад тільки починається — найцікавіше попереду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باغ ابھی شروع ہوا ہے — بہترین ابھی آنا باقی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vườn mới chỉ bắt đầu — điều tuyệt nhất còn ở phía trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花园才刚刚开始——精彩还在后头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花園才剛剛開始——精彩還在後頭。"
          }
        }
      }
    },
