    "Уведомление на телефон, когда земля у растения подсохла ниже выбранного порога.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار على الهاتف عندما تجف تربة النبتة إلى ما دون الحد الذي اخترته."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известие на телефона, когато почвата на растение изсъхне под избрания праг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো গাছের মাটি বেছে নেওয়া সীমার নিচে শুকিয়ে গেলে ফোনে আসা বিজ্ঞপ্তি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avís al telèfon quan la terra d’una planta s’ha assecat per sota del llindar triat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení v telefonu, když zemina u rostliny vyschne pod zvolenou hranici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En notifikation på telefonen, når jorden hos en plante er tørret under den valgte grænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung aufs Telefon, wenn die Erde einer Pflanze unter die gewählte Grenze getrocknet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ειδοποίηση στο τηλέφωνο όταν το χώμα ενός φυτού στεγνώσει κάτω από το όριο που διαλέξατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification on your phone when a plant’s soil has dried below the level you chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso en el teléfono cuando la tierra de una planta se ha secado por debajo del umbral elegido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitus puhelimeen, kun kasvin multa on kuivunut valitun rajan alle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification sur le téléphone quand la terre d’une plante a séché sous le seuil choisi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે કોઈ છોડની માટી પસંદ કરેલી મર્યાદાથી નીચે સુકાઈ જાય ત્યારે ફોન પર સૂચના."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראה בטלפון כשהאדמה של צמח התייבשה מתחת לסף שבחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन पर सूचना, जब किसी पौधे की मिट्टी चुनी गई सीमा से नीचे सूख जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijest na telefonu kad se zemlja neke biljke osuši ispod odabranog praga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés a telefonon, amikor egy növény földje a választott küszöb alá szárad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi di ponsel saat tanah tanaman mengering di bawah batas yang kamu pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica sul telefono quando la terra di una pianta si è asciugata sotto la soglia scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物の土が選んだ基準より乾いたときに届く通知です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдіктің топырағы таңдалған шектен төмен кепкенде телефонға келетін хабарландыру."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡದ ಮಣ್ಣು ನೀವು ಆರಿಸಿದ ಮಟ್ಟಕ್ಕಿಂತ ಕೆಳಗೆ ಒಣಗಿದಾಗ ಫೋನ್‌ಗೆ ಬರುವ ಸೂಚನೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물의 흙이 정한 기준보다 마르면 휴대폰으로 오는 알림이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimas telefone, kai augalo žemė išdžiūsta žemiau pasirinktos ribos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചെടിയുടെ മണ്ണ് നിങ്ങൾ തിരഞ്ഞെടുത്ത നിലയ്ക്ക് താഴെ ഉണങ്ങുമ്പോൾ ഫോണിൽ വരുന്ന അറിയിപ്പ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखाद्या रोपाची माती तुम्ही निवडलेल्या पातळीखाली सुकल्यावर फोनवर येणारी सूचना."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan di telefon apabila tanah tumbuhan kering di bawah had yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et varsel på telefonen når jorda til en plante har tørket under grensen du valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding op je telefoon als de grond van een plant onder de gekozen grens is opgedroogd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ଗଛର ମାଟି ଆପଣ ବାଛିଥିବା ସୀମା ତଳକୁ ଶୁଖିଗଲେ ଫୋନରେ ଆସୁଥିବା ବିଜ୍ଞପ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ’ਤੇ ਸੂਚਨਾ, ਜਦੋਂ ਕਿਸੇ ਪੌਦੇ ਦੀ ਮਿੱਟੀ ਚੁਣੀ ਹੱਦ ਤੋਂ ਹੇਠਾਂ ਸੁੱਕ ਜਾਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie na telefonie, gdy ziemia rośliny przeschnie poniżej wybranego progu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação no celular quando a terra de uma planta secou abaixo do limite escolhido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação no telemóvel quando a terra de uma planta secou abaixo do limite escolhido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare pe telefon când pământul unei plante s-a uscat sub pragul ales."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie v telefóne, keď zemina rastliny vyschne pod zvolenú hranicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestilo na telefonu, ko se zemlja pri rastlini posuši pod izbrani prag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En notis i telefonen när jorden hos en växt har torkat under den gräns du valt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு செடியின் மண் நீங்கள் தேர்ந்த அளவுக்குக் கீழே காய்ந்தால் போனில் வரும் அறிவிப்பு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్క మట్టి మీరు ఎంచుకున్న స్థాయి కంటే కిందకు ఎండినప్పుడు ఫోన్‌కు వచ్చే నోటిఫికేషన్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนบนโทรศัพท์เมื่อดินของต้นไม้แห้งต่ำกว่าเกณฑ์ที่เลือกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkinin toprağı seçtiğiniz eşiğin altına kuruduğunda telefona gelen bildirim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення на телефон, коли земля в рослини підсохла нижче обраного порогу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون پر اطلاع جب کسی پودے کی مٹی منتخب حد سے نیچے سوکھ جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo trên điện thoại khi đất của cây khô dưới ngưỡng bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物的土干到你设定的阈值以下时，手机收到的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "植物的土乾到你設定的門檻以下時，手機收到的通知。"
          }
        }
      }
