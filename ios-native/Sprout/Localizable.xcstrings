    "Показаны %1$lld из %2$lld: больше телефону тяжело": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض %1$lld من %2$lld: أكثر من ذلك يُثقل الهاتف"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показани %1$lld от %2$lld: повече е тежко за телефона"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld-এর মধ্যে %1$lldটি দেখানো হচ্ছে: আরও হলে ফোনের জন্য ভারী"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostren %1$lld de %2$lld: més seria massa per al telèfon"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno %1$lld z %2$lld: víc by bylo na telefon moc"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser %1$lld af %2$lld: flere bliver for tungt for telefonen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld angezeigt: Mehr wäre zu viel für das Telefon"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται %1$lld από %2$lld: περισσότερα θα βάραιναν το τηλέφωνο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing %1$lld of %2$lld: more would strain the phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %1$lld de %2$lld: más sería demasiado para el teléfono"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään %1$lld/%2$lld: enempää puhelin ei jaksa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld affichées : davantage serait trop lourd pour le téléphone"
          }
        },
        "gu": {
          "stringUnit": {
