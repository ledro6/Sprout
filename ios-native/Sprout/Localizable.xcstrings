    "Снимок тёмный — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة داكنة جدًا — سأستخدم النموذج الجاهز للنوع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е тъмна — ще взема готовия модел на вида."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি খুব অন্ধকার — প্রজাতির তৈরি মডেল নেব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto és massa fosca: faré servir el model a punt de l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je příliš tmavá — použiji hotový model druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er for mørkt – jeg bruger artens færdige model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist zu dunkel — ich nehme das fertige Modell der Art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι πολύ σκοτεινή — θα χρησιμοποιήσω το έτοιμο μοντέλο του είδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is too dark — I’ll use the species’ ready-made model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está muy oscura: usaré el modelo listo de la especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on liian tumma – käytän lajin valmista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est trop sombre — je prendrai le modèle prêt de l’espèce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો બહુ અંધારો છે — પ્રજાતિનું તૈયાર મૉડલ લઈશ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה חשוכה מדי — אשתמש במודל המוכן של הזן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो बहुत अँधेरी है — प्रजाति का तैयार मॉडल लूँगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je pretamna — uzet ću gotov model vrste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó túl sötét — a faj kész modelljét használom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya terlalu gelap — aku pakai model siap pakai spesies ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è troppo scura: userò il modello pronto della specie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が暗すぎます — この種類の既製モデルを使います。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет тым қараңғы — түрдің дайын моделін аламын."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 너무 어두워요 — 이 종의 기본 모델을 사용할게요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka per tamsi – naudosiu paruoštą rūšies modelį."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो खूप अंधारा आहे — प्रजातीचे तयार मॉडेल वापरेन."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu gelap — saya guna model sedia ada spesies ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er for mørkt – jeg bruker artens ferdige modell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is te donker — ik neem het kant-en-klare model van de soort."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ବହୁତ ଅନ୍ଧାର — ପ୍ରଜାତିର ପ୍ରସ୍ତୁତ ମଡେଲ୍ ନେବି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਬਹੁਤ ਹਨੇਰੀ ਹੈ — ਕਿਸਮ ਦਾ ਤਿਆਰ ਮਾਡਲ ਲਵਾਂਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest zbyt ciemne — użyję gotowego modelu gatunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto está escura demais — vou usar o modelo pronto da espécie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia está demasiado escura — vou usar o modelo pronto da espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia e prea întunecată — voi folosi modelul gata al speciei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je príliš tmavá — použijem hotový model druhu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je pretemna — uporabil bom pripravljen model vrste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot är för mörkt – jag tar artens färdiga modell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปมืดเกินไป — จะใช้โมเดลสำเร็จรูปของพันธุ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çok karanlık — türün hazır modelini kullanacağım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімок темний — візьму готову модель виду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh quá tối — mình sẽ dùng mô hình có sẵn của loài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片太暗——将使用该品种的现成模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片太暗——將使用該品種的現成模型。"
          }
        }
      }
