          "stringUnit": {
            "state": "translated",
            "value": "Haven er tom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Garten ist leer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κήπος είναι άδειος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden is empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardín está vacío."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarha on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jardin est vide."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બગીચો ખાલી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגינה ריקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचा खाली है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrt je prazan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kert üres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebun kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giardino è vuoto."
