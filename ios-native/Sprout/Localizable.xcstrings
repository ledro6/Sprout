        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдік сонда көшеді, ал бөлме тізімде пайда болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡ ಅಲ್ಲಿಗೆ ಹೋಗುತ್ತದೆ, ಕೋಣೆ ಪಟ್ಟಿಯಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 그곳으로 옮겨지고 방이 목록에 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalas persikels ten, o kambarys atsiras sąraše."
