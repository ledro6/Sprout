            "value": "Farben, Dichte und Höhe – aus dem Foto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρώματα, πυκνότητα και ύψος — από τη φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors, density and height — from the photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores, densidad y altura, a partir de la foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värit, tuuheus ja korkeus – kuvasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs, densité et taille — d’après la photo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રંગ, ઘનતા અને ઊંચાઈ — ફોટામાંથી."
          }
        },
        "he": {
          "stringUnit": {
