    "Покажите друзьям, как рос ваш сад.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرِ أصدقاءك كيف نمت حديقتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажете на приятели как расте градината ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধুদের দেখান আপনার বাগান কেমন বেড়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensenya als amics com ha crescut el teu jardí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukažte přátelům, jak vaše zahrada rostla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis dine venner, hvordan din have er vokset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig deinen Freunden, wie dein Garten gewachsen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείξτε στους φίλους σας πώς μεγάλωσε ο κήπος σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your friends how your garden grew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseña a tus amigos cómo creció tu jardín."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä ystävillesi, miten puutarhasi kasvoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez à vos amis comment votre jardin a grandi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મિત્રોને બતાવો કે તમારો બગીચો કેવી રીતે વધ્યો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדאי להראות לחברים איך הגינה גדלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों को दिखाएँ कि आपका बगीचा कैसे बढ़ा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokažite prijateljima kako je vaš vrt rastao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutasd meg a barátaidnak, hogyan nőtt a kerted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan pada teman bagaimana kebun Anda tumbuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ai tuoi amici come è cresciuto il tuo giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭の成長を友達に見せましょう。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағыңыздың қалай өскенін достарға көрсетіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ತೋಟ ಹೇಗೆ ಬೆಳೆಯಿತು ಎಂದು ಸ್ನೇಹಿತರಿಗೆ ತೋರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원이 어떻게 자랐는지 친구에게 보여 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parodykite draugams, kaip augo jūsų sodas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തോട്ടം എങ്ങനെ വളർന്നുവെന്ന് കൂട്ടുകാരെ കാണിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मित्रांना दाखवा तुमची बाग कशी वाढली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan kepada rakan bagaimana taman anda membesar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis vennene dine hvordan hagen din vokste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je vrienden zien hoe je tuin is gegroeid."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଗିଚା କିପରି ବଢ଼ିଲା ସାଙ୍ଗମାନଙ୍କୁ ଦେଖାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੋਸਤਾਂ ਨੂੰ ਦਿਖਾਓ ਕਿ ਤੁਹਾਡਾ ਬਗੀਚਾ ਕਿਵੇਂ ਵਧਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż znajomym, jak rósł twój ogród."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre aos amigos como seu jardim cresceu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre aos amigos como o seu jardim cresceu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată-le prietenilor cum a crescut grădina ta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážte priateľom, ako vaša záhrada rástla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokažite prijateljem, kako je vaš vrt rasel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa dina vänner hur din trädgård har vuxit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தோட்டம் எப்படி வளர்ந்தது என்று நண்பர்களுக்குக் காட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ తోట ఎలా పెరిగిందో స్నేహితులకు చూపించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อวดเพื่อน ๆ ว่าสวนของคุณเติบโตแค่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçenizin nasıl büyüdüğünü arkadaşlarınıza gösterin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажіть друзям, як ріс ваш сад."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوستوں کو دکھائیں کہ آپ کا باغ کیسے بڑھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoe với bạn bè khu vườn của bạn đã lớn thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给朋友看看你的花园是怎么长大的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給朋友看看你的花園是怎麼長大的。"
          }
        }
      }
    },
    "Показаны %1$lld из %2$lld: больше телефону тяжело": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض %1$lld من %2$lld: أكثر من ذلك يُثقل الهاتف"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показани %1$lld от %2$lld: повече е тежко за телефона"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld-এর মধ্যে %1$lldটি দেখানো হচ্ছে: আরও হলে ফোনের জন্য ভারী"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostren %1$lld de %2$lld: més seria massa per al telèfon"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno %1$lld z %2$lld: víc by bylo na telefon moc"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser %1$lld af %2$lld: flere bliver for tungt for telefonen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld angezeigt: Mehr wäre zu viel für das Telefon"
          }
