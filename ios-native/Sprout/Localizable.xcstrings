    "Все дождутся вас: перед отъездом полейте — и можно ехать.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle venter på dig: Vand dem, før du tager af sted – så kan du rejse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle halten durch: Gieß sie vor der Abreise — und los geht’s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone will wait for you: water them before you leave and off you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas te esperarán: riégalas antes de irte y listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki odottavat sinua: kastele ne ennen lähtöä, niin voit lähteä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vous attendront : arrosez-les avant de partir, et c’est parti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte ti aspetteranno: annaffiale prima di partire e via."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle venter på deg: Vann dem før du drar – så kan du reise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wachten allemaal op je: geef ze water voor je vertrekt en klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas vão esperar por você: regue antes de sair e pode ir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas vão esperar por si: regue antes de partir e pode ir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla väntar på dig: vattna före avresan och åk."
          }
        }
      }
    },
