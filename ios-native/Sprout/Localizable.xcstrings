        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପାଖରେ କେତେ ଗଛ ଓ କୋଠରୀ ଅଛି, ଓ କେତେ ଦିନ ହେବ ଆପଣ ବଗିଚାର ଯତ୍ନ ନେଉଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਕੋਲ ਕਿੰਨੇ ਪੌਦੇ ਅਤੇ ਕਮਰੇ ਹਨ, ਅਤੇ ਕਿੰਨੇ ਦਿਨਾਂ ਤੋਂ ਤੁਸੀਂ ਬਗੀਚੇ ਦੀ ਦੇਖਭਾਲ ਕਰ ਰਹੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile masz roślin i pokoi oraz od ilu dni dbasz o ogród."
          }
        },
        "pt-BR": {
