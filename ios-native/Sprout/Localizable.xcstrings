    "Счёт от %@. Обновится, когда друг пришлёт код снова.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Score fra %@. Opdateres, når din ven sender koden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand vom %@. Wird aktualisiert, wenn dein Freund den Code erneut schickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score as of %@. It updates when your friend sends their code again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntuación del %@. Se actualizará cuando tu amigo vuelva a enviar su código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisteet %@. Päivittyy, kun kaverisi lähettää koodin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Score du %@. Il sera mis à jour quand votre ami renverra son code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punteggio del %@. Si aggiornerà quando il tuo amico invierà di nuovo il codice."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poeng fra %@. Oppdateres når vennen sender koden på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Score van %@. Wordt bijgewerkt als je vriend de code opnieuw stuurt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando seu amigo enviar o código de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontuação de %@. Atualiza quando o seu amigo voltar a enviar o código."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poäng från %@. Uppdateras när vännen skickar koden igen."
          }
        }
      }
    },
