            "value": "%2$lld개 중 %1$lld개 표시: 더 많으면 기기에 무리예요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma %1$lld iš %2$lld: daugiau telefonui būtų per sunku"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld-ൽ %1$lld കാണിക്കുന്നു: കൂടുതലായാൽ ഫോണിന് ഭാരം"
