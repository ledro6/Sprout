    "Ошибочную запись удалит долгое нажатие.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف الإدخال الخاطئ بضغطة مطوّلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешен запис се изтрива с продължително натискане."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsació llarga esborra una entrada errònia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybný záznam smažete dlouhým podržením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en forkert post nede for at slette den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen falschen Eintrag löschst du durch langes Drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια λάθος εγγραφή διαγράφεται με παρατεταμένο πάτημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press to delete a mistaken entry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación larga borra una entrada errónea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista virheellinen merkintä pitkällä painalluksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long supprime une entrée erronée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומה שגויה נמחקת בלחיצה ארוכה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogrešan unos brišete dugim pritiskom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibás bejegyzést hosszú nyomással törölhetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione prolungata elimina una voce sbagliata."
          }
        },
