    "Снимок мыльный — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة ضبابية — سأستخدم النموذج الجاهز للنوع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е размазана — ще взема готовия модел на вида."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto està desenfocada: faré servir el model a punt de l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je rozmazaná — použiji hotový model druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er uskarpt – jeg bruger artens færdige model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist unscharf — ich nehme das fertige Modell der Art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι θολή — θα χρησιμοποιήσω το έτοιμο μοντέλο του είδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is blurry — I’ll use the species’ ready-made model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está borrosa: usaré el modelo listo de la especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on epätarkka – käytän lajin valmista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est floue — je prendrai le modèle prêt de l’espèce."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה מטושטשת — אשתמש במודל המוכן של הזן."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je mutna — uzet ću gotov model vrste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó elmosódott — a faj kész modelljét használom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è sfocata: userò il modello pronto della specie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет бұлыңғыр — түрдің дайын моделін аламын."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka neryški – naudosiu paruoštą rūšies modelį."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er uskarpt – jeg bruker artens ferdige modell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is onscherp — ik neem het kant-en-klare model van de soort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest nieostre — użyję gotowego modelu gatunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto está desfocada — vou usar o modelo pronto da espécie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia está desfocada — vou usar o modelo pronto da espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia e neclară — voi folosi modelul gata al speciei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je rozmazaná — použijem hotový model druhu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je zamegljena — uporabil bom pripravljen model vrste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot är suddigt – jag tar artens färdiga modell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf bulanık — türün hazır modelini kullanacağım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімок розмитий — візьму готову модель виду."
          }
        }
      }
    },
