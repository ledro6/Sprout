    "На телефоне нет ни Face ID, ни код-пароля.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في هذا الهاتف بصمة وجه ولا رمز دخول."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът няма нито Face ID, нито код."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে Face ID বা পাসকোড কোনোটিই নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest telèfon no té Face ID ni codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon nemá Face ID ani kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen har hverken Face ID eller adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat weder Face ID noch einen Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το τηλέφωνο δεν έχει ούτε Face ID ούτε κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has neither Face ID nor a passcode."
          }
