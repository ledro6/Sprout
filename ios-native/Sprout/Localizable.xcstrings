    "Один круг — один срок полива. Ближние орбиты у тех, кто сохнет быстро, дальние — у терпеливых.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدورة الواحدة موعد سقي واحد. المدارات القريبة للتي تجف بسرعة، والبعيدة للصبورة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Една обиколка е един интервал на поливане. Близките орбити са на бързо изсъхващите, далечните – на търпеливите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক পাক মানে জল দেওয়ার একটি ব্যবধান। কাছের কক্ষপথ তাড়াতাড়ি শুকোনো গাছের, দূরেরগুলো ধৈর্যশীলদের।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una òrbita és un interval de reg. Les òrbites properes són de les que s’assequen de pressa; les llunyanes, de les pacients."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden oběh je jeden interval zalévání. Blízké dráhy mají rostliny, které rychle vysychají, vzdálené ty trpělivé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én omgang er ét vandingsinterval. De indre baner tilhører dem, der tørrer hurtigt, de ydre de tålmodige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Umlaufbahn ist ein Gießintervall. Innen kreisen die, die schnell austrocknen, außen die Geduldigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία τροχιά είναι ένα διάστημα ποτίσματος. Οι κοντινές τροχιές ανήκουν σε όσα ξεραίνονται γρήγορα, οι μακρινές στα υπομονετικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One orbit is one watering interval. Inner orbits belong to quick-drying plants, outer ones to the patient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una órbita es un intervalo de riego. Las órbitas cercanas son de las que se secan rápido; las lejanas, de las pacientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kierros on yksi kasteluväli. Sisemmät radat kuuluvat nopeasti kuivuville, ulommat kärsivällisille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une orbite, c’est une fréquence d’arrosage. Les orbites proches sont celles des plantes qui sèchent vite, les lointaines celles des patientes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક ચક્કર એટલે પાણી આપવાનો એક ગાળો. નજીકની કક્ષાઓ જલદી સુકાતા છોડની, દૂરની ધીરજવાળાની."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקפה אחת היא תדירות השקיה אחת. המסלולים הקרובים שייכים למתייבשים מהר, הרחוקים – לסבלניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चक्कर पानी देने का एक अंतराल है। पास की कक्षाएँ जल्दी सूखने वालों की, दूर की धैर्यवानों की।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan krug je jedan interval zalijevanja. Bliske putanje imaju biljke koje brzo sahnu, daleke one strpljive."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kör egy öntözési időköz. A belső pályák a gyorsan száradóké, a külsők a türelmeseké."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu putaran adalah satu jarak siram. Orbit dekat milik yang cepat kering, orbit jauh milik yang sabar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’orbita è un intervallo di annaffiatura. Le orbite vicine sono di chi si asciuga in fretta, quelle lontane delle pazienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1周が水やりの間隔。内側の軌道は乾きやすい植物、外側は我慢強い植物です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір айналым — бір суару мерзімі. Жақын орбиталар тез кебетіндерде, алыстары — шыдамдыларда."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಸುತ್ತು ಒಂದು ನೀರು ಹಾಕುವ ಅಂತರ. ಹತ್ತಿರದ ಕಕ್ಷೆಗಳು ಬೇಗ ಒಣಗುವವರದ್ದು, ದೂರದವು ತಾಳ್ಮೆಯವರದ್ದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 바퀴가 물주기 간격입니다. 안쪽 궤도는 빨리 마르는 식물, 바깥쪽은 참을성 있는 식물이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienas ratas – vienas laistymo intervalas. Artimos orbitos – greitai džiūstančių, tolimos – kantriųjų."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചുറ്റ് ഒരു നനയ്ക്കൽ ഇടവേളയാണ്. അടുത്ത ഭ്രമണപഥങ്ങൾ വേഗം ഉണങ്ങുന്നവരുടേത്, അകലെയുള്ളവ ക്ഷമയുള്ളവരുടേത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फेरी म्हणजे पाणी देण्याचे एक अंतर. जवळच्या कक्षा लवकर सुकणाऱ्यांच्या, दूरच्या धीराच्या रोपांच्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pusingan ialah satu selang siraman. Orbit dekat milik yang cepat kering, orbit jauh milik yang sabar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én runde er ett vanningsintervall. De indre banene tilhører de som tørker fort, de ytre de tålmodige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén baan is één gietinterval. Binnenbanen horen bij snelle drogers, buitenbanen bij de geduldigen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ ପରିକ୍ରମା ଏକ ପାଣି ଦେବା ବ୍ୟବଧାନ। ନିକଟ କକ୍ଷପଥ ଶୀଘ୍ର ଶୁଖୁଥିବାଙ୍କର, ଦୂର ଧୈର୍ଯ୍ୟଶୀଳଙ୍କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਚੱਕਰ ਪਾਣੀ ਦੇਣ ਦਾ ਇੱਕ ਵਕਫ਼ਾ ਹੈ। ਨੇੜਲੇ ਪੰਧ ਛੇਤੀ ਸੁੱਕਣ ਵਾਲਿਆਂ ਦੇ, ਦੂਰਲੇ ਸਬਰ ਵਾਲਿਆਂ ਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno okrążenie to jeden odstęp podlewania. Bliskie orbity mają te, co szybko schną, dalekie – cierpliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma órbita é um intervalo de rega. As órbitas próximas são das que secam rápido; as distantes, das pacientes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma órbita é um intervalo de rega. As órbitas próximas são das que secam depressa; as distantes, das pacientes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O orbită e un interval de udare. Orbitele apropiate sunt ale celor care se usucă repede, cele îndepărtate – ale celor răbdătoare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden obeh je jeden interval polievania. Blízke dráhy majú rastliny, ktoré rýchlo vysychajú, vzdialené tie trpezlivé."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "En krog je en interval zalivanja. Bližnje tirnice imajo rastline, ki se hitro sušijo, oddaljene tiste potrpežljive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett varv är ett vattningsintervall. De inre banorna hör till de som torkar fort, de yttre till de tålmodiga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சுற்று ஒரு நீர் ஊற்றும் இடைவெளி. அருகிலுள்ள சுற்றுப்பாதைகள் விரைவில் காய்பவற்றுக்கு, தொலைவானவை பொறுமையானவற்றுக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక చుట్టు ఒక నీళ్లు పోసే విరామం. దగ్గరి కక్ష్యలు త్వరగా ఎండే వాటివి, దూరపువి ఓపిక గలవాటివి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งรอบคือหนึ่งช่วงรดน้ำ วงโคจรใกล้เป็นของต้นที่แห้งเร็ว วงโคจรไกลเป็นของต้นที่อดทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tur bir sulama aralığıdır. İç yörüngeler çabuk kuruyanların, dış yörüngeler sabırlıların."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне коло — один строк поливу. Ближні орбіти в тих, хто сохне швидко, дальні — у терплячих."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک چکر پانی دینے کا ایک وقفہ ہے۔ قریب کے مدار جلد سوکھنے والوں کے ہیں، دور کے صابر پودوں کے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một vòng là một khoảng tưới. Quỹ đạo gần thuộc về cây mau khô, quỹ đạo xa thuộc về cây kiên nhẫn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕一圈就是一个浇水间隔。内圈属于干得快的植物，外圈属于耐得住的植物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繞一圈就是一個澆水間隔。內圈屬於乾得快的植物，外圈屬於耐得住的植物。"
          }
        }
      }
    },
    "Одно нажатие — и полив записан. Передумали — внизу появится «Вернуть».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطة واحدة وتُسجَّل السقية. غيّرت رأيك؟ يظهر «تراجع» في الأسفل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Едно докосване и поливането е записано. Размислихте ли? Долу се появява „Върни“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক ট্যাপেই জল দেওয়া লেখা হয়ে যায়। মত বদলেছেন? নিচে “পূর্বাবস্থা” দেখাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toc i el reg queda anotat. Has canviat d’idea? A baix apareix «Desfés»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klepnutí a zalití je zapsané. Rozmysleli jste se? Dole se objeví „Vrátit“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk, og vandingen er noteret. Fortrudt? Nederst dukker ”Fortryd” op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen, und das Gießen ist notiert. Anders überlegt? Unten erscheint „Widerrufen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα άγγιγμα και το πότισμα καταγράφεται. Αλλάξατε γνώμη; Κάτω εμφανίζεται «Αναίρεση»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap and the watering is logged. Changed your mind? “Undo” appears at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque y el riego queda anotado. ¿Cambiaste de idea? Abajo aparece «Deshacer»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus, ja kastelu on kirjattu. Muutitko mielesi? Alas ilmestyy ”Kumoa”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher et l’arrosage est noté. Vous changez d’avis ? « Annuler » apparaît en bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક ટૅપ અને પાણી આપવાનું નોંધાયું. વિચાર બદલાયો? નીચે “પૂર્વવત્ કરો” દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה אחת וההשקיה נרשמה. התחרטתם? למטה יופיע “ביטול פעולה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप और पानी देना दर्ज। मन बदल गया? नीचे “पूर्ववत करें” दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan dodir i zalijevanje je zapisano. Predomislili ste se? Dolje se pojavi „Poništi”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás, és az öntözés rögzítve. Meggondoltad magad? Alul megjelenik a „Visszavonás”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketukan dan siraman tercatat. Berubah pikiran? “Urungkan” muncul di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco e l’annaffiatura è registrata. Ci hai ripensato? In basso compare “Annulla”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップひとつで水やりを記録。やっぱりやめる？ 下に「取り消す」が出ます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір түрту — суару жазылды. Ойыңыз өзгерді ме? Төменде «Қайтару» шығады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಟ್ಯಾಪ್‌ನಲ್ಲಿ ನೀರು ಹಾಕಿದ್ದು ದಾಖಲಾಗುತ್ತದೆ. ಮನಸ್ಸು ಬದಲಾಯಿತೇ? ಕೆಳಗೆ “ರದ್ದುಗೊಳಿಸಿ” ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 물주기가 기록됩니다. 마음이 바뀌었나요? 아래에 ‘실행 취소’가 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienas bakstelėjimas – ir laistymas užrašytas. Persigalvojote? Apačioje atsiras „Anuliuoti“."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ടാപ്പിൽ നനയ്ക്കൽ രേഖപ്പെടുത്തും. മനസ്സ് മാറിയോ? താഴെ “പഴയപടിയാക്കുക” കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टॅप आणि पाणी देणे नोंदले. विचार बदलला? खाली “पूर्ववत करा” दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan dan siraman direkodkan. Ubah fikiran? “Buat asal” muncul di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk, og vanningen er notert. Ombestemt deg? Nederst dukker «Angre» opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik en de gietbeurt staat genoteerd. Bedacht? Onderaan verschijnt ‘Herstel’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ ଟାପ୍‌ରେ ପାଣି ଦେବା ଲେଖାହୋଇଯାଏ। ମତ ବଦଳିଲା? ତଳେ “ପୂର୍ବବତ୍ କରନ୍ତୁ” ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਟੈਪ ਅਤੇ ਪਾਣੀ ਦੇਣਾ ਦਰਜ। ਮਨ ਬਦਲ ਗਿਆ? ਹੇਠਾਂ “ਅਣਕੀਤਾ ਕਰੋ” ਦਿਖੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie i podlanie zapisane. Zmiana zdania? Na dole pojawi się „Cofnij”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque e a rega fica registrada. Mudou de ideia? “Desfazer” aparece embaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque e a rega fica registada. Mudou de ideias? Em baixo aparece “Desfazer”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O atingere și udarea e notată. Te-ai răzgândit? Jos apare „Anulează”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klepnutie a poliatie je zapísané. Rozmysleli ste sa? Dole sa objaví „Vrátiť“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "En dotik in zalivanje je zapisano. Ste si premislili? Spodaj se prikaže »Razveljavi«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck och vattningen är noterad. Ångrat dig? Längst ned visas ”Ångra”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தட்டலில் நீர் ஊற்றல் பதிவாகிறது. மனம் மாறியதா? கீழே “செயல்தவிர்” தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ట్యాప్‌తో నీళ్లు పోసినట్లు నమోదవుతుంది. మనసు మారిందా? కింద “రద్దు చేయి” కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะครั้งเดียวก็บันทึกการรดน้ำ เปลี่ยนใจหรือ? “เลิกทำ” จะปรากฏด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dokunuş ve sulama kaydedilir. Fikrinizi mi değiştirdiniz? Altta “Geri al” çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне торкання — і полив записано. Передумали — внизу з’явиться «Повернути»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیپ اور پانی دینا درج ہو گیا۔ ارادہ بدل گیا؟ نیچے “کالعدم کریں” آ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chạm là lần tưới được ghi lại. Đổi ý? Nút “Hoàn tác” hiện ở dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下就记下浇水。改主意了？底部会出现“撤销”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下就記下澆水。改變主意了？底部會出現「還原」。"
          }
        }
      }
    },
