    "Это ваш собственный код: в таблице вы и так есть.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا رمزك أنت: أنت موجود في الجدول بالفعل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е вашият собствен код: и без това сте в таблицата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার নিজের কোড: আপনি তো আগে থেকেই তালিকায় আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És el teu propi codi: ja ets a la taula."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to váš vlastní kód: v tabulce už jste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er din egen kode: du er allerede i tabellen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein eigener Code: Du bist schon in der Tabelle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός είναι ο δικός σας κωδικός: είστε ήδη στον πίνακα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s your own code: you’re already in the table."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu propio código: ya estás en la tabla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on oma koodisi: olet jo taulukossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre propre code : vous êtes déjà dans le classement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમારો પોતાનો કોડ છે: તમે પહેલેથી કોષ્ટકમાં છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה הקוד שלך: כבר נמצאים בטבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका अपना कोड है: आप पहले से तालिका में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vaš vlastiti kod: već ste u tablici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a saját kódod: már szerepelsz a táblázatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kodemu sendiri: kamu sudah ada di tabel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo codice: sei già in classifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた自身のコードです：すでに表に載っています。"
          }
