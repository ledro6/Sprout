    "Лето: земля сохнет быстрее, поливать чаще": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيف: التربة تجف أسرع، اسقِ أكثر"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лято: пръстта съхне по-бързо, поливайте по-често"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রীষ্ম: মাটি তাড়াতাড়ি শুকায়, বেশি জল দিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiu: la terra s’asseca més de pressa, rega més"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Léto: zemina schne rychleji, zalévejte častěji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommer: jorden tørrer hurtigere, vand oftere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommer: Die Erde trocknet schneller, öfter gießen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλοκαίρι: το χώμα στεγνώνει πιο γρήγορα, ποτίζετε πιο συχνά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer: soil dries faster, water more often"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verano: la tierra se seca más rápido, riega más"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesä: multa kuivuu nopeammin, kastele useammin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Été : la terre sèche plus vite, arrosez plus souvent"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉનાળો: માટી ઝડપથી સુકાય છે, વધુ પાણી આપો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיץ: האדמה מתייבשת מהר יותר, להשקות יותר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्मी: मिट्टी जल्दी सूखती है, ज़्यादा पानी दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljeto: zemlja se suši brže, zalijevajte češće"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyár: a föld gyorsabban szárad, gyakrabban öntözz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim panas: tanah lebih cepat kering, siram lebih sering"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estate: il terriccio asciuga più in fretta, annaffia più spesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夏：土の乾きが早いので、水やりは多めに"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаз: топырақ тез кебеді, жиі суарыңыз"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇಸಿಗೆ: ಮಣ್ಣು ಬೇಗ ಒಣಗುತ್ತದೆ, ಹೆಚ್ಚು ನೀರು ಹಾಕಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여름: 흙이 빨리 말라요, 물은 더 자주"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasara: žemė džiūsta greičiau, laistykite dažniau"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വേനൽ: മണ്ണ് വേഗം ഉണങ്ങും, കൂടുതൽ നനയ്ക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हाळा: माती लवकर सुकते, जास्त पाणी द्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim panas: tanah cepat kering, siram lebih kerap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommer: jorda tørker raskere, vann oftere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zomer: de aarde droogt sneller, vaker water geven"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗ୍ରୀଷ୍ମ: ମାଟି ଶୀଘ୍ର ଶୁଖେ, ଅଧିକ ପାଣି ଦିଅନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗਰਮੀ: ਮਿੱਟੀ ਜਲਦੀ ਸੁੱਕਦੀ ਹੈ, ਵੱਧ ਪਾਣੀ ਦਿਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lato: ziemia schnie szybciej, podlewaj częściej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verão: a terra seca mais rápido, regue mais"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verão: a terra seca mais rápido, regue mais"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vară: pământul se usucă mai repede, udă mai des"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Leto: zemina schne rýchlejšie, polievajte častejšie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poletje: zemlja se suši hitreje, zalivajte pogosteje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommar: jorden torkar snabbare, vattna oftare"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோடை: மண் வேகமாக உலரும், அதிகமாகத் தண்ணீர் ஊற்றவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేసవి: మట్టి త్వరగా ఆరుతుంది, ఎక్కువ నీళ్లు పోయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฤดูร้อน: ดินแห้งเร็วขึ้น รดน้ำให้บ่อยขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz: toprak daha hızlı kurur, daha sık sulayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Літо: земля висихає швидше, поливати частіше"
