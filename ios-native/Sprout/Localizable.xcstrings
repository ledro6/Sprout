        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దగ్గర ఎన్ని మొక్కలు, గదులు ఉన్నాయి, ఎన్ని రోజులుగా తోటను చూసుకుంటున్నారు."
          }
