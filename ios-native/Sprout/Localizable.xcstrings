    "Sprout не собирает о вас никаких сведений и никуда их не передаёт.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout indsamler ingen oplysninger om dig og sender intet nogen steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout sammelt keine Informationen über dich und gibt nichts weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout collects no information about you and sends nothing anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout no recopila ninguna información sobre ti ni la envía a ninguna parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ei kerää sinusta mitään tietoja eikä lähetä mitään mihinkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ne collecte aucune information sur vous et ne transmet rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout non raccoglie informazioni su di te e non invia nulla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout samler ikke inn noen opplysninger om deg og sender ingenting noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout verzamelt geen gegevens over je en stuurt niets door."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout não coleta nenhuma informação sobre você e não envia nada para lugar nenhum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout não recolhe nenhuma informação sobre si e não envia nada para lado nenhum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout samlar inga uppgifter om dig och skickar inget någonstans."
          }
        }
      }
    },
