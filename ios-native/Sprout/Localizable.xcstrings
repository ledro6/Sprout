    "Растение «%@» удалено. Его можно вернуть.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت «%@». يمكنك استعادتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е изтрито. Може да се върне."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” মুছে ফেলা হয়েছে। ফেরানো যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» eliminada. La pots recuperar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ smazána. Můžete ji vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er slettet. Du kan hente den tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ gelöscht. Du kannst sie zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» διαγράφηκε. Μπορείτε να το επαναφέρετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deleted. You can bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminada. Puedes recuperarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” poistettu. Voit palauttaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » supprimée. Vous pouvez la récupérer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ડિલીટ થયો. પાછો લાવી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” נמחק. אפשר להחזיר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” डिलीट किया गया। इसे वापस ला सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” izbrisana. Možete je vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” törölve. Visszahozhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dihapus. Kamu bisa mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminata. Puoi recuperarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しました。元に戻せます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» жойылды. Оны қайтаруға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಅಳಿಸಲಾಗಿದೆ. ಹಿಂಪಡೆಯಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 삭제됨. 되돌릴 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ištrintas. Galite jį grąžinti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ഇല്ലാതാക്കി. തിരികെ കൊണ്ടുവരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” हटवले. परत आणता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dipadam. Anda boleh memulihkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er slettet. Du kan hente den tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ verwijderd. Je kunt hem terughalen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ଡିଲିଟ୍ ହେଲା। ଫେରାଇ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਮਿਟਾਇਆ ਗਿਆ। ਵਾਪਸ ਲਿਆਇਆ ਜਾ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto „%@”. Można ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” excluída. Você pode recuperá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” apagada. Pode recuperá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” a fost ștearsă. O poți recupera."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ vymazaná. Môžete ju vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« izbrisana. Lahko jo vrnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” raderad. Du kan ta tillbaka den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” நீக்கப்பட்டது. திரும்பப் பெறலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” తొలగించబడింది. తిరిగి తీసుకురావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ “%@” แล้ว กู้คืนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silindi. Geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослину «%@» видалено. Її можна повернути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” حذف کر دیا گیا۔ واپس لایا جا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa “%@”. Bạn có thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已删除。可以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已刪除。可以復原。"
          }
        }
      }
    },
    "Растение переедет туда, и комната появится в списке.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتقل النبتة إلى هناك وستظهر الغرفة في القائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растението ще се премести там, а стаята ще се появи в списъка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছটি সেখানে চলে যাবে এবং ঘরটি তালিকায় দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta s’hi traslladarà i l’habitació apareixerà a la llista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostlina se tam přestěhuje a místnost se objeví v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten flytter derhen, og rummet vises på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze zieht dorthin um, und der Raum erscheint in der Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φυτό θα μετακομίσει εκεί και το δωμάτιο θα εμφανιστεί στη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant will move there, and the room will appear in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se mudará allí y la habitación aparecerá en la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi muuttaa sinne, ja huone ilmestyy luetteloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante déménagera, et la pièce apparaîtra dans la liste."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડ ત્યાં જશે અને રૂમ સૂચિમાં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמח יעבור לשם והחדר יופיע ברשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधा वहाँ चला जाएगा और कमरा सूची में दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljka će se preseliti onamo, a soba će se pojaviti na popisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növény átköltözik oda, a szoba pedig megjelenik a listában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman akan pindah ke sana, dan ruangan akan muncul di daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta si trasferirà lì e la stanza apparirà nell’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物がそこへ移動し、部屋がリストに表示されます。"
