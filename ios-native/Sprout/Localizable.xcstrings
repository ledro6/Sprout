            "value": "Otvorte Sprout a záhrada sa objaví tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite Sprout in vaš vrt se bo pojavil tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Sprout så visas din trädgård här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Sprout แล้วสวนของคุณจะปรากฏที่นี่"
