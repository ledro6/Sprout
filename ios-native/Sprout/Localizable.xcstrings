        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” હવે બગીચામાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” כבר לא בגינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अब बगीचे में नहीं है।"
