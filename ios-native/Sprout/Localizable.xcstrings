    "Земля успевает пересохнуть — поливайте чуть раньше.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التربة تلحق أن تجف — اسقِ أبكر قليلًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Почвата успява да изсъхне – поливайте малко по-рано."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাটি শুকিয়ে যাচ্ছে — একটু আগে জল দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La terra s’arriba a assecar: rega una mica abans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlína stihne vyschnout – zalévejte o něco dřív."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden når at tørre ud – vand lidt tidligere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erde trocknet aus – gieß ein wenig früher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χώμα προλαβαίνει να ξεραθεί — ποτίστε λίγο νωρίτερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The soil has time to dry out — try watering a bit earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tierra llega a secarse: riega un poco antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Multa ehtii kuivua – kastele vähän aiemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La terre a le temps de sécher — arrosez un peu plus tôt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માટી સુકાઈ જાય છે — થોડું વહેલું પાણી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האדמה מספיקה להתייבש – השקו קצת מוקדם יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिट्टी सूख जाती है — थोड़ा पहले पानी दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemlja stigne presušiti – zalijevajte malo ranije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A föld kiszárad – öntözz egy kicsit korábban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanah sempat mengering — siram sedikit lebih awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La terra fa in tempo a seccarsi: annaffia un po’ prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "土が乾ききってしまいます — もう少し早めに水やりを。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топырақ кеуіп үлгереді — сәл ертерек суарыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣ್ಣು ಒಣಗಿಹೋಗುತ್ತದೆ — ಸ್ವಲ್ಪ ಬೇಗ ನೀರು ಹಾಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙이 바싹 말라 버려요 — 조금 더 일찍 물을 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žemė spėja išdžiūti – laistykite šiek tiek anksčiau."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മണ്ണ് ഉണങ്ങിപ്പോകുന്നു — അൽപ്പം നേരത്തെ നനയ്ക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माती सुकून जाते — थोडे आधी पाणी द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanah sempat kering — siram sedikit lebih awal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden rekker å tørke ut – vann litt tidligere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aarde droogt uit – geef iets eerder water."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାଟି ଶୁଖିଯାଏ — ଟିକେ ଆଗରୁ ପାଣି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿੱਟੀ ਸੁੱਕ ਜਾਂਦੀ ਹੈ — ਥੋੜ੍ਹਾ ਪਹਿਲਾਂ ਪਾਣੀ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziemia zdąży wyschnąć – podlewaj nieco wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A terra chega a secar — regue um pouco antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A terra chega a secar — regue um pouco mais cedo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pământul apucă să se usuce – udă puțin mai devreme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zem stihne vyschnúť – polievajte o niečo skôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemlja se utegne izsušiti – zalivajte malo prej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden hinner torka ut – vattna lite tidigare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மண் காய்ந்துவிடுகிறது — சற்று முன்னதாக நீர் ஊற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మట్టి ఎండిపోతోంది — కొంచెం ముందుగా నీళ్లు పోయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดินมีเวลาแห้ง — ลองรดน้ำเร็วขึ้นอีกหน่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprak kurumaya fırsat buluyor — biraz daha erken sulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Земля встигає пересохнути — поливайте трохи раніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مٹی سوکھ جاتی ہے — تھوڑا پہلے پانی دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đất kịp khô — hãy tưới sớm hơn một chút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土会干透——稍微早点浇吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "土會乾透——稍微早點澆吧。"
          }
        }
      }
    },
