    "Весь дом спит, а у растений — ужин.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيت كله نائم، والنباتات تتناول العشاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цялата къща спи, а растенията вечерят."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারা বাড়ি ঘুমোচ্ছে, আর গাছেদের রাতের খাবার চলছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tota la casa dorm i les plantes sopen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý dům spí a rostliny večeří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele huset sover, og planterne får aftensmad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Haus schläft, und die Pflanzen bekommen Abendessen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλο το σπίτι κοιμάται, και τα φυτά τρώνε βραδινό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole house is asleep, and the plants are having dinner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la casa duerme y las plantas cenan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko talo nukkuu, ja kasvit syövät illallista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la maison dort, et les plantes dînent."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આખું ઘર ઊંઘે છે, અને છોડ સાંજનું જમણ લે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הבית ישן, ולצמחים — ארוחת ערב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा घर सो रहा है, और पौधों का रात का खाना चल रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijela kuća spava, a biljke večeraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész ház alszik, a növények pedig vacsoráznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seisi rumah tidur, dan tanaman sedang makan malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la casa dorme e le piante cenano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家じゅうが眠るころ、植物たちは夕ごはん。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүкіл үй ұйықтап жатыр, ал өсімдіктерде — кешкі ас."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮನೆಯೆಲ್ಲಾ ನಿದ್ರಿಸುತ್ತಿದೆ, ಗಿಡಗಳಿಗೆ ರಾತ್ರಿ ಊಟ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온 집이 잠들 때, 식물들은 저녁을 먹어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas namas miega, o augalai vakarieniauja."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീട് മുഴുവൻ ഉറങ്ങുമ്പോൾ ചെടികൾക്ക് അത്താഴം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सगळे घर झोपले आहे, आणि रोपांचे रात्रीचे जेवण चालू आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seisi rumah tidur, dan tumbuhan sedang makan malam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele huset sover, og plantene spiser middag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hele huis slaapt en de planten krijgen hun avondeten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୂରା ଘର ଶୋଇଛି, ଆଉ ଗଛମାନଙ୍କର ରାତି ଖାଇବା ଚାଲିଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰਾ ਘਰ ਸੁੱਤਾ ਪਿਆ ਹੈ, ਅਤੇ ਪੌਦਿਆਂ ਦਾ ਰਾਤ ਦਾ ਖਾਣਾ ਚੱਲ ਰਿਹਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały dom śpi, a rośliny jedzą kolację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa toda dorme, e as plantas jantam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa toda dorme e as plantas jantam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toată casa doarme, iar plantele iau cina."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý dom spí a rastliny večerajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsa hiša spi, rastline pa večerjajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela huset sover, och växterna äter middag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடு முழுவதும் தூங்குகிறது, செடிகளுக்கு இரவு உணவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇల్లంతా నిద్రపోతోంది, మొక్కలకు రాత్రి భోజనం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งบ้านหลับหมดแล้ว ส่วนต้นไม้กำลังกินมื้อเย็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün ev uyuyor, bitkiler ise akşam yemeğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь дім спить, а в рослин — вечеря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سارا گھر سو رہا ہے، اور پودوں کا رات کا کھانا جاری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả nhà đã ngủ, còn cây đang ăn tối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全家都睡了，植物们在吃晚饭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全家都睡了，植物們在吃晚餐。"
          }
        }
      }
    },
