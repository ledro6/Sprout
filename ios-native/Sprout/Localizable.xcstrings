        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ଖୋଲନ୍ତୁ ଏବଂ ଆପଣଙ୍କ ବଗିଚା ଏଠାରେ ଦେଖାଯିବ।"
