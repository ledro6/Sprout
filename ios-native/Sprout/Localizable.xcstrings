          "stringUnit": {
            "state": "translated",
            "value": "Quantas plantas e divisões tem e há quantos dias cuida do jardim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte plante și camere ai și de câte zile îngrijești grădina."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko máte rastlín a izieb a koľko dní sa staráte o záhradu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko rastlin in sob imate ter koliko dni že skrbite za vrt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur många växter och rum du har och hur många dagar du har skött din trädgård."
