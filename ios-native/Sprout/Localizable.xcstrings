        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎರಡು ಬೆರಳುಗಳಿಂದ ತಿರುಗಿಸಿ, ಪಿಂಚ್‌ನಿಂದ ಗಾತ್ರ ಬದಲಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 회전, 핀치로 크기 조절"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dviem pirštais – pasukti, suimant – dydis"
