    "Вы с землёй на одной волне: поливаете, когда пора.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت والتربة على الموجة نفسها: تسقي حين يحين الوقت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие и почвата сте на една вълна: поливате точно когато трябва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আর মাটি এক তালে: ঠিক সময়ে জল দেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu i la terra aneu sincronitzats: regues just quan toca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vy a hlína jste naladěni stejně: zaléváte přesně, když je čas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og jorden er i takt: du vander præcis, når det er tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du und die Erde seid im Einklang: Du gießt genau dann, wenn es Zeit ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσείς και το χώμα είστε συντονισμένοι: ποτίζετε ακριβώς όταν πρέπει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and the soil are in sync: you water right when it’s time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú y la tierra vais al compás: riegas justo cuando toca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä ja multa olette samassa tahdissa: kastelet juuri oikeaan aikaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous et la terre êtes en phase : vous arrosez pile quand il faut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે અને માટી એક તાલમાં છો: બરાબર સમયે પાણી આપો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האדמה ואתם באותו קצב: ההשקיה מגיעה בדיוק בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप और मिट्टी एक सुर में हैं: ठीक समय पर पानी देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi i zemlja ste usklađeni: zalijevate točno kad treba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te és a föld egy hullámhosszon vagytok: épp akkor öntözöl, amikor kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dan tanah sehati: menyiram tepat saat dibutuhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu e la terra siete in sintonia: annaffi proprio quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "土とぴったり息が合っています。ちょうどいいタイミングで水やり。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз бен топырақ бір толқындасыз: дәл уақытында суарасыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಮತ್ತು ಮಣ್ಣು ಒಂದೇ ತಾಳದಲ್ಲಿ: ಸರಿಯಾದ ಸಮಯಕ್ಕೆ ನೀರು ಹಾಕುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙과 호흡이 딱 맞아요. 필요할 때 정확히 물을 줘요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs ir žemė — viena banga: laistote būtent tada, kai reikia."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളും മണ്ണും ഒരേ താളത്തിൽ: കൃത്യസമയത്ത് നനയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही आणि माती एका तालात: अगदी वेळेवर पाणी घालता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dan tanah sehati: menyiram tepat apabila perlu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og jorda er i takt: du vanner akkurat når det er tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij en de aarde zitten op één lijn: je geeft water precies op tijd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଓ ମାଟି ଏକା ତାଳରେ: ଠିକ୍ ସମୟରେ ପାଣି ଦିଅନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਤੇ ਮਿੱਟੀ ਇੱਕ ਤਾਲ ਵਿੱਚ: ਠੀਕ ਸਮੇਂ ਪਾਣੀ ਦਿੰਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty i ziemia nadajecie na tych samych falach: podlewasz, kiedy trzeba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você e a terra estão em sintonia: rega bem na hora certa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você e a terra estão em sintonia: rega mesmo na hora certa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu și pământul sunteți în ton: uzi exact când trebuie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vy a zem ste naladení rovnako: polievate presne vtedy, keď treba."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi in zemlja ste usklajeni: zalivate ravno takrat, ko je treba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du och jorden är i takt: du vattnar precis när det är dags."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்களும் மண்ணும் ஒரே தாளத்தில்: சரியான நேரத்தில் நீர் ஊற்றுகிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు, మట్టి ఒకే తాళంలో: సరైన సమయానికి నీళ్లు పోస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกับดินรู้ใจกัน รดน้ำตรงเวลาพอดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprakla aynı ritimdesiniz: tam zamanında suluyorsunuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви із землею на одній хвилі: поливаєте, коли саме час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اور مٹی ایک لے میں: عین وقت پر پانی دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn và đất rất ăn ý: tưới đúng lúc cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你和泥土心有灵犀：总在该浇的时候浇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你和泥土心有靈犀：總在該澆的時候澆。"
          }
        }
      }
    },
