            "value": "Vaš čas"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tid"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நேரம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సమయం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin saatiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш час"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا وقت"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的時間"
          }
        }
      }
    },
    "Ведите ползунок — сад перенесётся на дни вперёд, если поливать вовремя.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المنزلق — تتقدم الحديقة أيامًا إلى الأمام، كأنك تسقي في الوقت المناسب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете плъзгача – градината се пренася дни напред, сякаш поливате навреме."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্লাইডার টানুন — বাগান কয়েক দিন এগিয়ে যাবে, যেন আপনি ঠিক সময়ে জল দেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega el control: el jardí avança dies, com si reguessis a temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhněte posuvníkem – zahrada se přenese o dny dopředu, jako byste zalévali včas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i skyderen – haven springer dage frem, som hvis du vander til tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh am Regler – der Garten springt Tage voraus, als würdest du pünktlich gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε το ρυθμιστικό — ο κήπος πηγαίνει μέρες μπροστά, σαν να ποτίζετε στην ώρα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the slider to jump days ahead — as if you water on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza el control: el jardín avanza días, como si regaras a tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä liukusäädintä – puutarha hyppää päiviä eteenpäin, ikään kuin kastelisit ajallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le curseur : le jardin avance de quelques jours, si l’on arrose à temps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્લાઇડર ખસેડો — બગીચો થોડા દિવસ આગળ જશે, જાણે તમે સમયસર પાણી આપો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו את המחוון – הגינה תקפוץ ימים קדימה, כאילו השקיתם בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइडर खिसकाएँ — बगीचा कई दिन आगे चला जाएगा, मानो आप सही समय पर पानी देते हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite klizač – vrt skače danima naprijed, kao da zalijevate na vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a csúszkát – a kert napokat ugrik előre, mintha időben öntöznél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser penggeser — kebun melompat beberapa hari ke depan, seolah Anda menyiram tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il cursore: il giardino va avanti di giorni, come se annaffiassi in tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダーを動かすと、きちんと水やりした場合の数日後の庭へ。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүгірткіні жылжытыңыз — уағында суарсаңыз, бақ күндер алға жылжиды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಲೈಡರ್ ಎಳೆಯಿರಿ — ತೋಟ ಕೆಲವು ದಿನ ಮುಂದೆ ಹೋಗುತ್ತದೆ, ನೀವು ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ನೀರು ಹಾಕಿದಂತೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더를 움직이면 제때 물을 준다고 가정했을 때 며칠 뒤의 정원으로 갑니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkite slankiklį – sodas peršoks dienomis į priekį, lyg laistytumėte laiku."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ലൈഡർ വലിക്കുക — നിങ്ങൾ സമയത്ത് നനയ്ക്കുന്നു എന്ന പോലെ തോട്ടം ദിവസങ്ങൾ മുന്നോട്ട് പോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइडर ओढा — बाग काही दिवस पुढे जाईल, जणू तुम्ही वेळेवर पाणी देता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret peluncur — taman melompat beberapa hari ke hadapan, seolah-olah anda menyiram tepat pada masanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i glidebryteren – hagen hopper dager fremover, som om du vanner i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de schuifknop – de tuin springt dagen vooruit, alsof je op tijd water geeft."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ଲାଇଡର୍ ଟାଣନ୍ତୁ — ବଗିଚା କିଛି ଦିନ ଆଗକୁ ଯିବ, ଯେପରି ଆପଣ ଠିକ୍ ସମୟରେ ପାଣି ଦିଅନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਲਾਈਡਰ ਖਿਸਕਾਓ — ਬਗੀਚਾ ਕੁਝ ਦਿਨ ਅੱਗੇ ਚਲਾ ਜਾਵੇਗਾ, ਜਿਵੇਂ ਤੁਸੀਂ ਸਮੇਂ ਸਿਰ ਪਾਣੀ ਦਿੰਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń suwak – ogród przeniesie się o dni do przodu, jakbyś podlewał w porę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o controle — o jardim avança dias, como se você regasse na hora certa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o controlo — o jardim avança dias, como se regasse a tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage glisorul – grădina sare zile înainte, ca și cum ai uda la timp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite posúvač – záhrada sa presunie o dni dopredu, akoby ste polievali včas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlecite drsnik – vrt skoči dneve naprej, kot da zalivate pravočasno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra reglaget – trädgården hoppar dagar framåt, som om du vattnar i tid."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்லைடரை இழுங்கள் — நீங்கள் சரியான நேரத்தில் ஊற்றுவது போல தோட்டம் சில நாட்கள் முன்னேறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్లైడర్ లాగండి — మీరు సమయానికి నీళ్లు పోసినట్లుగా తోట కొన్ని రోజులు ముందుకు వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากแถบเลื่อน — สวนจะข้ามไปข้างหน้าหลายวัน เหมือนคุณรดน้ำตรงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürgüyü kaydırın — zamanında sularsanız bahçe günlerce ileri gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведіть повзунок — сад перенесеться на дні вперед, якщо поливати вчасно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائیڈر کھینچیں — باغ کئی دن آگے چلا جائے گا، جیسے آپ بروقت پانی دیتے ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo thanh trượt — khu vườn tiến lên vài ngày, như thể bạn tưới đúng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块——假如按时浇水，花园会快进好几天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移滑桿——假如按時澆水，花園會快轉好幾天。"
          }
        }
      }
    },
