    "Удалите приложение — вместе с ним исчезнет и всё, что оно помнило.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف التطبيق — وسيختفي معه كل ما كان يتذكره."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтрийте приложението — и всичко, което е помнело, изчезва с него."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ মুছে ফেলুন — এর মনে রাখা সবকিছুও সঙ্গে মুছে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina l’app i tot el que recordava desapareixerà amb ella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažte aplikaci — a vše, co si pamatovala, zmizí s ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet appen – og alt, hvad den huskede, forsvinder med den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösch die App — und alles, was sie sich gemerkt hat, verschwindet mit ihr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε την εφαρμογή — και ό,τι θυμόταν θα εξαφανιστεί μαζί της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the app — and everything it remembered disappears with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la app y todo lo que recordaba desaparecerá con ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista appi – ja kaikki, mitä se muisti, katoaa sen mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez l’app — et tout ce qu’elle a retenu disparaîtra avec elle."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ ડિલીટ કરો — તેને જે યાદ હતું તે બધું તેની સાથે જતું રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחקים את האפליקציה — וכל מה שהיא זכרה נעלם איתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप डिलीट करें — और जो कुछ उसे याद था, वह भी उसके साथ मिट जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišite aplikaciju — i sve što je zapamtila nestat će s njom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töröld az alkalmazást — és vele együtt eltűnik minden, amire emlékezett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus aplikasi — dan semua yang diingatnya ikut hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina l’app e tutto ciò che ricordava sparirà con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除すると、アプリが覚えていたこともすべて一緒に消えます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны жойыңыз — оның есінде қалғанның бәрі бірге жоғалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 삭제하면 앱이 기억하던 모든 것도 함께 사라져요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinkite programą – ir kartu su ja išnyks viskas, ką ji prisiminė."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप हटवा — त्याने जे लक्षात ठेवले ते सर्व त्यासोबत नाहीसे होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam apl — dan semua yang diingatinya hilang bersamanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett appen – og alt den husket, forsvinner med den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de app — en alles wat hij onthield verdwijnt mee."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ଡିଲିଟ୍ କରନ୍ତୁ — ଏହାର ମନେ ଥିବା ସବୁକିଛି ସାଥିରେ ଲିଭିଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਮਿਟਾਓ — ਇਸ ਨੂੰ ਜੋ ਯਾਦ ਸੀ ਉਹ ਸਭ ਨਾਲ ਹੀ ਮਿਟ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń aplikację — a zniknie z nią wszystko, co pamiętała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague o app — e tudo o que ele lembrava some junto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague a app — e tudo o que ela lembrava desaparece com ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge aplicația — și tot ce își amintea dispare odată cu ea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymažte apku — a všetko, čo si pamätala, zmizne s ňou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišite aplikacijo — in z njo izgine vse, kar si je zapomnila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera appen – så försvinner allt den kom ihåg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแอป — ทุกสิ่งที่แอปจำไว้จะหายไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı silin — hatırladığı her şey de onunla birlikte kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаліть застосунок — разом із ним зникне все, що він пам’ятав."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa ứng dụng — mọi điều nó nhớ sẽ biến mất cùng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 App，它记住的一切都会随之消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 App，它記得的一切都會隨之消失。"
          }
        }
      }
    },
