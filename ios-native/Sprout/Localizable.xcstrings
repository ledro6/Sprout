        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite planet da vidite tko je to."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy bolygóra, hogy lásd, ki az."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk planet untuk melihat siapa itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un pianeta per scoprire chi è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "惑星をタップすると、誰かがわかります。"
