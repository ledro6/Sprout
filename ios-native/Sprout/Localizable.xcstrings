    "Имя правится прямо в строке. Потяните за ручку справа, чтобы поменять порядок, — в том же порядке комнаты встанут и в меню на главной.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres direkte i rækken. Træk i håndtaget til højre for at ændre rækkefølgen – rummene vises i samme rækkefølge i menuen på startskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird direkt in der Zeile bearbeitet. Zieh am Griff rechts, um die Reihenfolge zu ändern — in derselben Reihenfolge erscheinen die Räume auch im Menü auf der Startseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit a name right in its row. Drag the handle on the right to change the order — rooms appear in the same order in the menu on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se edita en la propia fila. Arrastra el asa de la derecha para cambiar el orden: las habitaciones aparecerán en el mismo orden en el menú de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeä muokataan suoraan rivillä. Muuta järjestystä vetämällä oikealla olevasta kahvasta – huoneet näkyvät samassa järjestyksessä kodin valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom se modifie directement dans la ligne. Faites glisser la poignée à droite pour changer l’ordre — les pièces apparaîtront dans le même ordre dans le menu de l’accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome si modifica direttamente nella riga. Trascina la maniglia a destra per cambiare l’ordine: le stanze appariranno nello stesso ordine nel menu della Home."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres rett i raden. Dra i håndtaket til høyre for å endre rekkefølgen – rommene vises i samme rekkefølge i menyen på startsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam wijzig je direct in de regel. Sleep de greep rechts om de volgorde te wijzigen — in dezelfde volgorde staan de kamers in het menu op het startscherm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome é editado na própria linha. Arraste a alça à direita para mudar a ordem — os cômodos aparecerão na mesma ordem no menu do início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome edita-se na própria linha. Arraste a pega à direita para mudar a ordem — as divisões aparecem pela mesma ordem no menu do início."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet redigeras direkt i raden. Dra i handtaget till höger för att ändra ordningen – rummen visas i samma ordning i menyn på hemskärmen."
          }
        }
      }
    },
    "Имя стоит в профиле и уходит вместе со счётом друзьям.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn står i profilen og følger med din score til vennerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name steht im Profil und geht mit deinem Punktestand an Freunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name appears in your profile and is sent to friends along with your score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre aparece en el perfil y viaja con tu puntuación a tus amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi näkyy profiilissa ja lähtee pisteidesi mukana kavereille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom figure dans le profil et part avec votre score chez vos amis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome compare nel profilo e arriva agli amici con il tuo punteggio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet ditt står i profilen og følger med poengsummen til vennene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam staat in je profiel en gaat met je score mee naar vrienden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome aparece no perfil e vai junto com sua pontuação para os amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu nome aparece no perfil e vai com a sua pontuação para os amigos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt namn visas i profilen och följer med poängen till vännerna."
          }
        }
      }
    },
