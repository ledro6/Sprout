    "Позвать меня в соперники: скопируйте это сообщение целиком и нажмите «Вставить» в Sprout → Профиль → Друзья.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافتي كمنافس: انسخ هذه الرسالة كاملة واضغط «لصق» في Sprout ← الملف الشخصي ← الأصدقاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави ме за съперник: копирай цялото съобщение и докосни „Постави“ в Sprout → Профил → Приятели."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাকে প্রতিদ্বন্দ্বী হিসেবে যোগ করতে এই পুরো বার্তাটি কপি করুন এবং Sprout → প্রোফাইল → বন্ধুরা-তে “পেস্ট করুন” ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per afegir-me com a rival, copia tot aquest missatge i toca «Enganxa» a Sprout → Perfil → Amics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte si mě jako soupeře: zkopírujte celou tuto zprávu a klepněte na „Vložit“ v Sprout → Profil → Přátelé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj mig som rival: Kopiér hele denne besked, og tryk på ”Indsæt” i Sprout → Profil → Venner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mich als Rivalen hinzuzufügen: Kopiere diese ganze Nachricht und tippe in Sprout → Profil → Freunde auf „Einsetzen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσέ με ως αντίπαλο: αντίγραψε όλο αυτό το μήνυμα και πάτησε «Επικόλληση» στο Sprout → Προφίλ → Φίλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add me as a rival, copy this whole message and tap “Paste” in Sprout → Profile → Friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadirme como rival, copia todo este mensaje y toca “Pegar” en Sprout → Perfil → Amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää minut kilpailijaksi: kopioi koko tämä viesti ja napauta ”Sijoita” kohdassa Sprout → Profiili → Kaverit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour m’ajouter comme rival : copiez tout ce message et touchez « Coller » dans Sprout → Profil → Amis."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મને પ્રતિસ્પર્ધી તરીકે ઉમેરવા આ આખો સંદેશ કૉપિ કરો અને Sprout → પ્રોફાઇલ → મિત્રોમાં “પેસ્ટ કરો” પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף אותי כיריב: העתק את כל ההודעה הזו והקש על “הדבק” ב־Sprout ← פרופיל ← חברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे प्रतिद्वंद्वी के रूप में जोड़ने के लिए यह पूरा संदेश कॉपी करें और Sprout → प्रोफ़ाइल → दोस्त में “पेस्ट करें” पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj me kao suparnika: kopiraj cijelu ovu poruku i dodirni „Zalijepi” u Sprout → Profil → Prijatelji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá riválisként: másold ki ezt az egész üzenetet, és koppints a „Beillesztés” gombra itt: Sprout → Profil → Barátok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambahkanku sebagai rival, salin seluruh pesan ini dan ketuk “Tempel” di Sprout → Profil → Teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungermi come rivale, copia tutto questo messaggio e tocca “Incolla” in Sprout → Profilo → Amici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライバルに追加するには、このメッセージ全体をコピーして、Sprout → プロフィール → 友達で「ペースト」をタップしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мені қарсылас ретінде қос: осы хабарды толық көшіріп, Sprout → Профиль → Достар ішінде «Қою» түймесін бас."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನನ್ನನ್ನು ಎದುರಾಳಿಯಾಗಿ ಸೇರಿಸಲು ಈ ಪೂರ್ತಿ ಸಂದೇಶವನ್ನು ನಕಲಿಸಿ ಮತ್ತು Sprout → ಪ್ರೊಫೈಲ್ → ಸ್ನೇಹಿತರು ನಲ್ಲಿ “ಅಂಟಿಸಿ” ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나를 라이벌로 추가하려면 이 메시지 전체를 복사한 다음 Sprout → 프로필 → 친구에서 ‘붙여넣기’를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėk mane kaip varžovą: nukopijuok visą šią žinutę ir bakstelėk „Įklijuoti“ skiltyje Sprout → Profilis → Draugai."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്നെ എതിരാളിയായി ചേർക്കാൻ ഈ സന്ദേശം മുഴുവൻ പകർത്തി Sprout → പ്രൊഫൈൽ → സുഹൃത്തുക്കൾ എന്നതിൽ “ഒട്ടിക്കുക” ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मला प्रतिस्पर्धी म्हणून जोडण्यासाठी हा संपूर्ण संदेश कॉपी करा आणि Sprout → प्रोफाइल → मित्र मध्ये “पेस्ट करा” वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah saya sebagai pesaing, salin keseluruhan mesej ini dan ketik “Tampal” dalam Sprout → Profil → Rakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg meg til som rival: Kopier hele denne meldingen, og trykk på «Lim inn» i Sprout → Profil → Venner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg me toe als rivaal: kopieer dit hele bericht en tik op ‘Plak’ in Sprout → Profiel → Vrienden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୋତେ ପ୍ରତିଦ୍ୱନ୍ଦ୍ୱୀ ଭାବେ ଯୋଡ଼ିବାକୁ ଏହି ସମ୍ପୂର୍ଣ୍ଣ ବାର୍ତ୍ତା କପି କରନ୍ତୁ ଏବଂ Sprout → ପ୍ରୋଫାଇଲ୍ → ବନ୍ଧୁ ରେ “ପେଷ୍ଟ କରନ୍ତୁ” ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਨੂੰ ਵਿਰੋਧੀ ਵਜੋਂ ਜੋੜਨ ਲਈ ਇਹ ਪੂਰਾ ਸੁਨੇਹਾ ਕਾਪੀ ਕਰੋ ਅਤੇ Sprout → ਪ੍ਰੋਫ਼ਾਈਲ → ਦੋਸਤ ਵਿੱਚ “ਪੇਸਟ ਕਰੋ” 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać mnie jako rywala, skopiuj całą tę wiadomość i stuknij „Wklej” w Sprout → Profil → Znajomi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă-mă ca rival: copiază tot mesajul acesta și atinge „Lipește” în Sprout → Profil → Prieteni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte si ma ako súpera: skopírujte celú túto správu a klepnite na „Vložiť“ v Sprout → Profil → Priatelia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj me kot tekmeca: kopiraj vse to sporočilo in tapni »Prilepi« v Sprout → Profil → Prijatelji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till mig som rival: kopiera hela meddelandet och tryck på ”Klistra in” i Sprout → Profil → Vänner."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்னைப் போட்டியாளராகச் சேர்க்க, இந்த முழுச் செய்தியையும் நகலெடுத்து Sprout → சுயவிவரம் → நண்பர்கள் இல் “ஒட்டு” என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నన్ను ప్రత్యర్థిగా జోడించడానికి ఈ పూర్తి సందేశాన్ని కాపీ చేసి Sprout → ప్రొఫైల్ → స్నేహితులు లో “అతికించు” నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มฉันเป็นคู่แข่ง: คัดลอกข้อความนี้ทั้งหมด แล้วแตะ “วาง” ใน Sprout → โปรไฟล์ → เพื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beni rakip olarak eklemek için bu mesajın tamamını kopyala ve Sprout → Profil → Arkadaşlar’da “Yapıştır”a dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай мене в суперники: скопіюй це повідомлення повністю й натисни «Вставити» в Sprout → Профіль → Друзі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مجھے حریف کے طور پر شامل کرنے کے لیے یہ پورا پیغام کاپی کریں اور Sprout ← پروفائل ← دوست میں “پیسٹ کریں” پر تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thêm mình làm đối thủ: sao chép toàn bộ tin nhắn này rồi chạm vào “Dán” trong Sprout → Hồ sơ → Bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要把我加为对手：请完整拷贝这条消息，然后在 Sprout → 个人资料 → 朋友中轻点“粘贴”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要把我加為對手：請完整拷貝這則訊息，然後在 Sprout → 個人檔案 → 朋友中點一下「貼上」。"
          }
        }
      }
    },
    "Поздновато: карточка уже горит красным.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متأخر قليلًا: البطاقة صارت حمراء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Малко късно: картата вече свети в червено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটু দেরি: কার্ড ইতিমধ্যে লাল।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mica tard: la targeta ja és vermella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochu pozdě: karta už svítí červeně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidt sent: kortet lyser allerede rødt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas spät: Die Karte leuchtet schon rot."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λίγο αργά: η κάρτα είναι ήδη κόκκινη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit late: the card is already glowing red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo tarde: la tarjeta ya está en rojo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähän myöhään: kortti hehkuu jo punaisena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu tard : la carte est déjà rouge."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "થોડું મોડું: કાર્ડ પહેલેથી લાલ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצת מאוחר: הכרטיס כבר אדום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थोड़ी देर हो गई: कार्ड पहले ही लाल है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malo kasno: kartica već svijetli crveno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kicsit késő: a kártya már pirosan világít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agak terlambat: kartu sudah menyala merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po’ tardi: la scheda è già rossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し遅め：カードはもう赤く光っています。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешірек: карточка қызыл жанып тұр."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಲ್ಪ ತಡ: ಕಾರ್ಡ್ ಈಗಾಗಲೇ ಕೆಂಪಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 늦었어요: 카드가 이미 빨갛게 빛나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek per vėlai: kortelė jau šviečia raudonai."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അൽപ്പം വൈകി: കാർഡ് ഇതിനകം ചുവപ്പാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जरा उशीर झाला: कार्ड आधीच लाल आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Agak lewat: kad sudah bercahaya merah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Litt sent: kortet lyser allerede rødt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat laat: de kaart is al rood."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟିକେ ଡେରି: କାର୍ଡ ପୂର୍ବରୁ ନାଲି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਥੋੜ੍ਹੀ ਦੇਰ ਹੋ ਗਈ: ਕਾਰਡ ਪਹਿਲਾਂ ਹੀ ਲਾਲ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochę późno: karta już świeci na czerwono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco tarde: o cartão já está vermelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco tarde: o cartão já está vermelho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam târziu: fișa e deja roșie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochu neskoro: karta už svieti červeno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Malo pozno: kartica že sveti rdeče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite sent: kortet lyser redan rött."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சற்றுத் தாமதம்: அட்டை ஏற்கெனவே சிவப்பாக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొంచెం ఆలస్యం: కార్డు ఇప్పటికే ఎర్రగా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช้าไปนิด: การ์ดเป็นสีแดงแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz geç: kart zaten kırmızı yanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запізно: картка вже горить червоним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ذرا دیر ہو گئی: کارڈ پہلے ہی سرخ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hơi muộn: thẻ đã chuyển đỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点晚了：卡片已经亮红了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有點晚了：卡片已經亮紅了。"
          }
        }
      }
    },
