    "Неделя, месяц, год или всё время — цифры и графики ниже пересчитаются.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسبوع أو شهر أو سنة أو كل الوقت — تُعاد حسابات الأرقام والرسوم أدناه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Седмица, месец, година или цялото време – числата и графиките по-долу се преизчисляват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সপ্তাহ, মাস, বছর বা সব সময় — নিচের সংখ্যা আর চার্ট আবার হিসাব হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Setmana, mes, any o sempre: les xifres i els gràfics de sota es recalculen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týden, měsíc, rok nebo celou dobu – čísla a grafy níže se přepočítají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uge, måned, år eller hele tiden – tallene og diagrammerne nedenfor regnes om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woche, Monat, Jahr oder gesamt – Zahlen und Diagramme darunter werden neu berechnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εβδομάδα, μήνας, έτος ή όλο το διάστημα — οι αριθμοί και τα γραφήματα παρακάτω υπολογίζονται ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Week, month, year, or all time — the numbers and charts below will update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana, mes, año o todo: las cifras y gráficos de abajo se recalculan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viikko, kuukausi, vuosi tai koko aika – alla olevat luvut ja kaaviot lasketaan uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semaine, mois, année ou tout — les chiffres et graphiques ci-dessous se recalculent."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અઠવાડિયું, મહિનો, વર્ષ કે આખો સમય — નીચેના આંકડા અને ચાર્ટ ફરી ગણાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבוע, חודש, שנה או כל הזמן – המספרים והתרשימים למטה יחושבו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह, महीना, साल या पूरा समय — नीचे के आँकड़े और चार्ट दोबारा गिने जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjedan, mjesec, godina ili sve vrijeme – brojke i grafikoni ispod ponovno se izračunavaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hét, hónap, év vagy mindig – a lenti számok és grafikonok újraszámolódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu, bulan, tahun, atau sepanjang waktu — angka dan grafik di bawah dihitung ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Settimana, mese, anno o sempre: numeri e grafici qui sotto si ricalcolano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週・月・年・全期間 — 下の数字とグラフが再計算されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апта, ай, жыл немесе барлық уақыт — төмендегі сандар мен графиктер қайта есептеледі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾರ, ತಿಂಗಳು, ವರ್ಷ ಅಥವಾ ಇಡೀ ಅವಧಿ — ಕೆಳಗಿನ ಅಂಕಿಗಳು ಮತ್ತು ಚಾರ್ಟ್‌ಗಳು ಮತ್ತೆ ಲೆಕ್ಕವಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주, 월, 년 또는 전체 — 아래의 숫자와 차트가 다시 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Savaitė, mėnuo, metai ar visas laikas – skaičiai ir diagramos žemiau perskaičiuojami."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആഴ്ച, മാസം, വർഷം അല്ലെങ്കിൽ എല്ലാ കാലവും — താഴെയുള്ള സംഖ്യകളും ചാർട്ടുകളും വീണ്ടും കണക്കാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवडा, महिना, वर्ष किंवा संपूर्ण काळ — खालील आकडे आणि तक्ते पुन्हा मोजले जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu, bulan, tahun atau sepanjang masa — angka dan carta di bawah dikira semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uke, måned, år eller hele tiden – tallene og diagrammene nedenfor regnes om."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Week, maand, jaar of altijd – de cijfers en grafieken hieronder worden herberekend."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସପ୍ତାହ, ମାସ, ବର୍ଷ କିମ୍ବା ସବୁ ସମୟ — ତଳର ସଂଖ୍ୟା ଓ ଚାର୍ଟ ପୁଣି ହିସାବ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਫ਼ਤਾ, ਮਹੀਨਾ, ਸਾਲ ਜਾਂ ਸਾਰਾ ਸਮਾਂ — ਹੇਠਾਂ ਦੇ ਅੰਕੜੇ ਅਤੇ ਚਾਰਟ ਮੁੜ ਗਿਣੇ ਜਾਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzień, miesiąc, rok albo cały czas – liczby i wykresy poniżej przeliczą się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana, mês, ano ou tudo — os números e gráficos abaixo são recalculados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana, mês, ano ou tudo — os números e gráficos abaixo são recalculados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Săptămână, lună, an sau tot timpul – cifrele și graficele de mai jos se recalculează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týždeň, mesiac, rok alebo celý čas – čísla a grafy nižšie sa prepočítajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teden, mesec, leto ali ves čas – številke in grafi spodaj se preračunajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecka, månad, år eller all tid – siffrorna och diagrammen nedan räknas om."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாரம், மாதம், ஆண்டு அல்லது எல்லா நேரமும் — கீழே உள்ள எண்களும் வரைபடங்களும் மீண்டும் கணக்கிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారం, నెల, సంవత్సరం లేదా మొత్తం కాలం — కింది సంఖ్యలు, చార్టులు మళ్లీ లెక్కించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์ เดือน ปี หรือทั้งหมด — ตัวเลขและกราฟด้านล่างจะคำนวณใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta, ay, yıl ya da tüm zamanlar — aşağıdaki sayılar ve grafikler yeniden hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиждень, місяць, рік чи весь час — цифри й графіки нижче перерахуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتہ، مہینہ، سال یا سارا وقت — نیچے کے اعداد اور چارٹ دوبارہ حساب ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần, tháng, năm hoặc mọi lúc — các con số và biểu đồ bên dưới sẽ được tính lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周、月、年或全部——下方的数字和图表会重新计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週、月、年或全部——下方的數字和圖表會重新計算。"
          }
        }
      }
    },
