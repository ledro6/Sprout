        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakukenttä on alhaalla välilehtipalkin vieressä. Se hakee lempinimistä, lajeista ja muistiinpanoista."
          }
        },
        "fr": {
