        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли їдете й коли повернетеся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کب جا رہے ہیں اور کب واپس آئیں گے۔"
