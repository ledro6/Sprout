    "Вырастить пять разных видов.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ازرع خمسة أنواع مختلفة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отгледайте пет различни вида."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঁচটি আলাদা প্রজাতি বড় করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva cinc espècies diferents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypěstujte pět různých druhů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyrk fem forskellige arter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe fünf verschiedene Arten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεγαλώστε πέντε διαφορετικά είδη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow five different species."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva cinco especies distintas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvata viittä eri lajia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiver cinq espèces différentes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાંચ જુદી જુદી પ્રજાતિ ઉગાડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לגדל חמישה מינים שונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच अलग-अलग प्रजातियाँ उगाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzgojite pet različitih vrsta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevelj öt különböző fajt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanam lima spesies berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coltiva cinque specie diverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5種類の植物を育てる。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес түрлі өсімдік түрін өсіріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐದು ಬೇರೆ ಬೇರೆ ಜಾತಿಗಳನ್ನು ಬೆಳೆಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 다른 5종을 키우세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užauginkite penkias skirtingas rūšis."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അഞ്ച് വ്യത്യസ്ത ഇനങ്ങൾ വളർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाच वेगवेगळ्या प्रजाती वाढवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanam lima spesies berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyrk fem ulike arter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kweek vijf verschillende soorten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାଞ୍ଚଟି ଭିନ୍ନ ପ୍ରଜାତି ବଢ଼ାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੰਜ ਵੱਖ-ਵੱਖ ਕਿਸਮਾਂ ਉਗਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyhoduj pięć różnych gatunków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultive cinco espécies diferentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultive cinco espécies diferentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crește cinci specii diferite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypestujte päť rôznych druhov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzgojite pet različnih vrst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Odla fem olika arter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஐந்து வெவ்வேறு இனங்களை வளர்த்திடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐదు వేర్వేరు జాతులను పెంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลูกต้นไม้ห้าชนิดที่ต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş farklı tür yetiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виростити п’ять різних видів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پانچ مختلف اقسام اگائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trồng năm loài khác nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "养五种不同的植物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "養五種不同的植物。"
          }
        }
      }
    },
    "Где стоит растение и раз в сколько дней его поливать — барабан крутится пальцем.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين توضع النبتة وكل كم يومًا تُسقى — تُدار العجلة بالإصبع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде стои растението и през колко дни да се полива – колелото се върти с пръст."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গাছটি কোথায় আর কত দিন পরপর জল দিতে হবে — চাকাটি আঙুলে ঘোরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "On és la planta i cada quant regar-la: la roda gira amb el dit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde rostlina stojí a jak často ji zalévat – kolečkem se točí prstem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor planten står, og hvor tit den skal vandes – hjulet drejes med fingeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Pflanze steht und wie oft sie gegossen wird – das Rad dreht sich mit dem Finger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού στέκεται το φυτό και ανά πόσες μέρες ποτίζεται — ο τροχός γυρίζει με το δάχτυλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the plant stands and how often to water it — spin the wheel with your finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde está la planta y cada cuánto regarla: la rueda gira con el dedo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Missä kasvi on ja kuinka usein sitä kastellaan – rullaa pyöritetään sormella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se trouve la plante et tous les combien l’arroser — la molette tourne au doigt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છોડ ક્યાં છે અને કેટલા દિવસે પાણી આપવું — ચક્ર આંગળીથી ફેરવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפה הצמח עומד וכל כמה ימים להשקות אותו – את הגלגל מסובבים באצבע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पौधा कहाँ है और कितने दिन में पानी देना है — पहिया उंगली से घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdje biljka stoji i koliko je često zalijevati – kotačić se vrti prstom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol áll a növény, és milyen gyakran kell öntözni – a kereket ujjal forgathatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana tanaman berada dan berapa hari sekali disiram — roda diputar dengan jari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove sta la pianta e ogni quanto annaffiarla: la ruota gira con il dito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物を置く部屋と、何日ごとに水やりするか — ホイールは指で回せます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдік қай жерде тұр және неше күнде бір суарылады — барабан саусақпен айналады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಿಡ ಎಲ್ಲಿದೆ ಮತ್ತು ಎಷ್ಟು ದಿನಕ್ಕೊಮ್ಮೆ ನೀರು — ಚಕ್ರವನ್ನು ಬೆರಳಿನಿಂದ ತಿರುಗಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 있는 곳과 며칠마다 물을 줄지 — 휠은 손가락으로 돌려요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur stovi augalas ir kas kiek dienų jį laistyti – ratukas sukamas pirštu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെടി എവിടെയാണ്, എത്ര ദിവസം കൂടുമ്പോൾ നനയ്ക്കണം — ചക്രം വിരൽ കൊണ്ട് തിരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रोप कुठे आहे आणि किती दिवसांनी पाणी द्यायचे — चक्र बोटाने फिरवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana tumbuhan berada dan berapa hari sekali disiram — roda diputar dengan jari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor planten står, og hvor ofte den skal vannes – hjulet snurres med fingeren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de plant staat en om de hoeveel dagen ze water krijgt – het wiel draait met je vinger."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗଛ କେଉଁଠି ଅଛି ଓ କେତେ ଦିନରେ ପାଣି ଦେବେ — ଚକଟିକୁ ଆଙ୍ଗୁଠିରେ ଘୁରାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੌਦਾ ਕਿੱਥੇ ਹੈ ਅਤੇ ਕਿੰਨੇ ਦਿਨਾਂ ਬਾਅਦ ਪਾਣੀ ਦੇਣਾ ਹੈ — ਪਹੀਆ ਉਂਗਲ ਨਾਲ ਘੁਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie stoi roślina i co ile dni ją podlewać – bęben kręci się palcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde a planta fica e de quanto em quanto tempo regar — a roda gira com o dedo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está a planta e de quanto em quanto tempo a regar — a roda gira com o dedo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unde stă planta și cât de des s-o uzi – roata se învârte cu degetul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde rastlina stojí a ako často ju polievať – kolieskom sa točí prstom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kje rastlina stoji in kako pogosto jo zalivati – kolo se vrti s prstom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var växten står och hur ofta den ska vattnas – hjulet snurras med fingret."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செடி எங்கே உள்ளது, எத்தனை நாளுக்கு ஒருமுறை நீர் — சக்கரத்தை விரலால் சுழற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొక్క ఎక్కడ ఉంది, ఎన్ని రోజులకొకసారి నీళ్లు — చక్రాన్ని వేలితో తిప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นไม้วางอยู่ที่ไหน และรดน้ำทุกกี่วัน — หมุนวงล้อด้วยนิ้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitki nerede duruyor ve kaç günde bir sulanmalı — çark parmakla çevrilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Де стоїть рослина й раз на скільки днів її поливати — барабан крутиться пальцем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پودا کہاں ہے اور کتنے دن بعد پانی دینا ہے — پہیہ انگلی سے گھمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cây đặt ở đâu và bao nhiêu ngày tưới một lần — xoay bánh xe bằng ngón tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物放在哪儿、几天浇一次——用手指转动滚轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "植物放在哪裡、幾天澆一次——用手指轉動滾輪。"
          }
        }
      }
    },
