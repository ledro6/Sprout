    "Называет растения, у которых срок полива — сегодня, от самого сухого.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nævner de planter, der skal vandes i dag, den tørreste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die Pflanzen, die heute gegossen werden müssen, die trockenste zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names the plants due for watering today, driest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice qué plantas toca regar hoy, de la más seca a la menos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelee tänään kasteltavat kasvit kuivimmasta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme les plantes à arroser aujourd’hui, de la plus sèche à la moins sèche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le piante da annaffiare oggi, dalla più secca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevner plantene som skal vannes i dag, den tørreste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noemt de planten die vandaag water nodig hebben, de droogste eerst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz quais plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz que plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämner växterna som ska vattnas i dag, den torraste först."
          }
        }
      }
    },
    "Найдётся по кличке или по виду — «Баксик», «Монстера».": {
