    "Медленно ведите телефоном над полом или столом": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك الهاتف ببطء فوق الأرض أو طاولة"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бавно движете телефона над пода или над маса"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেঝে বা টেবিলের উপর দিয়ে ধীরে ধীরে ফোন সরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou el telèfon a poc a poc per sobre del terra o d’una taula"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomalu pohybujte telefonem nad podlahou nebo stolem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før langsomt telefonen hen over gulvet eller et bord"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege das Telefon langsam über den Boden oder einen Tisch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κινήστε αργά το τηλέφωνο πάνω από το πάτωμα ή ένα τραπέζι"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly move your phone over the floor or a table"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el teléfono despacio sobre el suelo o una mesa"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikuta puhelinta hitaasti lattian tai pöydän yllä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez lentement le téléphone au-dessus du sol ou d’une table"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોનને જમીન કે ટેબલ ઉપર ધીમે ધીમે ફેરવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזיזו את הטלפון לאט מעל הרצפה או שולחן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को फ़र्श या मेज़ के ऊपर धीरे-धीरे घुमाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polako pomičite telefon iznad poda ili stola"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassan mozgasd a telefont a padló vagy egy asztal fölött"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan ponsel perlahan di atas lantai atau meja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi lentamente il telefono sopra il pavimento o un tavolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床かテーブルの上で、ゆっくりiPhoneを動かしてください"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонды еден не үстел үстінен баяу жүргізіңіз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥이나 테이블 위에서 기기를 천천히 움직이세요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lėtai veskite telefoną virš grindų ar stalo"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जमिनीवरून किंवा टेबलवरून फोन हळूहळू फिरवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan telefon perlahan-lahan di atas lantai atau meja"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før telefonen sakte over gulvet eller et bord"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg de telefoon langzaam over de vloer of een tafel"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚଟାଣ କିମ୍ବା ଟେବୁଲ୍ ଉପରେ ଫୋନ୍ ଧୀରେ ଘୁଞ୍ଚାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਨੂੰ ਫ਼ਰਸ਼ ਜਾਂ ਮੇਜ਼ ਉੱਤੇ ਹੌਲੀ-ਹੌਲੀ ਘੁਮਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powoli przesuwaj telefon nad podłogą lub stołem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o celular devagar sobre o chão ou uma mesa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o telemóvel devagar sobre o chão ou uma mesa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mișcă încet telefonul deasupra podelei sau a unei mese"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaly pohybujte telefónom nad podlahou alebo stolom"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Počasi premikajte telefon nad tlemi ali mizo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För telefonen långsamt över golvet eller ett bord"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่อยๆ เลื่อนโทรศัพท์เหนือพื้นหรือโต๊ะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu zeminin ya da bir masanın üzerinde yavaşça gezdirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільно ведіть телефоном над підлогою або столом"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển điện thoại chậm trên sàn hoặc mặt bàn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地面或桌面上方缓慢移动手机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在地面或桌面上方緩慢移動手機"
          }
