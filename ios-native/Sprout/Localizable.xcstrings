        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कब जा रहे हैं और कब लौटेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad odlazite i kad se vraćate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor indulsz, és mikor érsz vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan Anda pergi dan kapan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando parti e quando torni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発する日と戻る日。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қашан кетесіз және қашан ораласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಯಾವಾಗ ಹೊರಡುತ್ತೀರಿ ಮತ್ತು ಯಾವಾಗ ಹಿಂತಿರುಗುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 떠나고 언제 돌아오는지."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada išvykstate ir kada grįšite."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ എപ്പോൾ പോകുന്നു, എപ്പോൾ തിരിച്ചുവരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कधी जाणार आणि कधी परतणार."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila anda pergi dan bila anda kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du reiser, og når du kommer tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je vertrekt en wanneer je terugkomt."
          }
