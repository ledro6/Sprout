          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas plantas y habitaciones tienes y cuántos días llevas cuidando tu jardín."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka monta kasvia ja huonetta sinulla on ja kuinka monta päivää olet hoitanut puutarhaasi."
