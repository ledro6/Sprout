          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Sprout أي معلومات عنك ولا يرسل شيئًا إلى أي مكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout не събира никакви сведения за вас и не ги изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout আপনার সম্পর্কে কোনো তথ্য সংগ্রহ করে না এবং কোথাও কিছু পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout no recull cap informació sobre tu ni l’envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout o vás nesbírá žádné údaje a nikam nic neposílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout indsamler ingen oplysninger om dig og sender intet nogen steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout sammelt keine Informationen über dich und gibt nichts weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sprout δεν συλλέγει καμία πληροφορία για εσάς και δεν στέλνει τίποτα πουθενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout collects no information about you and sends nothing anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout no recopila ninguna información sobre ti ni la envía a ninguna parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ei kerää sinusta mitään tietoja eikä lähetä mitään mihinkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ne collecte aucune information sur vous et ne transmet rien."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout તમારા વિશે કોઈ માહિતી એકઠી કરતું નથી અને ક્યાંય કંઈ મોકલતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout לא אוסף עליך שום מידע ולא שולח דבר לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout आपके बारे में कोई जानकारी इकट्ठा नहीं करता और कहीं कुछ नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ne prikuplja nikakve podatke o vama i nikamo ih ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sprout semmilyen adatot nem gyűjt rólad, és nem küld sehova."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout tidak mengumpulkan informasi apa pun tentangmu dan tidak mengirimkan apa pun ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout non raccoglie informazioni su di te e non invia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sproutはあなたに関する情報を一切集めず、どこにも送信しません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout сіз туралы ешқандай мәлімет жинамайды және ешқайда жібермейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout은 사용자에 관한 어떤 정보도 수집하지 않으며 어디에도 보내지 않아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout nerenka jokios informacijos apie jus ir niekur nieko nesiunčia."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout तुमच्याबद्दल कोणतीही माहिती गोळा करत नाही आणि कुठेही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout tidak mengumpul sebarang maklumat tentang anda dan tidak menghantar apa-apa ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout samler ikke inn noen opplysninger om deg og sender ingenting noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout verzamelt geen gegevens over je en stuurt niets door."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ଆପଣଙ୍କ ବିଷୟରେ କୌଣସି ସୂଚନା ସଂଗ୍ରହ କରେ ନାହିଁ ଏବଂ କୁଆଡ଼େ କିଛି ପଠାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ਤੁਹਾਡੇ ਬਾਰੇ ਕੋਈ ਜਾਣਕਾਰੀ ਇਕੱਠੀ ਨਹੀਂ ਕਰਦੀ ਅਤੇ ਕਿਤੇ ਕੁਝ ਨਹੀਂ ਭੇਜਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout nie zbiera o tobie żadnych informacji i nigdzie ich nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout não coleta nenhuma informação sobre você e não envia nada para lugar nenhum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout não recolhe nenhuma informação sobre si e não envia nada para lado nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout nu colectează nicio informație despre tine și nu trimite nimic nicăieri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout o vás nezbiera žiadne údaje a nikam nič neposiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout o vas ne zbira nobenih podatkov in jih nikamor ne pošilja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout samlar inga uppgifter om dig och skickar inget någonstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ไม่เก็บข้อมูลใดๆ เกี่ยวกับคุณและไม่ส่งอะไรไปที่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout hakkınızda hiçbir bilgi toplamaz ve hiçbir yere göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout не збирає про вас жодних відомостей і нікуди їх не передає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout không thu thập bất kỳ thông tin nào về bạn và không gửi đi đâu cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout 不会收集你的任何信息，也不会发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout 不會收集你的任何資訊，也不會傳送到任何地方。"
          }
        }
      }
    },
