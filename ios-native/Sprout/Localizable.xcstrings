    "Позвать меня в соперники: скопируйте это сообщение целиком и нажмите «Вставить» в Sprout → Профиль → Друзья.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافتي كمنافس: انسخ هذه الرسالة كاملة واضغط «لصق» في Sprout ← الملف الشخصي ← الأصدقاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави ме за съперник: копирай цялото съобщение и докосни „Постави“ в Sprout → Профил → Приятели."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per afegir-me com a rival, copia tot aquest missatge i toca «Enganxa» a Sprout → Perfil → Amics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte si mě jako soupeře: zkopírujte celou tuto zprávu a klepněte na „Vložit“ v Sprout → Profil → Přátelé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj mig som rival: Kopiér hele denne besked, og tryk på ”Indsæt” i Sprout → Profil → Venner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mich als Rivalen hinzuzufügen: Kopiere diese ganze Nachricht und tippe in Sprout → Profil → Freunde auf „Einsetzen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσέ με ως αντίπαλο: αντίγραψε όλο αυτό το μήνυμα και πάτησε «Επικόλληση» στο Sprout → Προφίλ → Φίλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add me as a rival, copy this whole message and tap “Paste” in Sprout → Profile → Friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadirme como rival, copia todo este mensaje y toca “Pegar” en Sprout → Perfil → Amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää minut kilpailijaksi: kopioi koko tämä viesti ja napauta ”Sijoita” kohdassa Sprout → Profiili → Kaverit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour m’ajouter comme rival : copiez tout ce message et touchez « Coller » dans Sprout → Profil → Amis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף אותי כיריב: העתק את כל ההודעה הזו והקש על “הדבק” ב־Sprout ← פרופיל ← חברים."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj me kao suparnika: kopiraj cijelu ovu poruku i dodirni „Zalijepi” u Sprout → Profil → Prijatelji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá riválisként: másold ki ezt az egész üzenetet, és koppints a „Beillesztés” gombra itt: Sprout → Profil → Barátok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungermi come rivale, copia tutto questo messaggio e tocca “Incolla” in Sprout → Profilo → Amici."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мені қарсылас ретінде қос: осы хабарды толық көшіріп, Sprout → Профиль → Достар ішінде «Қою» түймесін бас."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėk mane kaip varžovą: nukopijuok visą šią žinutę ir bakstelėk „Įklijuoti“ skiltyje Sprout → Profilis → Draugai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg meg til som rival: Kopier hele denne meldingen, og trykk på «Lim inn» i Sprout → Profil → Venner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg me toe als rivaal: kopieer dit hele bericht en tik op ‘Plak’ in Sprout → Profiel → Vrienden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać mnie jako rywala, skopiuj całą tę wiadomość i stuknij „Wklej” w Sprout → Profil → Znajomi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă-mă ca rival: copiază tot mesajul acesta și atinge „Lipește” în Sprout → Profil → Prieteni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte si ma ako súpera: skopírujte celú túto správu a klepnite na „Vložiť“ v Sprout → Profil → Priatelia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj me kot tekmeca: kopiraj vse to sporočilo in tapni »Prilepi« v Sprout → Profil → Prijatelji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till mig som rival: kopiera hela meddelandet och tryck på ”Klistra in” i Sprout → Profil → Vänner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beni rakip olarak eklemek için bu mesajın tamamını kopyala ve Sprout → Profil → Arkadaşlar’da “Yapıştır”a dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай мене в суперники: скопіюй це повідомлення повністю й натисни «Вставити» в Sprout → Профіль → Друзі."
          }
        }
      }
    },
