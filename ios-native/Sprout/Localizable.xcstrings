        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sudah tidak ada di kebun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è più nel giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はもう庭にありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» енді бақта жоқ."
