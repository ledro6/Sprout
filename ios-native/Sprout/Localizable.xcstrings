        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಈಗ ತೋಟದಲ್ಲಿ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 더 이상 정원에 없어요."
