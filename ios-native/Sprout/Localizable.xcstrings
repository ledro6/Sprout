        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay geçit töreni yok: bitkiler farklı zamanlarda su istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найближчого місяця парадів немає: рослини просять води врозбрід."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مہینے کوئی پریڈ نہیں: پودے الگ الگ وقت پانی مانگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháng này không có cuộc diễu hành nào: cây cần nước vào những lúc khác nhau."
          }
        },
        "zh-Hans": {
