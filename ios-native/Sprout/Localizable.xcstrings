    "Звуки выключены в настройках — будет без музыки.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصوات متوقفة في الإعدادات — سيُعرض دون موسيقى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуците са изключени в настройките – ще е без музика."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে শব্দ বন্ধ আছে — সংগীত ছাড়াই চলবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els sons estan desactivats a Configuració: sonarà sense música."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuky jsou v nastavení vypnuté – bude to bez hudby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyde er slået fra i Indstillinger – det afspilles uden musik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Töne sind in den Einstellungen aus – es läuft ohne Musik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ήχοι είναι απενεργοποιημένοι στις ρυθμίσεις — θα παίξει χωρίς μουσική."
          }
        },
        "en": {
