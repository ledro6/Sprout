        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У неї можна буде посадити або перевезти рослини."
          }
        }
      }
    },
    "Растения дождутся меня сами — поливать никого не нужно. Спасибо!": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتدبر النباتات أمرها من دوني — لا حاجة للسقي. شكرًا!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растенията ще издържат без мен — няма нужда от поливане. Благодаря!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes aguantaran sense mi: no cal regar. Gràcies!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostliny to beze mě zvládnou — zalévat není potřeba. Díky!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planterne klarer sig uden mig – ingen skal vandes. Tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen kommen ohne mich aus — gießen ist nicht nötig. Danke!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα φυτά θα τα βγάλουν πέρα χωρίς εμένα — δεν χρειάζεται πότισμα. Ευχαριστώ!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plants will be fine without me — no watering needed. Thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas aguantarán sin mí: no hace falta regar. ¡Gracias!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvit pärjäävät ilman minua – kastelua ei tarvita. Kiitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes tiendront sans moi — pas besoin d’arroser. Merci !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמחים יסתדרו בלעדיי — אין צורך להשקות. תודה!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljke će izdržati bez mene — ne treba ih zalijevati. Hvala!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növények kibírják nélkülem — nem kell öntözni. Köszönöm!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante resisteranno senza di me: non serve annaffiare. Grazie!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдіктер менсіз де шыдайды — суарудың қажеті жоқ. Рақмет!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalai išsivers be manęs – laistyti nereikia. Ačiū!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantene klarer seg uten meg – ingen trenger vann. Takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planten redden zich zonder mij — water geven is niet nodig. Bedankt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośliny poradzą sobie beze mnie — nie trzeba ich podlewać. Dziękuję!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas vão aguentar sem mim — não precisa regar. Obrigado!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas aguentam sem mim — não é preciso regar. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantele se descurcă fără mine — nu trebuie udate. Mulțumesc!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastliny to bezo mňa zvládnu — netreba polievať. Ďakujem!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastline bodo zdržale brez mene — zalivanje ni potrebno. Hvala!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växterna klarar sig utan mig – ingen behöver vattnas. Tack!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiler bensiz idare eder — sulamaya gerek yok. Teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослини дочекаються мене самі — поливати нікого не треба. Дякую!"
          }
        }
      }
    },
    "Растения на снимке не видно — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر نبتة في الصورة — سأستخدم النموذج الجاهز للنوع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На снимката не се вижда растение — ще взема готовия модел на вида."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es veu cap planta a la foto: faré servir el model a punt de l’espècie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotce není vidět žádná rostlina — použiji hotový model druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen plante på fotoet – jeg bruger artens færdige model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Foto ist keine Pflanze zu sehen — ich nehme das fertige Modell der Art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν φαίνεται φυτό στη φωτογραφία — θα χρησιμοποιήσω το έτοιμο μοντέλο του είδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plant visible in the photo — I’ll use the species’ ready-made model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ve ninguna planta en la foto: usaré el modelo listo de la especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvassa ei näy kasvia – käytän lajin valmista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune plante visible sur la photo — je prendrai le modèle prêt de l’espèce."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא רואים צמח בתמונה — אשתמש במודל המוכן של הזן."
          }
        },
        "hr": {
          "stringUnit": {
