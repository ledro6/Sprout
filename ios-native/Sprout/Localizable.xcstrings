            "value": "Cores, densidade e altura, tiradas da fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culori, densitate și înălțime – din fotografie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Farby, hustota a výška – z fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Barve, gostota in višina – s fotografije."
          }
        },
        "sv": {
