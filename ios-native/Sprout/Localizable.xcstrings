    "Растения «%@» в саду больше нет.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد «%@» في الحديقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ вече не е в градината."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” আর বাগানে নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja no és al jardí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ už v zahradě není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er ikke længere i haven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht mehr im Garten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν είναι πια στον κήπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is no longer in the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya no está en el jardín."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole enää puutarhassa."
          }
        },
        "fr": {
