    "По запросу «%@» в квартире ничего не растёт.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في منزلك يطابق «%@»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По заявката „%@“ вкъщи нищо не расте."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa no creix res que coincideixi amb «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U vás doma nic neodpovídá „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet hjemme hos dig passer til ”%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu „%@“ wächst bei dir nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο σπίτι δεν υπάρχει τίποτα για «%@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in your home matches “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No crece nada en casa que coincida con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotonasi ei kasva mitään haulla ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne pousse chez vous pour « %@ »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין בבית שום דבר שמתאים ל־“%@”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod vas ništa ne odgovara upitu „%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Otthon semmi sem felel meg ennek: „%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna pianta in casa corrisponde a “%@”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» сұрауы бойынша үйде ештеңе өспейді."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Namuose nieko neatitinka „%@“."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting hjemme hos deg passer til «%@»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets bij je thuis past bij ‘%@’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W domu nic nie pasuje do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cresce na sua casa com “%@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em sua casa corresponde a “%@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acasă nu crește nimic pentru „%@”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "U vás doma nič nezodpovedá „%@“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doma nič ne ustreza »%@«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget hemma hos dig matchar ”%@”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde “%@” ile eşleşen bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За запитом «%@» у квартирі нічого не росте."
          }
        }
      }
    },
