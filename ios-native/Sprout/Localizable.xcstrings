    "Имя правится прямо в строке. Потяните за ручку справа, чтобы поменять порядок, — в том же порядке комнаты встанут и в меню на главной.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعدَّل الاسم مباشرة في السطر. اسحب المقبض لتغيير الترتيب — ستظهر الغرف بالترتيب نفسه في قائمة الصفحة الرئيسية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името се редактира направо в реда. Дръпнете дръжката вдясно, за да смените реда — в същия ред стаите ще се появят и в менюто на началния екран."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom s’edita a la mateixa fila. Arrossega la nansa de la dreta per canviar l’ordre: les habitacions sortiran en el mateix ordre al menú d’inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název se upravuje přímo v řádku. Tažením úchytu vpravo změníte pořadí — ve stejném pořadí budou místnosti i v nabídce na domovské obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres direkte i rækken. Træk i håndtaget til højre for at ændre rækkefølgen – rummene vises i samme rækkefølge i menuen på startskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird direkt in der Zeile bearbeitet. Zieh am Griff rechts, um die Reihenfolge zu ändern — in derselben Reihenfolge erscheinen die Räume auch im Menü auf der Startseite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα αλλάζει απευθείας στη γραμμή. Σύρετε τη λαβή δεξιά για να αλλάξετε τη σειρά — με την ίδια σειρά θα εμφανίζονται τα δωμάτια και στο μενού της αρχικής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit a name right in its row. Drag the handle on the right to change the order — rooms appear in the same order in the menu on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se edita en la propia fila. Arrastra el asa de la derecha para cambiar el orden: las habitaciones aparecerán en el mismo orden en el menú de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeä muokataan suoraan rivillä. Muuta järjestystä vetämällä oikealla olevasta kahvasta – huoneet näkyvät samassa järjestyksessä kodin valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom se modifie directement dans la ligne. Faites glisser la poignée à droite pour changer l’ordre — les pièces apparaîtront dans le même ordre dans le menu de l’accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם נערך ישירות בשורה. גררו את הידית משמאל כדי לשנות את הסדר — באותו סדר החדרים יופיעו גם בתפריט במסך הראשי."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv se uređuje izravno u retku. Povucite ručicu desno da promijenite redoslijed — istim će redom sobe biti i u izborniku na početnoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név közvetlenül a sorban szerkeszthető. A sorrend a jobb oldali fogantyú húzásával módosítható — a szobák ugyanebben a sorrendben jelennek meg a főoldal menüjében is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome si modifica direttamente nella riga. Trascina la maniglia a destra per cambiare l’ordine: le stanze appariranno nello stesso ordine nel menu della Home."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы тура жолда өзгертіледі. Ретін өзгерту үшін оң жақтағы тұтқаны сүйреңіз — бөлмелер басты беттегі мәзірде де сол ретпен тұрады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pavadinimas redaguojamas tiesiog eilutėje. Tempkite rankenėlę dešinėje, kad pakeistumėte tvarką – ta pačia tvarka kambariai bus ir pradžios meniu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet redigeres rett i raden. Dra i håndtaket til høyre for å endre rekkefølgen – rommene vises i samme rekkefølge i menyen på startsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam wijzig je direct in de regel. Sleep de greep rechts om de volgorde te wijzigen — in dezelfde volgorde staan de kamers in het menu op het startscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwę edytuje się bezpośrednio w wierszu. Przeciągnij uchwyt po prawej, aby zmienić kolejność — w tej samej kolejności pokoje pojawią się w menu na ekranie głównym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome é editado na própria linha. Arraste a alça à direita para mudar a ordem — os cômodos aparecerão na mesma ordem no menu do início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome edita-se na própria linha. Arraste a pega à direita para mudar a ordem — as divisões aparecem pela mesma ordem no menu do início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele se editează direct pe rând. Trage de mânerul din dreapta ca să schimbi ordinea — camerele vor apărea în aceeași ordine și în meniul paginii principale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názov sa upravuje priamo v riadku. Potiahnutím úchytu vpravo zmeníte poradie — v rovnakom poradí budú miestnosti aj v ponuke na úvodnej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime urejate kar v vrstici. Povlecite ročico na desni, da spremenite vrstni red — v enakem vrstnem redu bodo sobe tudi v meniju na začetnem zaslonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet redigeras direkt i raden. Dra i handtaget till höger för att ändra ordningen – rummen visas i samma ordning i menyn på hemskärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad doğrudan satırda düzenlenir. Sırayı değiştirmek için sağdaki tutamağı sürükleyin — odalar ana sayfadaki menüde de aynı sırayla görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва правиться просто в рядку. Потягніть за ручку праворуч, щоб змінити порядок, — у тому самому порядку кімнати стануть і в меню на головній."
          }
        }
      }
    },
    "Имя стоит в профиле и уходит вместе со счётом друзьям.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر اسمك في الملف الشخصي ويُرسل مع نقاطك إلى الأصدقاء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името стои в профила и отива заедно с резултата при приятелите."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu nom surt al perfil i arriba als amics amb la teva puntuació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jméno je v profilu a putuje se skóre k přátelům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn står i profilen og følger med din score til vennerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name steht im Profil und geht mit deinem Punktestand an Freunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομά σας εμφανίζεται στο προφίλ και πηγαίνει μαζί με το σκορ στους φίλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name appears in your profile and is sent to friends along with your score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre aparece en el perfil y viaja con tu puntuación a tus amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi näkyy profiilissa ja lähtee pisteidesi mukana kavereille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom figure dans le profil et part avec votre score chez vos amis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם מופיע בפרופיל ונשלח לחברים יחד עם הניקוד."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime je u profilu i ide s vašim rezultatom prijateljima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A neved a profilban szerepel, és a pontszámoddal együtt eljut a barátaidhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome compare nel profilo e arriva agli amici con il tuo punteggio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атыңыз профильде тұрады және ұпаймен бірге достарға барады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardas rodomas profilyje ir kartu su rezultatu keliauja draugams."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet ditt står i profilen og følger med poengsummen til vennene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam staat in je profiel en gaat met je score mee naar vrienden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imię widnieje w profilu i trafia razem z wynikiem do znajomych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome aparece no perfil e vai junto com sua pontuação para os amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu nome aparece no perfil e vai com a sua pontuação para os amigos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele apare în profil și pleacă împreună cu scorul la prieteni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno je v profile a putuje so skóre k priateľom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime je v profilu in gre skupaj z rezultatom k prijateljem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt namn visas i profilen och följer med poängen till vännerna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız profilde görünür ve puanınızla birlikte arkadaşlarınıza gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім’я стоїть у профілі й іде разом із рахунком друзям."
          }
        }
      }
    },
