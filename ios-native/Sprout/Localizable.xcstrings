    "Телефон узнал: %1$@ — уверен на %2$lld%%. Поправьте, если не так.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التعرف: %1$@ — بثقة %2$lld٪. صحّح إن لم يكن صحيحًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознато: %1$@ — сигурност %2$lld%%. Поправете, ако не е така."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চেনা গেছে: %1$@ — %2$lld%% নিশ্চিত। ভুল হলে ঠিক করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconeguda: %1$@, amb un %2$lld %% de seguretat. Corregeix-ho si no és així."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznáno: %1$@ — jistota %2$lld %%. Pokud to nesedí, opravte to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkendt: %1$@ – %2$lld %% sikker. Ret det, hvis det er forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannt: %1$@ — zu %2$lld %% sicher. Korrigiere es, falls es nicht stimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναγνωρίστηκε: %1$@ — βεβαιότητα %2$lld%%. Διορθώστε αν δεν είναι σωστό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognized: %1$@ — %2$lld%% sure. Correct it if that’s wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocida: %1$@, con un %2$lld %% de seguridad. Corrígelo si no es así."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistettu: %1$@ – %2$lld %% varma. Korjaa, jos se on väärin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnu : %1$@ — sûr à %2$lld %%. Corrigez si ce n’est pas ça."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓળખાયું: %1$@ — %2$lld%% ખાતરી. ખોટું હોય તો સુધારો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהה: %1$@ — ודאות של %2$lld%%. אפשר לתקן אם זה לא נכון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचाना गया: %1$@ — %2$lld%% भरोसा। गलत हो तो ठीक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznato: %1$@ — sigurnost %2$lld %%. Ispravite ako nije točno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felismerve: %1$@ — %2$lld%%-os biztonsággal. Javítsd, ha nem ez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikenali: %1$@ — yakin %2$lld%%. Perbaiki kalau salah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosciuta: %1$@, sicuro al %2$lld%%. Correggi se non è giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識結果：%1$@ — 確信度%2$lld%%。違っていたら修正してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Танылды: %1$@ — сенімділік %2$lld%%. Қате болса, түзетіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식됨: %1$@ — 확신도 %2$lld%%. 틀렸다면 고쳐 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atpažinta: %1$@ – tikimybė %2$lld %%. Pataisykite, jei ne tas."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळखले: %1$@ — %2$lld%% खात्री. चुकीचे असल्यास दुरुस्त करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikenal pasti: %1$@ — yakin %2$lld%%. Betulkan jika salah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenkjent: %1$@ – %2$lld %% sikker. Rett det hvis det er feil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkend: %1$@ — %2$lld%% zeker. Pas het aan als het niet klopt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚିହ୍ନାଗଲା: %1$@ — %2$lld%% ନିଶ୍ଚିତ। ଭୁଲ୍ ହେଲେ ସୁଧାରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਛਾਣਿਆ: %1$@ — %2$lld%% ਯਕੀਨ। ਗਲਤ ਹੋਵੇ ਤਾਂ ਠੀਕ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznano: %1$@ — pewność %2$lld%%. Popraw, jeśli to nie to."
          }
        },
        "pt-BR": {
