    "Исчезнут все растения и весь журнал поливов. Вернуть их будет нельзя.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستختفي كل النباتات وسجل السقي كاملًا. لا يمكن التراجع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще изчезнат всички растения и целият дневник на поливанията. Връщане няма."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desapareixeran totes les plantes i tot el registre de regades. No es podrà desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizí všechny rostliny i celý deník zálivek. Nepůjde to vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planter og hele vandingsloggen forsvinder. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pflanzen und das ganze Gießprotokoll verschwinden. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα εξαφανιστούν όλα τα φυτά και όλο το ημερολόγιο ποτίσματος. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All plants and the whole watering log will disappear. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparecerán todas las plantas y todo el registro de riegos. No se podrá deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kasvit ja koko kastelupäiväkirja katoavat. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les plantes et tout le journal d’arrosage disparaîtront. Impossible de revenir en arrière."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הצמחים וכל יומן ההשקיות ייעלמו. אי אפשר לבטל."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestat će sve biljke i cijeli dnevnik zalijevanja. To se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden növény és a teljes öntözési napló eltűnik. Ez nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spariranno tutte le piante e tutto il registro delle annaffiature. Non si potrà annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық өсімдіктер мен бүкіл суару журналы жойылады. Қайтару мүмкін болмайды."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išnyks visi augalai ir visas laistymo žurnalas. Atšaukti nebus galima."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planter og hele vanningsloggen forsvinner. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planten en het hele waterlogboek verdwijnen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znikną wszystkie rośliny i cały dziennik podlewania. Nie da się tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas e todo o histórico de regas vão sumir. Não será possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas e todo o registo de regas vão desaparecer. Não será possível anular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dispărea toate plantele și tot jurnalul de udări. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiznú všetky rastliny aj celý denník polievania. Nebude sa to dať vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izginile bodo vse rastline in ves dnevnik zalivanja. Tega ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla växter och hela vattningsloggen försvinner. Det går inte att ångra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bitkiler ve bütün sulama günlüğü silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зникнуть усі рослини й увесь журнал поливів. Повернути їх буде неможливо."
          }
        }
      }
    },
    "Их включают в настройках телефона: Sprout → Уведомления.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّلها من إعدادات الهاتف: Sprout ← الإشعارات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете ги в настройките на телефона: Sprout → Известия."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa-les a la configuració del telèfon: Sprout → Notificacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte je v Nastavení telefonu: Sprout → Oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå dem til i telefonens Indstillinger: Sprout → Notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere sie in den Einstellungen des Telefons: Sprout → Mitteilungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις στις Ρυθμίσεις του τηλεφώνου: Sprout → Ειδοποιήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn them on in the phone’s Settings: Sprout → Notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalas en los Ajustes del teléfono: Sprout → Notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita ne päälle puhelimen asetuksista: Sprout → Ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-les dans les Réglages du téléphone : Sprout → Notifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להפעיל אותן בהגדרות הטלפון: Sprout ← התראות."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite ih u postavkama telefona: Sprout → Obavijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be őket a telefon Beállításaiban: Sprout → Értesítések."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivale nelle Impostazioni del telefono: Sprout → Notifiche."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оларды телефон баптауларында қосыңыз: Sprout → Хабарландырулар."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite juos telefono nustatymuose: Sprout → Pranešimai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå dem på i telefonens Innstillinger: Sprout → Varslinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet ze aan in de Instellingen van de telefoon: Sprout → Meldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz je w Ustawieniach telefonu: Sprout → Powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-as nos Ajustes do celular: Sprout → Notificações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-as nas Definições do telemóvel: Sprout → Notificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează-le în Configurările telefonului: Sprout → Notificări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite ich v Nastaveniach telefónu: Sprout → Hlásenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite jih v nastavitvah telefona: Sprout → Obvestila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på dem i telefonens Inställningar: Sprout → Notiser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun Ayarlar’ından açın: Sprout → Bildirimler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх вмикають у налаштуваннях телефона: Sprout → Сповіщення."
          }
        }
      }
    },
