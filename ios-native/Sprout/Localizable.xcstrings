            "state": "translated",
            "value": "Градината е празна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাগান খালি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardí és buit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrada je prázdná."
          }
        },
