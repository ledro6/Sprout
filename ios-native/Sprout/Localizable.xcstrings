    "Растение «%@» удалено. Его можно вернуть.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er slettet. Du kan hente den tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ gelöscht. Du kannst sie zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deleted. You can bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminada. Puedes recuperarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” poistettu. Voit palauttaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » supprimée. Vous pouvez la récupérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminata. Puoi recuperarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er slettet. Du kan hente den tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ verwijderd. Je kunt hem terughalen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” excluída. Você pode recuperá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” apagada. Pode recuperá-la."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” raderad. Du kan ta tillbaka den."
          }
        }
      }
    },
    "Растение переедет туда, и комната появится в списке.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten flytter derhen, og rummet vises på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze zieht dorthin um, und der Raum erscheint in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant will move there, and the room will appear in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se mudará allí y la habitación aparecerá en la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi muuttaa sinne, ja huone ilmestyy luetteloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante déménagera, et la pièce apparaîtra dans la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta si trasferirà lì e la stanza apparirà nell’elenco."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten flytter dit, og rommet vises i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant verhuist daarheen en de kamer verschijnt in de lijst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta vai se mudar para lá, e o cômodo aparecerá na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta muda-se para lá e a divisão aparece na lista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växten flyttar dit och rummet visas i listan."
          }
        }
      }
    },
    "Растение стоит. Его можно полить.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten står på plads. Du kan vande den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze steht. Du kannst sie gießen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is in place. You can water it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta está colocada. Puedes regarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi on paikallaan. Voit kastella sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante est en place. Vous pouvez l’arroser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta è posizionata. Puoi annaffiarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten står på plass. Du kan vanne den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant staat. Je kunt hem water geven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está no lugar. Você pode regá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está no lugar. Pode regá-la."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växten står på plats. Du kan vattna den."
          }
        }
      }
