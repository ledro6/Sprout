    "Кольцо — ваш год: каждая яркая точка — день с поливом.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحلقة هي عامك: كل نقطة مضيئة يوم سقي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пръстенът е вашата година: всяка ярка точка е ден с поливане."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বলয় আপনার বছর: প্রতিটি উজ্জ্বল বিন্দু জল দেওয়ার দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anell és el teu any: cada punt brillant és un dia amb reg."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kruh je váš rok: každá jasná tečka je den se zálivkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen er dit år: hver lys prik er en dag med vanding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ring ist dein Jahr: Jeder helle Punkt ist ein Tag mit Gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δακτύλιος είναι η χρονιά σας: κάθε φωτεινή κουκκίδα είναι μια μέρα με πότισμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring is your year: every bright dot is a day you watered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo es tu año: cada punto brillante es un día con riego."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengas on vuotesi: jokainen kirkas piste on kastelupäivä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anneau, c’est votre année : chaque point brillant est un jour d’arrosage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વર્તુળ તમારું વર્ષ છે: દરેક ચમકતું ટપકું પાણી આપ્યાનો દિવસ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטבעת היא השנה שלך: כל נקודה בוהקת היא יום עם השקיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह घेरा आपका साल है: हर चमकता बिंदु पानी वाला दिन है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prsten je vaša godina: svaka svijetla točka je dan sa zalijevanjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűrű az éved: minden fényes pont egy öntözős nap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin ini adalah tahun Anda: setiap titik terang adalah hari dengan penyiraman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anello è il tuo anno: ogni punto luminoso è un giorno di annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングがあなたの1年。明るい点が水やりした日です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақина — сіздің жылыңыз: әр жарық нүкте — суарылған күн."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಉಂಗುರ ನಿಮ್ಮ ವರ್ಷ: ಪ್ರತಿ ಹೊಳೆಯುವ ಚುಕ್ಕೆ ನೀರು ಹಾಕಿದ ದಿನ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링은 당신의 한 해예요. 밝은 점 하나하나가 물 준 날이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiedas — tai jūsų metai: kiekvienas šviesus taškas — diena su laistymu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വളയം നിങ്ങളുടെ വർഷമാണ്: ഓരോ തിളങ്ങുന്ന പുള്ളിയും നനച്ച ഒരു ദിവസം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे वर्तुळ तुमचे वर्ष आहे: प्रत्येक चमकणारा ठिपका म्हणजे पाणी घातलेला दिवस."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin ini tahun anda: setiap titik terang ialah hari dengan siraman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen er året ditt: hver lys prikk er en dag med vanning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ring is je jaar: elke heldere stip is een dag met water."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ବଳୟ ଆପଣଙ୍କ ବର୍ଷ: ପ୍ରତ୍ୟେକ ଉଜ୍ଜ୍ୱଳ ବିନ୍ଦୁ ପାଣି ଦେଇଥିବା ଦିନ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਘੇਰਾ ਤੁਹਾਡਾ ਸਾਲ ਹੈ: ਹਰ ਚਮਕਦਾ ਬਿੰਦੂ ਪਾਣੀ ਵਾਲਾ ਦਿਨ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień to twój rok: każdy jasny punkt to dzień z podlewaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel é o seu ano: cada ponto brilhante é um dia com rega."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel é o seu ano: cada ponto brilhante é um dia com rega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inelul e anul tău: fiecare punct luminos e o zi cu udare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kruh je váš rok: každá jasná bodka je deň s polievaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroč je vaše leto: vsaka svetla pika je dan z zalivanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen är ditt år: varje ljus prick är en dag med vattning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வளையம் உங்கள் ஆண்டு: ஒவ்வொரு ஒளிரும் புள்ளியும் நீர் ஊற்றிய ஒரு நாள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వలయం మీ ఏడాది: ప్రతి మెరిసే చుక్క నీళ్లు పోసిన రోజు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนคือหนึ่งปีของคุณ ทุกจุดสว่างคือวันที่รดน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halka sizin yılınız: her parlak nokta sulama yapılan bir gün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце — ваш рік: кожна яскрава точка — день із поливом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دائرہ آپ کا سال ہے: ہر چمکتا نقطہ پانی والا دن ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng tròn là cả năm của bạn: mỗi chấm sáng là một ngày có tưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环就是你的一年：每个亮点都是浇过水的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓環就是你的一年：每個亮點都是澆過水的一天。"
          }
        }
      }
    },
    "Кольцо — сколько растений довольны. Полоска под ним — влажность каждого, от самого сухого.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحلقة تبيّن كم نبتة راضية. والشريط تحتها يبيّن رطوبة كل نبتة، بدءًا بالأجف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пръстенът показва колко растения са доволни. Лентата под него – влажността на всяко, от най-сухото."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বৃত্তটি দেখায় কতগুলো গাছ খুশি। নিচের ফিতে প্রতিটির আর্দ্রতা দেখায়, সবচেয়ে শুকনো থেকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anell mostra quantes plantes estan contentes. La franja de sota, la humitat de cadascuna, de la més seca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kruh ukazuje, kolik rostlin je spokojených. Proužek pod ním vlhkost každé z nich, od nejsušší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen viser, hvor mange planter der er tilfredse. Striben nedenunder viser fugten hos hver enkelt, den tørreste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ring zeigt, wie viele Pflanzen zufrieden sind. Der Streifen darunter zeigt die Feuchtigkeit jeder einzelnen, die trockenste zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δακτύλιος δείχνει πόσα φυτά είναι ικανοποιημένα. Η λωρίδα από κάτω δείχνει την υγρασία του καθενός, από το πιο ξερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring shows how many plants are happy. The strip below shows each one’s moisture, driest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo muestra cuántas plantas están contentas. La franja de abajo, la humedad de cada una, de la más seca a la más húmeda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengas näyttää, kuinka moni kasvi on tyytyväinen. Alla oleva nauha näyttää jokaisen kosteuden kuivimmasta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anneau montre combien de plantes sont contentes. La bande en dessous montre l’humidité de chacune, de la plus sèche à la plus humide."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વર્તુળ બતાવે છે કેટલા છોડ ખુશ છે. નીચેની પટ્ટી દરેકનો ભેજ બતાવે છે, સૌથી સૂકાથી શરૂ કરીને."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטבעת מראה כמה צמחים מרוצים. הפס שמתחתיה מראה את הלחות של כל אחד, מהיבש ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घेरा बताता है कितने पौधे ख़ुश हैं। उसके नीचे की पट्टी हर पौधे की नमी दिखाती है, सबसे सूखे से शुरू।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prsten pokazuje koliko je biljaka zadovoljno. Traka ispod pokazuje vlažnost svake, od najsuše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűrű mutatja, hány növény elégedett. Alatta a csík mindegyik nedvességét, a legszárazabbtól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin menunjukkan berapa tanaman yang senang. Pita di bawahnya menunjukkan kelembapan tiap tanaman, dari yang paling kering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anello mostra quante piante sono contente. La striscia sotto mostra l’umidità di ciascuna, dalla più secca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングは満足している植物の数。その下の帯は、乾いている順にそれぞれの湿度を示します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақина — қанша өсімдік риза екенін көрсетеді. Астындағы жолақ — әрқайсысының ылғалы, ең құрғағынан бастап."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಂಗುರ ಎಷ್ಟು ಗಿಡಗಳು ಖುಷಿಯಾಗಿವೆ ಎಂದು ತೋರಿಸುತ್ತದೆ. ಕೆಳಗಿನ ಪಟ್ಟಿ ಪ್ರತಿಯೊಂದರ ತೇವಾಂಶವನ್ನು ಅತಿ ಒಣಗಿದ್ದರಿಂದ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링은 만족한 식물의 수를 보여 줍니다. 그 아래 띠는 가장 마른 것부터 각 식물의 습도를 보여 줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiedas rodo, kiek augalų patenkinti. Juosta po juo – kiekvieno drėgmę, nuo sausiausio."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വളയം എത്ര ചെടികൾ സന്തുഷ്ടരാണെന്ന് കാണിക്കുന്നു. താഴെയുള്ള പട്ട ഓരോന്നിന്റെയും ഈർപ്പം ഏറ്റവും ഉണങ്ങിയതിൽ നിന്ന് കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तुळ सांगते किती रोपे खूश आहेत. त्याखालची पट्टी प्रत्येकाचा ओलावा दाखवते, सर्वात कोरड्यापासून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelang menunjukkan berapa banyak tumbuhan yang gembira. Jalur di bawahnya menunjukkan kelembapan setiap satu, dari yang paling kering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen viser hvor mange planter som er fornøyde. Stripen under viser fuktigheten til hver, den tørreste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ring toont hoeveel planten tevreden zijn. De strook eronder toont de vochtigheid van elke plant, de droogste eerst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଳୟଟି ଦେଖାଏ କେତେ ଗଛ ଖୁସି। ତଳର ଫିତା ପ୍ରତ୍ୟେକଙ୍କ ଆର୍ଦ୍ରତା ଦେଖାଏ, ସବୁଠୁ ଶୁଖିଲାରୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੇਰਾ ਦੱਸਦਾ ਹੈ ਕਿੰਨੇ ਪੌਦੇ ਖ਼ੁਸ਼ ਹਨ। ਹੇਠਲੀ ਪੱਟੀ ਹਰ ਇੱਕ ਦੀ ਨਮੀ ਦਿਖਾਉਂਦੀ ਹੈ, ਸਭ ਤੋਂ ਸੁੱਕੇ ਤੋਂ ਸ਼ੁਰੂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień pokazuje, ile roślin jest zadowolonych. Pasek pod nim – wilgotność każdej, od najsuchszej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel mostra quantas plantas estão felizes. A faixa abaixo mostra a umidade de cada uma, da mais seca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel mostra quantas plantas estão contentes. A faixa por baixo mostra a humidade de cada uma, da mais seca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inelul arată câte plante sunt mulțumite. Banda de dedesubt arată umiditatea fiecăreia, de la cea mai uscată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kruh ukazuje, koľko rastlín je spokojných. Pásik pod ním vlhkosť každej z nich, od najsuchšej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroč kaže, koliko rastlin je zadovoljnih. Trak pod njim kaže vlažnost vsake, od najbolj suhe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringen visar hur många växter som är nöjda. Remsan under visar fukten hos var och en, den torraste först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளையம் எத்தனை செடிகள் மகிழ்ச்சியாக உள்ளன என்று காட்டுகிறது. கீழே உள்ள பட்டை ஒவ்வொன்றின் ஈரப்பதத்தையும் மிகக் காய்ந்ததிலிருந்து காட்டுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉంగరం ఎన్ని మొక్కలు సంతోషంగా ఉన్నాయో చూపిస్తుంది. కింది పట్టీ ప్రతి మొక్క తేమను అత్యంత ఎండినదాని నుంచి చూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนบอกว่ามีต้นไม้กี่ต้นที่พอใจ แถบด้านล่างบอกความชื้นของแต่ละต้น เริ่มจากต้นที่แห้งที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halka, kaç bitkinin memnun olduğunu gösterir. Altındaki şerit, her birinin nemini en kurudan başlayarak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце — скільки рослин задоволені. Смужка під ним — вологість кожної, від найсухішої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دائرہ بتاتا ہے کتنے پودے خوش ہیں۔ اس کے نیچے پٹی ہر پودے کی نمی دکھاتی ہے، سب سے خشک سے شروع کر کے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng tròn cho biết bao nhiêu cây đang vui. Dải bên dưới cho biết độ ẩm của từng cây, từ cây khô nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环显示有多少植物状态良好。下面的色条显示每株的湿度，从最干的开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓環顯示有多少植物狀態良好。下面的色條顯示每株的濕度，從最乾的開始。"
          }
        }
      }
    },
