          "stringUnit": {
            "state": "translated",
            "value": "آج کسے پانی دینا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay tưới cây nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天该浇谁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天該澆誰"
          }
        }
      }
    },
    "Кого полить соседу": {
      "extractionState": "manual",
      "localizations": {
