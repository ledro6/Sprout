    "Поливаете с запасом: пересохнуть вашим растениям не грозит.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسقي مبكرًا: لا خطر على نباتاتك من الجفاف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливате с резерв: на растенията ви не им грози пресъхване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আগেভাগে জল দেন: গাছের শুকিয়ে যাওয়ার ভয় নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Regues amb marge: les teves plantes no corren perill d’assecar-se."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaléváte s rezervou: vaše rostliny nevyschnou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vander i god tid: dine planter risikerer ikke at tørre ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gießt vorsorglich: Austrocknen droht deinen Pflanzen nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποτίζετε με περιθώριο: τα φυτά σας δεν κινδυνεύουν να ξεραθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You water ahead of time: your plants are in no danger of drying out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riegas con margen: tus plantas no corren peligro de secarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastelet varman päälle: kasvisi eivät ole vaarassa kuivua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous arrosez en avance : vos plantes ne risquent pas de se dessécher."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે વહેલું પાણી આપો છો: છોડ સુકાવાનો ડર નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשקיה מגיעה מראש: הצמחים לא בסכנת יובש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से पानी देते हैं: पौधों के सूखने का डर नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijevate s rezervom: vašim biljkama ne prijeti isušivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előre öntözöl: a növényeidet nem fenyegeti a kiszáradás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyiram lebih awal: tanaman Anda tak akan kekeringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffi in anticipo: le tue piante non rischiano di seccarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早めの水やり派。植物が乾ききる心配はありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдын ала суарасыз: өсімдіктеріңізге кеуіп қалу қаупі жоқ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಮೊದಲೇ ನೀರು ಹಾಕುತ್ತೀರಿ: ಗಿಡಗಳು ಒಣಗುವ ಭಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 있게 물을 줘요. 식물이 마를 걱정은 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laistote su atsarga: jūsų augalai tikrai neišdžius."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നേരത്തേ നനയ്ക്കുന്നു: ചെടികൾ ഉണങ്ങുമെന്ന പേടി വേണ്ട."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही आधीच पाणी घालता: रोपे सुकण्याची भीती नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyiram lebih awal: tumbuhan anda tidak akan kering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vanner med god margin: plantene dine står ikke i fare for å tørke ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geeft water met marge: uitdrogen zit er voor je planten niet in."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଆଗରୁ ପାଣି ଦିଅନ୍ତି: ଗଛ ଶୁଖିବାର ଭୟ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਪਹਿਲਾਂ ਹੀ ਪਾਣੀ ਦਿੰਦੇ ਹੋ: ਪੌਦਿਆਂ ਦੇ ਸੁੱਕਣ ਦਾ ਡਰ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewasz z zapasem: twoim roślinom nie grozi przesuszenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você rega com folga: suas plantas não correm risco de secar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega com margem: as suas plantas não correm o risco de secar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi cu rezervă: plantele tale nu riscă să se usuce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polievate s rezervou: vaše rastliny nevyschnú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalivate z rezervo: vaše rastline se ne bodo izsušile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vattnar med marginal: dina växter löper ingen risk att torka ut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் முன்பே நீர் ஊற்றுகிறீர்கள்: செடிகள் காய்ந்துவிடும் பயமில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ముందే నీళ్లు పోస్తారు: మొక్కలు ఎండిపోయే భయం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรดน้ำเผื่อไว้ ต้นไม้ของคุณไม่มีทางแห้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenden suluyorsunuz: bitkilerinizin kuruma riski yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливаєте із запасом: пересохнути вашим рослинам не загрожує."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ پہلے سے پانی دیتے ہیں: پودوں کے سوکھنے کا ڈر نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tưới dư dả: cây của bạn không lo bị khô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你总是提前浇水：植物们绝不会干透。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你總是提早澆水：植物們絕不會乾透。"
          }
        }
      }
    },
    "Поливать хоть одно растение семь дней подряд.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسقِ نبتة واحدة على الأقل سبعة أيام متتالية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливайте поне едно растение седем дни поред."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টানা সাত দিন অন্তত একটি গাছে জল দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega almenys una planta set dies seguits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalévejte aspoň jednu rostlinu sedm dní v řadě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vand mindst én plante syv dage i træk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieße sieben Tage in Folge mindestens eine Pflanze."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποτίζετε τουλάχιστον ένα φυτό επτά μέρες στη σειρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water at least one plant seven days in a row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega al menos una planta siete días seguidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastele ainakin yhtä kasvia seitsemänä päivänä putkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
