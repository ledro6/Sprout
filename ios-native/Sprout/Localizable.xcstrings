        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളുടെ സ്വന്തം കോഡാണ്: നിങ്ങൾ ഇതിനകം പട്ടികയിലുണ്ട്."
