    "Позвать меня в соперники: скопируйте это сообщение целиком и нажмите «Вставить» в Sprout → Профиль → Друзья.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj mig som rival: Kopiér hele denne besked, og tryk på ”Indsæt” i Sprout → Profil → Venner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mich als Rivalen hinzuzufügen: Kopiere diese ganze Nachricht und tippe in Sprout → Profil → Freunde auf „Einsetzen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add me as a rival, copy this whole message and tap “Paste” in Sprout → Profile → Friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadirme como rival, copia todo este mensaje y toca “Pegar” en Sprout → Perfil → Amigos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää minut kilpailijaksi: kopioi koko tämä viesti ja napauta ”Sijoita” kohdassa Sprout → Profiili → Kaverit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour m’ajouter comme rival : copiez tout ce message et touchez « Coller » dans Sprout → Profil → Amis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungermi come rivale, copia tutto questo messaggio e tocca “Incolla” in Sprout → Profilo → Amici."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg meg til som rival: Kopier hele denne meldingen, og trykk på «Lim inn» i Sprout → Profil → Venner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg me toe als rivaal: kopieer dit hele bericht en tik op ‘Plak’ in Sprout → Profiel → Vrienden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para me adicionar como rival, copie esta mensagem inteira e toque em “Colar” em Sprout → Perfil → Amigos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till mig som rival: kopiera hela meddelandet och tryck på ”Klistra in” i Sprout → Profil → Vänner."
          }
        }
      }
    },
