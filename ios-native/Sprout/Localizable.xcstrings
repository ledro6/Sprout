    "Откройте Sprout — и сад появится здесь.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Sprout وستظهر حديقتك هنا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Sprout — и градината ще се появи тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout খুলুন, আপনার বাগান এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Sprout i el teu jardí apareixerà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Sprout a zahrada se objeví tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Sprout, så vises din have her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Sprout, dann erscheint dein Garten hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Sprout και ο κήπος σας θα εμφανιστεί εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sprout and your garden will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Sprout y tu jardín aparecerá aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Sprout, niin puutarhasi näkyy tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Sprout et votre jardin apparaîtra ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ખોલો અને તમારો બગીચો અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Sprout והגינה תופיע כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout खोलें और आपका बगीचा यहाँ दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Sprout i vaš će se vrt pojaviti ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Sproutot, és itt megjelenik a kerted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Sprout, dan kebunmu akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Sprout e il tuo giardino apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sproutを開くと、ここに庭が表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout-ты ашыңыз — бақ осында пайда болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ತೆರೆಯಿರಿ, ನಿಮ್ಮ ತೋಟ ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout을 열면 여기에 정원이 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite Sprout ir sodas atsiras čia."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout തുറക്കുക, നിങ്ങളുടെ തോട്ടം ഇവിടെ കാണും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout उघडा आणि तुमची बाग इथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Sprout dan taman anda akan muncul di sini."
