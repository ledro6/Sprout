            "state": "translated",
            "value": "照片模糊——請拍得更清晰些。"
          }
        }
      }
    },
    "Снимок пересвечен — снимите без прямого солнца.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة شديدة الإضاءة — التقطها بعيدًا عن الشمس المباشرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е преекспонирана – снимайте без пряко слънце."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিতে আলো বেশি — সরাসরি রোদ এড়িয়ে তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto està sobreexposada: fes-la sense sol directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je přepálená – vyfoťte ji mimo přímé slunce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er overeksponeret – tag det uden direkte sol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist überbelichtet – mach eins ohne direkte Sonne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι υπερφωτισμένη — τραβήξτε τη χωρίς άμεσο ήλιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is overexposed — take one out of direct sun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está sobreexpuesta: tómala sin sol directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on ylivalottunut – ota se ilman suoraa aurinkoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est surexposée — prenez-la hors du soleil direct."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટોમાં વધુ પડતો પ્રકાશ છે — સીધા તડકા વગર લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה חשופה מדי — צלמו בלי שמש ישירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो में ज़्यादा रोशनी है — सीधी धूप से हटकर लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je presvijetla – snimite je bez izravnog sunca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó túlexponált – készítsd közvetlen nap nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya terlalu terang — ambil tanpa sinar matahari langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è sovraesposta: scattala senza sole diretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が白飛びしています — 直射日光を避けて撮ってください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет тым ашық — тікелей күнсіз түсіріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋದಲ್ಲಿ ಬೆಳಕು ಹೆಚ್ಚು — ನೇರ ಬಿಸಿಲು ಇಲ್ಲದೆ ತೆಗೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 너무 밝아요 — 직사광선을 피해서 찍어 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka pereksponuota – fotografuokite be tiesioginės saulės."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോയിൽ വെളിച്ചം കൂടുതലാണ് — നേരിട്ടുള്ള വെയിലില്ലാതെ എടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटोत जास्त प्रकाश आहे — थेट उन्हाशिवाय घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto terlalu terang — ambil tanpa cahaya matahari terus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er overeksponert – ta det uten direkte sol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is overbelicht – maak er een zonder direct zonlicht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋରେ ଅଧିକ ଆଲୋକ — ସିଧା ଖରା ବିନା ଉଠାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਵਿੱਚ ਵੱਧ ਰੋਸ਼ਨੀ ਹੈ — ਸਿੱਧੀ ਧੁੱਪ ਤੋਂ ਹਟ ਕੇ ਲਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest prześwietlone – zrób je bez ostrego słońca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto está estourada: tire longe do sol direto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia está sobre-exposta: tire-a sem sol direto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia e supraexpusă – fă-o fără soare direct."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je preexponovaná – odfoťte ju mimo priameho slnka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je preosvetljena – posnemite jo brez neposrednega sonca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot är överexponerat – ta det utan direkt sol."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்தில் அதிக வெளிச்சம் — நேரடி வெயில் இல்லாமல் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలో వెలుతురు ఎక్కువ — నేరుగా ఎండ లేకుండా తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปสว่างเกินไป — ถ่ายโดยไม่ให้โดนแดดตรง"
