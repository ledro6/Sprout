    "Растения в неё можно будет посадить или перевезти.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Pflanzen hineinsetzen oder dorthin umziehen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be able to plant in it or move plants there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás plantar en ella o traer plantas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit istuttaa siihen tai siirtää sinne kasveja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez y planter ou y déplacer des plantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai piantarci o spostarci piante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plante i det eller flytte planter dit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt er planten in zetten of naartoe verhuizen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você poderá plantar nele ou mudar plantas para lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poderá plantar nela ou mudar plantas para lá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan plantera i det eller flytta växter dit."
          }
        }
      }
    },
    "Растения дождутся меня сами — поливать никого не нужно. Спасибо!": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planterne klarer sig uden mig – ingen skal vandes. Tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen kommen ohne mich aus — gießen ist nicht nötig. Danke!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plants will be fine without me — no watering needed. Thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas aguantarán sin mí: no hace falta regar. ¡Gracias!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvit pärjäävät ilman minua – kastelua ei tarvita. Kiitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes tiendront sans moi — pas besoin d’arroser. Merci !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante resisteranno senza di me: non serve annaffiare. Grazie!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantene klarer seg uten meg – ingen trenger vann. Takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planten redden zich zonder mij — water geven is niet nodig. Bedankt!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas vão aguentar sem mim — não precisa regar. Obrigado!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas aguentam sem mim — não é preciso regar. Obrigado!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växterna klarar sig utan mig – ingen behöver vattnas. Tack!"
          }
        }
      }
    },
    "Растения на снимке не видно — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen plante på fotoet – jeg bruger artens færdige model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Foto ist keine Pflanze zu sehen — ich nehme das fertige Modell der Art."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plant visible in the photo — I’ll use the species’ ready-made model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ve ninguna planta en la foto: usaré el modelo listo de la especie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvassa ei näy kasvia – käytän lajin valmista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune plante visible sur la photo — je prendrai le modèle prêt de l’espèce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella foto non si vede nessuna pianta: userò il modello pronto della specie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plante synes på bildet – jeg bruker artens ferdige modell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen plant op de foto te zien — ik neem het kant-en-klare model van de soort."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma planta aparece na foto — vou usar o modelo pronto da espécie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se vê nenhuma planta na fotografia — vou usar o modelo pronto da espécie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen växt syns på fotot – jag tar artens färdiga modell."
          }
        }
      }
    },
    "Растения на снимке телефон не узнал — впишите вид сами.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen genkendte ingen plante på fotoet – skriv selv arten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon hat auf dem Foto keine Pflanze erkannt — gib die Art selbst ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone didn’t recognize a plant in the photo — enter the species yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono no reconoció ninguna planta en la foto: escribe la especie tú mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelin ei tunnistanut kuvasta kasvia – kirjoita laji itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone n’a pas reconnu de plante sur la photo — saisissez l’espèce vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono non ha riconosciuto piante nella foto: inserisci tu la specie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kjente ikke igjen noen plante på bildet – skriv inn arten selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De telefoon herkende geen plant op de foto — vul de soort zelf in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular não reconheceu nenhuma planta na foto — digite a espécie você mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel não reconheceu nenhuma planta na fotografia — escreva a espécie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kände inte igen någon växt på fotot – skriv in arten själv."
          }
        }
      }
    },
