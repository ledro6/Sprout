        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಷ್ಟು ಗಿಡಗಳಿಗೆ ನೀರು ಬೇಕು ಮತ್ತು ಮೊದಲು ಯಾರು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물이 필요한 식물 수와 가장 먼저 줄 식물."
