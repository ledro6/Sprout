    "Назовитесь — имя встретит вас при запуске": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرّف بنفسك — سيرحّب بك اسمك عند التشغيل"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Представете се — името ще ви посреща при стартиране"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয় দিন — অ্যাপ খুললে নাম দিয়ে আপনাকে স্বাগত জানানো হবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenta’t: el teu nom et saludarà en obrir l’app"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představte se — jméno vás přivítá při spuštění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præsentér dig – dit navn byder dig velkommen ved start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich vor — dein Name begrüßt dich beim Start"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συστηθείτε — το όνομά σας θα σας καλωσορίζει στην εκκίνηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce yourself — your name will greet you at launch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preséntate: tu nombre te saludará al abrir la app"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittäydy – nimesi tervehtii sinua käynnistyksessä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présentez-vous — votre nom vous accueillera au lancement"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિચય આપો — ઍપ ખૂલતાં તમારું નામ તમારું સ્વાગત કરશે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציגו את עצמכם — השם יקבל את פניכם בפתיחה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना परिचय दें — ऐप खुलने पर आपका नाम आपका स्वागत करेगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavite se — ime će vas pozdraviti pri pokretanju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatkozz be — a neved köszönt majd induláskor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalkan dirimu — namamu akan menyambutmu saat aplikasi dibuka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentati: il tuo nome ti accoglierà all’avvio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己紹介しましょう — 起動時に名前でお迎えします"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Танысайық — атыңыз іске қосқанда сізді қарсы алады"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಚಯಿಸಿಕೊಳ್ಳಿ — ಪ್ರಾರಂಭದಲ್ಲಿ ನಿಮ್ಮ ಹೆಸರು ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기소개를 해 주세요 — 실행할 때 이름으로 맞이할게요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisistatykite – vardas pasitiks jus paleidus programą"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയം പരിചയപ്പെടുത്തുക — തുറക്കുമ്പോൾ നിങ്ങളുടെ പേര് നിങ്ങളെ സ്വാഗതം ചെയ്യും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळख करून द्या — अ‍ॅप उघडताना तुमचे नाव तुमचे स्वागत करेल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalkan diri — nama anda akan menyambut anda semasa dibuka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenter deg – navnet ditt ønsker deg velkommen ved oppstart"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor — je naam begroet je bij het openen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରିଚୟ ଦିଅନ୍ତୁ — ଆପ୍ ଖୋଲିଲେ ଆପଣଙ୍କ ନାମ ଆପଣଙ୍କୁ ସ୍ୱାଗତ କରିବ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਣ-ਪਛਾਣ ਕਰਾਓ — ਐਪ ਖੁੱਲ੍ਹਣ 'ਤੇ ਤੁਹਾਡਾ ਨਾਮ ਤੁਹਾਡਾ ਸਵਾਗਤ ਕਰੇਗਾ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedstaw się — imię przywita cię przy starcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresente-se — seu nome vai recebê-lo ao abrir o app"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresente-se — o seu nome vai recebê-lo ao abrir a app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezintă-te — numele te va întâmpina la pornire"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavte sa — meno vás privíta pri spustení"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavite se — ime vas bo pozdravilo ob zagonu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentera dig – ditt namn hälsar dig vid start"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களை அறிமுகப்படுத்துங்கள் — தொடங்கும்போது உங்கள் பெயர் உங்களை வரவேற்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిమ్మల్ని పరిచయం చేసుకోండి — ప్రారంభంలో మీ పేరు మిమ్మల్ని స్వాగతిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำตัวหน่อย — ชื่อของคุณจะต้อนรับคุณเมื่อเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinizi tanıtın — adınız açılışta sizi karşılasın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвіться — ім’я зустріне вас під час запуску"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا تعارف کرائیں — ایپ کھلنے پر آپ کا نام آپ کا استقبال کرے گا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới thiệu bản thân — tên bạn sẽ chào bạn khi mở ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "介绍一下自己吧——启动时会用名字欢迎你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介紹一下自己吧——啟動時會用名字歡迎你"
          }
        }
      }
    },
    "Назовитесь — приложение будет здороваться по имени. Нажмите на кружок, чтобы поставить фото.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرنا باسمك — وسيحيّيك التطبيق به. اضغط الدائرة لوضع صورة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Представете се – приложението ще ви поздравява по име. Докоснете кръгчето, за да сложите снимка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নাম বলুন — অ্যাপ আপনাকে নাম ধরে সম্ভাষণ করবে। ছবি বসাতে বৃত্তে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Digues el teu nom: l’app et saludarà amb ell. Toca el cercle per posar-hi una foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představte se – aplikace vás bude zdravit jménem. Klepnutím na kroužek nastavíte fotku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig dit navn – appen hilser på dig med det. Tryk på cirklen for at sætte et foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag deinen Namen – die App begrüßt dich dann damit. Tippe auf den Kreis, um ein Foto zu setzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πείτε μας το όνομά σας — η εφαρμογή θα σας χαιρετά με αυτό. Αγγίξτε τον κύκλο για να βάλετε φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us your name — the app will greet you by it. Tap the circle to add a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinos tu nombre: la app te saludará con él. Toca el círculo para poner una foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro nimesi – sovellus tervehtii sinua sillä. Napauta ympyrää lisätäksesi kuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présentez-vous — l’app vous saluera par votre nom. Touchez le cercle pour mettre une photo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું નામ કહો — ઍપ તમને નામથી આવકારશે. ફોટો મૂકવા વર્તુળ પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרו לנו איך קוראים לכם – האפליקציה תברך אתכם בשם. הקישו על העיגול כדי להוסיף תמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना नाम बताएँ — ऐप आपको नाम से नमस्ते करेगा। फ़ोटो लगाने के लिए गोले पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavite se – aplikacija će vas pozdravljati imenom. Dodirnite krug da postavite fotografiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatkozz be – az app a neveden fog köszönteni. Koppints a körre, hogy fotót állíts be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan nama Anda — aplikasi akan menyapa Anda dengannya. Ketuk lingkaran untuk memasang foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentati: l’app ti saluterà per nome. Tocca il cerchio per mettere una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を教えてください — アプリが名前であいさつします。丸をタップすると写真を設定できます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атыңызды айтыңыз — қолданба сізбен атыңызбен амандасады. Сурет қою үшін шеңберді түртіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೆಸರು ಹೇಳಿ — ಆ್ಯಪ್ ನಿಮ್ಮನ್ನು ಹೆಸರಿನಿಂದ ಸ್ವಾಗತಿಸುತ್ತದೆ. ಫೋಟೋ ಹಾಕಲು ವೃತ್ತವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 알려 주세요 — 앱이 이름으로 인사할게요. 동그라미를 탭하면 사진을 넣을 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisistatykite – programa sveikins jus vardu. Bakstelėkite apskritimą, kad įdėtumėte nuotrauką."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പേര് പറയൂ — ആപ്പ് നിങ്ങളെ പേര് ചൊല്ലി സ്വാഗതം ചെയ്യും. ഫോട്ടോ ഇടാൻ വൃത്തത്തിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे नाव सांगा — अ‍ॅप तुम्हाला नावाने नमस्कार करेल. फोटो लावण्यासाठी वर्तुळावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beritahu nama anda — aplikasi akan menyapa anda dengannya. Ketik bulatan untuk meletakkan foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hva du heter – appen hilser på deg med navn. Trykk på sirkelen for å sette et bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel je naam – de app begroet je er dan mee. Tik op de cirkel om een foto te zetten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନାମ କୁହନ୍ତୁ — ଆପ୍ ଆପଣଙ୍କୁ ନାମ ଧରି ନମସ୍କାର କରିବ। ଫଟୋ ରଖିବାକୁ ବୃତ୍ତରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਨਾਂ ਦੱਸੋ — ਐਪ ਤੁਹਾਨੂੰ ਨਾਂ ਨਾਲ ਸਤਿ ਸ੍ਰੀ ਅਕਾਲ ਕਹੇਗੀ। ਫ਼ੋਟੋ ਲਾਉਣ ਲਈ ਗੋਲੇ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedstaw się – aplikacja będzie witać cię po imieniu. Stuknij kółko, by dodać zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga seu nome — o app vai cumprimentar você por ele. Toque no círculo para colocar uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o seu nome — a app vai cumprimentá-lo por ele. Toque no círculo para pôr uma fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-ți numele – aplicația te va saluta cu el. Atinge cercul ca să pui o fotografie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavte sa – aplikácia vás bude zdraviť menom. Klepnutím na krúžok nastavíte fotku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavite se – aplikacija vas bo pozdravljala z imenom. Tapnite krog, da nastavite fotografijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta vad du heter – appen hälsar på dig med namn. Tryck på cirkeln för att sätta ett foto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயரைச் சொல்லுங்கள் — ஆப் உங்களைப் பெயரால் வரவேற்கும். புகைப்படம் வைக்க வட்டத்தைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పేరు చెప్పండి — యాప్ మిమ్మల్ని పేరుతో పలకరిస్తుంది. ఫోటో పెట్టడానికి వృత్తంపై నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกชื่อของคุณ — แอปจะทักทายคุณด้วยชื่อนั้น แตะวงกลมเพื่อใส่รูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınızı söyleyin — uygulama sizi adınızla selamlasın. Fotoğraf koymak için daireye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвіться — застосунок вітатиметься на ім’я. Натисніть на кружечок, щоб поставити фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا نام بتائیں — ایپ آپ کو نام سے سلام کرے گی۔ تصویر لگانے کے لیے دائرے پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết tên bạn — ứng dụng sẽ chào bạn bằng tên đó. Chạm vào vòng tròn để đặt ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们你的名字——应用会用它跟你打招呼。轻点圆圈即可设置照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們你的名字——App 會用它跟你打招呼。點一下圓圈即可設定照片。"
          }
        }
      }
    },
    "Называет растения, у которых срок полива — сегодня, от самого сухого.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكر النباتات التي يحين سقيها اليوم، بدءًا بالأكثر جفافًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изброява растенията със срок за поливане днес, от най-сухото."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ যেসব গাছে জল দিতে হবে তাদের নাম বলে, সবচেয়ে শুকনোটি থেকে শুরু করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diu quines plantes toca regar avui, de la més seca a la menys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyjmenuje rostliny, které je dnes potřeba zalít, od nejsušší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nævner de planter, der skal vandes i dag, den tørreste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die Pflanzen, die heute gegossen werden müssen, die trockenste zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λέει ποια φυτά θέλουν πότισμα σήμερα, ξεκινώντας από το πιο ξερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names the plants due for watering today, driest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice qué plantas toca regar hoy, de la más seca a la menos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelee tänään kasteltavat kasvit kuivimmasta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme les plantes à arroser aujourd’hui, de la plus sèche à la moins sèche."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજે જેમને પાણી આપવાનું છે તે છોડનાં નામ, સૌથી સૂકાથી શરૂ કરીને, જણાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונה את הצמחים שצריך להשקות היום, מהיבש ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज जिन पौधों को पानी देना है, उनके नाम बताता है, सबसे सूखे से शुरू करके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabraja biljke koje danas treba zaliti, od najsuše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felsorolja a ma öntözendő növényeket, a legszárazabbal kezdve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebutkan tanaman yang jadwal siramnya hari ini, dari yang paling kering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le piante da annaffiare oggi, dalla più secca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が水やり日の植物を、乾いている順に読み上げます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін суару мерзімі келген өсімдіктерді ең құрғағынан бастап атайды."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದು ನೀರು ಹಾಕಬೇಕಾದ ಗಿಡಗಳ ಹೆಸರು ಹೇಳುತ್ತದೆ, ಹೆಚ್ಚು ಒಣಗಿದ್ದರಿಂದ ಆರಂಭಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 물을 줘야 하는 식물을 가장 마른 것부터 알려 줘요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išvardija augalus, kuriuos reikia palaistyti šiandien, nuo sausiausio."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് നനയ്ക്കേണ്ട ചെടികളുടെ പേരുകൾ പറയുന്നു, ഏറ്റവും ഉണങ്ങിയതിൽ നിന്ന് തുടങ്ങി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज पाणी घालायच्या रोपांची नावे सांगते, सर्वात कोरड्यापासून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebut tumbuhan yang perlu disiram hari ini, bermula dengan yang paling kering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevner plantene som skal vannes i dag, den tørreste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noemt de planten die vandaag water nodig hebben, de droogste eerst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଯେଉଁ ଗଛକୁ ପାଣି ଦେବାକୁ ହେବ ସେମାନଙ୍କ ନାମ କହେ, ସବୁଠାରୁ ଶୁଖିଲାଠାରୁ ଆରମ୍ଭ କରି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਜਿਨ੍ਹਾਂ ਪੌਦਿਆਂ ਨੂੰ ਪਾਣੀ ਦੇਣਾ ਹੈ ਉਨ੍ਹਾਂ ਦੇ ਨਾਮ ਦੱਸਦਾ ਹੈ, ਸਭ ਤੋਂ ਸੁੱਕੇ ਤੋਂ ਸ਼ੁਰੂ ਕਰਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymienia rośliny, które dziś trzeba podlać, od najbardziej suchej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz quais plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz que plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune ce plante trebuie udate azi, de la cea mai uscată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymenuje rastliny, ktoré treba dnes poliať, od najsuchšej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Našteje rastline, ki jih je treba danes zaliti, od najbolj suhe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämner växterna som ska vattnas i dag, den torraste först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று தண்ணீர் ஊற்ற வேண்டிய செடிகளை, மிக உலர்ந்ததிலிருந்து தொடங்கிச் சொல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు నీళ్లు పోయాల్సిన మొక్కల పేర్లు చెబుతుంది, బాగా ఎండిన దానితో మొదలుపెట్టి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกต้นไม้ที่ถึงกำหนดรดน้ำวันนี้ เริ่มจากต้นที่แห้งที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sulanması gereken bitkileri en kurudan başlayarak söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Називає рослини, у яких строк поливу — сьогодні, від найсухішої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج جن پودوں کو پانی دینا ہے ان کے نام بتاتا ہے، سب سے خشک سے شروع کر کے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nêu các cây đến hạn tưới hôm nay, bắt đầu từ cây khô nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按从最干开始的顺序，说出今天该浇水的植物。"
          }
