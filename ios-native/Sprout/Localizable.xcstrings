    "При наклоне каждая фигурка узора движется со своей скоростью, будто плывёт в воде.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإمالة يتحرك كل شكل في النقش بسرعته الخاصة، كأنه يطفو في الماء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При накланяне всяка фигурка от шарката се движи със своя скорост, сякаш плува във вода."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেলালে নকশার প্রতিটি আকৃতি নিজের গতিতে চলে, যেন জলে ভাসছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan inclines el telèfon, cada figura del motiu es mou a la seva velocitat, com si surés a l’aigua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při naklonění se každý tvar vzoru pohybuje svou rychlostí, jako by plul ve vodě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, bevæger hver figur i mønsteret sig i sit eget tempo, som om den svæver i vand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Neigen bewegt sich jede Figur des Musters in ihrem eigenen Tempo, als schwebte sie im Wasser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν γέρνετε το τηλέφωνο, κάθε σχήμα του μοτίβου κινείται με τη δική του ταχύτητα, σαν να επιπλέει στο νερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you tilt the phone, each shape in the pattern moves at its own speed, as if floating in water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al inclinar el teléfono, cada figura del patrón se mueve a su propio ritmo, como si flotara en el agua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallistaessa jokainen kuvion hahmo liikkuu omaa vauhtiaan, kuin kelluisi vedessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous inclinez le téléphone, chaque figure du motif bouge à sa propre vitesse, comme si elle flottait dans l’eau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નમાવતાં ભાતની દરેક આકૃતિ પોતાની ઝડપે ચાલે છે, જાણે પાણીમાં તરતી હોય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהטיה כל צורה בדוגמה זזה במהירות משלה, כאילו היא צפה במים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झुकाने पर पैटर्न की हर आकृति अपनी रफ़्तार से चलती है, मानो पानी में तैर रही हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad nagnete telefon, svaki oblik uzorka kreće se svojom brzinom, kao da pluta u vodi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Döntéskor a minta minden formája a saját tempójában mozog, mintha vízben lebegne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dimiringkan, tiap bentuk pada pola bergerak dengan kecepatannya sendiri, seperti mengapung di air."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando inclini il telefono, ogni figura del motivo si muove alla sua velocità, come se galleggiasse nell’acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾けると、模様の図形がそれぞれ違う速さで動きます。水に浮かんでいるようです。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еңкейткенде өрнектің әр фигурасы өз жылдамдығымен қозғалады, суда жүзіп жүргендей."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಓರೆ ಮಾಡಿದಾಗ ವಿನ್ಯಾಸದ ಪ್ರತಿಯೊಂದು ಆಕೃತಿ ತನ್ನದೇ ವೇಗದಲ್ಲಿ ಚಲಿಸುತ್ತದೆ, ನೀರಿನಲ್ಲಿ ತೇಲುವಂತೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울이면 무늬의 도형마다 제각각의 속도로 움직여요. 물에 떠 있는 것처럼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakreipus telefoną, kiekviena rašto figūra juda savo greičiu, tarsi plauktų vandenyje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചരിക്കുമ്പോൾ ചിത്രപ്പണിയിലെ ഓരോ രൂപവും സ്വന്തം വേഗത്തിൽ നീങ്ങും, വെള്ളത്തിൽ ഒഴുകുന്ന പോലെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तिरका केल्यावर नक्षीतील प्रत्येक आकृती आपल्या वेगाने हलते, जणू पाण्यात तरंगते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila dicondongkan, setiap bentuk dalam corak bergerak pada kelajuannya sendiri, seperti terapung dalam air."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, beveger hver figur i mønsteret seg i sitt eget tempo, som om den flyter i vann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de telefoon kantelt, beweegt elk figuurtje van het patroon in zijn eigen tempo, alsof het in water zweeft."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଢଳାଇଲେ ନକ୍ସାର ପ୍ରତ୍ୟେକ ଆକୃତି ନିଜ ଗତିରେ ଚାଲେ, ଯେପରି ପାଣିରେ ଭାସୁଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਝੁਕਾਉਣ ’ਤੇ ਨਮੂਨੇ ਦੀ ਹਰ ਆਕ੍ਰਿਤੀ ਆਪਣੀ ਰਫ਼ਤਾਰ ਨਾਲ ਚੱਲਦੀ ਹੈ, ਜਿਵੇਂ ਪਾਣੀ ਵਿੱਚ ਤੈਰ ਰਹੀ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy przechyleniu każda figurka wzoru porusza się we własnym tempie, jakby płynęła w wodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao inclinar o celular, cada figura do padrão se move no próprio ritmo, como se boiasse na água."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao inclinar o telemóvel, cada figura do padrão move-se ao seu ritmo, como se flutuasse na água."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când înclini telefonul, fiecare figură a modelului se mișcă în ritmul ei, de parcă ar pluti în apă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri naklonení sa každý tvar vzoru pohybuje vlastnou rýchlosťou, akoby plával vo vode."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko nagnete telefon, se vsaka oblika vzorca premika s svojo hitrostjo, kot bi plavala v vodi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lutar telefonen rör sig varje figur i mönstret i sin egen takt, som om den flöt i vatten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாய்க்கும்போது வடிவத்தின் ஒவ்வொரு உருவமும் தன் வேகத்தில் நகரும், நீரில் மிதப்பது போல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వంచినప్పుడు నమూనాలోని ప్రతి ఆకారం తన సొంత వేగంతో కదులుతుంది, నీటిలో తేలుతున్నట్టు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเอียง รูปทรงแต่ละชิ้นในลวดลายจะขยับด้วยความเร็วของตัวเอง เหมือนลอยอยู่ในน้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu eğince desendeki her şekil kendi hızında hareket eder, suda süzülüyormuş gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час нахилу кожна фігурка візерунка рухається зі своєю швидкістю, ніби пливе у воді."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جھکانے پر نقش کی ہر شکل اپنی رفتار سے چلتی ہے، جیسے پانی میں تیر رہی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nghiêng, mỗi hình trong hoa văn di chuyển với tốc độ riêng, như đang trôi trong nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倾斜时，图案里的每个图形以各自的速度移动，像漂在水里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傾斜時，圖案裡的每個圖形以各自的速度移動，像漂在水裡。"
          }
        }
      }
    },
    "При скольких процентах воды в земле вы обычно берётесь за лейку.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند أي نسبة من الماء في التربة تمسك عادة بإبريق السقي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При колко процента вода в почвата обикновено посягате към лейката."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাটিতে কত শতাংশ জল থাকলে আপনি সাধারণত ঝাঁঝরি তোলেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb quanta aigua a la terra sols agafar la regadora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při kolika procentech vody v hlíně obvykle berete konev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved hvor mange procent vand i jorden du plejer at tage vandkanden frem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei wie viel Prozent Wasser in der Erde du meist zur Gießkanne greifst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με πόσο νερό στο χώμα πιάνετε συνήθως το ποτιστήρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much water is usually left in the soil when you reach for the watering can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué porcentaje de agua en la tierra sueles coger la regadera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monenko prosentin vesimäärässä tartut yleensä kastelukannuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel pourcentage d’eau dans la terre vous prenez d’habitude l’arrosoir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માટીમાં કેટલા ટકા પાણી હોય ત્યારે તમે સામાન્ય રીતે ઝારી ઉપાડો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכמה אחוזי מים באדמה אתם בדרך כלל לוקחים את המזלף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिट्टी में कितने प्रतिशत पानी बचा हो तो आप आमतौर पर झारी उठाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri koliko posto vode u zemlji obično posežete za kantom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány százalék víznél nyúlsz általában a locsolókannáért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada berapa persen air di tanah Anda biasanya mengambil gembor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con quanta acqua nella terra di solito prendi l’annaffiatoio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "土の水分が何パーセントのときに、ふだんジョウロを手に取るか。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топырақта қанша пайыз су қалғанда әдетте суғышты қолға аласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣ್ಣಿನಲ್ಲಿ ಎಷ್ಟು ಶೇಕಡಾ ನೀರು ಇದ್ದಾಗ ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ನೀರಿನ ಕ್ಯಾನ್ ಎತ್ತುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙의 수분이 몇 퍼센트일 때 보통 물뿌리개를 드는지."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esant kiek procentų vandens žemėje, paprastai imate laistytuvą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മണ്ണിൽ എത്ര ശതമാനം വെള്ളമുള്ളപ്പോഴാണ് നിങ്ങൾ സാധാരണ നനയ്ക്കൽ പാത്രം എടുക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मातीत किती टक्के पाणी असताना तुम्ही सहसा झारी उचलता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada berapa peratus air dalam tanah anda biasanya mencapai penyiram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved hvor mange prosent vann i jorden du pleier å ta fram vannkanna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij hoeveel procent water in de aarde je meestal naar de gieter grijpt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାଟିରେ କେତେ ପ୍ରତିଶତ ପାଣି ଥିଲେ ଆପଣ ସାଧାରଣତଃ ଝାରି ଉଠାନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿੱਟੀ ਵਿੱਚ ਕਿੰਨੇ ਪ੍ਰਤੀਸ਼ਤ ਪਾਣੀ ਹੋਵੇ ਤਾਂ ਤੁਸੀਂ ਆਮ ਤੌਰ 'ਤੇ ਫੁਹਾਰਾ ਚੁੱਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy ilu procentach wody w ziemi zwykle sięgasz po konewkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com quanto de água na terra você costuma pegar o regador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com quanta água na terra costuma pegar no regador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La ce procent de apă din pământ iei de obicei stropitoarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri koľkých percentách vody v zemi zvyčajne siahnete po krhle."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri koliko odstotkih vode v zemlji običajno sežete po zalivalki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid hur många procent vatten i jorden du brukar ta fram vattenkannan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மண்ணில் எத்தனை சதவீதம் நீர் இருக்கும்போது நீங்கள் வழக்கமாகப் பூவாளியை எடுக்கிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మట్టిలో ఎంత శాతం నీరు ఉన్నప్పుడు మీరు సాధారణంగా జారీ తీసుకుంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกติคุณหยิบบัวรดน้ำเมื่อดินเหลือน้ำกี่เปอร์เซ็นต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toprakta yüzde kaç su kaldığında genellikle sulama kabına uzanıyorsunuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За скількох відсотків води в землі ви зазвичай берете лійку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مٹی میں کتنے فیصد پانی ہو تو آپ عموماً فوارہ اٹھاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thường cầm bình tưới khi đất còn bao nhiêu phần trăm nước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "土里还剩百分之多少的水时，你通常会拿起水壶。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "土裡還剩百分之多少的水時，你通常會拿起澆水壺。"
          }
        }
      }
    },
