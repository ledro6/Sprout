    "Нажмите — и сад встанет вокруг прицела": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط وستظهر الحديقة حول المؤشر"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете и градината ще застане около мерника"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca i el jardí apareixerà al voltant del punt de mira"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte a zahrada se objeví kolem zaměřovače"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk, så dukker haven op omkring sigtet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, und der Garten erscheint um das Fadenkreuz"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε και ο κήπος θα εμφανιστεί γύρω από το σκόπευτρο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and the garden will appear around the reticle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y el jardín aparecerá alrededor de la mira"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta, niin puutarha ilmestyy tähtäimen ympärille"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et le jardin apparaîtra autour du viseur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו והגינה תופיע סביב הכוונת"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite i vrt će se pojaviti oko nišana"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints, és a kert megjelenik a célkereszt körül"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e il giardino apparirà attorno al mirino"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түртіңіз — бақ көздегіштің айналасына орнайды"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite ir sodas atsiras aplink taikiklį"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk, så dukker hagen opp rundt siktet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik en de tuin verschijnt rond het vizier"
          }
