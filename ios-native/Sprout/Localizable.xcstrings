    "Снимок мыльный — снимите почётче.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة غير واضحة — التقط صورة أوضح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимката е размазана – снимайте по-ясно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটা ঝাপসা — আরও পরিষ্কার একটা তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto està desenfocada: fes-ne una de més nítida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka je rozmazaná – vyfoťte ostřejší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er sløret – tag et skarpere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist unscharf – mach ein schärferes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία είναι θολή — τραβήξτε μια πιο καθαρή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is blurry — take a sharper one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto está borrosa: toma otra más nítida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on epätarkka – ota tarkempi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo est floue — prenez-en une plus nette."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ઝાંખો છે — વધુ સ્પષ્ટ લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה מטושטשת — צלמו חדה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो धुंधली है — साफ़ फ़ोटो लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je mutna – snimite oštriju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó elmosódott – készíts élesebbet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotonya buram — ambil yang lebih tajam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto è sfocata: scattane una più nitida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がぼやけています — もっとはっきり撮ってください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурет бұлыңғыр — анығырақ түсіріңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಮಸುಕಾಗಿದೆ — ಇನ್ನಷ್ಟು ಸ್ಪಷ್ಟವಾಗಿ ತೆಗೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 흐려요 — 더 선명하게 찍어 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotrauka neryški – nufotografuokite ryškiau."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ മങ്ങിയതാണ് — വ്യക്തമായി എടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो धूसर आहे — अधिक स्पष्ट घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto kabur — ambil yang lebih jelas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er uskarpt – ta et skarpere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is onscherp – maak een scherpere."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଅସ୍ପଷ୍ଟ — ଅଧିକ ସ୍ପଷ୍ଟ ଉଠାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਧੁੰਦਲੀ ਹੈ — ਹੋਰ ਸਾਫ਼ ਲਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie jest nieostre – zrób ostrzejsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto está borrada: tire uma mais nítida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia está desfocada: tire uma mais nítida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia e neclară – fă una mai clară."
          }
        },
        "sk": {
          "stringUnit": {
