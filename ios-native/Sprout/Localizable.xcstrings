        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өз кодыңыз: сіз кестеде бұрыннан барсыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ನಿಮ್ಮದೇ ಕೋಡ್: ನೀವು ಈಗಾಗಲೇ ಕೋಷ್ಟಕದಲ್ಲಿದ್ದೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
