    "Растение «%@» удалено. Его можно вернуть.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت «%@». يمكنك استعادتها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е изтрито. Може да се върне."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» eliminada. La pots recuperar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ smazána. Můžete ji vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” er slettet. Du kan hente den tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ gelöscht. Du kannst sie zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» διαγράφηκε. Μπορείτε να το επαναφέρετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deleted. You can bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminada. Puedes recuperarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” poistettu. Voit palauttaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » supprimée. Vous pouvez la récupérer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” נמחק. אפשר להחזיר אותו."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” izbrisana. Možete je vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” törölve. Visszahozhatod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminata. Puoi recuperarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» жойылды. Оны қайтаруға болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ištrintas. Galite jį grąžinti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er slettet. Du kan hente den tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ verwijderd. Je kunt hem terughalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto „%@”. Można ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” excluída. Você pode recuperá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” apagada. Pode recuperá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” a fost ștearsă. O poți recupera."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ vymazaná. Môžete ju vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« izbrisana. Lahko jo vrnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” raderad. Du kan ta tillbaka den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silindi. Geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослину «%@» видалено. Її можна повернути."
          }
        }
      }
    },
    "Растение переедет туда, и комната появится в списке.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتقل النبتة إلى هناك وستظهر الغرفة في القائمة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растението ще се премести там, а стаята ще се появи в списъка."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta s’hi traslladarà i l’habitació apareixerà a la llista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostlina se tam přestěhuje a místnost se objeví v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten flytter derhen, og rummet vises på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze zieht dorthin um, und der Raum erscheint in der Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φυτό θα μετακομίσει εκεί και το δωμάτιο θα εμφανιστεί στη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant will move there, and the room will appear in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se mudará allí y la habitación aparecerá en la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi muuttaa sinne, ja huone ilmestyy luetteloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante déménagera, et la pièce apparaîtra dans la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמח יעבור לשם והחדר יופיע ברשימה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljka će se preseliti onamo, a soba će se pojaviti na popisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növény átköltözik oda, a szoba pedig megjelenik a listában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta si trasferirà lì e la stanza apparirà nell’elenco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдік сонда көшеді, ал бөлме тізімде пайда болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalas persikels ten, o kambarys atsiras sąraše."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten flytter dit, og rommet vises i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant verhuist daarheen en de kamer verschijnt in de lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roślina się tam przeniesie, a pokój pojawi się na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta vai se mudar para lá, e o cômodo aparecerá na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta muda-se para lá e a divisão aparece na lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planta se va muta acolo, iar camera va apărea în listă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlina sa tam presťahuje a miestnosť sa objaví v zozname."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlina se bo preselila tja, soba pa se bo pojavila na seznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växten flyttar dit och rummet visas i listan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitki oraya taşınacak ve oda listede görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослина переїде туди, і кімната з’явиться в списку."
          }
        }
      }
    },
    "Растение стоит. Его можно полить.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النبتة في مكانها. يمكنك سقيها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Растението е поставено. Може да го полеете."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta és al seu lloc. La pots regar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostlina stojí. Můžete ji zalít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten står på plads. Du kan vande den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze steht. Du kannst sie gießen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φυτό τοποθετήθηκε. Μπορείτε να το ποτίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is in place. You can water it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta está colocada. Puedes regarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvi on paikallaan. Voit kastella sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante est en place. Vous pouvez l’arroser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמח במקום. אפשר להשקות אותו."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biljka stoji. Možete je zaliti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A növény a helyén van. Megöntözheted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta è posizionata. Puoi annaffiarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өсімдік орнады. Оны суаруға болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Augalas pastatytas. Galite jį palaistyti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten står på plass. Du kan vanne den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant staat. Je kunt hem water geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roślina stoi. Możesz ją podlać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está no lugar. Você pode regá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está no lugar. Pode regá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planta e așezată. O poți uda."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlina stojí. Môžete ju poliať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastlina stoji. Lahko jo zalijete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växten står på plats. Du kan vattna den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
