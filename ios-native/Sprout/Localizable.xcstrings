            "value": "צבעים, צפיפות וגובה — מהתמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंग, घनापन और ऊँचाई — फ़ोटो से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boje, gustoća i visina – s fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Színek, sűrűség és magasság – a fotóról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna, kerapatan, dan tinggi — dari foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori, densità e altezza, dalla foto."
          }
        },
        "ja": {
          "stringUnit": {
