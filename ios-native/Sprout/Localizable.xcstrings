        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬಳಿ ಎಷ್ಟು ಗಿಡಗಳು ಮತ್ತು ಕೋಣೆಗಳಿವೆ, ಎಷ್ಟು ದಿನದಿಂದ ತೋಟವನ್ನು ನೋಡಿಕೊಳ್ಳುತ್ತಿದ್ದೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물과 방이 몇 개인지, 정원을 며칠째 돌보고 있는지."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek turite augalų ir kambarių ir kiek dienų prižiūrite sodą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് എത്ര ചെടികളും മുറികളും ഉണ്ട്, എത്ര ദിവസമായി തോട്ടം പരിപാലിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्याकडे किती रोपे आणि खोल्या आहेत, आणि किती दिवस तुम्ही बागेची काळजी घेत आहात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tumbuhan dan bilik yang anda ada, dan sudah berapa hari anda menjaga taman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter og rom du har, og hvor mange dager du har stelt hagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel planten en kamers je hebt en hoeveel dagen je al voor je tuin zorgt."
