    "Пересадка, удобрения, где любит стоять…": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير الأصيص، السماد، أين تحب أن تكون…"
