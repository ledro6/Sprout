    "Если вы поливаете раньше срока, приложение заметит и предложит сделать срок короче.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا سقيت قبل الموعد، يلاحظ التطبيق ذلك ويقترح تقصير المدة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако поливате преди срока, приложението ще забележи и ще предложи по-кратък срок."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়ের আগে জল দিলে অ্যাপ তা লক্ষ করে ব্যবধান কমানোর পরামর্শ দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si reges abans d’hora, l’app ho nota i et proposa escurçar l’interval."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když zaléváte dřív, aplikace si toho všimne a navrhne kratší interval."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vander du før tid, opdager appen det og foreslår et kortere interval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gießt du früher als fällig, merkt die App das und schlägt ein kürzeres Intervall vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ποτίζετε πριν την ώρα, η εφαρμογή το προσέχει και προτείνει μικρότερο διάστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you water before it’s due, the app notices and offers to shorten the interval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si riegas antes de tiempo, la app lo nota y te propone acortar el intervalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos kastelet ennen aikaa, appi huomaa sen ja ehdottaa lyhyempää väliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous arrosez avant l’échéance, l’app le remarque et propose de raccourcir la fréquence."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે સમય પહેલાં પાણી આપો, તો ઍપ નોંધ લઈને ગાળો ટૂંકો કરવાનું સૂચવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם משקים לפני הזמן, האפליקציה שמה לב ומציעה לקצר את התדירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप समय से पहले पानी देते हैं, तो ऐप ध्यान देकर अंतराल छोटा करने का सुझाव देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako zalijevate prije roka, aplikacija će to primijetiti i predložiti kraći razmak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a határidő előtt öntözöl, az alkalmazás észreveszi, és rövidebb gyakoriságot javasol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu menyiram sebelum waktunya, aplikasi menyadarinya dan menyarankan jarak yang lebih pendek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se annaffi prima del tempo, l’app se ne accorge e propone di accorciare l’intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定より早く水をあげていると、アプリが気づいて間隔を短くするよう提案します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімінен бұрын суарсаңыз, қолданба мұны байқап, мерзімді қысқартуды ұсынады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸಮಯಕ್ಕೆ ಮುಂಚೆ ನೀರು ಹಾಕಿದರೆ, ಆ್ಯಪ್ ಗಮನಿಸಿ ಅಂತರವನ್ನು ಕಡಿಮೆ ಮಾಡಲು ಸೂಚಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정보다 일찍 물을 주면 앱이 알아채고 간격을 줄이자고 제안해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei laistote anksčiau laiko, programa tai pastebės ir pasiūlys trumpesnį intervalą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമയത്തിന് മുമ്പ് നനച്ചാൽ, ആപ്പ് അത് ശ്രദ്ധിച്ച് ഇടവേള കുറയ്ക്കാൻ നിർദ്ദേശിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही वेळेआधी पाणी दिल्यास अ‍ॅप ते लक्षात घेऊन अंतर कमी करण्याचे सुचवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menyiram sebelum masanya, apl akan perasan dan mencadangkan selang yang lebih pendek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanner du før tiden, merker appen det og foreslår et kortere intervall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je eerder water dan nodig, dan merkt de app dat en stelt een korter interval voor."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯଦି ଆପଣ ସମୟ ପୂର୍ବରୁ ପାଣି ଦିଅନ୍ତି, ଆପ୍ ତାହା ଲକ୍ଷ୍ୟ କରି ବ୍ୟବଧାନ କମାଇବାକୁ ପରାମର୍ଶ ଦିଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਸਮੇਂ ਤੋਂ ਪਹਿਲਾਂ ਪਾਣੀ ਦਿੰਦੇ ਹੋ, ਤਾਂ ਐਪ ਧਿਆਨ ਦੇ ਕੇ ਵਕਫ਼ਾ ਘਟਾਉਣ ਦਾ ਸੁਝਾਅ ਦਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli podlewasz przed czasem, aplikacja to zauważy i zaproponuje krótszy odstęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você rega antes da hora, o app percebe e sugere encurtar o intervalo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se regar antes do tempo, a app repara e propõe encurtar o intervalo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă uzi mai devreme, aplicația observă și îți propune un interval mai scurt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak polievate skôr, aplikácia si to všimne a navrhne kratší interval."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če zalivate pred rokom, aplikacija to opazi in predlaga krajši razmik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattnar du före tiden märker appen det och föreslår ett kortare intervall."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரத்துக்கு முன்பே நீர் ஊற்றினால், ஆப் அதைக் கவனித்து இடைவெளியைக் குறைக்கப் பரிந்துரைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు గడువుకు ముందే నీళ్లు పోస్తే, యాప్ గమనించి విరామాన్ని తగ్గించమని సూచిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณรดน้ำก่อนกำหนด แอปจะสังเกตเห็นและแนะนำให้ลดรอบให้สั้นลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanından önce sularsanız uygulama bunu fark eder ve aralığı kısaltmayı önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви поливаєте раніше строку, застосунок помітить і запропонує зробити строк коротшим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ وقت سے پہلے پانی دیں تو ایپ نوٹ کر کے وقفہ کم کرنے کا مشورہ دیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn tưới sớm hơn hạn, ứng dụng sẽ nhận ra và đề nghị rút ngắn chu kỳ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你总是提前浇水，App 会注意到，并建议缩短间隔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你總是提前澆水，App 會注意到，並建議縮短間隔。"
          }
        }
      }
