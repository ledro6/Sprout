    "Это ваш собственный код: в таблице вы и так есть.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا رمزك أنت: أنت موجود في الجدول بالفعل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е вашият собствен код: и без това сте в таблицата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার নিজের কোড: আপনি তো আগে থেকেই তালিকায় আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És el teu propi codi: ja ets a la taula."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to váš vlastní kód: v tabulce už jste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er din egen kode: du er allerede i tabellen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein eigener Code: Du bist schon in der Tabelle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός είναι ο δικός σας κωδικός: είστε ήδη στον πίνακα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s your own code: you’re already in the table."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu propio código: ya estás en la tabla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on oma koodisi: olet jo taulukossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre propre code : vous êtes déjà dans le classement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમારો પોતાનો કોડ છે: તમે પહેલેથી કોષ્ટકમાં છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה הקוד שלך: כבר נמצאים בטבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका अपना कोड है: आप पहले से तालिका में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vaš vlastiti kod: već ste u tablici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a saját kódod: már szerepelsz a táblázatban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kodemu sendiri: kamu sudah ada di tabel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo codice: sei già in classifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた自身のコードです：すでに表に載っています。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өз кодыңыз: сіз кестеде бұрыннан барсыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 코드예요: 이미 표에 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai jūsų pačių kodas: lentelėje jūs jau esate."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा तुमचाच कोड आहे: तुम्ही आधीच तक्त्यात आहात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kod anda sendiri: anda sudah ada dalam jadual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er din egen kode: du er allerede i tabellen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is je eigen code: je staat al in de tabel."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆପଣଙ୍କ ନିଜ କୋଡ୍: ଆପଣ ପୂର୍ବରୁ ସାରଣୀରେ ଅଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਤੁਹਾਡਾ ਆਪਣਾ ਕੋਡ ਹੈ: ਤੁਸੀਂ ਪਹਿਲਾਂ ਹੀ ਸਾਰਣੀ ਵਿੱਚ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To twój własny kod: już jesteś w tabeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu próprio código: você já está na tabela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É o seu próprio código: já está na tabela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E propriul tău cod: ești deja în tabel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to váš vlastný kód: v tabuľke už ste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vaša lastna koda: v tabeli ste že."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är din egen kod: du finns redan i tabellen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรหัสของคุณเอง: คุณอยู่ในตารางแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin kendi kodunuz: zaten tablodasınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ваш власний код: у таблиці ви й так є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mã của chính bạn: bạn đã có trong bảng."
          }
