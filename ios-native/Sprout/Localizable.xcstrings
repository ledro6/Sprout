        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기소개를 해 주세요 — 실행할 때 이름으로 맞이할게요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisistatykite – vardas pasitiks jus paleidus programą"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळख करून द्या — अ‍ॅप उघडताना तुमचे नाव तुमचे स्वागत करेल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalkan diri — nama anda akan menyambut anda semasa dibuka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenter deg – navnet ditt ønsker deg velkommen ved oppstart"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor — je naam begroet je bij het openen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରିଚୟ ଦିଅନ୍ତୁ — ଆପ୍ ଖୋଲିଲେ ଆପଣଙ୍କ ନାମ ଆପଣଙ୍କୁ ସ୍ୱାଗତ କରିବ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਣ-ਪਛਾਣ ਕਰਾਓ — ਐਪ ਖੁੱਲ੍ਹਣ 'ਤੇ ਤੁਹਾਡਾ ਨਾਮ ਤੁਹਾਡਾ ਸਵਾਗਤ ਕਰੇਗਾ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedstaw się — imię przywita cię przy starcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresente-se — seu nome vai recebê-lo ao abrir o app"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresente-se — o seu nome vai recebê-lo ao abrir a app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezintă-te — numele te va întâmpina la pornire"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavte sa — meno vás privíta pri spustení"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predstavite se — ime vas bo pozdravilo ob zagonu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentera dig – ditt namn hälsar dig vid start"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำตัวหน่อย — ชื่อของคุณจะต้อนรับคุณเมื่อเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinizi tanıtın — adınız açılışta sizi karşılasın"
