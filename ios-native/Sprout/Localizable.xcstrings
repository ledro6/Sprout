    "Поливов ещё не было.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحدث سقي بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма поливания."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো জল দেওয়া হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha regades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné zálivky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen vandinger endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nie gegossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμα ποτίσματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No waterings yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay riegos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kasteluja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun arrosage pour l’instant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી પાણી આપ્યું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא היו השקיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई सिंचाई नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema zalijevanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem volt öntözés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada penyiraman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ水やりの記録がありません。"
