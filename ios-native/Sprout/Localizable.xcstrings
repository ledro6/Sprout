    "Статистика скоро вернётся в новом виде.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود الإحصاءات قريبًا بشكل جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистиката скоро ще се върне в нов вид."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিসংখ্যান শিগগিরই নতুন রূপে ফিরবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estadístiques tornaran aviat amb un nou aspecte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiky se brzy vrátí v nové podobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistikken vender snart tilbage i ny form."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statistik kommt bald in neuer Form zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στατιστικά θα επιστρέψουν σύντομα σε νέα μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistics will be back soon in a new form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas volverán pronto con un nuevo aspecto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilastot palaavat pian uudessa muodossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques reviendront bientôt sous une nouvelle forme."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આંકડા જલદી નવા સ્વરૂપમાં પાછા આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסטטיסטיקה תחזור בקרוב במראה חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँकड़े जल्द ही नए रूप में लौटेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika se uskoro vraća u novom obliku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A statisztika hamarosan új formában tér vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik akan segera kembali dengan wajah baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche torneranno presto in una nuova veste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統計は近日中に新しい形で戻ってきます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика жақында жаңа түрде оралады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಕಿಅಂಶಗಳು ಶೀಘ್ರದಲ್ಲೇ ಹೊಸ ರೂಪದಲ್ಲಿ ಮರಳುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계는 곧 새로운 모습으로 돌아와요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika netrukus sugrįš nauju pavidalu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിതിവിവരക്കണക്കുകൾ ഉടൻ പുതിയ രൂപത്തിൽ തിരിച്ചെത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आकडेवारी लवकरच नव्या रूपात परत येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik akan kembali tidak lama lagi dalam bentuk baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistikken kommer snart tilbake i ny form."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistieken komen binnenkort terug in een nieuwe vorm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରିସଂଖ୍ୟାନ ଶୀଘ୍ର ନୂଆ ରୂପରେ ଫେରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਕੜੇ ਜਲਦੀ ਨਵੇਂ ਰੂਪ ਵਿੱਚ ਵਾਪਸ ਆਉਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statystyki wkrótce wrócą w nowej formie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas voltam em breve com cara nova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas voltam em breve com um novo aspeto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Statisticile revin curând într-o formă nouă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štatistika sa čoskoro vráti v novej podobe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika se kmalu vrne v novi podobi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiken kommer snart tillbaka i ny form."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புள்ளிவிவரம் விரைவில் புதிய வடிவில் திரும்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
