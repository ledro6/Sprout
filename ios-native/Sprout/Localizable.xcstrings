            "value": "ਟੈਪ ਕਰੋ ਅਤੇ ਬਗੀਚਾ ਨਿਸ਼ਾਨੇ ਦੇ ਆਲੇ-ਦੁਆਲੇ ਦਿਖੇਗਾ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, a ogród pojawi się wokół celownika"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e o jardim aparecerá em volta da mira"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e o jardim aparece à volta da mira"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge și grădina apare în jurul vizorului"
          }
        },
