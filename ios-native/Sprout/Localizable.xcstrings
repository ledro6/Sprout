    "Называет растения, у которых срок полива — сегодня, от самого сухого.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكر النباتات التي يحين سقيها اليوم، بدءًا بالأكثر جفافًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изброява растенията със срок за поливане днес, от най-сухото."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ যেসব গাছে জল দিতে হবে তাদের নাম বলে, সবচেয়ে শুকনোটি থেকে শুরু করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diu quines plantes toca regar avui, de la més seca a la menys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyjmenuje rostliny, které je dnes potřeba zalít, od nejsušší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nævner de planter, der skal vandes i dag, den tørreste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die Pflanzen, die heute gegossen werden müssen, die trockenste zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λέει ποια φυτά θέλουν πότισμα σήμερα, ξεκινώντας από το πιο ξερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names the plants due for watering today, driest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice qué plantas toca regar hoy, de la más seca a la menos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelee tänään kasteltavat kasvit kuivimmasta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme les plantes à arroser aujourd’hui, de la plus sèche à la moins sèche."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજે જેમને પાણી આપવાનું છે તે છોડનાં નામ, સૌથી સૂકાથી શરૂ કરીને, જણાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונה את הצמחים שצריך להשקות היום, מהיבש ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज जिन पौधों को पानी देना है, उनके नाम बताता है, सबसे सूखे से शुरू करके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabraja biljke koje danas treba zaliti, od najsuše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felsorolja a ma öntözendő növényeket, a legszárazabbal kezdve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebutkan tanaman yang jadwal siramnya hari ini, dari yang paling kering."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le piante da annaffiare oggi, dalla più secca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が水やり日の植物を、乾いている順に読み上げます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін суару мерзімі келген өсімдіктерді ең құрғағынан бастап атайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 물을 줘야 하는 식물을 가장 마른 것부터 알려 줘요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išvardija augalus, kuriuos reikia palaistyti šiandien, nuo sausiausio."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज पाणी घालायच्या रोपांची नावे सांगते, सर्वात कोरड्यापासून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyebut tumbuhan yang perlu disiram hari ini, bermula dengan yang paling kering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevner plantene som skal vannes i dag, den tørreste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noemt de planten die vandaag water nodig hebben, de droogste eerst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଯେଉଁ ଗଛକୁ ପାଣି ଦେବାକୁ ହେବ ସେମାନଙ୍କ ନାମ କହେ, ସବୁଠାରୁ ଶୁଖିଲାଠାରୁ ଆରମ୍ଭ କରି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਜਿਨ੍ਹਾਂ ਪੌਦਿਆਂ ਨੂੰ ਪਾਣੀ ਦੇਣਾ ਹੈ ਉਨ੍ਹਾਂ ਦੇ ਨਾਮ ਦੱਸਦਾ ਹੈ, ਸਭ ਤੋਂ ਸੁੱਕੇ ਤੋਂ ਸ਼ੁਰੂ ਕਰਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymienia rośliny, które dziś trzeba podlać, od najbardziej suchej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz quais plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz que plantas precisam de rega hoje, da mais seca para a menos seca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune ce plante trebuie udate azi, de la cea mai uscată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymenuje rastliny, ktoré treba dnes poliať, od najsuchšej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Našteje rastline, ki jih je treba danes zaliti, od najbolj suhe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämner växterna som ska vattnas i dag, den torraste först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกต้นไม้ที่ถึงกำหนดรดน้ำวันนี้ เริ่มจากต้นที่แห้งที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sulanması gereken bitkileri en kurudan başlayarak söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Називає рослини, у яких строк поливу — сьогодні, від найсухішої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nêu các cây đến hạn tưới hôm nay, bắt đầu từ cây khô nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按从最干开始的顺序，说出今天该浇水的植物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依從最乾開始的順序，說出今天該澆水的植物。"
          }
        }
      }
    },
    "Найдётся по кличке или по виду — «Баксик», «Монстера».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث باللقب أو النوع — «بكسي»، «مونستيرا»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търсете по прякор или вид — „Бакси“, „Монстера“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাকনাম বা প্রজাতি দিয়ে খুঁজুন — “বক্সি”, “মনস্টেরা”।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per sobrenom o espècie: «Baxi», «Costella d’Adam»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledejte podle přezdívky nebo druhu — „Baxík“, „Monstera“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg på kælenavn eller art – ”Baxi”, ”Monstera”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Spitzname oder Art — „Baxi“, „Monstera“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητήστε με παρατσούκλι ή είδος — «Μπάξι», «Μονστέρα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by nickname or species — “Bucky”, “Monstera”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por apodo o especie: “Baxi”, “Monstera”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae lempinimellä tai lajilla – ”Baxi”, ”Monstera”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez par surnom ou par espèce — « Bouboule », « Monstera »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હુલામણા નામ કે પ્રજાતિથી શોધો — “બક્સી”, “મોન્સ્ટેરા”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיפוש לפי כינוי או זן — “בקסי”, “מונסטרה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपनाम या प्रजाति से खोजें — “बक्सी”, “मॉन्स्टेरा”।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tražite po nadimku ili vrsti — „Baksi”, „Monstera”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keress becenévre vagy fajra — „Baxi”, „Könnyező pálma”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari berdasarkan nama panggilan atau spesies — “Baxi”, “Monstera”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per soprannome o specie: “Baxi”, “Monstera”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームか種類で検索 —「バクシー」「モンステラ」。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лақап атымен не түрімен іздеңіз — «Бакси», «Монстера»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별명이나 종으로 검색하세요 — ‘박시’, ‘몬스테라’."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieškokite pagal pravardę ar rūšį – „Baksis“, „Monstera“."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टोपणनाव किंवा प्रजातीने शोधा — “बक्सी”, “मॉन्स्टेरा”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari mengikut nama panggilan atau spesies — “Baxi”, “Monstera”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk på kallenavn eller art – «Baxi», «Monstera»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek op bijnaam of soort — ‘Baxi’, ‘Monstera’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡାକନାମ କିମ୍ବା ପ୍ରଜାତି ଦ୍ୱାରା ଖୋଜନ୍ତୁ — “ବକ୍ସି”, “ମନଷ୍ଟେରା”।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਪਨਾਮ ਜਾਂ ਕਿਸਮ ਨਾਲ ਖੋਜੋ — “ਬਕਸੀ”, “ਮੌਨਸਟੇਰਾ”।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj po przezwisku lub gatunku — „Baksik”, „Monstera”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por apelido ou espécie — “Baxi”, “Costela-de-adão”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise por alcunha ou espécie — “Baxi”, “Costela-de-adão”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută după poreclă sau specie — „Baxi”, „Monstera”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadajte podľa prezývky alebo druhu — „Baxík“, „Monstera“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iščite po vzdevku ali vrsti — »Baksi«, »Monstera«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök på smeknamn eller art – ”Baxi”, ”Monstera”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาด้วยชื่อเล่นหรือพันธุ์ — “บักซี่”, “มอนสเตอร่า”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma ada ya da türe göre arayın — “Baksi”, “Deve tabanı”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдеться за кличкою або видом — «Баксик», «Монстера»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm theo biệt danh hoặc loài — “Baxi”, “Trầu bà lá xẻ”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按昵称或品种搜索——“巴克西”“龟背竹”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依暱稱或品種搜尋——「巴克西」「龜背芋」。"
          }
        }
      }
    },
