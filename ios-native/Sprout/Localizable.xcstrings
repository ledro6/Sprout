    "Приложение не выходит в интернет. У него нет ни учётной записи, ни сервера, ни аналитики, ни рекламы.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldrig på internettet. Den har ingen konto, ingen server, ingen analyse og ingen reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App geht nicht ins Internet. Sie hat weder ein Konto noch einen Server, keine Analyse und keine Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app never goes online. It has no account, no server, no analytics and no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se conecta a internet. No tiene cuenta, ni servidor, ni analíticas, ni publicidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appi ei käytä internetiä. Sillä ei ole tiliä, palvelinta, analytiikkaa eikä mainoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne se connecte jamais à Internet. Elle n’a ni compte, ni serveur, ni statistiques, ni publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non va su internet. Non ha account, server, analisi né pubblicità."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldri på internett. Den har ingen konto, ingen server, ingen analyse og ingen reklame."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app gaat niet online. Hij heeft geen account, geen server, geen analyse en geen reclame."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não acessa a internet. Não tem conta, servidor, análises nem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app não acede à internet. Não tem conta, servidor, estatísticas nem publicidade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen går aldrig ut på internet. Den har inget konto, ingen server, ingen analys och ingen reklam."
          }
        }
      }
    },
