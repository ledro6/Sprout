        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes není potřeba nic zalévat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen skal vandes i dag."
          }
        },
        "de": {
