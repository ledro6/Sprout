    "Самые сухие растения и кнопка «Полить».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النباتات الأكثر جفافًا وزر «اسقِ»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-сухите растения и бутон „Полей“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে শুকনো গাছ ও “জল দিন” বোতাম।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes més seques i un botó «Rega»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsušší rostliny a tlačítko „Zalít“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tørreste planter og en ”Vand”-knap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die trockensten Pflanzen und eine „Gießen“-Taste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πιο ξερά φυτά και ένα κουμπί «Πότισμα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The driest plants and a “Water” button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas más secas y un botón “Regar”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuivimmat kasvit ja Kastele-painike."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes les plus sèches et un bouton « Arroser »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી સૂકા છોડ અને “પાણી આપો” બટન."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמחים היבשים ביותר וכפתור “השקיה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे सूखे पौधे और “पानी दें” बटन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najsuše biljke i gumb „Zalij”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legszárazabb növények és egy „Öntözés” gomb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaman terkering dan tombol “Siram”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante più secche e un pulsante “Annaffia”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん乾いた植物と「水やり」ボタン。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең құрғақ өсімдіктер және «Суару» түймесі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೆಚ್ಚು ಒಣಗಿದ ಗಿಡಗಳು ಮತ್ತು “ನೀರು ಹಾಕಿ” ಬಟನ್."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 마른 식물과 ‘물주기’ 버튼."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sausiausi augalai ir mygtukas „Palaistyti“."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും ഉണങ്ങിയ ചെടികളും “നനയ്ക്കുക” ബട്ടണും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वात कोरडी रोपे आणि “पाणी घाला” बटण."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbuhan paling kering dan butang “Siram”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De tørreste plantene og en «Vann»-knapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De droogste planten en een knop ‘Geef water’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁଠାରୁ ଶୁଖିଲା ଗଛ ଏବଂ “ପାଣି ଦିଅନ୍ତୁ” ବଟନ୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਸੁੱਕੇ ਪੌਦੇ ਅਤੇ “ਪਾਣੀ ਦਿਓ” ਬਟਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbardziej suche rośliny i przycisk „Podlej”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas mais secas e um botão “Regar”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas mais secas e um botão “Regar”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele mai uscate plante și un buton „Udă”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najsuchšie rastliny a tlačidlo „Poliať“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbolj suhe rastline in gumb »Zalij«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De torraste växterna och en ”Vattna”-knapp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிக உலர்ந்த செடிகளும் “தண்ணீர் ஊற்று” பொத்தானும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బాగా ఎండిన మొక్కలు మరియు “నీళ్లు పోయండి” బటన్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นไม้ที่แห้งที่สุดและปุ่ม “รดน้ำ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En kuru bitkiler ve bir “Sula” düğmesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найсухіші рослини й кнопка «Полити»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے خشک پودے اور “پانی دیں” بٹن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những cây khô nhất và nút “Tưới”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最干的植物和“浇水”按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最乾的植物和「澆水」按鈕。"
          }
        }
      }
    },
