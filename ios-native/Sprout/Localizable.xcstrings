    "Комната появится, когда вы нажмёте «Готово».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الغرفة عندما تضغط «تم»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаята ще се появи, когато докоснете „Готово“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“সম্পন্ন” ট্যাপ করলে ঘরটি দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’habitació apareixerà quan toquis «Fet»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost se objeví, až klepnete na „Hotovo“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet vises, når du trykker på ”OK”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum erscheint, wenn du auf „Fertig“ tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δωμάτιο θα εμφανιστεί όταν πατήσετε «Τέλος»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room will appear when you tap “Done”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La habitación aparecerá cuando toques “OK”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huone ilmestyy, kun napautat ”Valmis”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce apparaîtra quand vous toucherez « OK »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“પૂર્ણ” પર ટૅપ કરશો ત્યારે રૂમ દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החדר יופיע כשתקישו על “סיום”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“पूर्ण” पर टैप करने पर कमरा दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba će se pojaviti kad dodirnete „Gotovo”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szoba akkor jelenik meg, ha a „Kész” gombra koppintasz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruangan akan muncul saat kamu mengetuk “Selesai”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stanza apparirà quando tocchi “Fine”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「完了」をタップすると部屋が表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Дайын» түймесін басқанда бөлме пайда болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘완료’를 탭하면 방이 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kambarys atsiras, kai bakstelėsite „Atlikta“."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“पूर्ण” वर टॅप केल्यावर खोली दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik akan muncul apabila anda ketik “Selesai”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rommet vises når du trykker på «Ferdig»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kamer verschijnt als je op ‘Gereed’ tikt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ହୋଇଗଲା” ଟାପ୍ କଲେ ରୁମ୍ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਹੋ ਗਿਆ” 'ਤੇ ਟੈਪ ਕਰਨ 'ਤੇ ਕਮਰਾ ਦਿਖੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój pojawi się, gdy stukniesz „Gotowe”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cômodo aparecerá quando você tocar em “OK”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A divisão aparece quando tocar em “OK”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera va apărea când atingi „Gata”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť sa objaví, keď klepnete na „Hotovo“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba se bo pojavila, ko tapnete »Končano«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet visas när du trycker på ”Klar”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องจะปรากฏเมื่อคุณแตะ “เสร็จสิ้น”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda, “Bitti”ye dokunduğunuzda görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімната з’явиться, коли ви натиснете «Готово»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng sẽ xuất hiện khi bạn chạm “Xong”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“完成”后房间就会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「完成」後房間就會出現。"
          }
        }
      }
    },
