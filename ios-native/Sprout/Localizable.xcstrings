    "Скольким растениям понадобится вода в ближайшие дни. Нажмите на столбик — появятся клички.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم نبتة ستحتاج إلى الماء في الأيام القادمة. اضغط على عمود لترى الأسماء."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко растения ще имат нужда от вода през следващите дни. Докоснете стълбче, за да видите имената."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সামনের দিনগুলোতে কতগুলো গাছের জল লাগবে। নাম দেখতে একটি বারে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantes plantes necessitaran aigua els propers dies. Toca una barra per veure’n els noms."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik rostlin bude v příštích dnech potřebovat vodu. Klepnutím na sloupec uvidíte jména."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter der får brug for vand de næste dage. Tryk på en søjle for at se navnene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Pflanzen in den nächsten Tagen Wasser brauchen. Tippe auf einen Balken, um ihre Namen zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσα φυτά θα χρειαστούν νερό τις επόμενες μέρες. Αγγίξτε μια μπάρα για να δείτε τα ονόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many plants will need water in the coming days. Tap a bar to see their names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas plantas necesitarán agua en los próximos días. Toca una barra para ver sus nombres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka moni kasvi tarvitsee vettä lähipäivinä. Napauta palkkia nähdäksesi nimet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de plantes auront besoin d’eau dans les jours à venir. Touchez une barre pour voir leurs noms."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આવતા દિવસોમાં કેટલા છોડને પાણી જોઈશે. નામ જોવા માટે કોઈ બાર પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה צמחים יצטרכו מים בימים הקרובים. הקישו על עמודה כדי לראות שמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने वाले दिनों में कितने पौधों को पानी चाहिए होगा। नाम देखने के लिए किसी बार पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko će biljaka trebati vodu sljedećih dana. Dodirnite stupac da vidite imena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány növénynek kell víz a következő napokban. Koppints egy oszlopra a nevekért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tanaman yang perlu air dalam beberapa hari ke depan. Ketuk batang untuk melihat namanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante piante avranno bisogno d’acqua nei prossimi giorni. Tocca una barra per vedere i nomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この先数日で水が必要になる植物の数。バーをタップすると名前が表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдағы күндері қанша өсімдікке су керек болады. Бағанды түртсеңіз — лақап аттар шығады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ದಿನಗಳಲ್ಲಿ ಎಷ್ಟು ಗಿಡಗಳಿಗೆ ನೀರು ಬೇಕಾಗುತ್ತದೆ. ಹೆಸರುಗಳನ್ನು ನೋಡಲು ಬಾರ್ ಮೇಲೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 며칠 동안 물이 필요한 식물의 수. 막대를 탭하면 이름이 보여요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek augalų artimiausiomis dienomis reikės vandens. Bakstelėkite stulpelį, kad pamatytumėte vardus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വരും ദിവസങ്ങളിൽ എത്ര ചെടികൾക്ക് വെള്ളം വേണം. പേരുകൾ കാണാൻ ഒരു ബാറിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येत्या दिवसांत किती रोपांना पाणी लागेल. नावे पाहण्यासाठी एखाद्या स्तंभावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa tumbuhan akan memerlukan air dalam beberapa hari akan datang. Ketik bar untuk melihat namanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange planter som trenger vann de neste dagene. Trykk på en søyle for å se navnene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel planten de komende dagen water nodig hebben. Tik op een staaf om hun namen te zien."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
