            "value": "«പുറപ്പെടൽ» എന്നതിൽ തോട്ടം യാത്രയ്ക്ക് ഒരുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "«जाणे» मध्ये बाग प्रवासासाठी तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
