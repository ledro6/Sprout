            "state": "translated",
            "value": "கைமுறை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాన్యువల్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вручну"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thủ công"
          }
        },
        "zh-Hans": {
          "stringUnit": {
