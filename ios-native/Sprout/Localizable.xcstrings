            "value": "Το τηλέφωνο δεν αναγνώρισε φυτό στη φωτογραφία — γράψτε το είδος μόνοι σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone didn’t recognize a plant in the photo — enter the species yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono no reconoció ninguna planta en la foto: escribe la especie tú mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelin ei tunnistanut kuvasta kasvia – kirjoita laji itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone n’a pas reconnu de plante sur la photo — saisissez l’espèce vous-même."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોન ફોટામાં છોડ ઓળખી શક્યો નહીં — પ્રજાતિ જાતે લખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטלפון לא זיהה צמח בתמונה — יש להקליד את הזן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन फ़ोटो में पौधा नहीं पहचान पाया — प्रजाति खुद लिखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon nije prepoznao biljku na fotografiji — upišite vrstu sami."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon nem ismert fel növényt a fotón — írd be a fajt magad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel tidak mengenali tanaman di foto — ketik spesiesnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono non ha riconosciuto piante nella foto: inserisci tu la specie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の植物を認識できませんでした — 種類を入力してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон суреттегі өсімдікті танымады — түрін өзіңіз жазыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಫೋಟೋದಲ್ಲಿ ಗಿಡವನ್ನು ಗುರುತಿಸಲಿಲ್ಲ — ಜಾತಿಯನ್ನು ನೀವೇ ನಮೂದಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에서 식물을 인식하지 못했어요 — 종을 직접 입력하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonas neatpažino augalo nuotraukoje – įrašykite rūšį patys."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോയിലെ ചെടി ഫോൺ തിരിച്ചറിഞ്ഞില്ല — ഇനം സ്വയം നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोनने फोटोतील रोप ओळखले नाही — प्रजाती स्वतः लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon tidak mengecam tumbuhan dalam foto — taipkan spesies sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kjente ikke igjen noen plante på bildet – skriv inn arten selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De telefoon herkende geen plant op de foto — vul de soort zelf in."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ୍ ଫଟୋରେ ଗଛ ଚିହ୍ନିପାରିଲା ନାହିଁ — ପ୍ରଜାତି ନିଜେ ଲେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਨੇ ਫ਼ੋਟੋ ਵਿੱਚ ਪੌਦਾ ਨਹੀਂ ਪਛਾਣਿਆ — ਕਿਸਮ ਆਪ ਲਿਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon nie rozpoznał rośliny na zdjęciu — wpisz gatunek sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular não reconheceu nenhuma planta na foto — digite a espécie você mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel não reconheceu nenhuma planta na fotografia — escreva a espécie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonul n-a recunoscut nicio plantă în fotografie — scrie tu specia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón na fotke nerozpoznal žiadnu rastlinu — zadajte druh sami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon na fotografiji ni prepoznal rastline — vrsto vpišite sami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen kände inte igen någon växt på fotot – skriv in arten själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்தில் செடியை ஃபோன் அடையாளம் காணவில்லை — இனத்தை நீங்களே உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్ ఫోటోలో మొక్కను గుర్తించలేదు — జాతిని మీరే నమోదు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์จำต้นไม้ในรูปไม่ได้ — โปรดพิมพ์พันธุ์เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon fotoğrafta bitki tanımadı — türü kendiniz yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рослину на знімку телефон не впізнав — впишіть вид самі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون تصویر میں پودا نہیں پہچان سکا — نوع خود لکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại không nhận ra cây trong ảnh — hãy tự nhập loài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有在照片中认出植物——请自己填写品种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機沒有在照片中認出植物——請自行填寫品種。"
          }
        }
      }
    },
