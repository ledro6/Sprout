    "Узор на фоне чуть сдвигается, когда вы наклоняете телефон, — будто лежит глубже экрана.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك نقش الخلفية قليلًا عندما تُميل الهاتف، كأنه أعمق من الشاشة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шарката на фона леко се премества, когато накланяте телефона – сякаш лежи по-дълбоко от екрана."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন হেলালে পটভূমির নকশা একটু সরে যায় — যেন স্ক্রিনের চেয়ে গভীরে আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El motiu del fons es mou una mica quan inclines el telèfon, com si fos més endins que la pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzor v pozadí se trochu posune, když nakloníte telefon – jako by ležel hlouběji než displej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mønsteret i baggrunden flytter sig lidt, når du vipper telefonen – som om det ligger dybere end skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrundmuster verschiebt sich leicht, wenn du das Telefon neigst – als läge es tiefer als der Bildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοτίβο του φόντου μετακινείται λίγο όταν γέρνετε το τηλέφωνο — σαν να βρίσκεται πιο βαθιά από την οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background pattern shifts slightly as you tilt your phone — as if it lay deeper than the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El patrón del fondo se desplaza un poco al inclinar el teléfono, como si estuviera más hondo que la pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustan kuvio siirtyy hieman, kun kallistat puhelinta – kuin se olisi näyttöä syvemmällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le motif du fond bouge légèrement quand vous inclinez le téléphone — comme s’il était plus profond que l’écran."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોન નમાવતાં પૃષ્ઠભૂમિની ભાત થોડી ખસે છે — જાણે સ્ક્રીનથી ઊંડે હોય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדוגמה ברקע זזה מעט כשמטים את הטלפון – כאילו היא מונחת עמוק יותר מהמסך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन झुकाने पर पृष्ठभूमि का पैटर्न थोड़ा खिसकता है — मानो स्क्रीन से गहराई में हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzorak u pozadini malo se pomakne kad nagnete telefon – kao da leži dublje od zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A háttér mintája kicsit elmozdul, ha megdöntöd a telefont – mintha mélyebben lenne a kijelzőnél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola latar bergeser sedikit saat kamu memiringkan ponsel — seolah berada lebih dalam dari layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motivo dello sfondo si sposta un po’ quando inclini il telefono, come se fosse più in profondità dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを傾けると、背景の模様が少し動きます。画面より奥にあるように見えます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фондағы өрнек телефонды еңкейткенде сәл жылжиды — экраннан тереңірек жатқандай."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಓರೆ ಮಾಡಿದಾಗ ಹಿನ್ನೆಲೆಯ ವಿನ್ಯಾಸ ಸ್ವಲ್ಪ ಸರಿಯುತ್ತದೆ — ಪರದೆಗಿಂತ ಆಳದಲ್ಲಿ ಇದ್ದಂತೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 기울이면 배경 무늬가 살짝 움직여요. 화면보다 깊이 있는 것처럼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fono raštas truputį pasislenka, kai pakreipiate telefoną, – tarsi būtų giliau už ekraną."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൺ ചരിക്കുമ്പോൾ പശ്ചാത്തലത്തിലെ ചിത്രപ്പണി അൽപ്പം നീങ്ങും — സ്ക്രീനിനേക്കാൾ ആഴത്തിലാണെന്ന പോലെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन तिरका केल्यावर पार्श्वभूमीची नक्षी थोडी सरकते — जणू स्क्रीनपेक्षा खोल आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Corak latar bergerak sedikit apabila anda mencondongkan telefon — seolah-olah terletak lebih dalam daripada skrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mønsteret i bakgrunnen flytter seg litt når du vipper telefonen – som om det ligger dypere enn skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het patroon op de achtergrond verschuift een beetje als je de telefoon kantelt – alsof het dieper ligt dan het scherm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ ଢଳାଇଲେ ପୃଷ୍ଠଭୂମିର ନକ୍ସା ଟିକେ ଘୁଞ୍ଚେ — ଯେପରି ସ୍କ୍ରିନଠାରୁ ଗଭୀରରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਝੁਕਾਉਣ ’ਤੇ ਪਿਛੋਕੜ ਦਾ ਨਮੂਨਾ ਥੋੜ੍ਹਾ ਖਿਸਕਦਾ ਹੈ — ਜਿਵੇਂ ਸਕਰੀਨ ਤੋਂ ਡੂੰਘਾ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzór w tle lekko się przesuwa, gdy przechylasz telefon – jakby leżał głębiej niż ekran."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão do fundo se desloca um pouco quando você inclina o celular — como se estivesse mais fundo que a tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão do fundo desloca-se um pouco quando inclina o telemóvel — como se estivesse mais fundo do que o ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul din fundal se mișcă puțin când înclini telefonul — de parcă ar fi mai adânc decât ecranul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzor v pozadí sa trochu posunie, keď nakloníte telefón – akoby ležal hlbšie než displej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzorec v ozadju se malo premakne, ko nagnete telefon – kot da leži globlje od zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mönstret i bakgrunden rör sig lite när du lutar telefonen – som om det låg djupare än skärmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "போனைச் சாய்க்கும்போது பின்னணி வடிவம் சற்று நகரும் — திரையை விட ஆழத்தில் இருப்பது போல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్‌ను వంచినప్పుడు నేపథ్య నమూనా కొద్దిగా జరుగుతుంది — తెర కంటే లోతులో ఉన్నట్టు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลวดลายพื้นหลังจะขยับเล็กน้อยเมื่อคุณเอียงโทรศัพท์ เหมือนอยู่ลึกกว่าหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu eğdiğinizde arka plandaki desen biraz kayar; sanki ekrandan daha derindeymiş gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Візерунок на тлі трохи зсувається, коли ви нахиляєте телефон, — ніби лежить глибше за екран."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون جھکانے پر پس منظر کا نقش ذرا سا سرکتا ہے، جیسے اسکرین سے گہرائی میں ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa văn nền dịch chuyển nhẹ khi bạn nghiêng điện thoại — như thể nằm sâu hơn màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倾斜手机时，背景图案会轻微移动——好像它在屏幕更深处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傾斜手機時，背景圖案會輕微移動——好像它在螢幕更深處。"
          }
        }
      }
    },
