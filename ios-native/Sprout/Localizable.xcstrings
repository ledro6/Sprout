    "Потяните снимок или разведите пальцы. Двойное нажатие вернёт как было.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i fotoet, eller spred fingrene. Dobbelttryk for at nulstille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das Foto oder spreiz die Finger. Doppeltippen setzt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the photo or spread your fingers. Double-tap to reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la foto o separa los dedos. Toca dos veces para restablecer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kuvaa tai levitä sormia. Palauta kaksoisnapautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la photo ou écartez les doigts. Touchez deux fois pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la foto o allarga le dita. Tocca due volte per ripristinare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i bildet eller spre fingrene. Dobbelttrykk for å tilbakestille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de foto of spreid je vingers. Dubbeltik om te herstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a foto ou afaste os dedos. Toque duas vezes para voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a fotografia ou afaste os dedos. Toque duas vezes para repor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra fotot eller sära på fingrarna. Dubbeltryck för att återställa."
          }
        }
      }
    },
    "Похоже, земля сохнет быстрее: %1$@ вместо %2$@.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden ser ud til at tørre hurtigere: %1$@ i stedet for %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erde scheint schneller zu trocknen: %1$@ statt %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the soil dries faster: %1$@ instead of %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la tierra se seca más rápido: %1$@ en lugar de %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Multa näyttää kuivuvan nopeammin: %1$@ eikä %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que la terre sèche plus vite : %1$@ au lieu de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che il terriccio asciughi più in fretta: %1$@ invece di %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorda ser ut til å tørke raskere: %1$@ i stedet for %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aarde lijkt sneller te drogen: %1$@ in plaats van %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que a terra seca mais rápido: %1$@ em vez de %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorden verkar torka snabbare: %1$@ i stället för %2$@."
          }
        }
      }
    },
