    "Переезд в горшок побольше со свежей землёй. Обычно раз в год-два, весной.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل النبتة إلى أصيص أكبر مع تربة جديدة. عادةً مرة كل سنة أو سنتين، في الربيع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преместване в по-голяма саксия с прясна почва. Обикновено веднъж на година-две, напролет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাজা মাটিসহ বড় টবে সরানো। সাধারণত বছরে বা দুই বছরে একবার, বসন্তে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar la planta a un test més gran amb terra nova. Normalment cada un o dos anys, a la primavera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přestěhování do většího květináče s čerstvou zeminou. Obvykle jednou za rok či dva, na jaře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytning til en større potte med frisk jord. Normalt hvert eller hvert andet år, om foråret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umzug in einen größeren Topf mit frischer Erde. Meist alle ein bis zwei Jahre, im Frühling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακόμιση σε μεγαλύτερη γλάστρα με φρέσκο χώμα. Συνήθως κάθε ένα με δύο χρόνια, την άνοιξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the plant to a bigger pot with fresh soil. Usually once every year or two, in spring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar la planta a una maceta más grande con tierra nueva. Normalmente cada uno o dos años, en primavera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutto isompaan ruukkuun tuoreeseen multaan. Yleensä vuoden tai kahden välein, keväällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage dans un pot plus grand avec de la terre neuve. En général tous les un ou deux ans, au printemps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તાજી માટી સાથે મોટા કૂંડામાં ખસેડવું. સામાન્ય રીતે વર્ષે-બે વર્ષે એક વાર, વસંતમાં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר לעציץ גדול יותר עם אדמה טרייה. בדרך כלל פעם בשנה־שנתיים, באביב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताज़ी मिट्टी के साथ बड़े गमले में ले जाना। आमतौर पर साल-दो साल में एक बार, वसंत में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preseljenje u veću teglu sa svježom zemljom. Obično jednom u godinu-dvije, u proljeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Költözés nagyobb cserépbe, friss földbe. Általában egy-két évente, tavasszal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindah ke pot yang lebih besar dengan tanah baru. Biasanya setahun atau dua tahun sekali, di musim semi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasloco in un vaso più grande con terriccio fresco. Di solito ogni uno o due anni, in primavera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい土と一回り大きな鉢に移すことです。ふつうは1〜2年に一度、春に行います。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа топырағы бар үлкенірек құмыраға көшіру. Әдетте бір-екі жылда бір рет, көктемде."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ಮಣ್ಣಿನೊಂದಿಗೆ ದೊಡ್ಡ ಕುಂಡಕ್ಕೆ ಸ್ಥಳಾಂತರ. ಸಾಮಾನ್ಯವಾಗಿ ವರ್ಷ-ಎರಡು ವರ್ಷಕ್ಕೊಮ್ಮೆ, ವಸಂತದಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 흙과 더 큰 화분으로 옮기는 일이에요. 보통 1~2년에 한 번, 봄에 해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Persikraustymas į didesnį vazoną su šviežia žeme. Paprastai kas metus ar dvejus, pavasarį."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ മണ്ണോടെ വലിയ ചട്ടിയിലേക്ക് മാറ്റൽ. സാധാരണ ഒന്നോ രണ്ടോ വർഷത്തിലൊരിക്കൽ, വസന്തകാലത്ത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ताज्या मातीसह मोठ्या कुंडीत हलवणे. साधारणपणे वर्ष-दोन वर्षांतून एकदा, वसंतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpindah ke pasu yang lebih besar dengan tanah baharu. Biasanya setahun atau dua tahun sekali, pada musim bunga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytting til en større potte med fersk jord. Vanligvis hvert år eller annethvert år, om våren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhuizen naar een grotere pot met verse grond. Meestal eens per één à twee jaar, in het voorjaar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନୂଆ ମାଟି ସହ ବଡ଼ ଟବକୁ ସ୍ଥାନାନ୍ତର। ସାଧାରଣତଃ ବର୍ଷେ-ଦୁଇବର୍ଷରେ ଥରେ, ବସନ୍ତରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਾਜ਼ੀ ਮਿੱਟੀ ਨਾਲ ਵੱਡੇ ਗਮਲੇ ਵਿੱਚ ਬਦਲਣਾ। ਆਮ ਤੌਰ ’ਤੇ ਸਾਲ-ਦੋ ਸਾਲ ਵਿੱਚ ਇੱਕ ਵਾਰ, ਬਸੰਤ ਵਿੱਚ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeprowadzka do większej doniczki ze świeżą ziemią. Zwykle raz na rok lub dwa, wiosną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança para um vaso maior com terra nova. Em geral a cada um ou dois anos, na primavera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança para um vaso maior com terra nova. Normalmente a cada um ou dois anos, na primavera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutarea într-un ghiveci mai mare, cu pământ proaspăt. De obicei o dată la unu-doi ani, primăvara."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presťahovanie do väčšieho kvetináča s čerstvou zeminou. Zvyčajne raz za rok či dva, na jar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selitev v večji lonec s svežo zemljo. Navadno enkrat na leto ali dve, spomladi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt till en större kruka med färsk jord. Oftast varje eller vartannat år, på våren."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய மண்ணுடன் பெரிய தொட்டிக்கு மாற்றுதல். பொதுவாக ஓரிரு ஆண்டுக்கு ஒருமுறை, வசந்தத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తాజా మట్టితో పెద్ద కుండీలోకి మార్చడం. సాధారణంగా ఏడాది-రెండేళ్లకు ఒకసారి, వసంతంలో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายไปกระถางที่ใหญ่ขึ้นพร้อมดินใหม่ โดยปกติปีละครั้งหรือสองปีครั้ง ในฤดูใบไม้ผลิ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze topraklı daha büyük bir saksıya taşınma. Genellikle bir iki yılda bir, ilkbaharda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переїзд у більший вазон зі свіжою землею. Зазвичай раз на рік-два, навесні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تازہ مٹی کے ساتھ بڑے گملے میں منتقلی۔ عموماً سال دو سال میں ایک بار، بہار میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển cây sang chậu lớn hơn với đất mới. Thường một đến hai năm một lần, vào mùa xuân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把植物移到更大的盆里，换上新土。通常一到两年一次，在春天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把植物移到更大的盆裡，換上新土。通常一到兩年一次，在春天。"
          }
        }
      }
    },
