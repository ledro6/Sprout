    "В саду пока ничего не растёт. Посадите первое растение во вкладке «Добавить».": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vokser endnu intet i din have. Plant den første på fanen ”Tilføj”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Garten wächst noch nichts. Setz die erste Pflanze im Tab „Hinzufügen“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is growing in your garden yet. Plant the first one in the “Add” tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no crece nada en tu jardín. Planta la primera en la pestaña “Añadir”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhassasi ei vielä kasva mitään. Istuta ensimmäinen välilehdellä ”Lisää”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne pousse encore dans votre jardin. Plantez la première plante dans l’onglet « Ajouter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo giardino non cresce ancora niente. Pianta la prima nella scheda “Aggiungi”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting vokser i hagen din ennå. Plant den første i fanen «Legg til»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er groeit nog niets in je tuin. Plant de eerste in het tabblad ‘Voeg toe’."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada crescendo no seu jardim. Plante a primeira na aba “Adicionar”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não cresce nada no seu jardim. Plante a primeira no separador “Adicionar”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget växer i din trädgård än. Plantera den första på fliken ”Lägg till”."
          }
        }
      }
    },
    "В саду пока пусто.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven er tom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Garten ist leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden is empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardín está vacío."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarha on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jardin est vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giardino è vuoto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen er tom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tuin is leeg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está vazio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está vazio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trädgården är tom."
          }
        }
      }
    },
    "В скопированном нет кода Sprout. Скопируйте сообщение друга целиком — код лежит в нём последней строкой.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kopierede indeholder ingen Sprout-kode. Kopiér din vens hele besked – koden står på sidste linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kopierten ist kein Sprout-Code. Kopiere die ganze Nachricht deines Freundes — der Code steht in der letzten Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s no Sprout code in what you copied. Copy your friend’s whole message — the code is its last line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copiaste no contiene un código de Sprout. Copia el mensaje entero de tu amigo: el código está en la última línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioimassasi tekstissä ei ole Sprout-koodia. Kopioi kaverisi koko viesti – koodi on viimeisellä rivillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez copié ne contient pas de code Sprout. Copiez tout le message de votre ami — le code est sur la dernière ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel testo copiato non c’è un codice Sprout. Copia l’intero messaggio del tuo amico: il codice è nell’ultima riga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierte, inneholder ingen Sprout-kode. Kopier hele meldingen fra vennen din – koden står på siste linje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In wat je kopieerde staat geen Sprout-code. Kopieer het hele bericht van je vriend — de code staat op de laatste regel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem código do Sprout. Copie a mensagem inteira do seu amigo — o código fica na última linha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem um código do Sprout. Copie a mensagem inteira do seu amigo — o código está na última linha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierade innehåller ingen Sprout-kod. Kopiera vännens hela meddelande – koden står på sista raden."
          }
        }
      }
    },
