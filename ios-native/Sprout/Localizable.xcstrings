          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Épp jó: a kártya narancsszínben világít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas sekali: kartu menyala oranye."
