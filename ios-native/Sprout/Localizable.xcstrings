    "Вместе с ней уйдут %lld растений. Вернуть их будет нельзя.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plante forsvinder med det. Det kan ikke fortrydes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld planter forsvinder med det. Det kan ikke fortrydes."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit ihm verschwindet %lld Pflanze. Das lässt sich nicht rückgängig machen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mit ihm verschwinden %lld Pflanzen. Das lässt sich nicht rückgängig machen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Its %lld plant will go with it. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Its %lld plants will go with it. This can’t be undone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Con ella se irá %lld planta. No se podrá deshacer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Con ella se irán %lld plantas. No se podrá deshacer."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sen mukana katoaa %lld kasvi. Tätä ei voi kumota."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sen mukana katoaa %lld kasvia. Tätä ei voi kumota."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plante partira avec elle. Impossible de revenir en arrière."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plantes partiront avec elle. Impossible de revenir en arrière."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Con lei se ne andrà %lld pianta. Non si potrà annullare."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Con lei se ne andranno %lld piante. Non si potrà annullare."
                }
              }
            }
          }
        },
        "nb": {
          "variations": {
