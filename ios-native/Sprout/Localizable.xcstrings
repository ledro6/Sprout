        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기엔 늘 다음 단계가 적혀 있어요: 카메라를 향하고, 식물을 놓고, 선택하기."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia visada parašytas kitas žingsnis: nukreipti kamerą, pastatyti augalą, jį pasirinkti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ എപ്പോഴും അടുത്ത ഘട്ടം എഴുതിയിരിക്കും: ക്യാമറ തിരിക്കുക, ചെടി വയ്ക്കുക, അത് തിരഞ്ഞെടുക്കുക."
