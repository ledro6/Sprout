        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko rastlin potrebuje vodo in katera je prva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur många växter som behöver vatten och vem som är först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எத்தனை செடிகளுக்குத் தண்ணீர் தேவை, முதலில் யார்."
          }
