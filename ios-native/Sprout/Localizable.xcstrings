    "Удобрение, разведённое в воде для полива. Нужно раз в несколько недель, пока растение растёт.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سماد مذاب في ماء السقي. يلزم كل بضعة أسابيع ما دامت النبتة تنمو."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тор, разтворен във водата за поливане. Нужен е на няколко седмици, докато растението расте."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জল দেওয়ার জলে গোলানো সার। গাছ বাড়ার সময় কয়েক সপ্তাহ পরপর লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Adob dissolt a l’aigua de reg. Cal cada poques setmanes mentre la planta creix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hnojivo rozpuštěné ve vodě na zálivku. Potřeba jednou za pár týdnů, dokud rostlina roste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gødning opløst i vandingsvandet. Planten har brug for det hver få uger, mens den vokser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünger, im Gießwasser aufgelöst. Braucht die Pflanze alle paar Wochen, solange sie wächst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λίπασμα διαλυμένο στο νερό του ποτίσματος. Χρειάζεται κάθε λίγες εβδομάδες, όσο το φυτό μεγαλώνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertilizer mixed into the watering water. Plants need it every few weeks while they’re growing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abono disuelto en el agua de riego. Hace falta cada pocas semanas mientras la planta crece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasteluveteen liuotettua lannoitetta. Tarvitaan muutaman viikon välein, kun kasvi kasvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l’engrais dilué dans l’eau d’arrosage. Nécessaire toutes les quelques semaines pendant la croissance."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાણીમાં ઓગાળેલું ખાતર. છોડ વધતો હોય ત્યારે દર થોડા અઠવાડિયે જોઈએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דשן שמומס במי ההשקיה. צריך אותו כל כמה שבועות, כל עוד הצמח גדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी में घोली गई खाद। पौधे के बढ़ते समय हर कुछ हफ़्तों में चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gnojivo otopljeno u vodi za zalijevanje. Treba ga svakih nekoliko tjedana dok biljka raste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az öntözővízben feloldott tápoldat. Néhány hetente kell, amíg a növény növekszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pupuk yang dilarutkan dalam air siraman. Dibutuhkan tiap beberapa minggu selama tanaman tumbuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concime sciolto nell’acqua di annaffiatura. Serve ogni poche settimane mentre la pianta cresce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりの水に溶かす肥料です。育っている間は数週間ごとに必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суару суына ерітілген тыңайтқыш. Өсімдік өсіп жатқанда бірнеше апта сайын керек."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀರಿನಲ್ಲಿ ಕರಗಿಸಿದ ಗೊಬ್ಬರ. ಗಿಡ ಬೆಳೆಯುತ್ತಿರುವಾಗ ಕೆಲವು ವಾರಗಳಿಗೊಮ್ಮೆ ಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 줄 때 섞는 비료예요. 식물이 자라는 동안 몇 주마다 필요해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trąšos, ištirpintos laistymo vandenyje. Reikia kas kelias savaites, kol augalas auga."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നനയ്ക്കാനുള്ള വെള്ളത്തിൽ കലക്കിയ വളം. ചെടി വളരുന്ന കാലത്ത് ഏതാനും ആഴ്ച കൂടുമ്പോൾ വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाण्यात विरघळवलेले खत. रोप वाढत असताना दर काही आठवड्यांनी लागते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja yang dilarutkan dalam air siraman. Diperlukan setiap beberapa minggu semasa tumbuhan membesar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjødsel løst opp i vanningsvannet. Trengs med noen ukers mellomrom mens planten vokser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantenvoeding opgelost in het gietwater. Om de paar weken nodig zolang de plant groeit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାଣିରେ ମିଶାଯାଇଥିବା ଖତ। ଗଛ ବଢ଼ୁଥିବା ବେଳେ କିଛି ସପ୍ତାହରେ ଥରେ ଦରକାର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਣੀ ਵਿੱਚ ਘੋਲੀ ਹੋਈ ਖਾਦ। ਪੌਦੇ ਦੇ ਵਧਣ ਸਮੇਂ ਹਰ ਕੁਝ ਹਫ਼ਤਿਆਂ ਬਾਅਦ ਚਾਹੀਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawóz rozpuszczony w wodzie do podlewania. Potrzebny co kilka tygodni, póki roślina rośnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adubo dissolvido na água da rega. É preciso a cada poucas semanas enquanto a planta cresce."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adubo dissolvido na água da rega. É preciso de poucas em poucas semanas enquanto a planta cresce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îngrășământ dizolvat în apa de udat. E nevoie de el la câteva săptămâni, cât timp planta crește."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hnojivo rozpustené vo vode na polievanie. Treba ho raz za pár týždňov, kým rastlina rastie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gnojilo, raztopljeno v vodi za zalivanje. Potrebno na nekaj tednov, dokler rastlina raste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gödning upplöst i vattningsvattnet. Behövs med några veckors mellanrum medan växten växer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீரில் கரைத்த உரம். செடி வளரும் காலத்தில் சில வாரங்களுக்கு ஒருமுறை தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీటిలో కలిపిన ఎరువు. మొక్క పెరుగుతున్నప్పుడు కొన్ని వారాలకొకసారి అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ๋ยที่ละลายในน้ำสำหรับรด ต้องใช้ทุกไม่กี่สัปดาห์ระหว่างที่ต้นไม้เติบโต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulama suyunda çözülmüş gübre. Bitki büyürken birkaç haftada bir gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Добриво, розведене у воді для поливу. Потрібне раз на кілька тижнів, поки рослина росте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پانی میں گھلی ہوئی کھاد۔ پودا بڑھتے وقت ہر چند ہفتوں بعد چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân bón hòa vào nước tưới. Cần vài tuần một lần khi cây đang lớn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "溶在浇水用水里的肥料。植物生长期间每隔几周需要一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溶在澆水用水裡的肥料。植物生長期間每隔幾週需要一次。"
          }
        }
      }
    },
