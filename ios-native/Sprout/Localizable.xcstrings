    "Отмечает полив: влажность встаёт на сто процентов, а полив попадает в журнал.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل السقي: ترتفع الرطوبة إلى مئة بالمئة ويُضاف السقي إلى السجل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбелязва поливане: влажността става сто процента, а поливането влиза в дневника."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জল দেওয়া নথিভুক্ত করে: আর্দ্রতা একশো শতাংশ হয় এবং হিসাবে যোগ হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una regada: la humitat puja al cent per cent i la regada s’anota al registre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamená zalití: vlhkost stoupne na sto procent a zalití se zapíše do deníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanding: fugten stiger til hundrede procent, og vandingen kommer i loggen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermerkt das Gießen: Die Feuchtigkeit steigt auf hundert Prozent, und das Gießen landet im Protokoll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράφει ένα πότισμα: η υγρασία ανεβαίνει στο εκατό τοις εκατό και το πότισμα μπαίνει στο ημερολόγιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs a watering: moisture goes up to one hundred percent and the watering is added to the log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un riego: la humedad sube al cien por cien y el riego se anota en el registro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa kastelun: kosteus nousee sataan prosenttiin ja kastelu tallentuu päiväkirjaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un arrosage : l’humidité remonte à cent pour cent et l’arrosage entre dans le journal."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાણી આપ્યાની નોંધ કરે છે: ભેજ સો ટકા થાય છે અને નોંધ ઉમેરાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רושם השקיה: הלחות עולה למאה אחוז וההשקיה נכנסת ליומן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंचाई दर्ज करता है: नमी सौ प्रतिशत हो जाती है और सिंचाई लॉग में जुड़ जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilježi zalijevanje: vlažnost raste na sto posto, a zalijevanje ulazi u dnevnik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzít egy öntözést: a nedvesség száz százalékra nő, az öntözés pedig bekerül a naplóba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencatat penyiraman: kelembapan naik ke seratus persen dan penyiraman masuk ke catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un’annaffiatura: l’umidità sale al cento per cento e l’annaffiatura finisce nel registro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりを記録します：湿度が100パーセントになり、水やりが記録に追加されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суаруды белгілейді: ылғал жүз пайызға жетеді, ал суару журналға түседі."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀರು ಹಾಕಿದ್ದನ್ನು ದಾಖಲಿಸುತ್ತದೆ: ತೇವಾಂಶ ನೂರು ಶೇಕಡಾ ಆಗುತ್ತದೆ, ದಾಖಲೆಗೆ ಸೇರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물주기를 기록해요: 습도가 100퍼센트가 되고 기록에 추가돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažymi laistymą: drėgmė pakyla iki šimto procentų, o laistymas įrašomas į žurnalą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നന രേഖപ്പെടുത്തുന്നു: ഈർപ്പം നൂറ് ശതമാനമാകും, രേഖയിൽ ചേരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाणी घातल्याची नोंद करते: ओलावा शंभर टक्के होतो आणि नोंद जोडली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekod siraman: kelembapan naik ke seratus peratus dan siraman dimasukkan ke dalam log."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer en vanning: fukten stiger til hundre prosent, og vanningen havner i loggen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert een waterbeurt: de vochtigheid gaat naar honderd procent en de beurt komt in het logboek."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାଣି ଦେବା ଲିପିବଦ୍ଧ କରେ: ଆର୍ଦ୍ରତା ଶହେ ପ୍ରତିଶତ ହୁଏ ଏବଂ ରେକର୍ଡରେ ଯୋଡ଼ାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਣੀ ਦੇਣਾ ਦਰਜ ਕਰਦਾ ਹੈ: ਨਮੀ ਸੌ ਪ੍ਰਤੀਸ਼ਤ ਹੋ ਜਾਂਦੀ ਹੈ ਅਤੇ ਰਿਕਾਰਡ ਵਿੱਚ ਜੁੜ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje podlanie: wilgotność rośnie do stu procent, a podlanie trafia do dziennika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra uma rega: a umidade sobe para cem por cento e a rega entra no histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista uma rega: a humidade sobe para cem por cento e a rega entra no registo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o udare: umiditatea urcă la sută la sută, iar udarea intră în jurnal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamená poliatie: vlhkosť stúpne na sto percent a poliatie sa zapíše do denníka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabeleži zalivanje: vlažnost se dvigne na sto odstotkov, zalivanje pa se zapiše v dnevnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerar en vattning: fukten går upp till hundra procent och vattningen hamnar i loggen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீர்ப்பாசனத்தைப் பதிவு செய்கிறது: ஈரப்பதம் நூறு சதவீதமாகும், பதிவில் சேரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీళ్లు పోయడాన్ని నమోదు చేస్తుంది: తేమ వంద శాతం అవుతుంది, రికార్డులో చేరుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการรดน้ำ: ความชื้นขึ้นเป็นร้อยเปอร์เซ็นต์ และการรดน้ำถูกบันทึกลงสมุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sulamayı kaydeder: nem yüzde yüze çıkar ve sulama günlüğe eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначає полив: вологість стає сто відсотків, а полив потрапляє в журнал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آبپاشی درج کرتا ہے: نمی سو فیصد ہو جاتی ہے اور ریکارڈ میں شامل ہو جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại lần tưới: độ ẩm lên một trăm phần trăm và lần tưới được ghi vào nhật ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录一次浇水：湿度升到百分之百，并记入浇水记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄一次澆水：濕度升到百分之百，並記入澆水紀錄。"
          }
        }
      }
    },
