    "Нужен iPhone с датчиком LiDAR — модели Pro, начиная с iPhone 12 Pro.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم iPhone بمستشعر LiDAR — طرازات Pro بدءًا من iPhone 12 Pro."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен е iPhone с LiDAR сензор – Pro моделите от iPhone 12 Pro нататък."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR সেন্সরযুক্ত iPhone লাগবে — iPhone 12 Pro থেকে Pro মডেলগুলো।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal un iPhone amb sensor LiDAR: models Pro a partir de l’iPhone 12 Pro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebujete iPhone se senzorem LiDAR – modely Pro od iPhonu 12 Pro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver en iPhone med LiDAR-sensor – Pro-modeller fra iPhone 12 Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht ein iPhone mit LiDAR-Sensor – Pro-Modelle ab iPhone 12 Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζεται iPhone με αισθητήρα LiDAR — μοντέλα Pro από το iPhone 12 Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs an iPhone with a LiDAR sensor — Pro models from iPhone 12 Pro on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas un iPhone con sensor LiDAR: modelos Pro desde el iPhone 12 Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan iPhone, jossa on LiDAR-anturi – Pro-mallit iPhone 12 Prosta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un iPhone avec capteur LiDAR — modèles Pro à partir de l’iPhone 12 Pro."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR સેન્સરવાળો iPhone જોઈએ — iPhone 12 Pro થી Pro મૉડલ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש אייפון עם חיישן LiDAR — דגמי Pro החל מ־iPhone 12 Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR सेंसर वाला iPhone चाहिए — iPhone 12 Pro से आगे के Pro मॉडल।"
          }
        },
        "hr": {
