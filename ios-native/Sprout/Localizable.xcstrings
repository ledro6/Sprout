        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಣ್ಣು ಬೇಗ ಒಣಗುತ್ತಿರುವಂತಿದೆ: %2$@ ಬದಲು %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙이 더 빨리 마르는 것 같아요: %2$@ 대신 %1$@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodo, žemė džiūsta greičiau: %1$@, o ne %2$@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മണ്ണ് വേഗം ഉണങ്ങുന്നതായി തോന്നുന്നു: %2$@ എന്നതിന് പകരം %1$@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "माती लवकर सुकते असे दिसते: %2$@ ऐवजी %1$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nampaknya tanah kering lebih cepat: %1$@, bukan %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jorda ser ut til å tørke raskere: %1$@ i stedet for %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aarde lijkt sneller te drogen: %1$@ in plaats van %2$@."
