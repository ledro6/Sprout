    "Удалите приложение — вместе с ним исчезнет и всё, что оно помнило.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet appen – og alt, hvad den huskede, forsvinder med den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösch die App — und alles, was sie sich gemerkt hat, verschwindet mit ihr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the app — and everything it remembered disappears with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la app y todo lo que recordaba desaparecerá con ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista appi – ja kaikki, mitä se muisti, katoaa sen mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez l’app — et tout ce qu’elle a retenu disparaîtra avec elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina l’app e tutto ciò che ricordava sparirà con lei."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett appen – og alt den husket, forsvinner med den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de app — en alles wat hij onthield verdwijnt mee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague o app — e tudo o que ele lembrava some junto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague a app — e tudo o que ela lembrava desaparece com ela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera appen – så försvinner allt den kom ihåg."
          }
        }
      }
    },
