    "Снимок мыльный — возьму готовую модель вида.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet er uskarpt – jeg bruger artens færdige model."
