    "Ваш сад как солнечная система: растения кружат по орбитам полива. Загляните — там можно послушать месяц.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حديقتك كالمجموعة الشمسية: النبتات تدور في مدارات السقي. ألقِ نظرة — يمكنك حتى الاستماع إلى شهر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Градината ви като Слънчева система: растенията обикалят по орбитите си на поливане. Надникнете – там може дори да чуете един месец."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাগান সৌরজগতের মতো: গাছেরা জলের কক্ষপথে ঘোরে। একবার দেখুন — একটা মাস শুনতেও পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu jardí com un sistema solar: les plantes giren per les seves òrbites de reg. Fes-hi un cop d’ull: fins i tot pots escoltar un mes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zahrada jako sluneční soustava: rostliny krouží po drahách zalévání. Nahlédněte – dá se tam i poslechnout měsíc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din have som et solsystem: planterne kredser i deres vandingsbaner. Kig ind – der kan du endda lytte til en måned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten als Sonnensystem: Die Pflanzen kreisen auf ihren Gießbahnen. Schau rein – dort kannst du dir sogar einen Monat anhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κήπος σας σαν ηλιακό σύστημα: τα φυτά περιφέρονται στις τροχιές ποτίσματός τους. Ρίξτε μια ματιά — μπορείτε και να ακούσετε έναν μήνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden as a solar system: plants circle along their watering orbits. Take a look — you can even listen to a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jardín como un sistema solar: las plantas giran en sus órbitas de riego. Échale un vistazo: hasta puedes escuchar un mes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhasi aurinkokuntana: kasvit kiertävät kasteluratojaan. Kurkista – siellä voi jopa kuunnella kuukauden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jardin comme un système solaire : les plantes tournent sur leurs orbites d’arrosage. Jetez un œil — on peut même y écouter un mois."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો બગીચો સૂર્યમંડળ જેવો: છોડ પોતાની પાણીની ભ્રમણકક્ષામાં ફરે છે. એક નજર નાખો — એક મહિનો સાંભળી પણ શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגינה שלך כמו מערכת השמש: הצמחים חגים במסלולי ההשקיה שלהם. הציצו – אפשר אפילו להאזין לחודש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बगीचा सौरमंडल जैसा: पौधे अपनी पानी की कक्षाओं में घूमते हैं। झाँककर देखें — एक महीना सुना भी जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš vrt kao Sunčev sustav: biljke kruže svojim putanjama zalijevanja. Zavirite – ondje možete čak i poslušati mjesec."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kerted mint naprendszer: a növények az öntözési pályáikon keringenek. Nézz be – akár egy hónapot is meghallgathatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebun Anda seperti tata surya: tanaman beredar di orbit siramnya. Lihatlah — Anda bahkan bisa mendengarkan sebulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino come un sistema solare: le piante girano sulle loro orbite di annaffiatura. Dai un’occhiata: puoi perfino ascoltare un mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭を太陽系に見立てて：植物が水やりの軌道を回ります。のぞいてみて — 1か月の音を聴くこともできます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағыңыз Күн жүйесі сияқты: өсімдіктер суару орбиталарымен айналады. Кіріп көріңіз — онда бір айды тыңдауға болады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ತೋಟ ಸೌರವ್ಯೂಹದಂತೆ: ಗಿಡಗಳು ನೀರಿನ ಕಕ್ಷೆಗಳಲ್ಲಿ ಸುತ್ತುತ್ತವೆ. ಒಮ್ಮೆ ನೋಡಿ — ಒಂದು ತಿಂಗಳನ್ನು ಕೇಳಲೂ ಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원을 태양계처럼: 식물이 물주기 궤도를 돕니다. 들어가 보세요 — 한 달을 들어 볼 수도 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų sodas kaip Saulės sistema: augalai sukasi laistymo orbitomis. Užsukite – ten galima net pasiklausyti mėnesio."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തോട്ടം ഒരു സൗരയൂഥം പോലെ: ചെടികൾ അവരുടെ നനയ്ക്കൽ ഭ്രമണപഥങ്ങളിൽ ചുറ്റുന്നു. ഒന്നു നോക്കൂ — ഒരു മാസം കേൾക്കുകയും ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची बाग सूर्यमालेसारखी: रोपे आपापल्या पाण्याच्या कक्षांत फिरतात. डोकावून पाहा — एक महिना ऐकताही येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taman anda seperti sistem suria: tumbuhan beredar di orbit siramannya. Lihatlah — anda juga boleh mendengar sebulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen din som et solsystem: plantene sirkler i vanningsbanene sine. Ta en titt – der kan du til og med lytte til en måned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin als zonnestelsel: de planten draaien in hun gietbanen. Kijk eens – je kunt zelfs een maand beluisteren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବଗିଚା ସୌରମଣ୍ଡଳ ପରି: ଗଛମାନେ ପାଣିର କକ୍ଷପଥରେ ଘୂରନ୍ତି। ଥରେ ଦେଖନ୍ତୁ — ଗୋଟିଏ ମାସ ଶୁଣି ବି ପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਬਗੀਚਾ ਸੂਰਜੀ ਮੰਡਲ ਵਰਗਾ: ਪੌਦੇ ਆਪਣੇ ਪਾਣੀ ਦੇ ਪੰਧਾਂ 'ਤੇ ਘੁੰਮਦੇ ਹਨ। ਝਾਤ ਮਾਰੋ — ਇੱਕ ਮਹੀਨਾ ਸੁਣ ਵੀ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ogród jak Układ Słoneczny: rośliny krążą po orbitach podlewania. Zajrzyj – można tam nawet posłuchać miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jardim como um sistema solar: as plantas giram em suas órbitas de rega. Dê uma olhada — dá até para ouvir um mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu jardim como um sistema solar: as plantas giram nas suas órbitas de rega. Espreite — até pode ouvir um mês."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grădina ta ca un sistem solar: plantele se rotesc pe orbitele de udare. Aruncă o privire – poți chiar asculta o lună."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša záhrada ako slnečná sústava: rastliny krúžia po dráhach polievania. Nazrite – dá sa tam aj vypočuť mesiac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš vrt kot osončje: rastline krožijo po svojih tirnicah zalivanja. Pokukajte – tam lahko celo poslušate mesec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din trädgård som ett solsystem: växterna kretsar i sina vattningsbanor. Ta en titt – där kan du till och med lyssna på en månad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தோட்டம் சூரியக் குடும்பம் போல: செடிகள் தங்கள் நீர் சுற்றுப்பாதைகளில் சுழல்கின்றன. எட்டிப் பாருங்கள் — ஒரு மாதத்தைக் கேட்கவும் முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ తోట సౌర కుటుంబంలా: మొక్కలు తమ నీటి కక్ష్యల్లో తిరుగుతాయి. ఒకసారి చూడండి — ఒక నెలను వినవచ్చు కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวนของคุณเหมือนระบบสุริยะ: ต้นไม้โคจรไปตามวงโคจรการรดน้ำ ลองเข้าไปดูสิ — ฟังเสียงของทั้งเดือนได้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz bir güneş sistemi gibi: bitkiler sulama yörüngelerinde döner. Bir göz atın — bir ayı dinleyebilirsiniz bile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сад як Сонячна система: рослини кружляють орбітами поливу. Загляньте — там можна послухати місяць."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا باغ نظامِ شمسی کی طرح: پودے اپنے پانی کے مداروں پر گھومتے ہیں۔ ایک نظر ڈالیں — آپ ایک مہینہ سن بھی سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vườn như một hệ mặt trời: cây cối xoay quanh quỹ đạo tưới của mình. Ghé xem nhé — bạn còn có thể nghe cả một tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把花园想象成太阳系：植物沿着浇水轨道运转。进去看看——还能听一整个月。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把花園想像成太陽系：植物沿著澆水軌道運行。進去看看——還能聽一整個月。"
          }
        }
      }
    },
