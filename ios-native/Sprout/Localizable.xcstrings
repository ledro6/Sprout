    "Поливаете между делами, при свете дня.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسقي بين المشاغل، في وضح النهار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливате между задачите, посред бял ден."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজের ফাঁকে, দিনের আলোয় জল দেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Regues entre feina i feina, a plena llum del dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaléváte mezi povinnostmi, za bílého dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vander ind imellem, ved højlys dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gießt zwischendurch, bei Tageslicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποτίζετε ανάμεσα στις δουλειές, μέρα μεσημέρι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You water between errands, in broad daylight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riegas entre tarea y tarea, a plena luz del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastelet muiden puuhien lomassa, päivänvalossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous arrosez entre deux tâches, en plein jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કામની વચ્ચે, દિવસના અજવાળે પાણી આપો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשקיה בין עניין לעניין, באור יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कामों के बीच, दिन के उजाले में पानी देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalijevate između obaveza, po danu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két dolog között öntözöl, fényes nappal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyiram di sela kesibukan, di siang hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffi tra una cosa e l’altra, alla luce del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用事の合間、明るい昼間に水やり。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Істердің арасында, күндіз суарасыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲಸಗಳ ನಡುವೆ, ಹಗಲಿನ ಬೆಳಕಿನಲ್ಲಿ ನೀರು ಹಾಕುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일하는 틈틈이, 환한 낮에 물을 줘요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laistote tarp kitų darbų, šviesiu paros metu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജോലികൾക്കിടയിൽ, പകൽവെളിച്ചത്തിൽ നനയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कामांच्या मधे, दिवसाच्या उजेडात पाणी घालता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyiram di celah-celah urusan, pada siang hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vanner innimellom, midt på lyse dagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geeft water tussen de bedrijven door, bij daglicht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାମ ଫାଙ୍କରେ, ଦିନ ଆଲୁଅରେ ପାଣି ଦିଅନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਮਾਂ ਦੇ ਵਿਚਕਾਰ, ਦਿਨ ਦੇ ਚਾਨਣ ਵਿੱਚ ਪਾਣੀ ਦਿੰਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewasz między sprawami, w biały dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você rega entre uma coisa e outra, à luz do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega entre uma coisa e outra, à luz do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi între treburi, la lumina zilei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Polievate medzi povinnosťami, za bieleho dňa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalivate med opravki, pri belem dnevu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vattnar mellan varven, i dagsljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேலைகளுக்கு இடையில், பகல் வெளிச்சத்தில் நீர் ஊற்றுகிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పనుల మధ్యలో, పగటి వెలుగులో నీళ్లు పోస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรดน้ำระหว่างงานอื่น ๆ ตอนกลางวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlerin arasında, gün ışığında suluyorsunuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливаєте між справами, за денного світла."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کاموں کے بیچ، دن کی روشنی میں پانی دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tưới xen giữa công việc, giữa ban ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在忙碌间隙、在白天浇水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在忙碌空檔、在白天澆水。"
          }
        }
      }
    },
