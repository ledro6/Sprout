        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാസം പരേഡുകളില്ല: ചെടികൾ വ്യത്യസ്ത സമയങ്ങളിൽ വെള്ളം ചോദിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या महिन्यात परेड नाही: रोपे वेगवेगळ्या वेळी पाणी मागतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan ini tiada perarakan: tumbuhan meminta air pada masa yang berbeza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen parader denne måneden: plantene vil ha vann til ulike tider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze maand geen parades: je planten willen op verschillende momenten water."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ମାସରେ କୌଣସି ପରେଡ୍ ନାହିଁ: ଗଛମାନେ ଭିନ୍ନ ଭିନ୍ନ ସମୟରେ ପାଣି ମାଗନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਹੀਨੇ ਕੋਈ ਪਰੇਡ ਨਹੀਂ: ਪੌਦੇ ਵੱਖ-ਵੱਖ ਸਮੇਂ ਪਾਣੀ ਮੰਗਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu brak parad: rośliny proszą o wodę w różnych porach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum desfile neste mês: as plantas pedem água em momentos diferentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum desfile este mês: as plantas pedem água em alturas diferentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna aceasta nu sunt parade: plantele cer apă la momente diferite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento mesiac žiadne prehliadky: rastliny chcú vodu v rôznom čase."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta mesec ni parad: rastline si vode želijo ob različnih časih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga parader den här månaden: växterna vill ha vatten vid olika tider."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதம் அணிவகுப்பு இல்லை: செடிகள் வெவ்வேறு நேரங்களில் நீர் கேட்கின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నెల పరేడ్‌లు లేవు: మొక్కలు వేర్వేరు సమయాల్లో నీళ్లు అడుగుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนนี้ไม่มีขบวนพาเหรด: ต้นไม้ต้องการน้ำคนละเวลา"
