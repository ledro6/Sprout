        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿੰਨੇ ਪੌਦਿਆਂ ਨੂੰ ਪਾਣੀ ਚਾਹੀਦਾ ਹੈ ਅਤੇ ਪਹਿਲਾ ਕੌਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile roślin potrzebuje wody i która pierwsza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas plantas precisam de água e qual é a primeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas plantas precisam de água e qual é a primeira."
          }
        },
        "ro": {
