          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "«ଯିବା» ରେ ବଗିଚାକୁ ଯାତ୍ରା ପାଇଁ ପ୍ରସ୍ତୁତ କରନ୍ତୁ।"
