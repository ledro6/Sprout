        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do podlania przez sąsiada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o vizinho regar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o vizinho regar"
          }
        },
        "ro": {
