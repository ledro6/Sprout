    "В саду пока ничего не растёт. Посадите первое растение во вкладке «Добавить».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء ينمو في حديقتك بعد. ازرع أول نبتة من علامة التبويب «إضافة»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В градината все още нищо не расте. Засадете първото растение в раздела „Добави“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no creix res al teu jardí. Planta la primera a la pestanya «Afegeix»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve vaší zahradě zatím nic neroste. Zasaďte první rostlinu na kartě „Přidat“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vokser endnu intet i din have. Plant den første på fanen ”Tilføj”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Garten wächst noch nichts. Setz die erste Pflanze im Tab „Hinzufügen“ ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στον κήπο σας δεν μεγαλώνει ακόμα τίποτα. Φυτέψτε το πρώτο στην καρτέλα «Προσθήκη»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is growing in your garden yet. Plant the first one in the “Add” tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no crece nada en tu jardín. Planta la primera en la pestaña “Añadir”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarhassasi ei vielä kasva mitään. Istuta ensimmäinen välilehdellä ”Lisää”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne pousse encore dans votre jardin. Plantez la première plante dans l’onglet « Ajouter »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא גדל כלום בגינה. אפשר לשתול את הצמח הראשון בכרטיסייה “הוספה”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U vašem vrtu još ništa ne raste. Posadite prvu biljku na kartici „Dodaj”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kertedben még semmi sem nő. Ültesd el az elsőt a „Hozzáadás” lapon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo giardino non cresce ancora niente. Pianta la prima nella scheda “Aggiungi”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақта әзірге ештеңе өспейді. Алғашқы өсімдікті «Қосу» қойындысында отырғызыңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų sode dar niekas neauga. Pasodinkite pirmąjį augalą skirtuke „Pridėti“."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting vokser i hagen din ennå. Plant den første i fanen «Legg til»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er groeit nog niets in je tuin. Plant de eerste in het tabblad ‘Voeg toe’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W twoim ogrodzie jeszcze nic nie rośnie. Posadź pierwszą roślinę w karcie „Dodaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada crescendo no seu jardim. Plante a primeira na aba “Adicionar”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não cresce nada no seu jardim. Plante a primeira no separador “Adicionar”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În grădina ta încă nu crește nimic. Plantează prima plantă în fila „Adaugă”."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vo vašej záhrade zatiaľ nič nerastie. Zasaďte prvú rastlinu na karte „Pridať“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vašem vrtu še nič ne raste. Posadite prvo rastlino na zavihku »Dodaj«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget växer i din trädgård än. Plantera den första på fliken ”Lägg till”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçenizde henüz bir şey yetişmiyor. İlk bitkiyi “Ekle” sekmesinde dikin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У саду поки нічого не росте. Посадіть першу рослину у вкладці «Додати»."
          }
        }
      }
    },
    "В саду пока пусто.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحديقة فارغة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Градината е празна."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardí és buit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrada je prázdná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven er tom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Garten ist leer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κήπος είναι άδειος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The garden is empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jardín está vacío."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puutarha on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jardin est vide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגינה ריקה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrt je prazan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kert üres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giardino è vuoto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақ әзірге бос."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodas tuščias."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagen er tom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tuin is leeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogród jest pusty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está vazio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jardim está vazio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grădina e goală."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záhrada je prázdna."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrt je prazen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trädgården är tom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçe boş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У саду поки порожньо."
          }
        }
      }
    },
    "В скопированном нет кода Sprout. Скопируйте сообщение друга целиком — код лежит в нём последней строкой.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد رمز Sprout فيما نسخته. انسخ رسالة صديقك كاملة — الرمز في السطر الأخير."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В копираното няма код на Sprout. Копирайте цялото съобщение на приятеля — кодът е на последния ред."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que has copiat no conté cap codi de Sprout. Copia el missatge sencer del teu amic: el codi és a l’última línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve zkopírovaném textu není kód Sproutu. Zkopírujte celou zprávu od přítele — kód je na posledním řádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kopierede indeholder ingen Sprout-kode. Kopiér din vens hele besked – koden står på sidste linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kopierten ist kein Sprout-Code. Kopiere die ganze Nachricht deines Freundes — der Code steht in der letzten Zeile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο κείμενο που αντιγράψατε δεν υπάρχει κωδικός Sprout. Αντιγράψτε ολόκληρο το μήνυμα του φίλου — ο κωδικός είναι στην τελευταία γραμμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s no Sprout code in what you copied. Copy your friend’s whole message — the code is its last line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copiaste no contiene un código de Sprout. Copia el mensaje entero de tu amigo: el código está en la última línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioimassasi tekstissä ei ole Sprout-koodia. Kopioi kaverisi koko viesti – koodi on viimeisellä rivillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez copié ne contient pas de code Sprout. Copiez tout le message de votre ami — le code est sur la dernière ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטקסט שהועתק אין קוד Sprout. יש להעתיק את כל ההודעה של החבר — הקוד בשורה האחרונה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U kopiranom tekstu nema Sprout koda. Kopirajte cijelu prijateljevu poruku — kod je u zadnjem retku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimásolt szövegben nincs Sprout-kód. Másold ki a barátod teljes üzenetét — a kód az utolsó sorban van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel testo copiato non c’è un codice Sprout. Copia l’intero messaggio del tuo amico: il codice è nell’ultima riga."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірілген мәтінде Sprout коды жоқ. Досыңыздың хабарын толық көшіріңіз — код соңғы жолда тұр."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukopijuotame tekste nėra Sprout kodo. Nukopijuokite visą draugo žinutę – kodas yra paskutinėje eilutėje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierte, inneholder ingen Sprout-kode. Kopier hele meldingen fra vennen din – koden står på siste linje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In wat je kopieerde staat geen Sprout-code. Kopieer het hele bericht van je vriend — de code staat op de laatste regel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W skopiowanym tekście nie ma kodu Sprout. Skopiuj całą wiadomość znajomego — kod jest w ostatnim wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem código do Sprout. Copie a mensagem inteira do seu amigo — o código fica na última linha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto copiado não tem um código do Sprout. Copie a mensagem inteira do seu amigo — o código está na última linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul copiat nu conține un cod Sprout. Copiază tot mesajul prietenului — codul e pe ultimul rând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V skopírovanom texte nie je kód Sproutu. Skopírujte celú správu od priateľa — kód je na poslednom riadku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V kopiranem ni kode Sprout. Kopirajte celotno sporočilo prijatelja — koda je v zadnji vrstici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du kopierade innehåller ingen Sprout-kod. Kopiera vännens hela meddelande – koden står på sista raden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığınızda Sprout kodu yok. Arkadaşınızın mesajının tamamını kopyalayın — kod son satırdadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У скопійованому немає коду Sprout. Скопіюйте повідомлення друга повністю — код лежить у ньому останнім рядком."
          }
        }
      }
    },
