{
  "sourceLanguage": "ru",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقراءة مستشعر الرطوبة في الأصيص — Flower Care وما يشبهه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да чете датчика за влажност в саксията — Flower Care и подобни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টবের আর্দ্রতা সেন্সর পড়তে — Flower Care ও এ ধরনের সেন্সর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per llegir el sensor d’humitat del test: Flower Care i similars."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke čtení čidla vlhkosti v květináči – Flower Care a podobných."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at aflæse fugtsensoren i potten – Flower Care og lignende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Feuchtigkeitssensor im Topf zu lesen – Flower Care und ähnliche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να διαβάζει τον αισθητήρα υγρασίας στη γλάστρα — Flower Care και παρόμοιους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read the moisture sensor in the pot — Flower Care and similar ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer el sensor de humedad de la maceta: Flower Care y similares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruukun kosteusanturin lukemiseen – Flower Care ja vastaavat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour lire le capteur d’humidité du pot — Flower Care et similaires."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૂંડાનો ભેજ સેન્સર વાંચવા — Flower Care અને તેના જેવા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקרוא את חיישן הלחות בעציץ — Flower Care ודומים לו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गमले का नमी सेंसर पढ़ने के लिए — Flower Care और इसी तरह के सेंसर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za očitavanje senzora vlage u loncu — Flower Care i sličnih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cserépben lévő nedvességérzékelő olvasásához – Flower Care és hasonlók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membaca sensor kelembapan di pot — Flower Care dan sejenisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per leggere il sensore di umidità nel vaso: Flower Care e simili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉢の水分センサー（Flower Careなど）を読み取るため。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құмырадағы ылғалдылық датчигін оқу үшін — Flower Care және ұқсастары."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕುಂಡದ ತೇವಾಂಶ ಸೆನ್ಸರ್ ಓದಲು — Flower Care ಮತ್ತು ಅಂತಹವು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화분의 습도 센서를 읽기 위해 — Flower Care 등."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtume skaityti drėgmės jutiklį vazone — Flower Care ir panašius."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചട്ടിയിലെ ഈർപ്പ സെൻസർ വായിക്കാൻ — Flower Care പോലുള്ളവ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंडीतील ओलावा सेन्सर वाचण्यासाठी — Flower Care आणि तत्सम."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membaca penderia kelembapan dalam pasu — Flower Care dan seumpamanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å lese av fuktsensoren i potta – Flower Care og lignende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de vochtsensor in de pot uit te lezen – Flower Care en vergelijkbare."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟବର ଆର୍ଦ୍ରତା ସେନ୍ସର ପଢ଼ିବାକୁ — Flower Care ଓ ସେହିପରି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗਮਲੇ ਦਾ ਨਮੀ ਸੈਂਸਰ ਪੜ੍ਹਨ ਲਈ — Flower Care ਅਤੇ ਇਸ ਵਰਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odczytywać czujnik wilgotności w doniczce — Flower Care i podobne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ler o sensor de umidade do vaso — Flower Care e parecidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ler o sensor de humidade do vaso — Flower Care e semelhantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a citi senzorul de umiditate din ghiveci — Flower Care și altele similare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы читать датчик влажности в горшке — Flower Care и похожие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na čítanie senzora vlhkosti v kvetináči – Flower Care a podobných."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za branje senzorja vlage v loncu — Flower Care in podobnih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att läsa fuktsensorn i krukan – Flower Care och liknande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொட்டியிலுள்ள ஈரப்பதச் சென்சாரைப் படிக்க — Flower Care போன்றவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుండీలోని తేమ సెన్సార్‌ను చదవడానికి — Flower Care వంటివి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่ออ่านค่าเซ็นเซอร์ความชื้นในกระถาง — Flower Care และอื่น ๆ ที่คล้ายกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saksıdaki nem sensörünü okumak için — Flower Care ve benzerleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб читати датчик вологості в горщику — Flower Care та схожі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گملے کا نمی کا سینسر پڑھنے کے لیے — Flower Care اور اس جیسے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đọc cảm biến độ ẩm trong chậu — Flower Care và tương tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取花盆中的湿度传感器——如 Flower Care 等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取花盆中的濕度感測器——如 Flower Care 等。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأحتفظ في التقويم بتقويم خاص بمواعيد السقي والتسميد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да водя в Календар свой календар със сроковете за поливане и торене."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারে জল ও সার দেওয়ার দিনগুলোর জন্য আলাদা একটি ক্যালেন্ডার রাখতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mantenir al Calendari un calendari propi amb els dies de reg i d’adob."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abych v Kalendáři vedl vlastní kalendář s termíny zálivky a hnojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at føre en Sprout-kalender med datoer for vanding og gødning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen eigenen Kalender mit Gieß- und Düngeterminen zu führen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να κρατώ στο Ημερολόγιο δικό μου ημερολόγιο με τις ημέρες ποτίσματος και λίπανσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep a Sprout calendar with watering and feeding dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para llevar en Calendario un calendario propio con las fechas de riego y abono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta voin pitää Kalenterissa omaa kalenteria kastelu- ja lannoituspäivistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour tenir dans Calendrier un calendrier Sprout avec les dates d’arrosage et d’engrais."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૅલેન્ડરમાં પાણી અને ખાતરની તારીખો સાથે પોતાનું કૅલેન્ડર રાખવા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לנהל ביומן לוח שנה משלי עם מועדי השקיה ודישון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर में पानी और खाद की तारीख़ों वाला अपना कैलेंडर रखने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da u Kalendaru vodim vlastiti kalendar s rokovima zalijevanja i prihrane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy a Naptárban saját naptárt vezessek az öntözés és a tápoldatozás időpontjaival."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyimpan kalender Sprout berisi jadwal menyiram dan memupuk di Kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tenere in Calendario un calendario Sprout con le date di annaffiatura e concimazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりと肥料の予定をまとめたSproutのカレンダーを作るために使います。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнтізбеде суару және тыңайту мерзімдері бар өз күнтізбемді жүргізу үшін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಲೆಂಡರ್‌ನಲ್ಲಿ ನೀರು ಮತ್ತು ಗೊಬ್ಬರದ ದಿನಾಂಕಗಳಿರುವ ಸ್ವಂತ ಕ್ಯಾಲೆಂಡರ್ ಇಡಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물주기와 비료 일정을 담은 Sprout 캘린더를 캘린더 앱에 만들기 위해 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad Kalendoriuje vesčiau savo kalendorių su laistymo ir tręšimo terminais."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നനയും വളവും ഉള്ള തീയതികളോടെ കലണ്ടറിൽ സ്വന്തം കലണ്ടർ സൂക്ഷിക്കാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलेंडरमध्ये पाणी आणि खताच्या तारखांचे स्वतःचे कॅलेंडर ठेवण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyimpan kalendar Sprout dengan tarikh siraman dan pembajaan dalam Kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å føre en egen kalender med datoer for vanning og gjødsling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om in Agenda een eigen agenda bij te houden met de data voor water geven en voeden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ୟାଲେଣ୍ଡରରେ ପାଣି ଓ ସାର ଦେବା ତାରିଖ ସହ ନିଜ କ୍ୟାଲେଣ୍ଡର ରଖିବା ପାଇଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਲੰਡਰ ਵਿੱਚ ਪਾਣੀ ਅਤੇ ਖਾਦ ਦੀਆਂ ਤਾਰੀਖ਼ਾਂ ਵਾਲਾ ਆਪਣਾ ਕੈਲੰਡਰ ਰੱਖਣ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby prowadzić w Kalendarzu własny kalendarz z terminami podlewania i nawożenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para manter no Calendário um calendário Sprout com as datas de rega e adubação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para manter no Calendário um calendário Sprout com as datas de rega e adubação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a ține în Calendar un calendar propriu cu termenele de udare și fertilizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы вести в Календаре свой календарь со сроками полива и подкормки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby som v Kalendári viedol vlastný kalendár s termínmi polievania a hnojenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da v Koledarju vodim svoj koledar z roki zalivanja in gnojenja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att föra en egen kalender med datum för vattning och gödsling."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீர் மற்றும் உர நாட்களுடன் கேலெண்டரில் சொந்த கேலெண்டரை வைத்திருக்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీళ్లు, ఎరువు తేదీలతో క్యాలెండర్‌లో సొంత క్యాలెండర్ ఉంచడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อสร้างปฏิทิน Sprout ที่มีวันรดน้ำและใส่ปุ๋ยในแอปปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim’de sulama ve gübreleme tarihlerini içeren bir Sprout takvimi tutmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вести в Календарі свій календар зі строками поливу й підживлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر میں پانی اور کھاد کی تاریخوں والا اپنا کیلنڈر رکھنے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tạo trong Lịch một lịch Sprout với ngày tưới cây và bón phân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在日历中创建一个包含浇水和施肥日期的 Sprout 日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在行事曆中建立包含澆水與施肥日期的 Sprout 行事曆。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتصوير النباتات لحديقتك ووضعها في غرفتك بالواقع المعزز."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да снимате растения за градината и да ги поставяте в стаята в добавена реалност."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাগানের জন্য গাছের ছবি তুলতে এবং অগমেন্টেড রিয়েলিটিতে ঘরে রাখতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fotografiar plantes per al teu jardí i col·locar-les a l’habitació en realitat augmentada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli fotit rostliny do zahrady a stavět je do místnosti v rozšířené realitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at fotografere planter til din have og placere dem i dit rum i augmented reality."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Pflanzen für deinen Garten zu fotografieren und sie in Augmented Reality in deinen Raum zu stellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να φωτογραφίζετε φυτά για τον κήπο σας και να τα τοποθετείτε στο δωμάτιο σε επαυξημένη πραγματικότητα."
