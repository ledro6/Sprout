            "value": "Ke čtení čidel vlhkosti půdy z aplikace Domácnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at aflæse jordfugtsensorer fra appen Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Bodenfeuchtesensoren aus der Home-App zu lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να διαβάζει τους αισθητήρες υγρασίας εδάφους από την εφαρμογή Οικία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read soil moisture sensors from the Home app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer los sensores de humedad del suelo de la app Casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaperän kosteusantureiden lukemiseen Koti-apista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour lire les capteurs d’humidité du sol de l’app Maison."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હોમ ઍપમાંથી માટીના ભેજ સેન્સર વાંચવા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקרוא את חיישני לחות הקרקע מהיישום “בית”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम ऐप से मिट्टी की नमी के सेंसर पढ़ने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za očitavanje senzora vlage tla iz aplikacije Dom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A talajnedvesség-érzékelők olvasásához az Otthon appból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membaca sensor kelembapan tanah dari app “Rumah”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per leggere i sensori di umidità del terreno dall’app Casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ホーム」アプリの土壌水分センサーを読み取るため。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Үй» қолданбасындағы топырақ ылғалдылығы датчиктерін оқу үшін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಮ್ ಆ್ಯಪ್‌ನಿಂದ ಮಣ್ಣಿನ ತೇವಾಂಶ ಸೆನ್ಸರ್‌ಗಳನ್ನು ಓದಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘홈’ 앱에서 흙 습도 센서를 읽기 위해."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtume skaityti dirvožemio drėgmės jutiklius iš programos „Namai“."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹോം ആപ്പിലെ മണ്ണിന്റെ ഈർപ്പ സെൻസറുകൾ വായിക്കാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "होम ॲपमधील मातीच्या ओलाव्याचे सेन्सर वाचण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membaca penderia kelembapan tanah daripada apl “Rumah”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å lese av jordfuktsensorer fra Hjem-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om bodemvochtsensoren uit de Woning-app uit te lezen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହୋମ୍ ଆପ୍‌ରୁ ମାଟିର ଆର୍ଦ୍ରତା ସେନ୍ସର ପଢ଼ିବାକୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਮ ਐਪ ਤੋਂ ਮਿੱਟੀ ਦੀ ਨਮੀ ਦੇ ਸੈਂਸਰ ਪੜ੍ਹਨ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odczytywać czujniki wilgotności gleby z aplikacji Dom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ler os sensores de umidade do solo do app Casa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ler os sensores de humidade do solo da app Casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a citi senzorii de umiditate a solului din aplicația Locuință."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы читать датчики влажности почвы из приложения «Дом»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na čítanie senzorov vlhkosti pôdy z aplikácie Domácnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za branje senzorjev vlage prsti iz aplikacije Dom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att läsa jordfuktsensorer från appen Hem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஹோம் ஆப்பிலிருந்து மண் ஈரப்பதச் சென்சார்களைப் படிக்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోమ్ యాప్ నుంచి మట్టి తేమ సెన్సార్లను చదవడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่ออ่านค่าเซ็นเซอร์ความชื้นในดินจากแอป “บ้าน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev uygulamasındaki toprak nemi sensörlerini okumak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб читати датчики вологості ґрунту із застосунку «Дім»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہوم ایپ سے مٹی کی نمی کے سینسر پڑھنے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đọc cảm biến độ ẩm đất từ ứng dụng “Nhà”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于从“家庭”App 读取土壤湿度传感器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於從「家庭」App 讀取土壤濕度感測器。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمعرفة الطقس في الخارج: في الحر والهواء الجاف تجف التربة أسرع. يكفي الموقع التقريبي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да разбере времето навън: в жега и сух въздух пръстта съхне по-бързо. Стига и приблизително местоположение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাইরের আবহাওয়া জানতে: গরম আর শুকনো বাতাসে মাটি তাড়াতাড়ি শুকোয়। আনুমানিক লোকেশনই যথেষ্ট।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per saber el temps que fa a fora: amb calor i aire sec la terra s’asseca més de pressa. N’hi ha prou amb la ubicació aproximada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby šlo zjistit počasí venku: v horku a suchém vzduchu schne hlína rychleji. Stačí přibližná poloha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at hente vejret udenfor: i varme og tør luft tørrer jorden hurtigere. En omtrentlig lokalitet er nok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um das Wetter draußen abzurufen: Bei Hitze und trockener Luft trocknet die Erde schneller. Ein ungefährer Standort genügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να μαθαίνει τον καιρό έξω: με ζέστη και ξηρό αέρα το χώμα στεγνώνει πιο γρήγορα. Αρκεί η κατά προσέγγιση τοποθεσία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To check the weather outside: in heat and dry air, soil dries faster. An approximate location is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saber el tiempo que hace fuera: con calor y aire seco la tierra se seca más rápido. Basta con una ubicación aproximada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta ulkosää voidaan hakea: helteellä ja kuivassa ilmassa multa kuivuu nopeammin. Likimääräinen sijainti riittää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour connaître la météo dehors : par chaleur et air sec, la terre sèche plus vite. Une position approximative suffit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બહારનું હવામાન જાણવા: ગરમી અને સૂકી હવામાં માટી ઝડપથી સુકાય છે. અંદાજિત સ્થાન પૂરતું છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לדעת מה מזג האוויר בחוץ: בחום ובאוויר יבש האדמה מתייבשת מהר יותר. מיקום משוער מספיק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहर का मौसम जानने के लिए: गर्मी और सूखी हवा में मिट्टी जल्दी सूखती है। अनुमानित लोकेशन काफ़ी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za podatke o vremenu vani: po vrućini i suhom zraku zemlja se brže suši. Dovoljna je približna lokacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kinti időjárás lekéréséhez: hőségben és száraz levegőben a föld gyorsabban szárad. Elég a hozzávetőleges hely."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengetahui cuaca di luar: saat panas dan udara kering, tanah mengering lebih cepat. Lokasi perkiraan sudah cukup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conoscere il meteo fuori: con caldo e aria secca la terra si asciuga prima. Basta una posizione approssimativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外の天気を知るため：暑くて空気が乾いていると、土が早く乾きます。おおよその位置で十分です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сырттағы ауа райын білу үшін: ыстықта және құрғақ ауада топырақ тезірек кебеді. Шамамен алынған орын жетеді."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊರಗಿನ ಹವಾಮಾನ ತಿಳಿಯಲು: ಬಿಸಿ ಮತ್ತು ಒಣ ಗಾಳಿಯಲ್ಲಿ ಮಣ್ಣು ಬೇಗ ಒಣಗುತ್ತದೆ. ಅಂದಾಜು ಸ್ಥಳ ಸಾಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바깥 날씨를 알기 위해: 덥고 건조하면 흙이 더 빨리 말라요. 대략적인 위치면 충분해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad sužinotume orus lauke: per karštį ir sausą orą žemė džiūsta greičiau. Užtenka apytikslės vietos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുറത്തെ കാലാവസ്ഥ അറിയാൻ: ചൂടിലും വരണ്ട വായുവിലും മണ്ണ് വേഗം ഉണങ്ങും. ഏകദേശ ലൊക്കേഷൻ മതി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहेरचे हवामान जाणून घेण्यासाठी: उष्णतेत आणि कोरड्या हवेत माती लवकर सुकते. अंदाजे स्थान पुरेसे आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengetahui cuaca di luar: dalam panas dan udara kering, tanah kering lebih cepat. Lokasi anggaran sudah memadai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å hente været ute: i varme og tørr luft tørker jorda fortere. En omtrentlig posisjon er nok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om het weer buiten op te halen: bij hitte en droge lucht droogt de grond sneller. Een locatie bij benadering is genoeg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାହାରର ପାଣିପାଗ ଜାଣିବାକୁ: ଗରମ ଓ ଶୁଖିଲା ପବନରେ ମାଟି ଶୀଘ୍ର ଶୁଖେ। ଆନୁମାନିକ ଅବସ୍ଥାନ ଯଥେଷ୍ଟ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਹਰ ਦਾ ਮੌਸਮ ਜਾਣਨ ਲਈ: ਗਰਮੀ ਅਤੇ ਖੁਸ਼ਕ ਹਵਾ ਵਿੱਚ ਮਿੱਟੀ ਜਲਦੀ ਸੁੱਕਦੀ ਹੈ। ਅੰਦਾਜ਼ਨ ਟਿਕਾਣਾ ਕਾਫ਼ੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sprawdzić pogodę za oknem: w upale i suchym powietrzu ziemia schnie szybciej. Wystarczy przybliżona lokalizacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saber o tempo lá fora: com calor e ar seco, a terra seca mais rápido. A localização aproximada basta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saber o tempo lá fora: com calor e ar seco, a terra seca mais depressa. Basta a localização aproximada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a afla vremea de afară: la căldură și aer uscat pământul se usucă mai repede. E suficient locul aproximativ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы узнать погоду за окном: в жару и сухой воздух земля сохнет быстрее. Хватит примерного места."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa dalo zistiť počasie vonku: v horúčave a suchom vzduchu schne zemina rýchlejšie. Stačí približná poloha."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za vreme zunaj: v vročini in suhem zraku se zemlja suši hitreje. Dovolj je približna lokacija."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att hämta vädret ute: i värme och torr luft torkar jorden snabbare. Ungefärlig plats räcker."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியே உள்ள வானிலையை அறிய: வெப்பத்திலும் வறண்ட காற்றிலும் மண் வேகமாக உலரும். தோராயமான இருப்பிடம் போதும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బయటి వాతావరణం తెలుసుకోవడానికి: వేడిలో, పొడి గాలిలో మట్టి త్వరగా ఆరుతుంది. సుమారు లొకేషన్ చాలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อทราบสภาพอากาศข้างนอก: เมื่ออากาศร้อนและแห้ง ดินจะแห้งเร็วขึ้น ตำแหน่งโดยประมาณก็เพียงพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışarıdaki havayı öğrenmek için: sıcakta ve kuru havada toprak daha hızlı kurur. Yaklaşık konum yeterli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб дізнатися погоду за вікном: у спеку й сухе повітря земля сохне швидше. Вистачить приблизного місця."
