        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचे के पौधों की फ़ोटो लेने और उन्हें ऑगमेंटेड रियलिटी में कमरे में रखने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za fotografiranje biljaka za vrt i postavljanje u sobu u proširenoj stvarnosti."
