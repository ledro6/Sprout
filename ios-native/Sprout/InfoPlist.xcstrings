        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy növényeket fotózhass a kertedbe, és kiterjesztett valóságban elhelyezhesd őket a szobádban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memotret tanaman untuk kebunmu dan meletakkannya di ruangan dalam realitas tertambah."
