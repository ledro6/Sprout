{
  "sourceLanguage": "ru",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتصوير النباتات لحديقتك ووضعها في غرفتك بالواقع المعزز."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да снимате растения за градината и да ги поставяте в стаята в добавена реалност."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাগানের জন্য গাছের ছবি তুলতে এবং অগমেন্টেড রিয়েলিটিতে ঘরে রাখতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fotografiar plantes per al teu jardí i col·locar-les a l’habitació en realitat augmentada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli fotit rostliny do zahrady a stavět je do místnosti v rozšířené realitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at fotografere planter til din have og placere dem i dit rum i augmented reality."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Pflanzen für deinen Garten zu fotografieren und sie in Augmented Reality in deinen Raum zu stellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να φωτογραφίζετε φυτά για τον κήπο σας και να τα τοποθετείτε στο δωμάτιο σε επαυξημένη πραγματικότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To photograph plants for your garden and place them in your room in augmented reality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografiar plantas para tu jardín y colocarlas en tu habitación en realidad aumentada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvien kuvaamiseksi puutarhaasi ja niiden sijoittamiseksi huoneeseen lisätyssä todellisuudessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour photographier des plantes pour votre jardin et les placer dans votre pièce en réalité augmentée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બગીચા માટે છોડના ફોટા લેવા અને તેમને ઑગમેન્ટેડ રિયાલિટીમાં રૂમમાં મૂકવા માટે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לצלם צמחים לגינה ולהציב אותם בחדר במציאות רבודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचे के पौधों की फ़ोटो लेने और उन्हें ऑगमेंटेड रियलिटी में कमरे में रखने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za fotografiranje biljaka za vrt i postavljanje u sobu u proširenoj stvarnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy növényeket fotózhass a kertedbe, és kiterjesztett valóságban elhelyezhesd őket a szobádban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memotret tanaman untuk kebunmu dan meletakkannya di ruangan dalam realitas tertambah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fotografare le piante del tuo giardino e posizionarle nella stanza in realtà aumentata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭の植物を撮影し、拡張現実で部屋に置くため。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақ үшін өсімдіктерді суретке түсіріп, оларды толықтырылған шындықта бөлмеге орналастыру үшін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೋಟಕ್ಕಾಗಿ ಗಿಡಗಳ ಫೋಟೋ ತೆಗೆದು ಅವುಗಳನ್ನು ಆಗ್ಮೆಂಟೆಡ್ ರಿಯಾಲಿಟಿಯಲ್ಲಿ ಕೋಣೆಯಲ್ಲಿ ಇರಿಸಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원의 식물을 촬영하고 증강 현실로 방에 배치하기 위해."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte fotografuoti augalus sodui ir pastatyti juos kambaryje papildytojoje realybėje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തോട്ടത്തിനായി ചെടികളുടെ ഫോട്ടോ എടുക്കാനും അവയെ ഓഗ്മെന്റഡ് റിയാലിറ്റിയിൽ മുറിയിൽ വയ്ക്കാനും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बागेसाठी रोपांचे फोटो काढण्यासाठी आणि त्यांना ऑगमेंटेड रिअ‍ॅलिटीमध्ये खोलीत ठेवण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengambil foto tumbuhan untuk taman anda dan meletakkannya di dalam bilik dalam realiti tambahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fotografere planter til hagen din og plassere dem i rommet ditt i utvidet virkelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om planten voor je tuin te fotograferen en ze in augmented reality in je kamer te zetten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଗିଚା ପାଇଁ ଗଛର ଫଟୋ ନେବା ଏବଂ ସେଗୁଡ଼ିକୁ ଅଗମେଣ୍ଟେଡ୍ ରିଆଲିଟିରେ ରୁମ୍‌ରେ ରଖିବା ପାଇଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਗੀਚੇ ਲਈ ਪੌਦਿਆਂ ਦੀਆਂ ਫ਼ੋਟੋਆਂ ਲੈਣ ਅਤੇ ਉਨ੍ਹਾਂ ਨੂੰ ਔਗਮੈਂਟਡ ਰਿਐਲਿਟੀ ਵਿੱਚ ਕਮਰੇ ਵਿੱਚ ਰੱਖਣ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby fotografować rośliny do ogrodu i stawiać je w pokoju w rzeczywistości rozszerzonej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografar plantas para o seu jardim e colocá-las no seu cômodo em realidade aumentada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografar plantas para o seu jardim e colocá-las na sua divisão em realidade aumentada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a fotografia plante pentru grădină și a le așeza în cameră în realitate augmentată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы снять растение для сада и поставить его в комнату в дополненной реальности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ste mohli fotiť rastliny do záhrady a umiestňovať ich do miestnosti v rozšírenej realite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko fotografirate rastline za vrt in jih postavite v sobo v obogateni resničnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att fotografera växter till din trädgård och placera dem i ditt rum i förstärkt verklighet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோட்டத்திற்காகச் செடிகளைப் புகைப்படம் எடுத்து, ஆக்மென்டட் ரியாலிட்டியில் அறையில் வைக்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తోట కోసం మొక్కల ఫోటోలు తీసి, వాటిని ఆగ్మెంటెడ్ రియాలిటీలో గదిలో ఉంచడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อถ่ายรูปต้นไม้สำหรับสวนและวางไว้ในห้องด้วยความเป็นจริงเสริม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz için bitkilerin fotoğrafını çekmek ve onları artırılmış gerçeklikte odanıza yerleştirmek için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб знімати рослини для саду й ставити їх у кімнату в доповненій реальності."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باغ کے لیے پودوں کی تصویریں لینے اور انہیں اضافہ شدہ حقیقت میں کمرے میں رکھنے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chụp ảnh cây cho khu vườn và đặt chúng vào phòng bằng thực tế tăng cường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于为花园拍摄植物，并在增强现实中将它们放入房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來為花園拍攝植物，並在擴增實境中將它們放入房間。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لفتح حديقتك المقفلة بوجهك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да отключвате заключената градина с лицето си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক করা বাগান মুখ দিয়ে খুলতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per obrir el jardí bloquejat amb la cara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli odemykat zamčenou zahradu obličejem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at låse din låste have op med dit ansigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deinen gesperrten Garten per Gesichtserkennung zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ξεκλειδώνετε τον κλειδωμένο κήπο με το πρόσωπό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock your locked garden with your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir tu jardín bloqueado con la cara."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitun puutarhan avaamiseksi kasvoilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ouvrir votre jardin verrouillé avec votre visage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લૉક કરેલો બગીચો ચહેરાથી ખોલવા માટે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לפתוח את הגינה הנעולה בעזרת הפנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लॉक बगीचे को चेहरे से खोलने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za otključavanje zaključanog vrta licem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy a zárolt kertet az arcoddal nyithasd meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membuka kebunmu yang terkunci dengan wajah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aprire il giardino bloccato con il volto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックされた庭を顔で開くため。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құлыпталған бақты бетпен ашу үшін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲಾಕ್ ಮಾಡಿದ ತೋಟವನ್ನು ಮುಖದಿಂದ ತೆರೆಯಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠긴 정원을 얼굴로 열기 위해."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte atrakinti užrakintą sodą veidu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോക്ക് ചെയ്ത തോട്ടം മുഖം ഉപയോഗിച്ച് തുറക്കാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक केलेली बाग चेहऱ्याने उघडण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membuka taman anda yang dikunci dengan wajah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å låse opp den låste hagen din med ansiktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je vergrendelde tuin met je gezicht te openen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲକ୍ ହୋଇଥିବା ବଗିଚା ମୁହଁ ଦ୍ୱାରା ଖୋଲିବା ପାଇଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੌਕ ਕੀਤਾ ਬਗੀਚਾ ਚਿਹਰੇ ਨਾਲ ਖੋਲ੍ਹਣ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otwierać zablokowany ogród twarzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir seu jardim bloqueado com o rosto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir o seu jardim bloqueado com o rosto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a deschide grădina blocată cu fața."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открывать запертый сад по лицу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ste mohli odomykať zamknutú záhradu tvárou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko zaklenjeni vrt odklenete z obrazom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att låsa upp din låsta trädgård med ansiktet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பூட்டிய தோட்டத்தை முகத்தால் திறக்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాక్ చేసిన తోటను ముఖంతో తెరవడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อปลดล็อกสวนที่ล็อกไว้ด้วยใบหน้าของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli bahçenizi yüzünüzle açmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відкривати замкнений сад за обличчям."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقفل باغ کو چہرے سے کھولنے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để mở khu vườn đã khóa bằng khuôn mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于通过面容解锁已锁定的花园。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來以 Face ID 解鎖已鎖定的花園。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمالة الهاتف تحرّك نقش الخلفية قليلًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклонът на телефона леко мести шарката на фона."
