{
  "sourceLanguage": "ru",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتصوير النباتات لحديقتك ووضعها في غرفتك بالواقع المعزز."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да снимате растения за градината и да ги поставяте в стаята в добавена реалност."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fotografiar plantes per al teu jardí i col·locar-les a l’habitació en realitat augmentada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli fotit rostliny do zahrady a stavět je do místnosti v rozšířené realitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at fotografere planter til din have og placere dem i dit rum i augmented reality."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Pflanzen für deinen Garten zu fotografieren und sie in Augmented Reality in deinen Raum zu stellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να φωτογραφίζετε φυτά για τον κήπο σας και να τα τοποθετείτε στο δωμάτιο σε επαυξημένη πραγματικότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To photograph plants for your garden and place them in your room in augmented reality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografiar plantas para tu jardín y colocarlas en tu habitación en realidad aumentada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvien kuvaamiseksi puutarhaasi ja niiden sijoittamiseksi huoneeseen lisätyssä todellisuudessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour photographier des plantes pour votre jardin et les placer dans votre pièce en réalité augmentée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לצלם צמחים לגינה ולהציב אותם בחדר במציאות רבודה."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za fotografiranje biljaka za vrt i postavljanje u sobu u proširenoj stvarnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy növényeket fotózhass a kertedbe, és kiterjesztett valóságban elhelyezhesd őket a szobádban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per fotografare le piante del tuo giardino e posizionarle nella stanza in realtà aumentata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақ үшін өсімдіктерді суретке түсіріп, оларды толықтырылған шындықта бөлмеге орналастыру үшін."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte fotografuoti augalus sodui ir pastatyti juos kambaryje papildytojoje realybėje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fotografere planter til hagen din og plassere dem i rommet ditt i utvidet virkelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om planten voor je tuin te fotograferen en ze in augmented reality in je kamer te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby fotografować rośliny do ogrodu i stawiać je w pokoju w rzeczywistości rozszerzonej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografar plantas para o seu jardim e colocá-las no seu cômodo em realidade aumentada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para fotografar plantas para o seu jardim e colocá-las na sua divisão em realidade aumentada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a fotografia plante pentru grădină și a le așeza în cameră în realitate augmentată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы снять растение для сада и поставить его в комнату в дополненной реальности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ste mohli fotiť rastliny do záhrady a umiestňovať ich do miestnosti v rozšírenej realite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko fotografirate rastline za vrt in jih postavite v sobo v obogateni resničnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att fotografera växter till din trädgård och placera dem i ditt rum i förstärkt verklighet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz için bitkilerin fotoğrafını çekmek ve onları artırılmış gerçeklikte odanıza yerleştirmek için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб знімати рослини для саду й ставити їх у кімнату в доповненій реальності."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لفتح حديقتك المقفلة بوجهك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да отключвате заключената градина с лицето си."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per obrir el jardí bloquejat amb la cara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste mohli odemykat zamčenou zahradu obličejem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at låse din låste have op med dit ansigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deinen gesperrten Garten per Gesichtserkennung zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ξεκλειδώνετε τον κλειδωμένο κήπο με το πρόσωπό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock your locked garden with your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir tu jardín bloqueado con la cara."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitun puutarhan avaamiseksi kasvoilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ouvrir votre jardin verrouillé avec votre visage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לפתוח את הגינה הנעולה בעזרת הפנים."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za otključavanje zaključanog vrta licem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy a zárolt kertet az arcoddal nyithasd meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aprire il giardino bloccato con il volto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құлыпталған бақты бетпен ашу үшін."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte atrakinti užrakintą sodą veidu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å låse opp den låste hagen din med ansiktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je vergrendelde tuin met je gezicht te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby otwierać zablokowany ogród twarzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir seu jardim bloqueado com o rosto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para abrir o seu jardim bloqueado com o rosto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a deschide grădina blocată cu fața."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открывать запертый сад по лицу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ste mohli odomykať zamknutú záhradu tvárou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko zaklenjeni vrt odklenete z obrazom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att låsa upp din låsta trädgård med ansiktet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli bahçenizi yüzünüzle açmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відкривати замкнений сад за обличчям."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمالة الهاتف تحرّك نقش الخلفية قليلًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклонът на телефона леко мести шарката на фона."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En inclinar el telèfon, el motiu del fons es mou una mica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náklon telefonu lehce posouvá vzor na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, flytter baggrundsmønsteret sig en smule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Telefon neigst, bewegt sich das Hintergrundmuster leicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κλίση του τηλεφώνου μετακινεί ελαφρά το μοτίβο του φόντου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilting the phone gently moves the background pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al inclinar el teléfono, el patrón del fondo se mueve un poco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimen kallistaminen liikuttaa taustakuviota hieman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incliner le téléphone déplace légèrement le motif d’arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטיית הטלפון מזיזה קלות את הדוגמה ברקע."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagib telefona lagano pomiče uzorak u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon döntése kicsit elmozdítja a háttérmintát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinando il telefono il motivo dello sfondo si sposta leggermente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонды еңкейткенде фондағы өрнек сәл жылжиды."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakreipus telefoną, fono raštas šiek tiek pasislenka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vipper telefonen, flytter bakgrunnsmønsteret seg litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantelen van de telefoon beweegt het achtergrondpatroon een beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechylenie telefonu lekko porusza wzorem w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o celular move levemente o padrão do fundo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o telemóvel move ligeiramente o padrão do fundo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înclinarea telefonului mișcă ușor modelul din fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклон телефона чуть двигает узор на фоне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Náklon telefónu mierne posúva vzor na pozadí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagib telefona rahlo premakne vzorec v ozadju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lutar telefonen rör sig bakgrundsmönstret lite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu eğmek arka plandaki deseni hafifçe kaydırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нахил телефона трохи рухає візерунок на тлі."
          }
        }
      }
    }
  },
  "version": "1.0"
}
